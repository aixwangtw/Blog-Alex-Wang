{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-alex-wang",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/domain-router.mjs",
  "workers_dev": false,
  "vars": {
    "QUIZ_EMAIL_FROM": "Alex AI 服務 <noreply@aixwang.dev>"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": [
      "/",
      "/course",
      "/course/*",
      "/services",
      "/services/",
      "/services/speaking",
      "/services/speaking/*",
      "/services/development",
      "/services/development/*",
      "/quiz",
      "/quiz/*",
      "/api/button-click",
      "/api/tool-quiz-email",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "observability": {
    "enabled": true
  }
}
