{
  "name": "directus-extension-traffic-panels",
  "description": "流量統計儀表板的合併卡片（當日／近 30 天／累積）與合併表格（可拖拉欄寬、展開逐日明細）。",
  "icon": "extension",
  "version": "1.0.0",
  "private": true,
  "keywords": ["directus", "directus-extension", "directus-custom-bundle"],
  "type": "module",
  "files": ["dist"],
  "directus:extension": {
    "type": "bundle",
    "path": { "app": "dist/app.js", "api": "dist/api.js" },
    "entries": [
      { "type": "panel", "name": "traffic-summary-card", "source": "src/traffic-summary-card/index.ts" },
      { "type": "panel", "name": "traffic-content-table", "source": "src/traffic-content-table/index.ts" },
      { "type": "panel", "name": "traffic-source-table", "source": "src/traffic-source-table/index.ts" }
    ],
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "add": "directus-extension add"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.1.4",
    "typescript": "^5.6.0",
    "vue": "^3.5.0"
  }
}
