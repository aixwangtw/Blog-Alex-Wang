---
// 打勾清單項；首頁學習成果用 emerald 勾勾，其餘頁面用預設 amber
interface Props {
  as?: 'li' | 'div';
  iconClass?: string;
}

const { as: Tag = 'li', iconClass = 'text-accent' } = Astro.props;
---

<Tag class="flex gap-3 rounded-2xl border border-rule bg-surface/80 p-5 leading-7 text-ink-2 shadow-[0_6px_20px_rgba(22,22,26,0.04)]">
  <span class={iconClass}>✓</span>
  <slot />
</Tag>
