---
// 打勾清單項：改版前是 rounded-2xl ＋ shadow 的小卡，現在是髮絲線列。
//
// 呼叫端是 <ul class="space-y-4">（about 與 speaking 兩頁），所以線畫在每一列頭上、
// 最後一列另外補一條收尾線（last:border-b），整組才是閉合的。
// ✓ 加 aria-hidden：它是裝飾，螢幕閱讀器不需要在每一項前面唸一次「勾」。
interface Props {
  as?: 'li' | 'div';
  iconClass?: string;
}

const { as: Tag = 'li', iconClass = 'text-accent' } = Astro.props;
---

<Tag class="flex gap-3 border-t border-rule py-4 leading-8 text-ink-2 last:border-b">
  <span class={iconClass} aria-hidden="true">✓</span>
  <slot />
</Tag>
