---
// 需求分流區：首頁 hero 後與服務站首頁共用。
// 終端機視覺沿用首頁原本的 .cli 配色（深底、視窗列三色圓點、等寬字）。
// 輸入列只是打字動畫的顯示，不接任何後端，也不產生回答；點卡片時把該張卡的需求句打進輸入列，再前往卡片連結。
// 退路：沒有 JS 時卡片本身就是一般連結；prefers-reduced-motion 時不跑打字動畫、點了直接前往。
// 卡片例子只能用站上已有的內容（服務頁、教學頁、免費資源頁、演講頁的實際名稱）。
import { SERVICE_SITE, SITE } from '../consts';

interface Props {
  /** GA 事件的 location，區分首頁與服務站 */
  location: string;
  headingId?: string;
  /** 當首屏時用 h1（頁面唯一 h1） */
  headingLevel?: 'h1' | 'h2';
  /** 問句上方一行小字，放身分定位 */
  kicker?: string;
}

const { location, headingId = 'need-router-h', headingLevel = 'h2', kicker } = Astro.props;
const Heading = headingLevel;

const needs = [
  {
    key: 'development',
    need: '想把重複的工作自動化',
    examples: ['數學題庫系統：AI 辨識考卷、AI 詳解、AI 出題', '做過 CRM、預約系統、健檢系統、揪團平台'],
    action: '免費試用 Demo',
    href: `${SERVICE_SITE.url}/services/development/`,
  },
  {
    key: 'course',
    need: '想有人手把手帶著學 AI',
    examples: ['用 Claude Code 做有資料庫的系統、簡單網頁、AI 動畫影片', '雙北咖啡廳實體課或線上課'],
    action: '看教學方案',
    href: `${SERVICE_SITE.url}/course/`,
  },
  {
    key: 'resources',
    need: '想先領取免費資源',
    examples: ['Matt Pocock 開源 Skills（grill‑me）', 'feedback-desk PM溝通工具'],
    action: '立即領取',
    href: `${SITE.url}/resources/`,
  },
  {
    key: 'speaking',
    need: '想找 AI 講師',
    examples: ['主題：AI 一鍵拍片，跟 AI 對話就能完成影片', '曾受 MixerBox、TAIA 台灣人工智慧協會邀請演講'],
    action: '邀請演講',
    href: `${SERVICE_SITE.url}/services/speaking/`,
  },
];
---

<section class="need-router" aria-labelledby={headingId} data-need-router>
  <div class="need-term">
    <div class="need-term-bar" aria-hidden="true">
      <span class="need-term-dots"><i></i><i></i><i></i></span>
    </div>
    <div class="need-term-screen">
      {kicker && <p class="need-term-kicker">{kicker}</p>}
      <Heading id={headingId} class="need-term-q">你目前最想解決什麼問題？</Heading>
      <form class="need-term-line" role="search" data-need-form data-ga-submit={`${location}_search_submit`} data-ga-label="搜尋站內內容" data-ga-location={location} data-ga-action="search" data-ga-input={`#${headingId}-input`}>
        <span class="need-term-prompt" aria-hidden="true">&gt;</span>
        <label class="sr-only" for={`${headingId}-input`}>搜尋站內文章、服務與常見問題</label>
        <span class="need-term-field">
          <input
            id={`${headingId}-input`}
            class="need-term-input"
            type="search"
            name="q"
            autocomplete="off"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls={`${headingId}-results`}
            placeholder="輸入關鍵字搜尋，例如 Claude Code、題庫"
            data-need-input
          />
          <span class="need-term-overlay" aria-hidden="true"><span class="need-term-text" data-need-text data-idle={JSON.stringify(needs.map((item) => item.need))}></span><span class="need-term-caret"></span></span>
        </span>
      </form>
      <div class="need-term-results" id={`${headingId}-results`} role="listbox" aria-label="搜尋結果" data-need-results data-site={SITE.url} hidden></div>
      <p class="sr-only" aria-live="polite" data-need-status></p>
    </div>
  </div>

  <ul class="need-cards">
    {needs.map((item, index) => (
      <li>
        <a
          class="need-card"
          href={item.href}
          data-need={item.need}
          data-ga-button={`${location}_${item.key}`}
          data-ga-label={item.action}
          data-ga-location={location}
          data-ga-action="navigate"
        >
          <span class="need-card-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <strong class="need-card-title">{item.need}</strong>
          <span class="need-card-examples-label">例如</span>
          <ul class="need-card-examples">
            {item.examples.map((example) => <li>{example}</li>)}
          </ul>
          <span class="need-card-action">{item.action} <span aria-hidden="true">→</span></span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .need-router { width: 100%; }
  .need-term {
    border: 1px solid #3f3a37;
    border-radius: 14px;
    background: #181716;
    color: #f7f3ed;
    box-shadow: 0 26px 70px rgb(22 22 26 / 18%);
  }
  .need-term-bar {
    display: flex;
    height: 40px;
    align-items: center;
    padding: 0 18px;
    border-bottom: 1px solid #3f3a37;
    border-radius: 13px 13px 0 0;
    background: #24211f;
  }
  .need-term-dots { display: flex; gap: 6px; }
  .need-term-dots i { width: 9px; height: 9px; border-radius: 50%; }
  .need-term-dots i:first-child { background: #d96c70; }
  .need-term-dots i:nth-child(2) { background: #d6a34d; }
  .need-term-dots i:last-child { background: #69aa79; }
  .need-term-screen { padding: clamp(20px, 4vw, 40px); }
  .need-term-kicker {
    margin: 0 0 10px;
    color: #f0a6b1;
    font: 600 13px/1.5 var(--font-display);
    letter-spacing: 0.04em;
  }
  .need-term-q {
    margin: 0;
    color: #fffaf4;
    font: 650 clamp(22px, 3.6vw, 38px)/1.3 var(--font-display);
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }
  .need-term-line {
    display: flex;
    min-height: 52px;
    align-items: center;
    gap: 10px;
    margin: 20px 0 0;
    padding: 12px 16px;
    border: 1px solid #403b38;
    border-radius: 8px;
    background: #11100f;
    color: #fffaf4;
    font: 400 clamp(14px, 1.8vw, 17px)/1.5 var(--font-mono);
  }
  .need-term-prompt { flex: none; color: #f0a6b1; font-weight: 700; }
  .need-term-field { position: relative; display: flex; min-width: 0; flex: 1; align-items: center; }
  .need-term-input {
    width: 100%;
    min-width: 0;
    padding: 4px 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: #fffaf4;
    font: inherit;
  }
  .need-term-input::placeholder { color: #817a75; }
  .need-term-input::-webkit-search-cancel-button { filter: invert(1); }
  .need-term-line:focus-within { border-color: #9d4c5a; box-shadow: 0 0 0 2px rgb(240 166 177 / 35%); }
  /* 打字動畫蓋在輸入框上；聚焦或有輸入時隱藏，露出真正的輸入框 */
  .need-term-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    background: #11100f;
    pointer-events: none;
  }
  .need-term-overlay[hidden] { display: none; }
  .need-term-text { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: clip; }
  .need-term-results { display: grid; gap: 4px; margin-top: 8px; }
  .need-term-results[hidden] { display: none; }
  .need-term-results :global(a) {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #d9d3cc;
    text-decoration: none;
  }
  .need-term-results :global(a.is-active),
  .need-term-results :global(a:hover) { border-color: #8f4652; background: #2a2323; }
  .need-term-results :global(strong) { color: #fffaf4; font: 500 14px/1.5 var(--font-display); }
  .need-term-results :global(span) { overflow: hidden; color: #aaa39d; font: 400 12px/1.5 var(--font-display); text-overflow: ellipsis; white-space: nowrap; }
  .need-term-results :global(p) { margin: 0; padding: 8px 12px; color: #aaa39d; font-size: 13px; }
  .need-term-caret {
    flex: none;
    display: inline-block;
    width: 9px;
    height: 1.2em;
    margin-left: 1px;
    background: #f0a6b1;
    animation: need-caret 1s steps(1) infinite;
  }
  @keyframes need-caret { 50% { opacity: 0; } }

  .need-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .need-cards > li { display: flex; min-width: 0; }
  .need-card {
    display: flex;
    width: 100%;
    flex-direction: column;
    padding: 20px;
    border: 1px solid var(--color-rule-2);
    background: var(--color-paper);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }
  .need-card:hover { border-color: var(--color-accent); transform: translateY(-2px); }
  .need-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .need-card-index { color: var(--color-accent); font: 700 12px/1 var(--font-mono); }
  .need-card-title { display: block; margin-top: 12px; font: 650 18px/1.45 var(--font-display); }
  .need-card-examples-label { margin-top: 14px; color: var(--color-ink-3); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; }
  .need-card-examples { margin: 6px 0 0; padding: 0 0 0 1.1em; color: var(--color-ink-2); font-size: 14px; line-height: 1.7; list-style: disc; }
  .need-card-examples li + li { margin-top: 4px; }
  .need-card-action {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: auto;
    padding: 0 16px;
    border: 1px solid var(--color-accent);
    background: var(--color-accent);
    color: #fff;
    font-weight: 700;
  }
  .need-card-examples { margin-bottom: 18px; }
  .need-card.is-chosen { border-color: var(--color-accent); box-shadow: 0 0 0 2px var(--color-accent); }

  @media (max-width: 1023px) {
    .need-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599px) {
    .need-cards { grid-template-columns: 1fr; gap: 12px; }
    .need-card { padding: 18px 16px; }
    .need-term-bar { height: 30px; }
    .need-term-screen { padding: 16px; }
    .need-term-kicker { margin-bottom: 6px; font-size: 12px; }
    .need-term-line { min-height: 44px; margin-top: 12px; padding: 8px 12px; }
    .need-cards { margin-top: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .need-term-caret { animation: none; }
    .need-card { transition: none; }
    .need-card:hover { transform: none; }
  }
</style>

<script is:inline>
  /* 搜尋邏輯沿用首頁舊終端機搜尋（/search-index.json、比對標題＋說明＋關鍵字、最多 5 筆、方向鍵選、Enter 開啟）。 */
  (function () {
    var routers = document.querySelectorAll('[data-need-router]');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var searchIndexPromise;
    function loadSearchIndex() {
      if (!searchIndexPromise) {
        searchIndexPromise = fetch('/search-index.json')
          .then(function (response) { return response.json(); })
          .catch(function () { return []; });
      }
      return searchIndexPromise;
    }

    routers.forEach(function (router) {
      var text = router.querySelector('[data-need-text]');
      var overlay = text && text.parentNode;
      var input = router.querySelector('[data-need-input]');
      var form = router.querySelector('[data-need-form]');
      var results = router.querySelector('[data-need-results]');
      var status = router.querySelector('[data-need-status]');
      if (!text || !input || !form || !results) return;
      var idle = [];
      try { idle = JSON.parse(text.getAttribute('data-idle') || '[]'); } catch (e) { idle = []; }
      var timer = null;
      var navigating = false;
      var cycling = false;
      var active = -1;
      var queryId = 0;

      function stop() { if (timer) { clearTimeout(timer); timer = null; } cycling = false; }
      function showOverlay(on) { overlay.hidden = !on; }

      function typeTo(target, speed, done) {
        var chars = Array.from(target);
        var i = 0;
        text.textContent = '';
        (function step() {
          if (i <= chars.length) {
            text.textContent = chars.slice(0, i).join('');
            i += 1;
            timer = setTimeout(step, speed);
          } else if (done) {
            done();
          }
        })();
      }
      function erase(done) {
        var chars = Array.from(text.textContent);
        (function step() {
          if (chars.length) {
            chars.pop();
            text.textContent = chars.join('');
            timer = setTimeout(step, 28);
          } else {
            done();
          }
        })();
      }
      /* 閒置時輪流打出四項需求；聚焦輸入框或選了卡片就停止。 */
      function cycle(index) {
        if (!idle.length || reduce) return;
        cycling = true;
        showOverlay(true);
        typeTo(idle[index % idle.length], 70, function () {
          timer = setTimeout(function () {
            erase(function () { cycle(index + 1); });
          }, 1600);
        });
      }
      function resumeIdle() {
        if (reduce || navigating || cycling || input.value || document.activeElement === input) return;
        cycle(0);
      }

      /* 沒有動畫時（減少動態）只顯示 placeholder。 */
      showOverlay(false);

      function setExpanded(open) {
        results.hidden = !open;
        input.setAttribute('aria-expanded', String(open));
        if (!open) { input.removeAttribute('aria-activedescendant'); active = -1; }
      }
      function setActive(index) {
        var links = results.querySelectorAll('a');
        if (!links.length) return;
        active = Math.max(0, Math.min(index, links.length - 1));
        links.forEach(function (link, linkIndex) {
          var on = linkIndex === active;
          link.classList.toggle('is-active', on);
          link.setAttribute('aria-selected', String(on));
        });
        input.setAttribute('aria-activedescendant', links[active].id);
        links[active].scrollIntoView({ block: 'nearest' });
      }
      function render(items) {
        results.replaceChildren();
        if (!items.length) {
          var empty = document.createElement('p');
          empty.textContent = '找不到符合的內容，請換個關鍵字。';
          results.appendChild(empty);
          if (status) status.textContent = '找不到符合的內容';
          active = -1;
        } else {
          items.slice(0, 5).forEach(function (item, index) {
            var link = document.createElement('a');
            var title = document.createElement('strong');
            var description = document.createElement('span');
            link.id = results.id + '-' + index;
            link.setAttribute('role', 'option');
            /* 索引裡的主站相對路徑補上主站網域，服務站上才連得到 */
            link.href = new URL(item.u, results.getAttribute('data-site') || location.origin).href;
            link.dataset.gaButton = 'need_router_search_result';
            link.dataset.gaLabel = item.t;
            link.dataset.gaLocation = router.querySelector('[data-ga-location]').getAttribute('data-ga-location');
            link.dataset.gaAction = 'open_result';
            title.textContent = item.t;
            description.textContent = item.d || '';
            link.append(title, description);
            results.appendChild(link);
          });
          if (status) status.textContent = '找到 ' + Math.min(items.length, 5) + ' 筆結果，用上下鍵選擇';
          setActive(0);
        }
        setExpanded(true);
      }
      function search(raw) {
        var query = raw.trim().toLowerCase();
        var id = ++queryId;
        if (!query) {
          results.replaceChildren();
          setExpanded(false);
          if (status) status.textContent = '';
          return;
        }
        loadSearchIndex().then(function (items) {
          if (id !== queryId) return;
          render(items.filter(function (item) {
            return [item.t, item.d, item.g, item.g2].join(' ').toLowerCase().indexOf(query) !== -1;
          }));
        });
      }

      input.addEventListener('focus', function () {
        stop();
        showOverlay(false);
        loadSearchIndex();
      });
      input.addEventListener('blur', function () {
        setTimeout(function () {
          if (!router.contains(document.activeElement)) {
            setExpanded(false);
            resumeIdle();
          }
        }, 150);
      });
      input.addEventListener('input', function () { search(input.value); });
      input.addEventListener('keydown', function (event) {
        var links = results.querySelectorAll('a');
        if (event.key === 'ArrowDown' && links.length) {
          event.preventDefault();
          if (results.hidden) setExpanded(true);
          setActive(active + 1);
        } else if (event.key === 'ArrowUp' && links.length) {
          event.preventDefault();
          setActive(active - 1);
        } else if (event.key === 'Enter') {
          event.preventDefault();
          if (links.length && active >= 0) links[active].click();
          else search(input.value);
        } else if (event.key === 'Escape') {
          input.value = '';
          search('');
        }
      });
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        search(input.value);
      });

      if (!reduce) {
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            if (entries[0].isIntersecting) { io.disconnect(); resumeIdle(); }
          });
          io.observe(router);
        } else {
          resumeIdle();
        }
      }

      router.querySelectorAll('[data-need]').forEach(function (card) {
        card.addEventListener('click', function (event) {
          if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          if (reduce) return;
          event.preventDefault();
          if (navigating) return;
          navigating = true;
          stop();
          input.value = '';
          search('');
          showOverlay(true);
          card.classList.add('is-chosen');
          var href = card.href;
          /* 手機上卡片在終端機下方，先把輸入列捲回畫面，讓人看得到打出的需求。 */
          var box = form.getBoundingClientRect();
          if (box.top < 0 || box.bottom > window.innerHeight) {
            form.scrollIntoView({ block: 'center', behavior: 'smooth' });
          }
          typeTo(card.getAttribute('data-need'), 45, function () {
            timer = setTimeout(function () { window.location.href = href; }, 350);
          });
        });
      });

      window.addEventListener('pageshow', function (event) {
        if (!event.persisted) return;
        navigating = false;
        stop();
        router.querySelectorAll('.is-chosen').forEach(function (card) { card.classList.remove('is-chosen'); });
        resumeIdle();
      });
    });
  })();
</script>
