---
// 文章分享列：讀者用「安裝成 App／捷徑以視窗開啟」時沒有網址列，靠這排按鈕分享或複製連結。
// 手機支援 Web Share API 時顯示「分享」（叫出系統分享選單），不支援就隱藏；
// 「複製連結」與 LINE、Facebook、Threads 分享連結一律顯示。每個按鈕都帶 data-ga-* 追蹤。
interface Props {
  url: string;
  title: string;
  /** 追蹤位置：top＝標題下方、bottom＝文末 */
  position: 'top' | 'bottom';
}

const { url, title, position } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const location = `article_share_${position}`;
// 品牌圖示路徑：LINE、Facebook、Threads 官方標誌（單色），與站內其他 LINE／Threads 圖示同一組
const shareLinks = [
  { key: 'line', label: 'LINE', href: `https://social-plugins.line.me/lineit/share?url=${encodedUrl}`, icon: 'M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314' },
  { key: 'facebook', label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`, icon: 'M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073Z' },
  { key: 'threads', label: 'Threads', href: `https://www.threads.net/intent/post?text=${encodeURIComponent(`${title} ${url}`)}`, icon: 'M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221Z' },
];
---

<div class="share-bar" data-share-bar data-share-url={url} data-share-title={title} role="group" aria-label="分享這篇文章">
  <button
    type="button"
    class="share-bar-btn"
    data-share-native
    hidden
    aria-label="分享到…"
    title="分享到…"
    data-ga-button={`article_share_native_${position}`}
    data-ga-label="系統分享"
    data-ga-location={location}
    data-ga-action="share"
  >
    <!-- 紙飛機：同 Threads 的分享圖示 -->
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21.5 3 10.2 14.3" /><path d="M21.5 3 14.6 21l-4.4-6.7L3.5 9.9 21.5 3Z" /></svg>
  </button>
  <button
    type="button"
    class="share-bar-btn"
    data-share-copy
    aria-label="複製連結"
    title="複製連結"
    data-ga-button={`article_share_copy_${position}`}
    data-ga-label="複製連結"
    data-ga-location={location}
    data-ga-action="copy"
  >
    <svg data-icon-link viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 13.5a4.2 4.2 0 0 0 6.3.5l3-3a4.2 4.2 0 0 0-6-6l-1.7 1.7" /><path d="M14 10.5a4.2 4.2 0 0 0-6.3-.5l-3 3a4.2 4.2 0 0 0 6 6l1.7-1.7" /></svg>
    <svg data-icon-check hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
  </button>
  {shareLinks.map((item) => (
    <a
      class="share-bar-btn"
      href={item.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`分享到 ${item.label}（開新分頁）`}
      title={`分享到 ${item.label}`}
      data-ga-button={`article_share_${item.key}_${position}`}
      data-ga-label={`分享到 ${item.label}`}
      data-ga-location={location}
      data-ga-action="share"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d={item.icon} /></svg>
    </a>
  ))}
  <span class="share-bar-status" role="status" aria-live="polite" data-share-status></span>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-share-bar]:not([data-share-ready])').forEach(function (bar) {
      bar.setAttribute('data-share-ready', '');
      var url = bar.getAttribute('data-share-url');
      var title = bar.getAttribute('data-share-title');
      var nativeBtn = bar.querySelector('[data-share-native]');
      var copyBtn = bar.querySelector('[data-share-copy]');

      if (nativeBtn && navigator.share) {
        nativeBtn.hidden = false;
        nativeBtn.addEventListener('click', function () {
          navigator.share({ title: title, url: url }).catch(function () {});
        });
      }

      function copyText(text) {
        if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
          document.execCommand('copy');
          return Promise.resolve();
        } catch (e) {
          return Promise.reject(e);
        } finally {
          document.body.removeChild(textarea);
        }
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          var linkIcon = copyBtn.querySelector('[data-icon-link]');
          var checkIcon = copyBtn.querySelector('[data-icon-check]');
          var status = bar.querySelector('[data-share-status]');
          function feedback(ok) {
            if (ok) { linkIcon.setAttribute('hidden', ''); checkIcon.removeAttribute('hidden'); copyBtn.classList.add('is-copied'); }
            if (status) status.textContent = ok ? '已複製連結' : '複製失敗';
            setTimeout(function () {
              linkIcon.removeAttribute('hidden'); checkIcon.setAttribute('hidden', ''); copyBtn.classList.remove('is-copied');
              if (status) status.textContent = '';
            }, 1600);
          }
          copyText(url).then(function () { feedback(true); }, function () { feedback(false); });
        });
      }
    });
  })();
</script>

<style>
  .share-bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .share-bar-btn {
    display: inline-grid;
    width: 38px;
    height: 38px;
    place-items: center;
    padding: 0;
    border: 1px solid var(--color-rule-2);
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink-2);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }
  .share-bar-btn svg {
    width: 18px;
    height: 18px;
  }
  .share-bar-btn[hidden],
  .share-bar-btn svg[hidden] {
    display: none;
  }
  .share-bar-btn.is-copied {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  @media (hover: hover) and (pointer: fine) {
    .share-bar-btn:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }
  .share-bar-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .share-bar-status {
    font-size: 12px;
    color: var(--color-accent);
  }
</style>
