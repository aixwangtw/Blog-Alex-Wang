---
import { LINKS } from '../consts';

interface Props {
  paired?: boolean;
}

const { paired = false } = Astro.props;
---

<a
  class:list={['floating-line', paired && 'floating-line--paired']}
  href={LINKS.line}
  target="_blank"
  rel="noreferrer"
  aria-label="加 LINE 免費諮詢（開新分頁）"
  data-ga-button="floating_line"
  data-ga-label="LINE 免費諮詢"
  data-ga-location="floating_actions"
  data-ga-action="contact"
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
  </svg>
  <span>LINE</span>
</a>

<style is:global>
  .floating-line {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 80;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid #06c755;
    border-radius: 50%;
    background: #06c755;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 8px 24px rgb(22 22 26 / 18%);
    transition:
      background-color 0.18s var(--ease),
      opacity 0.18s var(--ease),
      transform 0.18s var(--ease),
      visibility 0.18s var(--ease);
  }
  .floating-line--paired {
    right: calc(max(18px, env(safe-area-inset-right)) + 64px);
  }
  .floating-line svg {
    width: 23px;
    height: 23px;
  }
  .floating-line span {
    position: absolute;
    top: calc(100% + 5px);
    color: #087a38;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  body.home-cli-visible:not(.search-chat-open) .floating-line {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
  }
  @media (max-width: 767px) {
    .floating-line {
      right: max(12px, env(safe-area-inset-right));
      bottom: max(12px, env(safe-area-inset-bottom));
      width: 46px;
      height: 46px;
    }
    .floating-line--paired {
      right: calc(max(12px, env(safe-area-inset-right)) + 56px);
    }
    .floating-line svg {
      width: 21px;
      height: 21px;
    }
    .floating-line span {
      display: none;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .floating-line:hover {
      border-color: #05b34c;
      background: #05b34c;
      transform: scale(1.06);
    }
  }
  .floating-line:focus-visible {
    outline: 3px solid #087a38;
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-line {
      transition: none !important;
    }
  }
</style>
