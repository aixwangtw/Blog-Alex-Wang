---
// 共用頁首：主站（Base.astro）與服務站（ServiceBase.astro）共用同一份導覽、文章與服務彈窗。
// 兩站差異只用 props 處理：
// - site：'main' 主站；'service' 服務站（站內連結改成主站完整網址，服務連結不另開新分頁）
// - showSearch：搜尋框只在主站顯示（它要搭配 Base.astro 的客服面板與搜尋腳本）
// - homeHref：logo 連結（主站 /；服務站為服務首頁）
// 樣式在 src/styles/site-chrome.css（含頁尾與客服面板，Base 也會引入）；導覽腳本在本檔最下方。
import { getCollection } from 'astro:content';
import { blogBannerPath } from '../lib/blog-banner';
import { FEEDBACK_DESK_RESOURCE, GRILL_ME_RESOURCE } from '../data/resources';
import { DEVELOPMENT_CAPABILITIES, ONE_ON_ONE_NAV_ITEMS, SPEAKING_KINDS } from '../data/services';
import { ARTICLE_EXCLUDED_TAGS, COURSE_SERVICE_URL, LINKS, SERVICE_SITE, SITE, SPEAKING_SERVICE_URL, articleGroupName } from '../consts';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import LineIcon from './LineIcon.astro';
import questionBankShot from '../assets/need-router/question-bank-import-review.jpg';
import teachingPhoto from '../assets/teaching-one-on-one.jpg';
import taichungTalk from '../assets/taichung-talk.jpg';
import { DEVELOPMENT_SERVICE } from '../consts';
import '../styles/site-chrome.css';

interface Props {
  site?: 'main' | 'service';
  showSearch?: boolean;
  homeHref?: string;
}

const { site = 'main', showSearch = false, homeHref = '/' } = Astro.props;
const isMainSite = site === 'main';
// 服務站的站內連結要回主站網域；主站維持相對連結
const siteBase = isMainSite ? '' : SITE.url;
// GA 事件名稱：主站用 header_*，服務站沿用原本的 service_header_*
const gaButton = (name: string) => (isMainSite ? name : name.replace(/^header_/, 'service_header_'));
const gaLocation = (name: string) =>
  isMainSite ? name : name === 'header' || name === 'header_nav' ? 'service_header' : name.replace(/^header_/, 'service_header_');
const withBase = (href: string) => (href.startsWith('/') ? `${siteBase}${href}` : href);

// 頁首導覽不放「首頁」：字標本身就是回首頁的連結，重複一次是浪費連結預算。
// 頁尾導覽（FOOTER_NAV）依同一套分類分組，「首頁」放在「關於」組。
const HEADER_NAV = [
  { href: '/about/', label: '關於' },
];
const CLAIM_INSTALL_HINT = '貼給你的 AI Agent，說「幫我安裝」';
// 服務只剩系統開發一項，不需要下拉，頁首直接放一顆強調色連結
const SERVICE_NAV_LINK = {
  key: 'services',
  label: '服務',
  href: DEVELOPMENT_SERVICE.url,
};
// 文章下拉：列出已發布（非 unlisted）文章（排除清單除外），依第一個標籤分組（部落格列表卡片也用第一個標籤當分類字）。
// 分組順序依「該組最新文章」由新到舊，組內也是新到舊；沒有標籤的文章歸「其他」。
const navPosts = (await getCollection('blog', ({ data }) => !data.unlisted)).sort(
  (a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
    (b.data.cmsId ?? 0) - (a.data.cmsId ?? 0),
);
// 彈窗分組設定：只影響彈窗，CMS 標籤與文章本身不動。
// 分組對照與排除清單用 src/consts.ts 的共用設定（ARTICLE_TAG_GROUP_MAP、ARTICLE_EXCLUDED_TAGS、articleGroupName）。
// 每組一個 icon（inline SVG，線條風格）；沒列在這裡的分組用文件 icon
const NAV_GROUP_ICON: Record<string, string> = { 'AI 教學': 'book', 客製開發: 'code', 開源工具: 'package' };
const NAV_ICON_PATHS: Record<string, string> = {
  book: '<path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z"/>',
  code: '<path d="m8 8-5 4 5 4"/><path d="m16 8 5 4-5 4"/><path d="m14 5-4 14"/>',
  package: '<path d="M12 3 3.5 7.5v9L12 21l8.5-4.5v-9z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>',
  doc: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 13h6M9 17h6"/>',
};
// 不放進彈窗的文章（用 slug；文章本身與其他清單不受影響）
const NAV_EXCLUDED_SLUGS: string[] = ['codex-cli-wsl2-windows'];
// 額外補進某個分組的資源項目：只寫「放進哪一組、引用哪個資源」，標題與網址一律取自 src/data/resources.ts（和領取導覽卡同一份）。
// 之後要把其他資源放進彈窗，也在這裡加一筆。
const NAV_EXTRA_ITEMS: { group: string; resource: { title: string; href: string; external?: boolean } }[] = [
  { group: '開源工具', resource: GRILL_ME_RESOURCE.nav },
];
const navArticleGroups: { name: string; items: { href: string; title: string; external?: boolean }[] }[] = [];
for (const post of navPosts) {
  if (ARTICLE_EXCLUDED_TAGS.includes(post.data.tags[0] ?? '') || NAV_EXCLUDED_SLUGS.includes(post.id)) continue;
  const name = articleGroupName(post.data.tags[0]);
  let group = navArticleGroups.find((item) => item.name === name);
  if (!group) {
    group = { name, items: [] };
    navArticleGroups.push(group);
  }
  group.items.push({ href: `/blog/${post.id}/`, title: post.data.title });
}
for (const extra of NAV_EXTRA_ITEMS) {
  navArticleGroups
    .find((group) => group.name === extra.group)
    ?.items.push({ href: extra.resource.href, title: extra.resource.title, external: extra.resource.external });
}
// 服務下拉（版面參考 deanlife.blog）：三張服務卡並列（系統開發、一對一教學、演講），右欄是諮詢。
// 每張卡片只放大標題與「- 」項目清單，項目文字都取自既有頁面資料；簡單網頁、動畫影片是教學頁的方案，列在一對一教學底下。
// 卡片圖片沿用首屏分流卡已經在用的實拍圖。
const navServiceCards: { href: string; title: string; items: string[]; image: ImageMetadata; imageAlt: string }[] = [
  {
    href: DEVELOPMENT_SERVICE.url,
    title: '系統開發',
    // 服務頁「可以做什麼」的項目（DEVELOPMENT_CAPABILITIES）
    items: DEVELOPMENT_CAPABILITIES.map((item) => item.title),
    image: questionBankShot,
    imageAlt: '數學題庫系統的考卷匯入審核頁',
  },
  {
    href: COURSE_SERVICE_URL,
    title: '一對一教學',
    // 「手把手完成自動化的設定，跑通後，安裝、開發、除錯、部署等都能自動化。」依原句拆開，再加教學頁的兩個方案
    items: ONE_ON_ONE_NAV_ITEMS,
    image: teachingPhoto,
    imageAlt: '一對一教學上課現場',
  },
  {
    href: SPEAKING_SERVICE_URL,
    title: '演講',
    // 演講頁開頭的「公開演講／企業內訓／工作坊」
    items: SPEAKING_KINDS,
    image: taichungTalk,
    imageAlt: 'Alex 在台中演講的現場',
  },
];
// 服務站導覽比照 deanlife.blog 精簡：關於／文章／開源工具／服務＋一顆「聊聊需求」CTA；開源工具連回主站 /resources/
const DROPDOWN_NAV_ALL = [
  {
    key: 'articles',
    label: '文章',
    href: '/blog/',
    subtitle: `全部 ${navPosts.length} 篇，依分類列出`,
    groups: navArticleGroups,
    previews: [
      {
        href: '/blog/math-teacher-question-bank/',
        eyebrow: '系統開發案例',
        title: '數學題庫系統',
        description: '補習班老師用的題庫系統：AI 辨識考卷、AI 詳解；AI 出題可在 Demo 體驗。',
        image: blogBannerPath('math-teacher-question-bank'),
        cta: '閱讀案例介紹',
        wide: true,
      },
    ],
  },
  {
    key: 'resources',
    label: '開源工具',
    href: '/resources/',
    subtitle: '開源的問題回報系統與 Skills',
    previews: [
      { ...GRILL_ME_RESOURCE.nav, navIcon: GRILL_ME_RESOURCE.nav.image, repo: GRILL_ME_RESOURCE.repoUrl },
      { ...FEEDBACK_DESK_RESOURCE.nav, navIcon: FEEDBACK_DESK_RESOURCE.nav.image, repo: FEEDBACK_DESK_RESOURCE.repoUrl },
    ],
  },
  {
    key: 'services',
    label: SERVICE_NAV_LINK.label,
    href: SERVICE_NAV_LINK.href,
    external: isMainSite,
    accent: isMainSite,
    subtitle: '系統開發、一對一教學、演講',
    cards: navServiceCards,
  },
];
const DROPDOWN_NAV = DROPDOWN_NAV_ALL;
---

<header class="site-header" id="site-header" data-open="false">
  <div class="hd-cap">
    <a
      class="hd-mark"
      href={homeHref}
      aria-label={`回首頁 — ${SITE.title}`}
      data-ga-button={gaButton("header_logo")}
      data-ga-label="Aix Logo"
      data-ga-location={gaLocation("header")}
      data-ga-action="home"
    >
      <img class="hd-logo" src="/aixwang-icon.png" width="24" height="24" alt="" aria-hidden="true" />
      <span class="hd-mark-t">Aix</span>
    </a>

    {showSearch && (
    <form
      class="nav-search-form"
      id="search-chat-form"
      role="search"
      data-ga-submit="search_chat_submit"
      data-ga-label="搜尋站內內容"
      data-ga-location="search_chat"
      data-ga-action="search"
      data-ga-input="#site-search"
    >
      <label class="sr-only" for="site-search">搜尋文章、常見問題</label>
      <button type="submit" class="nav-search-submit" aria-label="送出搜尋" title="送出搜尋">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
      </button>
      <input
        id="site-search"
        type="search"
        autocomplete="off"
        enterkeyhint="search"
        placeholder="搜尋文章、常見問題…"
        aria-controls="search-chat-panel"
        aria-haspopup="dialog"
        data-ga-button="search_chat_toggle"
        data-ga-label="搜尋與客服"
        data-ga-location={gaLocation("header_nav")}
        data-ga-action="open_search"
      />
    </form>
    )}

    <nav class="mainnav" id="mainnav" aria-label="主要導覽">
      <ul>
        {HEADER_NAV.map((item) => (
          <li>
            <a
              href={withBase(item.href)}
              data-ga-button={gaButton("header_about")}
              data-ga-label={item.label}
              data-ga-location={gaLocation("header_nav")}
              data-ga-action="navigate"
            >{item.label}</a>
          </li>
        ))}
        {DROPDOWN_NAV.map((menu) => (
          <li class:list={['service-nav-item', { 'service-nav-item--accent': menu.accent }]}>
            <div class:list={['service-nav-shell', { 'service-nav-shell--split': menu.href }]}>
              {menu.href && (
                <a
                  class="service-nav-direct"
                  href={withBase(menu.href)}
                  target={'external' in menu && menu.external ? '_blank' : undefined}
                  rel={'external' in menu && menu.external ? 'noreferrer' : undefined}
                  aria-label={'external' in menu && menu.external ? `${menu.label}（另開新頁籤）` : undefined}
                  data-ga-button={gaButton(`header_${menu.key}`)}
                  data-ga-label={menu.label}
                  data-ga-location={gaLocation("header_nav")}
                  data-ga-action="navigate"
                >{menu.label}</a>
              )}
              <details class="service-nav nav-dropdown" id={`nav-dropdown-${menu.key}`}>
                <summary
                  aria-label={menu.href ? `展開${menu.label}分類` : undefined}
                  data-ga-button={gaButton(`header_${menu.key}_dropdown`)}
                  data-ga-label={`${menu.label}下拉`}
                  data-ga-location={gaLocation("header_nav")}
                  data-ga-action="toggle_dropdown"
                >
                  <span class:list={{ 'sr-only': menu.href }}>{menu.label}</span>
                  <span class="service-nav-mark" aria-hidden="true">▾</span>
                </summary>
                <div class="service-menu service-menu--featured">
                  <div class="service-menu-head">
                    <span>{menu.label}</span>
                    <small>{menu.subtitle}</small>
                  </div>
                  {'groups' in menu && (
                    <div class="dm-cols">
                      {(menu.groups ?? []).map((group) => (
                        <section class="dm-col">
                          <h3 class="dm-head">{group.name}</h3>
                          <ul class="dm-rows">
                            {group.items.map((post) => (
                              <li>
                                <a
                                  class="dm-row"
                                  title={post.title}
                                  href={post.external ? post.href : withBase(post.href)}
                                  target={post.external ? '_blank' : undefined}
                                  rel={post.external ? 'noreferrer' : undefined}
                                  data-ga-button={gaButton(`header_${menu.key}_item_${post.href.replace(/[^a-z0-9]+/gi, '_')}`)}
                                  data-ga-label={post.title}
                                  data-ga-location={gaLocation(`header_${menu.key}_dropdown`)}
                                  data-ga-action="open_content"
                                >
                                  <span class="dm-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={NAV_ICON_PATHS[NAV_GROUP_ICON[group.name] ?? 'doc']} /></span>
                                  <span class="dm-row-text">{post.title}</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </section>
                      ))}
                    </div>
                  )}
                  {'cards' in menu && menu.cards && (
                    <div class="dm-cols dm-cols--services">
                      <section class="dm-col">
                        <h3 class="dm-head">服務項目</h3>
                        <ul class="dm-cards">
                          {menu.cards.map((card) => (
                            <li>
                              <a
                                class="dm-card"
                                href={card.href}
                                target={'external' in menu && menu.external ? '_blank' : undefined}
                                rel={'external' in menu && menu.external ? 'noreferrer' : undefined}
                                data-ga-button={gaButton(`header_services_item_${card.href.replace(/[^a-z0-9]+/gi, '_')}`)}
                                data-ga-label={card.title}
                                data-ga-location={gaLocation('header_services_dropdown')}
                                data-ga-action="open_content"
                              >
                                <Image class="dm-card-img" src={card.image} alt={card.imageAlt} width={192} height={192} loading="lazy" />
                                <span class="dm-card-copy">
                                  <strong>{card.title}</strong>
                                  {card.items.map((item) => <span>{item}</span>)}
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </section>
                    </div>
                  )}
                  {!('groups' in menu) && !('cards' in menu) && (
                  <div class="service-menu-grid">
                    {menu.previews.map((item, itemIndex) => (
                      <div
                        class:list={['service-preview', {
                          'service-preview--icon': 'navIcon' in item,
                          'service-preview--wide': 'wide' in item,
                        }]}
                      >
                        <a
                          class="service-preview-main"
                          href={withBase(item.href)}
                          target={'external' in item && item.external ? '_blank' : undefined}
                          rel={'external' in item && item.external ? 'noreferrer' : undefined}
                          data-ga-button={gaButton(`header_${menu.key}_card_${itemIndex + 1}`)}
                          data-ga-label={item.title}
                          data-ga-location={gaLocation(`header_${menu.key}_dropdown`)}
                          data-ga-action="open_content"
                        >
                          <img src={item.image} alt="" width="1200" height="630" loading="lazy" />
                          <span class="service-preview-copy">
                            <small>{item.eyebrow}</small>
                            <strong>{item.title}</strong>
                            <span>{item.description}</span>
                            {item.cta !== '領取' && (
                              <b class="service-preview-cta">{item.cta}<span aria-hidden="true">→</span></b>
                            )}
                          </span>
                        </a>
                        {item.cta === '領取' && 'repo' in item && (
                          <span class="service-preview-actions">
                            <button
                              type="button"
                              class="service-preview-cta"
                              data-copy-repo={item.repo}
                              data-copy-hint={CLAIM_INSTALL_HINT}
                              data-ga-button={gaButton(`header_resources_claim_${itemIndex + 1}`)}
                              data-ga-label={item.title}
                              data-ga-location={gaLocation("header_resources_dropdown")}
                              data-ga-action="copy_repo"
                              aria-label={`複製 ${item.title} Repo 連結`}
                            ><span class="service-preview-cta-label">領取</span><span aria-hidden="true">→</span></button>
                            <em>{CLAIM_INSTALL_HINT}</em>
                          </span>
                        )}
                      </div>
                    ))}
                  </div>
                  )}
                </div>
              </details>
            </div>
          </li>
        ))}
        {!isMainSite && (
          <li class="hd-book-item">
            <a class="service-book" href={LINKS.line} target="_blank" rel="noreferrer" data-ga-button="service_header_book" data-ga-label="聊聊需求" data-ga-location="service_header" data-ga-action="external"><LineIcon class="service-book-icon" />聊聊需求</a>
          </li>
        )}
      </ul>
    </nav>

    <div class="hd-tools">
      <button
        class="hd-cue"
        id="nav-cue"
        type="button"
        aria-expanded="false"
        aria-controls="mainnav"
        aria-label="開啟選單"
        data-ga-button={isMainSite ? 'header_mobile_menu' : 'service_mobile_menu'}
        data-ga-label={isMainSite ? '手機導覽選單' : '服務站手機選單'}
        data-ga-location={gaLocation('header')}
        data-ga-action="toggle_menu"
      >
        <span class="hd-cue-b" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<style is:global>
  /* 文章與服務下拉的版面參考 deanlife.blog：白底圓角面板＋柔和陰影、欄與欄之間 1px 分隔線、
     欄標題 16px/600；文章列是 42px 縮圖＋標題，服務是 1px 邊框卡片（96px 圖＋18px 標題＋條列說明）。 */
  .nav-js .mainnav .dm-cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; margin: 0; padding: 0; }
  .nav-js .mainnav .dm-row, .nav-js .mainnav .dm-card { justify-content: flex-start; white-space: normal; }
  .dm-col { min-width: 0; padding: 10px 2px; }
  .dm-head { margin: 0 0 8px; color: var(--color-accent); font-size: 13px; font-weight: 700; line-height: 1.3; }
  .nav-js .mainnav .dm-rows, .nav-js .mainnav .dm-cards { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; margin: 0; padding: 0; list-style: none; }
  .nav-js .mainnav .dm-rows > li, .nav-js .mainnav .dm-cards > li { display: block; padding: 0; border: 0; background: transparent; }
  .mainnav .dm-row { display: flex; align-items: center; gap: 12px; padding: 7px 2px; color: var(--color-ink); font-size: 15px; line-height: 1.45; white-space: normal; overflow-wrap: anywhere; }
  .dm-icon { display: none; flex: none; width: 42px; height: 42px; align-items: center; justify-content: center; border-radius: 6px; background: var(--color-paper-2); color: var(--color-accent); }
  .mainnav .dm-card { display: block; padding: 8px 2px; color: var(--color-ink); white-space: normal; }
  .dm-card-img { display: none; flex: none; width: 96px; height: 96px; border-radius: 4px; object-fit: cover; }
  .dm-card-copy { display: grid; min-width: 0; gap: 2px; }
  .dm-card-copy { align-content: start; }
  .dm-card-copy strong { margin-bottom: 2px; font-size: 16px; font-weight: 600; line-height: 1.2; }
  .dm-card-copy span { color: var(--color-ink-3); font-size: 12px; line-height: 1.55; overflow-wrap: anywhere; }
  .dm-card-copy span::before { content: '- '; }
  @media (hover: hover) and (pointer: fine) {
    .mainnav .dm-row:hover { color: var(--color-accent); }
    .mainnav .dm-card:hover { border-color: var(--color-accent-line-2); background: var(--color-accent-tint); }

  }
  @media (min-width: 1024px) {
    .service-menu:has(.dm-cols) {
      width: min(1000px, calc(100vw - 32px));
      max-height: calc(100vh - 110px);
      padding: 24px;
      overflow-y: auto;
      overscroll-behavior: contain;
      border: 0;
      border-radius: 8px;
      background: var(--color-paper);
      box-shadow: 0 0 16px rgb(192 199 205 / 42%);
    }
    .service-menu:has(.dm-cols) .service-menu-head { display: none; }
    .nav-js .mainnav .dm-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px 0; }
    .nav-js .mainnav .dm-cols--services { grid-template-columns: minmax(0, 1fr); }
    .nav-js .mainnav .dm-cols--services .dm-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .dm-col { padding: 12px 12px 12px 11px; border-left: 1px solid transparent; }
    .dm-col:not(:nth-child(3n + 1)) { border-left: 1px solid var(--color-rule); }
    .dm-cols--services .dm-col:not(:nth-child(3n + 1)) { border-left-color: transparent; }
    .dm-head { margin-bottom: 16px; color: var(--color-ink); font-size: 16px; font-weight: 600; line-height: 1.2; }
    .nav-js .mainnav .dm-rows { gap: 8px; }
    .mainnav .dm-row { padding: 0; font-size: 16px; }
    .dm-icon { display: flex; }
    /* 列高固定、標題最多兩行（超過截斷，完整標題在 title 提示）：各欄同一序位的列才會落在同一條水平線，icon 也固定在每列左側 */
    .dm-head { height: 20px; margin-bottom: 12px; line-height: 20px; }
    .mainnav .dm-row { height: 52px; }
    .dm-row-text { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; }
    .nav-js .mainnav .dm-cards { gap: 12px; }
    .mainnav .dm-card { display: flex; align-items: flex-start; gap: 16px; padding: 9px; border: 1px solid var(--color-rule-2); border-radius: 4px; }
    /* 三張服務卡同列等寬等高：li 撐滿格子、卡片填滿 li（說明長短不同也不會高低不齊） */
    .nav-js .mainnav .dm-cards > li { display: flex; }
    .nav-js .mainnav .dm-cards > li > .dm-card { flex: 1 1 auto; min-width: 0; }
    .dm-card-img { display: block; }
    .dm-card-copy strong { font-size: 18px; }
    .dm-card-copy span { font-size: 14px; }
  }
</style>

<style is:global>
  /* 服務站專用：頁首唯一的 CTA「聊聊需求」按鈕（站上主按鈕色）。
     .nav-js .mainnav a 會把所有導覽連結的左右內距歸零、字級設 18px，所以這裡選擇器要更具體，
     否則圖示與文字會貼到按鈕邊緣。桌機用固定 44px 高，手機展開選單時整列寬度撐滿。 */
  .nav-js .mainnav .service-book, .mainnav .service-book { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 10px 22px; border: 1px solid var(--color-accent); border-radius: 6px; background: var(--color-accent); color: #fff; font-size: 16px; font-weight: 650; line-height: 1.2; white-space: nowrap; transition: background-color .18s ease, border-color .18s ease; }
  .service-book .service-book-icon { display: block; flex: none; width: 20px; height: 20px; }
  @media (hover: hover) and (pointer: fine) {
    .mainnav .service-book:hover { border-color: var(--color-accent-2, var(--color-accent)); background: var(--color-accent-2, var(--color-accent)); color: #fff; }
  }
  @media (max-width: 1023px) {
    .nav-js .mainnav .hd-book-item { padding: 12px 0 14px; }
    .nav-js .mainnav .service-book { display: flex; width: 100%; padding: 12px 20px; }
  }
</style>

<script is:inline>
      /* 收合選單：獨立的 try 區塊，跟下面的搜尋互不影響。
         關鍵順序——`nav-js` 這個 class 只在「開關確定接好」之後才加到 <html>。
         反過來寫的話，只要下面任何一行拋例外，選單會被 CSS 收起來卻沒有東西能打開它，
         導覽就永久消失了。沒有 JS（或 JS 爆炸）時 .nav-js 不存在，
         導覽就是一排正常可見、可點的連結——連結一律寫在初始 HTML 裡，爬蟲讀得到。 */
      (function () {
        try {
          var header = document.getElementById('site-header');
          var cue = document.getElementById('nav-cue');
          var panel = document.getElementById('mainnav');
          var dropdowns = panel ? panel.querySelectorAll('.nav-dropdown') : [];
          if (!header || !cue || !panel) return;

          // 桌機導覽固定展開，手機則是「下拉面板」（用 max-height）。
          // max-height 必須用 scrollHeight 算，所以只能在 JS 裡設；
          // 換到桌機時要把 inline 的 max-height 清掉，免得殘值把橫排導覽壓扁。
          var mqDesktop = window.matchMedia('(min-width:1024px)');

          function applyHeight(open) {
            if (mqDesktop.matches) {
              panel.style.maxHeight = '';
              return;
            }
            // +28px 留給最後一顆連結的 :focus-visible 外框，不然 overflow:hidden 會切掉它
            // 頁首是 sticky，展開後比視窗高（例如文章清單全部展開）就會有項目永遠捲不到；
            // 高度以視窗高度為上限，超過的部分在面板內捲動（CSS 開啟時 overflow-y:auto）。
            var cap = Math.max(240, window.innerHeight - 84);
            panel.style.maxHeight = open ? Math.min(panel.scrollHeight + 28, cap) + 'px' : '0px';
          }

          // 開啟時把焦點送進第一個連結。原因是 DOM 順序：導覽排在工具列之前
          // （桌機膠囊的視覺順序要求如此），開關按鈕卻在工具列裡。焦點若留在按鈕上，
          // 按 Tab 會直接跳過剛展開的六個連結跑進內文——鍵盤使用者等於打不開選單。
          // 關閉時若焦點還在面板裡，收回按鈕上，不讓焦點掉到 body。
          function setOpen(open, moveFocus) {
            // 桌機版不提供收合；僅手機版的選單開關會改變狀態。
            if (mqDesktop.matches) open = true;
            var focusInside = panel.contains(document.activeElement);
            header.setAttribute('data-open', open ? 'true' : 'false');
            cue.setAttribute('aria-expanded', open ? 'true' : 'false');
            cue.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
            applyHeight(open);
            if (open && moveFocus) {
              var first = panel.querySelector('a');
              if (first) first.focus();
            } else if (!open && focusInside) {
              cue.focus();
            }
          }

          // 保留尺寸重算給舊版膠囊的漸進增強；目前 Dean 式桌機導覽使用完整容器寬。
          // 寫死的版本（原本 636px，依五個連結算的）在 NAV 加入第六項時被
          // overflow:hidden 直接切掉 44px，而且沒有任何警告。
          // 量的是收合狀態下 nav 的 scrollWidth（此時 CSS 把可視寬壓成 0/384，
          // 但 scrollWidth 仍反映內容的自然寬），加上膠囊其餘元件的固定佔用。
          // 字型載入會改變寬度，所以等 document.fonts.ready 之後再量一次。
          function sizeCapsule() {
            if (!window.matchMedia('(min-width: 1024px)').matches) return;
            var list = panel.querySelector('ul');
            if (!list) return;
            // 搜尋已移到右下角，這裡只保留字標、左右內距與邊框。
            var CHROME = 66;
            var need = Math.ceil(list.scrollWidth) + CHROME;
            header.style.setProperty('--capw-open', need + 'px');
          }
          sizeCapsule();
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(sizeCapsule).catch(function () {});
          }
          window.addEventListener('resize', sizeCapsule);

          // 斷點換邊時重算一次，避免手機展開後轉成桌機、殘留 max-height
          var onMQ = function () {
            sizeCapsule();
            setOpen(mqDesktop.matches, false);
          };
          if (mqDesktop.addEventListener) mqDesktop.addEventListener('change', onMQ);
          else if (mqDesktop.addListener) mqDesktop.addListener(onMQ);
          window.addEventListener('resize', onMQ);

          cue.addEventListener('click', function (e) {
            e.stopPropagation();
            setOpen(cue.getAttribute('aria-expanded') !== 'true', true);
          });

          // Esc 關閉並把焦點還給開關（鍵盤使用者不會迷路）
          document.addEventListener('keydown', function (e) {
            if (mqDesktop.matches) return;
            if (e.key !== 'Escape' && e.keyCode !== 27) return;
            if (cue.getAttribute('aria-expanded') !== 'true') return;
            setOpen(false);
            cue.focus();
          });

          // 點面板外面關閉
          document.addEventListener('click', function (e) {
            if (mqDesktop.matches) return;
            if (cue.getAttribute('aria-expanded') !== 'true') return;
            if (panel.contains(e.target) || cue.contains(e.target)) return;
            setOpen(false);
          });

          // 點面板裡的連結後關閉（同頁錨點時才看得出差別，但成本是零）
          panel.addEventListener('click', function (e) {
            if (mqDesktop.matches) return;
            if (e.target.closest && e.target.closest('a')) setOpen(false);
          });

          // 手機版展開任一子選單後內容高度會增加，必須同步重算外層選單高度，
          // 否則預覽卡片會被原本的 max-height 裁掉。
          Array.prototype.forEach.call(dropdowns, function (dropdown) {
            dropdown.addEventListener('toggle', function () {
              if (mqDesktop.matches || header.getAttribute('data-open') !== 'true') return;
              window.requestAnimationFrame(function () { applyHeight(true); });
            });
          });

          setOpen(mqDesktop.matches, false);
          document.documentElement.classList.add('nav-js'); // 全部接好了才收合
        } catch (err) {
          /* 沒接上就維持展開：一排正常可見、可點的導覽連結 */
        }
      })();

      (function () {
        // 參考 DR.DEAN：桌機游標移入即開啟，移出後稍延遲關閉；
        // 觸控裝置維持 details 原生點擊，鍵盤則以 focus 開啟。
        var dropdowns = Array.prototype.slice.call(document.querySelectorAll('.nav-dropdown'));
        if (!dropdowns.length) return;
        var hoverMenu = window.matchMedia('(min-width:1024px) and (hover:hover) and (pointer:fine)');
        var closeTimers = new WeakMap();

        function closeOthers(current) {
          dropdowns.forEach(function (dropdown) {
            if (dropdown !== current) dropdown.removeAttribute('open');
          });
        }

        dropdowns.forEach(function (dropdown) {
          var summary = dropdown.querySelector('summary');
          // 分離式導覽的文字連結與箭頭是兄弟節點；hover 監聽要掛在整個 shell，
          // 才能做到游標碰到文字就展開，而不是只有碰到小箭頭才有反應。
          var hoverTarget = dropdown.closest('.service-nav-shell') || dropdown;
          hoverTarget.addEventListener('mouseenter', function () {
            if (!hoverMenu.matches) return;
            window.clearTimeout(closeTimers.get(dropdown));
            closeOthers(dropdown);
            dropdown.setAttribute('open', '');
          });
          hoverTarget.addEventListener('mouseleave', function () {
            if (!hoverMenu.matches) return;
            closeTimers.set(dropdown, window.setTimeout(function () {
              dropdown.removeAttribute('open');
            }, 120));
          });
          summary.addEventListener('click', function (event) {
            if (!hoverMenu.matches) return;
            event.preventDefault();
            closeOthers(dropdown);
            dropdown.setAttribute('open', '');
          });
          dropdown.addEventListener('focusin', function () {
            if (!window.matchMedia('(min-width:1024px)').matches) return;
            closeOthers(dropdown);
            dropdown.setAttribute('open', '');
          });
          dropdown.addEventListener('focusout', function () {
            window.setTimeout(function () {
              if (!dropdown.contains(document.activeElement)) dropdown.removeAttribute('open');
            }, 0);
          });
          dropdown.addEventListener('toggle', function () {
            if (dropdown.open) closeOthers(dropdown);
          });
        });

        document.addEventListener('click', function (e) {
          dropdowns.forEach(function (dropdown) {
            if (dropdown.open && !dropdown.contains(e.target)) dropdown.removeAttribute('open');
          });
        });
        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape' && e.keyCode !== 27) return;
          var openDropdown = dropdowns.find(function (dropdown) { return dropdown.open; });
          if (!openDropdown) return;
          openDropdown.removeAttribute('open');
          var summary = openDropdown.querySelector('summary');
          if (summary) summary.focus();
        });
      })();

      (function () {
        // 共用提示元件：window.siteToast({ title, text, link })，約 3 秒自動淡出，點擊或 Esc 可提前關閉。
        var timer = 0;
        var node = null;
        function ensureStyle() {
          if (document.getElementById('site-toast-style')) return;
          var st = document.createElement('style');
          st.id = 'site-toast-style';
          st.textContent =
            '.site-toast{position:fixed;left:50%;bottom:max(24px,env(safe-area-inset-bottom));z-index:2147483000;' +
            'width:max-content;max-width:min(92vw,420px);box-sizing:border-box;padding:14px 18px;border-radius:4px;' +
            'background:#16161a;color:#fff;border-left:4px solid #7a2e3b;box-shadow:0 8px 28px rgba(0,0,0,.28);' +
            'font-size:15px;line-height:1.55;text-align:left;cursor:pointer;pointer-events:auto;' +
            'transform:translate(-50%,12px);opacity:0;transition:opacity .25s ease,transform .25s ease;overflow-wrap:anywhere}' +
            '.site-toast.is-visible{opacity:1;transform:translate(-50%,0)}' +
            '.site-toast strong{display:block;font-weight:700}' +
            '.site-toast span{display:block;margin-top:2px;color:#e8e4dc}' +
            '.site-toast a{color:#fff;text-decoration:underline;word-break:break-all}' +
            '@media (prefers-reduced-motion:reduce){.site-toast{transition:none}}';
          document.head.appendChild(st);
        }
        function hide() {
          window.clearTimeout(timer);
          if (!node) return;
          var n = node;
          node = null;
          n.classList.remove('is-visible');
          window.setTimeout(function () { n.remove(); }, 300);
        }
        window.siteToast = function (opts) {
          ensureStyle();
          hide();
          var el = document.createElement('div');
          el.className = 'site-toast';
          el.setAttribute('role', 'status');
          el.setAttribute('aria-live', 'polite');
          var t = document.createElement('strong');
          t.textContent = opts.title;
          el.appendChild(t);
          if (opts.text) {
            var d = document.createElement('span');
            d.textContent = opts.text;
            el.appendChild(d);
          }
          if (opts.link) {
            var a = document.createElement('span');
            var l = document.createElement('a');
            l.href = opts.link;
            l.textContent = opts.link;
            l.target = '_blank';
            l.rel = 'noopener';
            l.addEventListener('click', function (e) { e.stopPropagation(); });
            a.appendChild(l);
            el.appendChild(a);
          }
          el.addEventListener('click', hide);
          document.body.appendChild(el);
          node = el;
          window.requestAnimationFrame(function () { el.classList.add('is-visible'); });
          // 使用者若已被切到新分頁，等回到本分頁才開始計時，避免提示在沒人看時就消失。
          var wait = opts.link ? 6000 : 3000;
          function arm() {
            window.clearTimeout(timer);
            timer = window.setTimeout(hide, wait);
          }
          if (document.hidden) {
            var onVisible = function () {
              if (document.hidden) return;
              document.removeEventListener('visibilitychange', onVisible);
              if (node === el) arm();
            };
            document.addEventListener('visibilitychange', onVisible);
          } else {
            arm();
          }
        };
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && node) hide(); });
      })();

      (function () {
        // 「領取」只複製 Repo 網址；預覽卡片則保留為內容入口。
        // 用 data attribute 共用同一套行為，新增領取項目不需再寫一份 JS。
        var copyButtons = document.querySelectorAll('[data-copy-repo]');
        if (!copyButtons.length) return;

        function legacyCopy(text) {
          var field = document.createElement('textarea');
          field.value = text;
          field.setAttribute('readonly', '');
          field.style.position = 'fixed';
          field.style.opacity = '0';
          document.body.appendChild(field);
          field.select();
          var copied = document.execCommand('copy');
          field.remove();
          return copied ? Promise.resolve() : Promise.reject(new Error('copy failed'));
        }

        Array.prototype.forEach.call(copyButtons, function (button) {
          button.addEventListener('click', function () {
            var repo = button.getAttribute('data-copy-repo');
            var label = button.querySelector('.service-preview-cta-label');
            if (!repo || !label) return;
            var copyPromise = navigator.clipboard && navigator.clipboard.writeText
              ? navigator.clipboard.writeText(repo).catch(function () { return legacyCopy(repo); })
              : legacyCopy(repo);
            // 先發出複製，再於同一個 click 事件內同步開新分頁（使用者手勢仍有效，不會被彈出視窗攔截；
            // 若等 clipboard 的 Promise 完成才開，Safari／手機會視為非手勢而擋掉）。
            window.open(repo, '_blank', 'noopener');
            copyPromise.then(function () {
              label.textContent = '已複製';
              button.setAttribute('aria-label', '已複製 Repo 連結');
              window.setTimeout(function () {
                label.textContent = '領取';
                button.setAttribute('aria-label', '複製 Repo 連結');
              }, 1800);
              window.siteToast({ title: '已複製 GitHub 連結', text: button.getAttribute('data-copy-hint') || '' });
            }).catch(function () {
              label.textContent = '複製失敗';
              window.siteToast({ title: '複製失敗，請手動複製下方連結', link: repo });
            });
          });
        });
      })();
</script>
