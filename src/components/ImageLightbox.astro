---
// 共用圖片放大預覽：案例截圖（/cases/、首頁、服務站）一律用這個元件。
// 無 JS 時就是一個連到原圖的連結；有 JS 時點擊開 <dialog> 顯示原圖，Esc、點背景、關閉鈕都能關，開啟時鎖住頁面捲動。
// 放大顯示的是 1440×900 原檔，手機可用瀏覽器雙指縮放。
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** 套在 <img> 上的 class（沿用各頁原本的縮圖樣式） */
  imgClass?: string;
  class?: string;
  /** GA 事件 location 與按鈕代號 */
  gaLocation: string;
  gaKey: string;
  loading?: 'lazy' | 'eager';
  /** 同一組的圖在預覽內可左右切換 */
  group?: string;
  /** 預覽內顯示的說明（例如功能標籤） */
  caption?: string;
}

const { src, alt, width, height, imgClass, class: className, gaLocation, gaKey, loading = 'lazy', group, caption } = Astro.props;
---

<a
  class:list={['lightbox-trigger', className]}
  href={src}
  data-lightbox
  data-lightbox-group={group}
  data-lightbox-caption={caption}
  aria-label={`放大預覽：${alt}`}
  data-ga-button={`${gaLocation}_zoom_${gaKey}`}
  data-ga-label={`放大預覽：${alt}`}
  data-ga-location={gaLocation}
  data-ga-action="zoom"
>
  <img class={imgClass} src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" />
  <span class="lightbox-hint" aria-hidden="true">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5M11 8v6M8 11h6" /></svg>
  </span>
</a>

<style is:global>
  .lightbox-trigger { position: relative; display: block; cursor: zoom-in; }
  .lightbox-trigger:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }
  .lightbox-hint { position: absolute; right: 10px; bottom: 10px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: rgb(22 22 26 / 72%); opacity: 0.85; pointer-events: none; }
  .lightbox-hint svg { width: 18px; height: 18px; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; }
  .lightbox-dialog { position: fixed; inset: 0; margin: auto; height: fit-content; width: min(96vw, 1440px); max-width: none; max-height: 94vh; padding: 0; border: 0; background: transparent; overflow: visible; }
  .lightbox-dialog::backdrop { background: rgb(10 10 12 / 82%); }
  .lightbox-dialog img { display: block; width: 100%; height: auto; max-height: 90vh; object-fit: contain; border-radius: 6px; background: #fff; }
  .lightbox-close { position: absolute; top: -14px; right: -6px; display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: #fff; color: #16161a; font-size: 24px; line-height: 1; cursor: pointer; box-shadow: 0 4px 14px rgb(0 0 0 / 30%); }
  @media (max-width: 767px) { .lightbox-close { top: -52px; right: 0; } }
  html.lightbox-open { overflow: hidden; }
  .lightbox-caption { position: absolute; top: 10px; left: 10px; padding: 4px 12px; border-radius: 999px; background: rgb(22 22 26 / 80%); color: #fff; font-size: 14px; }
  .lightbox-caption:empty { display: none; }
  .lightbox-nav { position: absolute; top: 50%; display: grid; place-items: center; width: 44px; height: 44px; margin-top: -22px; border: 0; border-radius: 50%; background: rgb(255 255 255 / 92%); color: #16161a; font-size: 26px; line-height: 1; cursor: pointer; box-shadow: 0 4px 14px rgb(0 0 0 / 30%); }
  .lightbox-nav[hidden] { display: none; }
  .lightbox-prev { left: 8px; }
  .lightbox-next { right: 8px; }
  .lightbox-count { position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%); padding: 2px 10px; border-radius: 999px; background: rgb(22 22 26 / 70%); color: #fff; font-size: 13px; }
  .lightbox-count:empty { display: none; }
</style>

<script>
  // 全站只綁一次（Astro 會把同一支 script 去重）
  let dialog: HTMLDialogElement | null = null;
  let image: HTMLImageElement | null = null;
  let captionEl: HTMLElement | null = null;
  let countEl: HTMLElement | null = null;
  let prevBtn: HTMLButtonElement | null = null;
  let nextBtn: HTMLButtonElement | null = null;
  let items: HTMLAnchorElement[] = [];
  let current = 0;

  function render() {
    const trigger = items[current];
    if (!trigger || !image) return;
    image.src = trigger.href;
    image.alt = trigger.querySelector('img')?.alt ?? '';
    if (captionEl) captionEl.textContent = trigger.dataset.lightboxCaption ?? '';
    const multi = items.length > 1;
    if (countEl) countEl.textContent = multi ? `${current + 1} / ${items.length}` : '';
    if (prevBtn) prevBtn.hidden = !multi;
    if (nextBtn) nextBtn.hidden = !multi;
  }
  const step = (delta: number) => { current = (current + delta + items.length) % items.length; render(); };

  function makeButton(className: string, label: string, text: string, onClick: () => void) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = className;
    button.setAttribute('aria-label', label);
    button.textContent = text;
    button.addEventListener('click', onClick);
    return button;
  }

  function ensureDialog() {
    if (dialog) return;
    dialog = document.createElement('dialog');
    dialog.className = 'lightbox-dialog';
    dialog.setAttribute('aria-label', '圖片放大預覽');
    image = document.createElement('img');
    captionEl = document.createElement('span');
    captionEl.className = 'lightbox-caption';
    countEl = document.createElement('span');
    countEl.className = 'lightbox-count';
    prevBtn = makeButton('lightbox-nav lightbox-prev', '上一張', '‹', () => step(-1));
    nextBtn = makeButton('lightbox-nav lightbox-next', '下一張', '›', () => step(1));
    const close = makeButton('lightbox-close', '關閉預覽', '×', () => dialog?.close());
    dialog.append(image, captionEl, countEl, prevBtn, nextBtn, close);
    // 點背景（dialog 本體以外的 backdrop 區）關閉
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog?.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (items.length < 2) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); step(-1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); step(1); }
    });
    dialog.addEventListener('close', () => document.documentElement.classList.remove('lightbox-open'));
    document.body.appendChild(dialog);
  }

  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lightbox]');
    if (!trigger || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    ensureDialog();
    const group = trigger.dataset.lightboxGroup;
    items = group
      ? [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox][data-lightbox-group="${CSS.escape(group)}"]`)]
      : [trigger];
    current = Math.max(0, items.indexOf(trigger));
    render();
    document.documentElement.classList.add('lightbox-open');
    dialog?.showModal();
  });
</script>
