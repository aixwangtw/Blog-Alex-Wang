---
// ============================================================
// 工具選擇測驗：由 /services/tool-quiz/ 引用，正式網址是
// service.aixwang.dev/quiz/。結果連結用主站絕對網址，避免子網域 404；
// 使用者可直接加 LINE，或由伺服器把建議寄到指定 Email。
// ============================================================
import SectionHeading from './SectionHeading.astro';
import { LINKS, SITE } from '../consts';
---

<!-- ---------- 工具選擇測驗：共同先裝 Codex，再依需求推薦工具 ---------- -->
<section class="mt-8 sm:mt-10" id="tool-quiz" aria-labelledby="tool-quiz-heading">
  <p class="font-mono text-[11.5px] tracking-[0.12em] text-accent">30 秒測驗</p>
  <SectionHeading id="tool-quiz-heading" size="md" class="mt-2">每個需求該用什麼工具？</SectionHeading>
  <p class="mt-4 leading-8 text-ink-2">第一步都先安裝 Codex。回答 3 題後，再依自動發文、社群圖文、剪輯或配音等需求，告訴你要搭配什麼工具。</p>

  <div class="mt-8" data-quiz-root>
    <!-- Q1：單選 -->
    <div data-quiz-step="q1">
      <p class="font-mono text-[11.5px] tracking-[0.12em] text-ink-3">第 1 題／共 3 題</p>
      <p id="tool-quiz-q1-label" class="t-h3 mt-2 font-semibold text-ink">Q1. 你現在最大的卡點是？</p>
      <div class="mt-5 grid gap-3" role="radiogroup" aria-labelledby="tool-quiz-q1-label">
        <button
          type="button"
          role="radio"
          aria-checked="false"
          class="block w-full border border-rule-2 px-5 py-3.5 text-left leading-6 text-ink transition hover:border-accent hover:text-accent"
          data-quiz-answer
          data-question="q1"
          data-value="a"
          data-scores="{}"
          data-ga-button="quiz_q1_beginner"
          data-ga-label="完全不知道要用什麼工具，想先有個開始"
          data-ga-location="tools_quiz"
          data-ga-action="answer_question"
        >完全不知道要用什麼工具，想先有個開始</button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          class="block w-full border border-rule-2 px-5 py-3.5 text-left leading-6 text-ink transition hover:border-accent hover:text-accent"
          data-quiz-answer
          data-question="q1"
          data-value="b"
          data-scores="{}"
          data-ga-button="quiz_q1_specific_task"
          data-ga-label="已經有想做的具體任務，只是不知道用哪個工具"
          data-ga-location="tools_quiz"
          data-ga-action="answer_question"
        >已經有想做的具體任務，只是不知道用哪個工具</button>
      </div>
    </div>

    <!-- Q2：可複選 -->
    <div data-quiz-step="q2" hidden>
      <p class="font-mono text-[11.5px] tracking-[0.12em] text-ink-3">第 2 題／共 3 題</p>
      <p id="tool-quiz-q2-label" class="t-h3 mt-2 font-semibold text-ink">Q2. 你想完成的任務是？（可以選多個）</p>
      <div class="mt-5 grid gap-3" role="group" aria-labelledby="tool-quiz-q2-label">
        <button
          type="button"
          aria-pressed="false"
          class="block w-full border border-rule-2 px-5 py-3.5 text-left leading-6 text-ink transition hover:border-accent hover:text-accent"
          data-quiz-answer
          data-question="q2"
          data-value="a"
          data-scores="{&quot;meta&quot;:3}"
          data-ga-button="quiz_q2_meta"
          data-ga-label="排程自動發文到 IG／Threads／FB"
          data-ga-location="tools_quiz"
          data-ga-action="answer_question"
        >排程自動發文到 IG／Threads／FB</button>
        <button
          type="button"
          aria-pressed="false"
          class="block w-full border border-rule-2 px-5 py-3.5 text-left leading-6 text-ink transition hover:border-accent hover:text-accent"
          data-quiz-answer
          data-question="q2"
          data-value="b"
          data-scores="{&quot;tooka&quot;:3}"
          data-ga-button="quiz_q2_tooka"
          data-ga-label="做輪播圖文、知識卡設計"
          data-ga-location="tools_quiz"
          data-ga-action="answer_question"
        >做輪播圖文、知識卡設計</button>
        <button
          type="button"
          aria-pressed="false"
          class="block w-full border border-rule-2 px-5 py-3.5 text-left leading-6 text-ink transition hover:border-accent hover:text-accent"
          data-quiz-answer
          data-question="q2"
          data-value="c"
          data-scores="{&quot;remotion&quot;:3}"
          data-ga-button="quiz_q2_remotion"
          data-ga-label="拍影片、剪輯短影音"
          data-ga-location="tools_quiz"
          data-ga-action="answer_question"
        >拍影片、剪輯短影音</button>
        <button
          type="button"
          aria-pressed="false"
          class="block w-full border border-rule-2 px-5 py-3.5 text-left leading-6 text-ink transition hover:border-accent hover:text-accent"
          data-quiz-answer
          data-question="q2"
          data-value="d"
          data-scores="{&quot;elevenlabs&quot;:3}"
          data-ga-button="quiz_q2_elevenlabs"
          data-ga-label="幫影片配音、生成語音旁白"
          data-ga-location="tools_quiz"
          data-ga-action="answer_question"
        >幫影片配音、生成語音旁白</button>
        <button
          type="button"
          aria-pressed="false"
          class="block w-full border border-rule-2 px-5 py-3.5 text-left leading-6 text-ink transition hover:border-accent hover:text-accent"
          data-quiz-answer
          data-question="q2"
          data-value="e"
          data-scores="{&quot;codex&quot;:2}"
          data-ga-button="quiz_q2_codex"
          data-ga-label="還不確定，先學會操作 AI Agent 再說"
          data-ga-location="tools_quiz"
          data-ga-action="answer_question"
        >還不確定，先學會操作 AI Agent 再說</button>
      </div>
      <button
        type="button"
        class="mt-6 inline-flex min-h-11 items-center rounded-[3px] border border-rule-2 px-5 py-2.5 font-semibold text-ink transition hover:border-accent hover:text-accent"
        data-quiz-back="q1"
        data-ga-button="quiz_q2_back"
        data-ga-label="上一步"
        data-ga-location="tools_quiz"
        data-ga-action="answer_question"
      >上一步</button>
      <button
        type="button"
        class="mt-6 inline-flex min-h-11 items-center rounded-[3px] border border-rule-2 px-5 py-2.5 font-semibold text-ink transition hover:border-accent hover:text-accent"
        data-quiz-next
        data-ga-button="quiz_q2_next"
        data-ga-label="下一題"
        data-ga-location="tools_quiz"
        data-ga-action="answer_question"
      >下一題</button>
      <p class="mt-3 text-sm text-accent" data-quiz-q2-status aria-live="polite"></p>
    </div>

    <!-- Q3：單選 -->
    <div data-quiz-step="q3" hidden>
      <p class="font-mono text-[11.5px] tracking-[0.12em] text-ink-3">第 3 題／共 3 題</p>
      <p id="tool-quiz-q3-label" class="t-h3 mt-2 font-semibold text-ink">Q3. 如果只能先解決一件事，你會選？</p>
      <div class="mt-5 grid gap-3" role="radiogroup" aria-labelledby="tool-quiz-q3-label">
        <button
          type="button"
          role="radio"
          aria-checked="false"
          class="block w-full border border-rule-2 px-5 py-3.5 text-left leading-6 text-ink transition hover:border-accent hover:text-accent"
          data-quiz-answer
          data-question="q3"
          data-value="a"
          data-scores="{&quot;meta&quot;:1}"
          data-ga-button="quiz_q3_meta"
          data-ga-label="讓內容自動發布，不用手動貼文"
          data-ga-location="tools_quiz"
          data-ga-action="answer_question"
        >讓內容自動發布，不用手動貼文</button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          class="block w-full border border-rule-2 px-5 py-3.5 text-left leading-6 text-ink transition hover:border-accent hover:text-accent"
          data-quiz-answer
          data-question="q3"
          data-value="b"
          data-scores="{&quot;tooka&quot;:1}"
          data-ga-button="quiz_q3_tooka"
          data-ga-label="讓畫面版型穩定好看"
          data-ga-location="tools_quiz"
          data-ga-action="answer_question"
        >讓畫面版型穩定好看</button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          class="block w-full border border-rule-2 px-5 py-3.5 text-left leading-6 text-ink transition hover:border-accent hover:text-accent"
          data-quiz-answer
          data-question="q3"
          data-value="c"
          data-scores="{&quot;remotion&quot;:1}"
          data-ga-button="quiz_q3_remotion"
          data-ga-label="影片後製效率提升"
          data-ga-location="tools_quiz"
          data-ga-action="answer_question"
        >影片後製效率提升</button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          class="block w-full border border-rule-2 px-5 py-3.5 text-left leading-6 text-ink transition hover:border-accent hover:text-accent"
          data-quiz-answer
          data-question="q3"
          data-value="d"
          data-scores="{&quot;elevenlabs&quot;:1}"
          data-ga-button="quiz_q3_elevenlabs"
          data-ga-label="配音、旁白的自然度"
          data-ga-location="tools_quiz"
          data-ga-action="answer_question"
        >配音、旁白的自然度</button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          class="block w-full border border-rule-2 px-5 py-3.5 text-left leading-6 text-ink transition hover:border-accent hover:text-accent"
          data-quiz-answer
          data-question="q3"
          data-value="e"
          data-scores="{&quot;codex&quot;:1}"
          data-ga-button="quiz_q3_codex"
          data-ga-label="先搞懂 AI Agent 怎麼用"
          data-ga-location="tools_quiz"
          data-ga-action="answer_question"
        >先搞懂 AI Agent 怎麼用</button>
      </div>
      <button
        type="button"
        class="mt-6 inline-flex min-h-11 items-center rounded-[3px] border border-rule-2 px-5 py-2.5 font-semibold text-ink transition hover:border-accent hover:text-accent"
        data-quiz-back="q2"
        data-ga-button="quiz_q3_back"
        data-ga-label="上一步"
        data-ga-location="tools_quiz"
        data-ga-action="answer_question"
      >上一步</button>
    </div>

    <!-- 結果 -->
    <div data-quiz-step="result" hidden>
      <p class="font-mono text-[11.5px] tracking-[0.12em] text-accent">測驗結果</p>

      <div class="mt-4 border border-accent-line-2 bg-accent-tint p-6 sm:p-8">
        <p class="font-mono text-[11.5px] tracking-[0.12em] text-accent">所有需求的共同第一步</p>
        <p class="t-h3 mt-2 font-semibold text-ink">先安裝 Codex</p>
        <p class="mt-3 leading-8 text-ink-2">Codex 是操作其他工具、安裝 Skills、執行流程與協助除錯的入口。無論最後想做什麼，都先把它安裝好並完成第一次對話。</p>
        <p class="mt-4"><a
            href={`${SITE.url}/blog/codex-windows-wsl-install/`}
            class="text-accent underline underline-offset-4"
            data-ga-button="quiz_result_codex_required"
            data-ga-label="先安裝 Codex"
            data-ga-location="tools_quiz"
            data-ga-action="view_result"
          >VS Code＋Codex 插件版安裝教學</a></p>
      </div>

      <p class="mt-8 text-sm font-semibold text-ink-3">再依你的需求搭配：</p>

      <div class="mt-4" data-quiz-primary>
        <div class="border border-rule bg-white/40 p-6 sm:p-8" data-result-primary="codex" hidden>
          <p class="t-h3 font-semibold text-ink">目前先不用加其他工具</p>
          <p class="mt-3 leading-8 text-ink-2">你還不確定具體任務，先用 Codex 完成一個小任務，熟悉怎麼把需求交給 AI 執行。</p>
          <p class="mt-4"><a
              href={`${SITE.url}/blog/codex-windows-wsl-install/`}
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_codex_primary"
              data-ga-label="VS Code＋Codex 插件版安裝教學"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >VS Code＋Codex 插件版安裝教學</a></p>
          <p class="mt-2 text-sm leading-6 text-ink-3"><a
              href={`${SITE.url}/blog/claude-or-codex-budget/`}
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_codex_compare_claude"
              data-ga-label="想比較 Claude Code？"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >想比較 Claude Code？</a></p>
        </div>

        <div class="border border-rule bg-white/40 p-6 sm:p-8" data-result-primary="meta" hidden>
          <p class="t-h3 font-semibold text-ink">你需要的是 Meta API 串接</p>
          <p class="mt-3 leading-8 text-ink-2">把發文動作自動化，排程、權限設定都靠這組 API。</p>
          <p class="mt-4"><a
              href={`${SITE.url}/blog/threads-api-tutorial/`}
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_meta_primary"
              data-ga-label="Meta 三大 API 申請教學"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >Meta 三大 API 申請教學</a></p>
          <ul class="mt-3 grid gap-1.5 text-sm leading-6 text-ink-3">
            <li><a
                href={`${SITE.url}/blog/meta-api-application/`}
                class="text-accent underline underline-offset-4"
                data-ga-button="quiz_result_meta_extra_application"
                data-ga-label="API 申請流程"
                data-ga-location="tools_quiz"
                data-ga-action="view_result"
              >API 申請流程</a></li>
            <li><a
                href={`${SITE.url}/blog/instagram-api-tutorial/`}
                class="text-accent underline underline-offset-4"
                data-ga-button="quiz_result_meta_extra_instagram_api"
                data-ga-label="Instagram API 教學"
                data-ga-location="tools_quiz"
                data-ga-action="view_result"
              >Instagram API 教學</a></li>
            <li><a
                href={`${SITE.url}/blog/auto-posting-permissions/`}
                class="text-accent underline underline-offset-4"
                data-ga-button="quiz_result_meta_extra_auto_posting"
                data-ga-label="避免自動發文被封鎖"
                data-ga-location="tools_quiz"
                data-ga-action="view_result"
              >避免自動發文被封鎖</a></li>
          </ul>
        </div>

        <div class="border border-rule bg-white/40 p-6 sm:p-8" data-result-primary="tooka" hidden>
          <p class="t-h3 font-semibold text-ink">你需要的是 Tooka</p>
          <p class="mt-3 leading-8 text-ink-2">量產輪播圖文、知識卡，版型不會跑版。</p>
          <p class="mt-4"><a
              href={`${SITE.url}/blog/why-i-built-tooka/`}
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_tooka_primary"
              data-ga-label="AI 圖文生成工具怎麼選？我為什麼自己開發 Tooka"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >AI 圖文生成工具怎麼選？我為什麼自己開發 Tooka</a></p>
        </div>

        <div class="border border-rule bg-white/40 p-6 sm:p-8" data-result-primary="remotion" hidden>
          <p class="t-h3 font-semibold text-ink">你需要的是 Remotion</p>
          <p class="mt-3 leading-8 text-ink-2">用程式化的方式做影片，適合需要固定版型、大量產出短影音的人。像 grill-me 這支 Reel 就是用 Remotion 拍的。</p>
          <p class="mt-4"><a
              href="https://www.remotion.dev/"
              target="_blank"
              rel="noreferrer"
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_remotion_primary"
              data-ga-label="Remotion 官方網站"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >Remotion 官方網站</a></p>
          <p class="mt-2 text-sm leading-6 text-ink-3"><a
              href="https://www.instagram.com/reel/DbwqIJkydIQ/"
              target="_blank"
              rel="noreferrer"
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_remotion_case_study"
              data-ga-label="看實際案例"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >看實際案例</a></p>
        </div>

        <div class="border border-rule bg-white/40 p-6 sm:p-8" data-result-primary="elevenlabs" hidden>
          <p class="t-h3 font-semibold text-ink">你需要的是 ElevenLabs</p>
          <p class="mt-3 leading-8 text-ink-2">AI 語音生成、配音，短影音的旁白不用自己錄。grill-me 那支 Reel 的配音就是用它做的。</p>
          <p class="mt-4"><a
              href="https://elevenlabs.io/"
              target="_blank"
              rel="noreferrer"
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_elevenlabs_primary"
              data-ga-label="ElevenLabs 官方網站"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >ElevenLabs 官方網站</a></p>
          <p class="mt-2 text-sm leading-6 text-ink-3"><a
              href="https://www.instagram.com/reel/DbwqIJkydIQ/"
              target="_blank"
              rel="noreferrer"
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_elevenlabs_case_study"
              data-ga-label="看實際案例"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >看實際案例</a></p>
        </div>
      </div>

      <div class="mt-6" data-quiz-secondary hidden>
        <p class="text-sm font-semibold text-ink-3">你選的其他需求會用到：</p>
        <ul class="mt-2 grid gap-2 text-sm leading-6 text-ink-2" data-quiz-secondary-list>
          <li data-result-secondary="codex" hidden>先從 Codex 開始 — <a
              href={`${SITE.url}/blog/codex-windows-wsl-install/`}
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_secondary_codex"
              data-ga-label="VS Code＋Codex 插件版安裝教學"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >VS Code＋Codex 插件版安裝教學</a></li>
          <li data-result-secondary="meta" hidden>你需要的是 Meta API 串接 — <a
              href={`${SITE.url}/blog/threads-api-tutorial/`}
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_secondary_meta"
              data-ga-label="Meta 三大 API 申請教學"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >Meta 三大 API 申請教學</a></li>
          <li data-result-secondary="tooka" hidden>你需要的是 Tooka — <a
              href={`${SITE.url}/blog/why-i-built-tooka/`}
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_secondary_tooka"
              data-ga-label="AI 圖文生成工具怎麼選？我為什麼自己開發 Tooka"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >AI 圖文生成工具怎麼選？我為什麼自己開發 Tooka</a></li>
          <li data-result-secondary="remotion" hidden>你需要的是 Remotion — <a
              href="https://www.remotion.dev/"
              target="_blank"
              rel="noreferrer"
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_secondary_remotion"
              data-ga-label="Remotion 官方網站"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >Remotion 官方網站</a></li>
          <li data-result-secondary="elevenlabs" hidden>你需要的是 ElevenLabs — <a
              href="https://elevenlabs.io/"
              target="_blank"
              rel="noreferrer"
              class="text-accent underline underline-offset-4"
              data-ga-button="quiz_result_secondary_elevenlabs"
              data-ga-label="ElevenLabs 官方網站"
              data-ga-location="tools_quiz"
              data-ga-action="view_result"
            >ElevenLabs 官方網站</a></li>
        </ul>
      </div>

      <div class="mt-8 border-t border-rule pt-6">
        <p class="t-h3 font-semibold text-ink">把建議帶走</p>
        <p class="mt-2 leading-7 text-ink-2">可以直接加 LINE 詢問，或輸入 Email，把這次的工具建議寄給自己。</p>

        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <a
            href={LINKS.line}
            target="_blank"
            rel="noreferrer"
            class="inline-flex min-h-11 items-center justify-center rounded-[3px] border border-accent bg-accent px-5 py-3 font-semibold text-white no-underline transition hover:border-accent-2 hover:bg-accent-2"
            data-ga-button="quiz_result_line"
            data-ga-label="加 LINE 詢問"
            data-ga-location="tools_quiz_result"
            data-ga-action="contact"
          >加 LINE 詢問 ↗</a>

          <form class="grid gap-3" data-quiz-email-form novalidate>
            <label for="tool-quiz-email" class="sr-only">Email</label>
            <input
              id="tool-quiz-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              maxlength="254"
              required
              placeholder="你的 Email"
              class="min-h-11 w-full rounded-[3px] border border-rule-3 bg-white px-4 py-3 text-base text-ink outline-none focus:border-accent"
            />
            <input name="website" type="text" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <button
              type="submit"
              class="inline-flex min-h-11 items-center justify-center rounded-[3px] border border-rule-3 px-5 py-3 font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-wait disabled:opacity-60"
              data-quiz-email-submit
              data-ga-button="quiz_result_email"
              data-ga-label="寄送工具建議"
              data-ga-location="tools_quiz_result"
              data-ga-action="send_email"
            >寄送工具建議</button>
          </form>
        </div>
        <p class="mt-3 text-sm leading-6 text-ink-3" data-quiz-email-status aria-live="polite"></p>
      </div>

      <button
        type="button"
        class="mt-6 inline-flex min-h-11 items-center rounded-[3px] border border-rule-2 px-5 py-2.5 font-semibold text-ink transition hover:border-accent hover:text-accent"
        data-quiz-restart
        data-ga-button="quiz_restart"
        data-ga-label="重新測驗"
        data-ga-location="tools_quiz"
        data-ga-action="reset"
      >重新測驗</button>
    </div>
  </div>
</section>

<script>
  // 工具選擇測驗：固定 3 題線性流程，依計分表判斷結果，純 DOM 操作、不用框架。
  // 平手時的分類優先順序（規格定案，不要改順序）。
  const QUIZ_PRIORITY = ['codex', 'meta', 'tooka', 'remotion', 'elevenlabs'];

  const quizRoot = document.querySelector<HTMLElement>('[data-quiz-root]');

  if (quizRoot) {
    const root = quizRoot;
    const steps = root.querySelectorAll<HTMLElement>('[data-quiz-step]');
    let q1Scores: Record<string, number> = {};
    let q3Scores: Record<string, number> = {};
    const q2Scores = new Map<string, Record<string, number>>();
    let currentWinner = '';
    let currentSecondaries: string[] = [];

    function showStep(name: string) {
      steps.forEach((step) => {
        step.hidden = step.dataset.quizStep !== name;
      });
    }

    function setSelected(button: HTMLButtonElement, selected: boolean) {
      button.classList.toggle('border-accent', selected);
      button.classList.toggle('bg-accent-tint', selected);
      button.classList.toggle('text-accent-2', selected);
      button.classList.toggle('border-rule-2', !selected);
    }

    function readScores(button: HTMLButtonElement): Record<string, number> {
      try {
        return JSON.parse(button.dataset.scores || '{}');
      } catch {
        return {};
      }
    }

    // Q1／Q3：單選，選了就直接推進到下一步（Q3 選了直接算結果）
    function handleSingleChoice(button: HTMLButtonElement, nextStep: string, onSelect: (scores: Record<string, number>) => void) {
      const group = button.closest('[role="radiogroup"]');
      group?.querySelectorAll<HTMLButtonElement>('[role="radio"]').forEach((radio) => {
        const selected = radio === button;
        radio.setAttribute('aria-checked', selected ? 'true' : 'false');
        setSelected(radio, selected);
      });
      onSelect(readScores(button));
      showStep(nextStep);
    }

    root.querySelectorAll<HTMLButtonElement>('[data-question="q1"]').forEach((button) => {
      button.addEventListener('click', () => {
        handleSingleChoice(button, 'q2', (scores) => {
          q1Scores = scores;
        });
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-question="q2"]').forEach((button) => {
      button.addEventListener('click', () => {
        const pressed = button.getAttribute('aria-pressed') === 'true';
        const next = !pressed;
        button.setAttribute('aria-pressed', next ? 'true' : 'false');
        setSelected(button, next);
        const value = button.dataset.value || '';
        if (next) {
          q2Scores.set(value, readScores(button));
        } else {
          q2Scores.delete(value);
        }
      });
    });

    root.querySelector<HTMLButtonElement>('[data-quiz-next]')?.addEventListener('click', () => {
      const q2Status = root.querySelector<HTMLElement>('[data-quiz-q2-status]');
      if (q2Scores.size === 0) {
        if (q2Status) q2Status.textContent = '請至少選擇一個任務。';
        return;
      }
      if (q2Status) q2Status.textContent = '';
      showStep('q3');
    });

    // 上一步：只換頁，不 reset 已選答案（q1Scores／q2Scores 的狀態本來就還在）。
    root.querySelectorAll<HTMLButtonElement>('[data-quiz-back]').forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.dataset.quizBack;
        if (target) showStep(target);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-question="q3"]').forEach((button) => {
      button.addEventListener('click', () => {
        handleSingleChoice(button, 'result', (scores) => {
          q3Scores = scores;
        });
        showResult();
      });
    });

    function computeTotals(): Record<string, number> {
      const totals: Record<string, number> = { codex: 0, meta: 0, tooka: 0, remotion: 0, elevenlabs: 0 };
      const add = (scores: Record<string, number>) => {
        Object.entries(scores).forEach(([key, value]) => {
          if (key in totals) totals[key] += value;
        });
      };
      add(q1Scores);
      q2Scores.forEach((scores) => add(scores));
      add(q3Scores);
      return totals;
    }

    function showResult() {
      const totals = computeTotals();
      const maxScore = Math.max(...QUIZ_PRIORITY.map((key) => totals[key]));
      const winner = QUIZ_PRIORITY.find((key) => totals[key] === maxScore) ?? QUIZ_PRIORITY[0];
      currentWinner = winner;

      root.querySelectorAll<HTMLElement>('[data-result-primary]').forEach((card) => {
        card.hidden = card.dataset.resultPrimary !== winner;
      });

      const secondaries = QUIZ_PRIORITY.filter((key) => key !== winner && key !== 'codex' && totals[key] > 0).sort(
        (a, b) => totals[b] - totals[a] || QUIZ_PRIORITY.indexOf(a) - QUIZ_PRIORITY.indexOf(b)
      );
      currentSecondaries = secondaries;

      const secondaryContainer = root.querySelector<HTMLElement>('[data-quiz-secondary]');
      const secondaryList = root.querySelector<HTMLElement>('[data-quiz-secondary-list]');
      root.querySelectorAll<HTMLElement>('[data-result-secondary]').forEach((item) => {
        item.hidden = true;
      });
      if (secondaryContainer && secondaryList) {
        secondaryContainer.hidden = secondaries.length === 0;
        secondaries.forEach((key) => {
          const item = root.querySelector<HTMLElement>(`[data-result-secondary="${key}"]`);
          if (item) {
            item.hidden = false;
            secondaryList.appendChild(item);
          }
        });
      }

      showStep('result');
    }

    function resetQuiz() {
      q1Scores = {};
      q3Scores = {};
      q2Scores.clear();
      const q2Status = root.querySelector<HTMLElement>('[data-quiz-q2-status]');
      if (q2Status) q2Status.textContent = '';
      currentWinner = '';
      currentSecondaries = [];
      root.querySelectorAll<HTMLButtonElement>('[role="radio"]').forEach((radio) => {
        radio.setAttribute('aria-checked', 'false');
        setSelected(radio, false);
      });
      root.querySelectorAll<HTMLButtonElement>('[data-question="q2"]').forEach((button) => {
        button.setAttribute('aria-pressed', 'false');
        setSelected(button, false);
      });
      showStep('q1');
    }

    root.querySelector<HTMLButtonElement>('[data-quiz-restart]')?.addEventListener('click', resetQuiz);

    const emailForm = root.querySelector<HTMLFormElement>('[data-quiz-email-form]');
    const emailStatus = root.querySelector<HTMLElement>('[data-quiz-email-status]');
    const emailSubmit = root.querySelector<HTMLButtonElement>('[data-quiz-email-submit]');

    emailForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(emailForm);
      const email = String(formData.get('email') || '').trim();
      const website = String(formData.get('website') || '');

      if (!emailForm.reportValidity() || !currentWinner) return;
      if (emailStatus) emailStatus.textContent = '正在寄送…';
      if (emailSubmit) emailSubmit.disabled = true;

      try {
        const response = await fetch('/api/tool-quiz-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website, primary: currentWinner, secondary: currentSecondaries }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.message || '寄送失敗，請稍後再試。');

        if (emailStatus) emailStatus.textContent = '已寄出，請到收件匣查看；若沒看到，也請檢查垃圾郵件。';
        emailForm.reset();
      } catch (error) {
        if (emailStatus) emailStatus.textContent = error instanceof Error ? error.message : '寄送失敗，請稍後再試。';
      } finally {
        if (emailSubmit) emailSubmit.disabled = false;
      }
    });
  }
</script>
