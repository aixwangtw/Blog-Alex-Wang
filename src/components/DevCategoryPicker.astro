---
// 首屏「你想做什麼系統？」＋六個類別卡（主站首頁與服務站首頁共用，2026-10-31 取代 NeedRouter）。
// 去處規則：有可試用 Demo 的類別直接連 Demo（目前只有題庫管理系統）；其他類別開官方 LINE 聊天，
// 用 LINE URL scheme 的 oaMessage 帶入「我想做：<類別>」預填訊息（lin.ee 追蹤短網址不支援預填）。
// 不可為了填滿卡片編造案例、客戶或截圖；新增真實案例頁後，把該類別的 href 改過去。
import LineIcon from './LineIcon.astro';
import { LINKS } from '../consts';

interface Props {
  /** GA 事件的 location，區分首頁與服務站 */
  location: string;
  headingId?: string;
  kicker?: string;
}

const { location, headingId = 'dev-pick-h', kicker = '客製系統開發｜AI 導入'} = Astro.props;

const LINE_OA_ID = '@438efvtl';
const lineWithText = (category: string) =>
  `https://line.me/R/oaMessage/${LINE_OA_ID}/?${encodeURIComponent(`我想做：${category}，想先聊聊需求`)}`;
const DEMO_URL = 'https://demo-question.aixwang.dev';

const icons: Record<string, string> = {
  web: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><circle cx="6.5" cy="6.5" r=".6"/><circle cx="9" cy="6.5" r=".6"/>',
  admin: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  app: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
  bank: '<path d="M6 3h9l3 3v15H6z"/><path d="M9 10h6M9 14h6M9 18h3"/>',
  group: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M15 15.5c2.8 0 6 1.5 6 4.5"/>',
  liff: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h8"/>',
};

const categories = [
  { key: 'web', title: '網頁', href: lineWithText('網頁'), external: true },
  { key: 'admin', title: '內部管理系統', href: lineWithText('內部管理系統'), external: true },
  { key: 'app', title: 'APP', href: lineWithText('APP'), external: true },
  { key: 'bank', title: '題庫管理系統', href: DEMO_URL, external: true, label: '試用 Demo' },
  { key: 'group', title: '揪團平台', href: lineWithText('揪團平台'), external: true },
  { key: 'liff', title: 'LINE LIFF', href: lineWithText('LINE LIFF'), external: true },
];
---

<section class="dev-pick" aria-labelledby={headingId}>
  <p class="dev-pick-kicker">{kicker}</p>
  <h1 id={headingId}>你想做什麼系統？</h1>
  <p class="dev-pick-lead">題庫管理系統可以直接試用 Demo；其他類別點下去會開 LINE，訊息已經填好類別，送出就能開始聊。</p>
  <ul class="dev-pick-grid">
    {categories.map((item) => (
      <li>
        <a
          class="dev-pick-card"
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noreferrer' : undefined}
          data-ga-button={`${location}_${item.key}`}
          data-ga-label={item.title}
          data-ga-location={location}
          data-ga-action={item.external ? 'external' : 'navigate'}
        >
          <svg class="dev-pick-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[item.key]} />
          <strong>{item.title}</strong>
          <span class="dev-pick-go">{item.label ?? 'LINE 聊這個'} <span aria-hidden="true">→</span></span>
        </a>
      </li>
    ))}
  </ul>
  <div class="dev-pick-actions">
    <a class="dev-pick-btn" href={LINKS.line} target="_blank" rel="noreferrer" data-ga-button={`${location}_line`} data-ga-label="聊聊需求" data-ga-location={location} data-ga-action="external"><LineIcon class="dev-pick-btn-icon" /><span>聊聊需求</span></a>
    <p class="dev-pick-demo">不在上面的類別也可以直接聊。<strong>聊完需求可以先提供試用 Demo</strong>，試過覺得適合再簽約。</p>
  </div>
</section>

<style>
  .dev-pick { padding: clamp(28px, 5vw, 64px) 0 clamp(40px, 6vw, 72px); }
  .dev-pick-kicker { color: var(--color-accent); font-size: 13px; font-weight: 700; letter-spacing: .08em; }
  .dev-pick h1 { margin-top: 14px; font-family: var(--font-serif, serif); font-size: clamp(32px, 4.6vw, 56px); line-height: 1.2; font-weight: 600; color: var(--color-ink); }
  .dev-pick-lead { margin-top: 16px; max-width: 60ch; font-size: 16px; line-height: 1.85; color: var(--color-ink-2); }
  .dev-pick-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 28px 0 0; padding: 0; list-style: none; }
  .dev-pick-grid > li { display: flex; min-width: 0; }
  .dev-pick-card { display: flex; flex: 1; flex-direction: column; align-items: flex-start; gap: 12px; min-width: 0; min-height: 148px; padding: 20px; border: 1px solid var(--color-rule-2); border-radius: 8px; background: rgb(255 255 255 / 40%); color: var(--color-ink); text-decoration: none; transition: border-color .18s ease; }
  .dev-pick-icon { flex: none; width: 28px; height: 28px; fill: none; stroke: var(--color-accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .dev-pick-card strong { font-size: 18px; line-height: 1.35; overflow-wrap: anywhere; }
  .dev-pick-go { margin-top: auto; font-size: 14px; font-weight: 650; color: var(--color-accent); }
  @media (hover: hover) and (pointer: fine) { .dev-pick-card:hover { border-color: var(--color-accent); } }
  .dev-pick-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-top: 28px; }
  .dev-pick-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 50px; padding: 0 28px; border-radius: 6px; background: var(--color-accent); color: #fff; font-size: 17px; font-weight: 650; line-height: 1.2; white-space: nowrap; text-decoration: none; }
  :global(.dev-pick-btn-icon) { display: block; flex: none; width: 22px; height: 22px; }
  .dev-pick-demo { flex: 1 1 280px; max-width: 52ch; font-size: 15px; line-height: 1.8; color: var(--color-ink-2); }
  .dev-pick-demo strong { color: var(--color-ink); }
  @media (max-width: 767px) {
    .dev-pick-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 22px; }
    .dev-pick-card { min-height: 132px; padding: 16px 14px; gap: 10px; }
    .dev-pick-card strong { font-size: 16px; }
    .dev-pick-go { font-size: 13px; }
    .dev-pick-btn { width: 100%; }
    .dev-pick-demo { flex-basis: 100%; }
  }
  @media (max-width: 360px) {
    .dev-pick-card { padding: 14px 12px; }
    .dev-pick-card strong { font-size: 15px; }
  }
</style>
