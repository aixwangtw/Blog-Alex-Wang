---
// 用原生 <details> 呈現 FAQ：不需要 JS，且全文都在 HTML 裡，AI 爬蟲可直接讀取
interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

<div class="space-y-4">
  {faqs.map((item) => (
    <details class="group rounded-[1.5rem] border border-rule bg-surface/80 shadow-[0_8px_30px_rgba(22,22,26,0.05)] open:border-accent-line-2">
      <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-5 text-lg font-medium text-ink [&::-webkit-details-marker]:hidden">
        {item.question}
        <span class="text-ink-2 transition-transform group-open:rotate-180">▾</span>
      </summary>
      <div class="border-t border-rule px-6 pb-6 pt-4 leading-7 text-ink-2">
        {item.answer}
      </div>
    </details>
  ))}
</div>
