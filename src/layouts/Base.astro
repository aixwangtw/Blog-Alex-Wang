      /* ---------- 導覽本體：手機下拉、桌機橫排，同一組 DOM ---------- */
      .mainnav {
        order: 3;
        flex-basis: 100%;
      }
      /* 內距放在 ul 上而且不隨開合改變：這樣 panel.scrollHeight 在任何時候
         量到的都是同一個完整高度。若把內距放在會過渡的 .mainnav 上，
         JS 讀 scrollHeight 的那一瞬間內距還停在起始值，算出來的 max-height
         會短一截，最後一顆連結就被 overflow:hidden 切掉。 */
      .mainnav ul {
        padding: 8px 0 16px;
      }
      .mainnav li + li {
        border-top: 1px solid var(--color-rule);
      }
      .mainnav a {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        padding: 15px 2px;
        text-decoration: none;
        font-size: 17px;
        font-weight: 500;
        color: var(--color-ink);
        transition: color 0.18s var(--ease);
      }
      .np-go {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 12px;
        color: var(--color-accent);
      }
      /* 收合時要一起加 visibility:hidden。只有 max-height:0 的話，
         看不見的連結仍然可以被 Tab 選到，鍵盤焦點會跑進收起來的面板裡。 */
      .nav-js .mainnav {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        transition:
          max-height 0.3s var(--ease),
          opacity 0.3s var(--ease),
