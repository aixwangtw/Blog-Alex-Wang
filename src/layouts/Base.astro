      .ft-copy {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 11.5px;
      }
      .ft-legal {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 18px;
      }
      .ft-legal a {
        color: var(--color-ink-3);
        text-decoration: none;
      }

      /* ============================================================
         hover 一律加裝置條件：觸控裝置上 :hover 會「黏住」，
         點過的元件會停在 hover 狀態直到點別的地方。
         :focus-visible 另外寫一份、不設任何條件（見 global.css）。
         ============================================================ */
      @media (hover: hover) and (pointer: fine) {
        .hicon:hover {
          color: var(--color-accent);
          border-color: var(--color-accent);
          background: var(--color-accent-tint);
        }
        .hd-cue:hover {
          border-color: var(--color-ink);
        }
        /* jisto 的開關 hover：兩條線縮到 10px、旋轉 ±45°，往中線收成小 ✕ */
        .hd-cue:hover .hd-cue-b i {
          width: 10px;
          top: 3.85px;
        }
        .hd-cue:hover .hd-cue-b i:nth-child(1) {
          transform: rotate(45deg);
        }
        .hd-cue:hover .hd-cue-b i:nth-child(2) {
          transform: rotate(-45deg);
        }
        /* 已展開時 hover 維持完整 ✕，不要縮回 10px */
        .hd-cue[aria-expanded='true']:hover .hd-cue-b i {
          width: 15px;
        }
        .mainnav a:hover,
        .hd-mark:hover,
        .ft-list a:hover,
        .ft-legal a:hover {
          color: var(--color-accent);
        }
        .search-ex button:hover {
          background: var(--color-paper-2);
        }
      }

      /* 圖示的文字滑出只在 ≥768px 生效。
         實測 320px 下頁首只剩 280px 淨寬，字標 62 ＋ 四顆圖示 175 已經用掉 237px；
         再展開 68px 的「LINE 諮詢」會直接把字標擠出容器（橫向溢出）。
         小螢幕上圖示維持 42px 圓形，可讀名稱由 aria-label 提供。 */
      @media (min-width: 768px) {
        @media (hover: hover) and (pointer: fine) {
          .hicon--line:hover {
            grid-template-columns: 18px 68px;
          }
          .hicon--mail:hover {
            grid-template-columns: 18px 46px;
          }
        }
        .hicon--line:focus-visible {
          grid-template-columns: 18px 68px;
        }
        .hicon--mail:focus-visible {
          grid-template-columns: 18px 46px;
        }
      }

      /* 鍵盤焦點：不靠 hover 也要有等價的視覺回饋（不設裝置條件） */
      .hicon:focus-visible {
        color: var(--color-accent);
        border-color: var(--color-accent);
        background: var(--color-accent-tint);
      }
      .mainnav a:focus-visible {
        color: var(--color-accent);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .site-header,
        .hicon,
        .hd-cue,
        .hd-cue-b i,
        .mainnav,
        .hd-mark-t {
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
