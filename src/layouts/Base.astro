---
import { findMarkdownAlternate } from '../lib/agent-docs';
import SiteHeader from '../components/SiteHeader.astro';
import FloatingLine from '../components/FloatingLine.astro';
import LineIcon from '../components/LineIcon.astro';
import ogBanner from '../assets/banner-v2.png';
import lineBrandIcon from '../assets/line-brand-icon.png';
import { COLLABORATION_ENTRY_LINKS, FREE_ENTRY_LINKS, GUIDED_ENTRY_LINKS, LEARNING_ENTRY_LINKS, LINKS, PERSON_SCHEMA, SERVICE_SITE, SITE, COURSE_SERVICE_URL, SPEAKING_SERVICE_URL, LINE_CONSULT_LABEL, SECTION_NAMES, DEVELOPMENT_SERVICE, GA_MEASUREMENT_ID, DEMO_HOSTNAMES } from '../consts';
import '../styles/global.css';
import '../styles/site-chrome.css';

// 頁尾導覽：分組與頂部導覽列同一套分類（文章／領取／服務／關於），每組列出常用的下一層連結
const FOOTER_NAV = [
  {
    label: '文章',
    links: [
      { href: '/blog/', label: '全部文章' },
      { href: '/blog/custom-system-development-demo/', label: '系統開發費用與 Demo' },
      { href: DEVELOPMENT_SERVICE.caseArticle, label: '題庫系統案例' },
      { href: '/blog/vibecoding-tutorial/', label: 'Vibecoding 一對一教學' },
      { href: '/blog/claude-code-install/', label: 'Claude Code 安裝教學' },
      { href: '/faq/', label: '常見問題' },
    ],
  },
  {
    label: SECTION_NAMES.openSource,
    links: [
      { href: '/resources/', label: '免費資源' },
      { href: '/blog/feedback-desk/', label: 'feedback-desk PM溝通工具' },
    ],
  },
  {
    label: '服務',
    links: [
      { href: `${SERVICE_SITE.url}/services/development/`, label: '客製系統開發' },
      { href: `${SERVICE_SITE.url}/`, label: '服務總覽' },
      { href: COURSE_SERVICE_URL, label: '一對一教學' },
      { href: SPEAKING_SERVICE_URL, label: '演講邀約' },
    ],
  },
  {
    label: '關於',
    links: [
      { href: '/about/', label: '關於 Alex' },
      { href: '/', label: '首頁' },
    ],
  },
];

interface Props {
  title: string;
  description: string;
  /** 頁面專屬的 JSON-LD（Article、Service、FAQPage 等），會與全站 Person 一起輸出 */
  schema?: object[];
  ogType?: string;
  /** 社群分享預覽圖，預設用全站橫幅 */
  ogImage?: string;
  /** og:image 的像素尺寸與替代文字；自訂 ogImage（文章橫幅固定 1200×630）時沿用預設即可 */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  /** 不公開頁面：禁止搜尋引擎索引（unlisted 文章用） */
  noindex?: boolean;
}

const {
  title,
  description,
  schema = [],
  ogType = 'website',
  noindex = false,
  ogImage: pageOgImage,
  ogImageWidth = pageOgImage ? 1200 : ogBanner.width,
  ogImageHeight = pageOgImage ? 630 : ogBanner.height,
  ogImageAlt = title,
} = Astro.props;
const ogImage = pageOgImage ?? new URL(ogBanner.src, SITE.url).href;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 主要頁面有 Markdown 版（給 AI 讀），用 <link rel="alternate"> 指過去；對照表在 src/lib/agent-docs.ts
const markdownAlternate = findMarkdownAlternate(canonical.href);
const serviceHostname = new URL(SERVICE_SITE.url).hostname;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.title,
      alternateName: [SITE.titleEn, 'aixwang'],
      url: SITE.url,
      description: SITE.description,
      inLanguage: SITE.locale,
      publisher: { '@id': PERSON_SCHEMA['@id'] },
    },
    PERSON_SCHEMA,
    ...schema,
  ],
};
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <script is:inline define:vars={{ serviceHostname }}>
      // 內容站頁面若被共用 Worker 從服務子網域打開，不顯示內容站的學習入口。
      if (window.location.hostname === serviceHostname) {
        document.documentElement.classList.add('service-subdomain');
      }
    </script>
    <!-- Google Analytics（GA4）流量統計：gtag.js 延到頁面載入完才注入，避免佔用首次渲染的主執行緒；
         事件在此之前先排入 dataLayer，載入後照樣送出。
         noindex 頁面（草稿／不公開頁）完全不輸出 GA 腳本，不會被統計 -->
    {!noindex && <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID, mainHostname: new URL(SITE.url).hostname, demoHostnames: DEMO_HOSTNAMES }}>
      // 只統計正式網站；localhost、區域網路 IP 與其他預覽網址完全不載入 GA4。
      // 自用裝置開一次 ?analytics=off 會寫入跨子網域 Cookie；?analytics=on 可恢復。
      // 一般不執行 JavaScript 的爬蟲本來就不會送 GA；自動化瀏覽器則額外排除。
      var analyticsHosts = [mainHostname, 'www.' + mainHostname];
      var analyticsControl = new URLSearchParams(window.location.search).get('analytics');
      if (analyticsControl === 'off') {
        document.cookie = 'aixwang_ga_opt_out=1; Max-Age=315360000; Path=/; Domain=.aixwang.dev; SameSite=Lax; Secure';
      } else if (analyticsControl === 'on') {
        document.cookie = 'aixwang_ga_opt_out=; Max-Age=0; Path=/; Domain=.aixwang.dev; SameSite=Lax; Secure';
      }
      if (analyticsControl === 'off' || analyticsControl === 'on' || analyticsControl === 'status') {
        var cleanAnalyticsUrl = new URL(window.location.href);
        cleanAnalyticsUrl.searchParams.delete('analytics');
        window.history.replaceState({}, '', cleanAnalyticsUrl.pathname + cleanAnalyticsUrl.search + cleanAnalyticsUrl.hash);
      }
      var analyticsOptedOut = /(?:^|;\s*)aixwang_ga_opt_out=1(?:;|$)/.test(document.cookie);
      var analyticsAutomation = navigator.webdriver === true || /HeadlessChrome|Playwright|Puppeteer|Selenium|Aixwang[^\s]*Bot/i.test(navigator.userAgent);
      if (analyticsControl === 'status') {
        document.addEventListener('DOMContentLoaded', function () {
          var disabled = analyticsOptedOut || analyticsAutomation;
          var notice = document.createElement('div');
          var copy = document.createElement('span');
          var title = document.createElement('strong');
          var detail = document.createElement('small');
          var close = document.createElement('button');
          notice.setAttribute('role', 'status');
          notice.setAttribute('aria-live', 'polite');
          notice.style.cssText = 'position:fixed;z-index:2147483647;top:max(16px,env(safe-area-inset-top));left:50%;display:flex;width:min(440px,calc(100vw - 32px));transform:translateX(-50%);align-items:center;gap:14px;padding:14px 16px;border:1px solid ' + (disabled ? '#78b894' : '#d38b8b') + ';border-radius:6px;background:#171615;color:#fff;box-shadow:0 16px 48px rgba(0,0,0,.28);font-family:system-ui,-apple-system,sans-serif';
          copy.style.cssText = 'display:grid;min-width:0;flex:1;gap:3px';
          title.style.cssText = 'font-size:15px;line-height:1.4;color:' + (disabled ? '#91d6ae' : '#ffb3b3');
          detail.style.cssText = 'font-size:12px;line-height:1.55;color:#d4d0cc';
          close.type = 'button';
          close.setAttribute('aria-label', '關閉 GA4 狀態提示');
          close.textContent = '×';
          close.style.cssText = 'width:34px;height:34px;padding:0;border:1px solid #5b5753;border-radius:50%;background:transparent;color:#fff;font-size:20px;cursor:pointer';
          title.textContent = disabled ? '✓ GA4：已排除' : '● GA4：仍在統計';
          detail.textContent = analyticsOptedOut
            ? '這個瀏覽器已設定排除，不會送出 GA4 資料。'
            : analyticsAutomation
              ? '已辨識為自動化瀏覽器，不會送出 GA4 資料。'
              : '這個瀏覽器目前會送出 GA4 資料。';
          close.addEventListener('click', function () { notice.remove(); });
          copy.append(title, detail);
          notice.append(copy, close);
          document.body.appendChild(notice);
        });
      }
      if (analyticsHosts.indexOf(window.location.hostname) !== -1 && !analyticsOptedOut && !analyticsAutomation) {
        var preconnect = document.createElement('link');
        preconnect.rel = 'preconnect';
        preconnect.href = 'https://www.googletagmanager.com';
        preconnect.crossOrigin = 'anonymous';
        document.head.appendChild(preconnect);

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        var gaConfig = {};
        try {
          var gaUrl = new URL(window.location.href);
          if (gaUrl.searchParams.get('s') === 'line') {
            gaUrl.searchParams.delete('s');
            gaConfig = { campaign_source: 'line', campaign_medium: 'social', campaign_name: 'article_share', page_location: gaUrl.href };
            window.gtag('config', gaId, gaConfig);
            window.history.replaceState(window.history.state, '', gaUrl.pathname + gaUrl.search + gaUrl.hash);
            gaConfig = null;
          }
        } catch (e) {}
        if (gaConfig) window.gtag('config', gaId);

        window.addEventListener('load', function () {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        });

        // 今日新增的互動入口統一送 button_click，以參數區分按鈕、位置與動作。
        // 搜尋文字會先在瀏覽器遮罩 Email、電話、URL 與帳號，再以 search_term 送出。
        function redactSearchTerm(value) {
          return String(value || '')
            .replace(/\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b/gi, '[email]')
            .replace(/https?:\/\/\S+|www\.\S+/gi, '[url]')
            .replace(/(^|\s)@[a-z0-9._-]+/gi, '$1[account]')
            .replace(/(?:\+?\d[\d\s().-]{7,}\d)/g, '[phone]')
            .replace(/\s+/g, ' ')
            .trim()
            .slice(0, 100);
        }

        function trackButton(control) {
          if (!control) return;
          var label = control.getAttribute('data-ga-label') || control.textContent || '';
          var destination = control.href || control.getAttribute('data-copy-repo') || '';
          var parameters = {
            button_id: control.getAttribute('data-ga-button') || control.getAttribute('data-ga-submit') || 'unknown',
            button_label: label.replace(/\s+/g, ' ').trim().slice(0, 100),
            button_location: control.getAttribute('data-ga-location') || 'unknown',
            button_action: control.getAttribute('data-ga-action') || 'click',
            destination_url: destination,
            page_path: location.pathname,
          };
          window.gtag('event', 'button_click', parameters);
          // GA4 未註冊 button_id 自訂維度時，button_click 只能看總次數。
          // 另送 btn_<id> 原生事件，事件名稱最長 40 字元，可直接在事件報表看單顆次數。
          var buttonEventName = ('btn_' + parameters.button_id).replace(/[^a-zA-Z0-9_]/g, '_').slice(0, 40);
          window.gtag('event', buttonEventName, {
            button_label: parameters.button_label,
            button_location: parameters.button_location,
            page_path: parameters.page_path,
          });
          // 同步寫入 Directus，讓 CMS 能直接查看每顆按鈕的點擊明細與次數。
          // 不送搜尋文字、Email、IP 或 Cookie，只送畫面上既有的按鈕中繼資料。
          var cmsPayload = JSON.stringify(parameters);
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/button-click', new Blob([cmsPayload], { type: 'application/json' }));
          } else {
            fetch('/api/button-click', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: cmsPayload,
              keepalive: true,
            }).catch(function () {});
          }
        }

        // 文章內文（.prose-blog）的連結點擊：送 article_link_click；Demo 站另送 demo_click。
        // 回傳共用參數，讓 line_click 等既有事件也能帶上「文章內文第幾個連結」。
        function trackArticleBodyLink(a) {
          var body = a.closest && a.closest('.prose-blog');
          if (!body) return null;
          var links = Array.prototype.slice.call(body.querySelectorAll('a[href]'));
          var heading = '';
          var headings = body.querySelectorAll('h2, h3');
          for (var i = 0; i < headings.length; i += 1) {
            // DOCUMENT_POSITION_FOLLOWING：連結在這個標題之後，標題就是目前所在章節
            if (headings[i].compareDocumentPosition(a) & 4) heading = headings[i].textContent || '';
          }
          var text = (a.textContent || '').replace(/\s+/g, ' ').trim();
          if (!text) {
            var image = a.querySelector('img');
            text = image ? '[圖片] ' + (image.getAttribute('alt') || '') : '';
          }
          var host = '';
          try { host = new URL(a.href, location.href).hostname; } catch (error) {}
          var parameters = {
            link_url: a.href || '',
            link_domain: host,
            link_text: text.slice(0, 100),
            link_index: links.indexOf(a) + 1,
            link_location: 'article_body',
            section_heading: heading.replace(/\s+/g, ' ').trim().slice(0, 100),
            page_path: location.pathname,
          };
          window.gtag('event', 'article_link_click', parameters);
          return parameters;
        }


        // Demo → 聊聊需求 轉換追蹤：點過題庫 Demo 就記一個旗標（不含個資），之後每次 LINE 事件帶 after_demo。
        // 旗標寫成 .aixwang.dev 共用 Cookie（主站與服務站 localStorage 不互通），並同步寫 localStorage 當備援；讀寫都包 try/catch。
        function hasClickedDemo() {
          try { if (/(?:^|;\s*)aixwang_demo_clicked=1(?:;|$)/.test(document.cookie)) return true; } catch (e) {}
          try { if (window.localStorage.getItem('aixwang_demo_clicked') === '1') return true; } catch (e) {}
          return false;
        }
        function markDemoClicked() {
          try { document.cookie = 'aixwang_demo_clicked=1; Max-Age=15552000; Path=/; Domain=.aixwang.dev; SameSite=Lax; Secure'; } catch (e) {}
          try { window.localStorage.setItem('aixwang_demo_clicked', '1'); } catch (e) {}
        }
        function isDemoHref(href) {
          try { return demoHostnames.indexOf(new URL(href, location.href).hostname) !== -1; } catch (e) { return false; }
        }
        function isLineHref(href) {
          return href.indexOf('line.me') !== -1 || href.indexOf('lin.ee') !== -1;
        }
        function trackDemoLink(a, control, extra) {
          window.gtag('event', 'demo_click', Object.assign({
            link_url: a.href || '',
            button_id: control ? control.getAttribute('data-ga-button') || 'unknown' : 'none',
            demo_location: control ? control.getAttribute('data-ga-location') || 'unknown' : 'other',
            page_path: location.pathname,
          }, extra || {}));
          markDemoClicked();
        }

        // 自訂事件：追蹤按鈕與關鍵轉換點擊（LINE 諮詢 / YouTube）
        document.addEventListener('click', function (e) {
          var control = e.target.closest && e.target.closest('[data-ga-button]');
          if (control) trackButton(control);

          var a = e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          var href = a.href || '';
          // 文章內文連結（CMS markdown 渲染，無法逐顆加 data-ga-button）：一律送 article_link_click，
          // 帶目標網域、連結文字、第幾個連結、所在章節，才分得出是哪一顆被點。
          var bodyLink = trackArticleBodyLink(a);
          // LINE 連結有兩種網域：line.me（加好友網址）與 lin.ee（LINE 後台的追蹤短網址）。
          // 帶 data-ga-button 的按鈕點了 LINE 連結時，上面先送 button_click，這裡再補送 line_click。
          // 文章內文的 LINE 連結另帶 link_location／link_index／section_heading，跟頁首、文末 CTA 的分開。
          if (isDemoHref(href)) {
            trackDemoLink(a, control, bodyLink);
          } else if (isLineHref(href)) {
            window.gtag('event', 'line_click', Object.assign(
              { link_url: href, page_path: location.pathname, link_location: control ? control.getAttribute('data-ga-location') || 'button' : 'other', button_id: control ? control.getAttribute('data-ga-button') || 'unknown' : 'none', after_demo: hasClickedDemo() },
              bodyLink || {}
            ));
          } else if (href.indexOf('/course') !== -1) {
            window.gtag('event', 'one_on_one_click', { link_url: href, page_path: location.pathname });
          } else if (href.indexOf('/services/speaking') !== -1) {
            window.gtag('event', 'speaking_click', { link_url: href, page_path: location.pathname });
          } else if (href.indexOf('youtube.com') !== -1 || href.indexOf('youtu.be') !== -1) {
            window.gtag('event', 'youtube_click', { link_url: href, page_path: location.pathname });
          }
        });

        // 透過 submit 追蹤搜尋送出，點箭頭與按 Enter 只會各記一次。
        document.addEventListener('submit', function (e) {
          var form = e.target.closest && e.target.closest('form[data-ga-submit]');
          if (!form) return;
          var inputSelector = form.getAttribute('data-ga-input');
          var input = inputSelector ? document.querySelector(inputSelector) : null;
          if (inputSelector && (!input || !input.value.trim())) return;
          trackButton(form);
          if (input) {
            window.gtag('event', 'view_search_results', {
              search_term: redactSearchTerm(input.value),
              search_location: form.getAttribute('data-ga-location') || 'unknown',
              input_length: input.value.trim().length,
              page_path: location.pathname,
            });
          }
        });
      }
    </script>}

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- 允許 Google 搜尋／Discover 使用大圖預覽；unlisted 頁面則完全禁止索引 -->
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'max-image-preview:large'} />
    <link rel="icon" type="image/png" sizes="any" href="/favicon.png?v=2" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/aixwang-icon.png" />
    <link rel="canonical" href={canonical} />
    {markdownAlternate && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <!-- 底色維持純色紙感（原型 home-b4-lean.html 的 body 就是 background:var(--paper)）。
       改版前這裡有兩道 radial-gradient 粉色暈染，跟髮絲線列的版面語言互相干擾：
       髮絲線靠的是「線在乾淨紙上」的對比，底下有漸層時線的視覺重量會隨位置浮動。 -->
  <body
    data-pagefind-ignore={noindex ? 'all' : undefined}
    class="min-h-screen bg-paper font-display text-ink antialiased"
  >
    <a class="skip-link" href="#main">跳到主要內容</a>

    <SiteHeader showSearch />

    <FloatingLine />

    <div class="search-chatbot" id="search-chatbot">
      <section class="search-chat-panel" id="search-chat-panel" role="dialog" aria-label="客服：加 LINE 詢問、學習入口與站內搜尋" hidden>
        <div class="search-chat-bar">
          <span class="search-chat-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <b>客服</b>
          <button
            id="search-chat-close"
            type="button"
            aria-label="關閉客服"
            data-ga-button="search_chat_close"
            data-ga-label="關閉問答視窗"
            data-ga-location="search_chat"
            data-ga-action="close"
          >×</button>
        </div>
        <div class="search-chat-screen">
          <a
            class="search-chat-line"
            href={LINKS.line}
            target="_blank"
            rel="noreferrer"
            data-ga-button="search_chat_line"
            data-ga-label="加官方 LINE 詢問"
            data-ga-location="search_chat"
            data-ga-action="contact"
          >
            <img src={lineBrandIcon.src} width="40" height="40" alt="LINE" />
            <span><small>想直接問我或團隊？</small><b>加官方 LINE 詢問</b></span>
            <i aria-hidden="true">→</i>
          </a>
          <div class="search-chat-dialog">
            <p>你現在想做哪一件事？</p>
          </div>
          <div class="search-chat-tabs" role="tablist" aria-label="選擇需求">
            <button id="search-tab-collaborate" type="button" role="tab" aria-selected="true" aria-controls="search-panel-collaborate" data-search-radar-tab="collaborate" data-ga-button="search_radar_tab_collaborate" data-ga-label="邀合作" data-ga-location="search_chat" data-ga-action="switch_tab">找人開發或邀講</button>
            <button id="search-tab-learn" type="button" role="tab" aria-selected="false" aria-controls="search-panel-learn" data-search-radar-tab="learn" data-ga-button="search_radar_tab_learn" data-ga-label="自己學" data-ga-location="search_chat" data-ga-action="switch_tab" tabindex="-1">自己學 AI 工具</button>
            <button id="search-tab-guided" type="button" role="tab" aria-selected="false" aria-controls="search-panel-guided" data-search-radar-tab="guided" data-ga-button="search_radar_tab_guided" data-ga-label="找人帶" data-ga-location="search_chat" data-ga-action="switch_tab" tabindex="-1">請人手把手教</button>
            <button id="search-tab-free" type="button" role="tab" aria-selected="false" aria-controls="search-panel-free" data-search-radar-tab="free" data-ga-button="search_radar_tab_free" data-ga-label="找免費" data-ga-location="search_chat" data-ga-action="switch_tab" tabindex="-1">先找免費資源</button>
          </div>
          <div id="search-panel-learn" class="search-chat-tab-panel" role="tabpanel" aria-labelledby="search-tab-learn" data-search-radar-panel="learn" hidden>
            <nav class="search-chat-entries" aria-label="自己學 AI 工具">
              {LEARNING_ENTRY_LINKS.map((entry, index) => (
                <a href={entry.href} data-ga-button={`search_chat_entry_${entry.analyticsKey}`} data-ga-label={entry.analyticsLabel} data-ga-location="search_chat" data-ga-action="navigate"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span><strong>{entry.title}</strong><small>{entry.description}</small></span><i aria-hidden="true">↗</i></a>
              ))}
            </nav>
          </div>
          <div id="search-panel-guided" class="search-chat-tab-panel" role="tabpanel" aria-labelledby="search-tab-guided" data-search-radar-panel="guided" hidden>
            <nav class="search-chat-entries" aria-label="請人手把手教">
              {GUIDED_ENTRY_LINKS.map((entry, index) => (
                <a href={entry.href} data-ga-button={`search_chat_entry_${entry.analyticsKey}`} data-ga-label={entry.analyticsLabel} data-ga-location="search_chat" data-ga-action="navigate"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span><strong>{entry.title}</strong><small>{entry.description}</small></span><i aria-hidden="true">↗</i></a>
              ))}
            </nav>
          </div>
          <div id="search-panel-collaborate" class="search-chat-tab-panel" role="tabpanel" aria-labelledby="search-tab-collaborate" data-search-radar-panel="collaborate">
            <nav class="search-chat-entries" aria-label="找人開發或邀講">
              {COLLABORATION_ENTRY_LINKS.map((entry, index) => (
                <a href={entry.href} data-ga-button={`search_chat_entry_${entry.analyticsKey}`} data-ga-label={entry.analyticsLabel} data-ga-location="search_chat" data-ga-action="navigate"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span><strong>{entry.title}</strong><small>{entry.description}</small></span><i aria-hidden="true">↗</i></a>
              ))}
            </nav>
          </div>
          <div id="search-panel-free" class="search-chat-tab-panel" role="tabpanel" aria-labelledby="search-tab-free" data-search-radar-panel="free" hidden>
            <nav class="search-chat-entries" aria-label="先找免費資源">
              {FREE_ENTRY_LINKS.map((entry, index) => (
                <a href={entry.href} data-ga-button={`search_chat_entry_${entry.analyticsKey}`} data-ga-label={entry.analyticsLabel} data-ga-location="search_chat" data-ga-action="navigate"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span><strong>{entry.title}</strong><small>{entry.description}</small></span><i aria-hidden="true">↗</i></a>
              ))}
            </nav>
          </div>
          <div class="search-chat-results" id="search-results" aria-live="polite" hidden></div>
          <!-- 問句對上站內 FAQ 時，複製這個樣板顯示答案原文與原頁連結（public/faq-match.js 負責比對）。
               題目、答案、出處一律用 textContent 填入，不解析 HTML。 -->
          <template id="search-chat-faq-template">
            <article class="search-chat-faq">
              <p class="search-chat-faq-label">常見問題</p>
              <h3 class="search-chat-faq-question"></h3>
              <p class="search-chat-faq-answer"></p>
              <a
                class="search-chat-faq-link"
                href="/faq/"
                data-ga-button="search_chat_faq_link"
                data-ga-label="常見問題"
                data-ga-location="search_chat"
                data-ga-action="open_faq"
              ><span>看完整說明</span><small></small><i aria-hidden="true">→</i></a>
            </article>
          </template>
        </div>
      </section>
    </div>

    <script is:inline>

      (function () {
        // 右下角站內搜尋：只查本站索引，不連接外部服務。
        var container = document.getElementById('search-chatbot');
        if (document.documentElement.classList.contains('service-subdomain')) {
          if (container) container.remove();
          return;
        }
        // 輸入框在頁首（logo 旁），面板從輸入框下方展開；輸入的字直接拿去跑面板的站內搜尋
        var suppressOpen = false;
        // 窄螢幕（<360px）輸入框只剩約 100px，提示文字縮短才不會被截成半句
        var shortPlaceholder = window.matchMedia('(max-width: 359px)');
        function syncPlaceholder() {
          if (input) input.placeholder = shortPlaceholder.matches ? '搜尋…' : '搜尋文章、常見問題…';
        }
        var panel = document.getElementById('search-chat-panel');
        var closeButton = document.getElementById('search-chat-close');
        var form = document.getElementById('search-chat-form');
        var input = document.getElementById('site-search');
        var box = document.getElementById('search-results');
        var radarTabs = container ? Array.from(container.querySelectorAll('[data-search-radar-tab]')) : [];
        var radarPanels = container ? Array.from(container.querySelectorAll('[data-search-radar-panel]')) : [];
        var pagefind = null;
        var pagefindPromise = null;
        var fallbackIndex = null;
        var faqTemplate = document.getElementById('search-chat-faq-template');
        var faqMatcher = null;
        var faqMatcherPromise = null;
        var searchSequence = 0;
        var activeResult = -1;
        function activateRadarTab(key, moveFocus) {
          radarTabs.forEach(function (tab) {
            var selected = tab.getAttribute('data-search-radar-tab') === key;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;
            if (selected && moveFocus) tab.focus();
          });
          radarPanels.forEach(function (radarPanel) {
            radarPanel.hidden = radarPanel.getAttribute('data-search-radar-panel') !== key;
          });
        }
        radarTabs.forEach(function (tab, index) {
          tab.addEventListener('click', function () {
            activateRadarTab(tab.getAttribute('data-search-radar-tab'), false);
          });
          tab.addEventListener('keydown', function (event) {
            var nextIndex = index;
            if (event.key === 'ArrowRight') nextIndex = (index + 1) % radarTabs.length;
            else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + radarTabs.length) % radarTabs.length;
            else if (event.key === 'Home') nextIndex = 0;
            else if (event.key === 'End') nextIndex = radarTabs.length - 1;
            else return;
            event.preventDefault();
            activateRadarTab(radarTabs[nextIndex].getAttribute('data-search-radar-tab'), true);
          });
        });
        function placePanel() {
          // 桌機：面板左緣對齊輸入框、頂端貼在輸入框下方；手機由 CSS 改成全寬
          var anchor = form ? form.getBoundingClientRect() : null;
          if (!anchor || !panel) return;
          panel.style.setProperty('--panel-left', Math.max(12, anchor.left) + 'px');
          panel.style.setProperty('--panel-top', Math.round(anchor.bottom + 10) + 'px');
        }
        function openSearch() {
          if (!panel) return;
          panel.hidden = false;
          document.body.classList.add('search-chat-open');
          placePanel();
          // 手機導覽選單若開著（開關按鈕看得到才是手機版；桌機版 aria-expanded 恆為 true），先收起來，免得面板疊在選單上
          var navCue = document.getElementById('nav-cue');
          if (navCue && navCue.offsetParent !== null && navCue.getAttribute('aria-expanded') === 'true') navCue.click();
          if (input && document.activeElement !== input) window.setTimeout(function () { input.focus(); }, 0);
        }
        function closeSearch() {
          if (panel) panel.hidden = true;
          document.body.classList.remove('search-chat-open');
        }
        function loadFallback() {
          if (fallbackIndex) return Promise.resolve(fallbackIndex);
          return fetch('/search-index.json')
            .then(function (r) { return r.json(); })
            .then(function (d) { fallbackIndex = d; return d; });
        }
        function loadPagefind() {
          if (pagefind) return Promise.resolve(pagefind);
          if (pagefindPromise) return pagefindPromise;
          pagefindPromise = new Function('return import("/pagefind/pagefind.js")')()
            .then(function (module) {
              pagefind = module;
              return pagefind.init().then(function () { return pagefind; });
            })
            .catch(function () {
              pagefind = null;
              pagefindPromise = null;
              return null;
            });
          return pagefindPromise;
        }
        // FAQ 比對器與索引只在使用者點進輸入框時才載入；任一個失敗就當作沒有 FAQ，照原本流程搜尋文章。
        function loadFaqMatcher() {
          if (faqMatcher) return Promise.resolve(faqMatcher);
          if (faqMatcherPromise) return faqMatcherPromise;
          faqMatcherPromise = Promise.all([
            new Function('return import("/faq-match.js")')(),
            fetch('/faq-index.json').then(function (r) {
              if (!r.ok) throw new Error('faq-index ' + r.status);
              return r.json();
            }),
          ])
            .then(function (loaded) {
              var module = loaded[0];
              var index = module.buildFaqIndex(loaded[1]);
              faqMatcher = function (query) { return module.matchFaq(index, query); };
              return faqMatcher;
            })
            .catch(function () {
              faqMatcherPromise = null;
              return null;
            });
          return faqMatcherPromise;
        }
        function findFaq(query) {
          return loadFaqMatcher().then(function (matcher) {
            if (!matcher) return null;
            try {
              var match = matcher(query);
              return match ? match.item : null;
            } catch (error) {
              return null;
            }
          });
        }
        // 只接受站內路徑或本站子網域的連結，避免索引資料異常時塞進 javascript: 之類的網址
        function safeFaqUrl(url) {
          var value = String(url || '');
          if (/^\/(?!\/)/.test(value) || /^https:\/\/([a-z0-9-]+\.)*aixwang\.dev\//.test(value)) return value;
          return '/faq/';
        }
        function buildFaqCard(faq) {
          if (!faqTemplate || !faqTemplate.content) return null;
          var card = faqTemplate.content.firstElementChild.cloneNode(true);
          card.querySelector('.search-chat-faq-question').textContent = faq.q;
          card.querySelector('.search-chat-faq-answer').textContent = faq.a;
          var link = card.querySelector('.search-chat-faq-link');
          link.setAttribute('href', safeFaqUrl(faq.u));
          link.setAttribute('data-ga-label', String(faq.q || '').slice(0, 100));
          link.querySelector('small').textContent = faq.p ? '出自：' + faq.p : '';
          if (/^https?:/.test(link.getAttribute('href'))) link.setAttribute('rel', 'noreferrer');
          return card;
        }
        function escapeHtml(value) {
          return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }
        function render(list, faq) {
          activeResult = list.length ? 0 : -1;
          box.hidden = false;
          var faqCard = faq ? buildFaqCard(faq) : null;
          if (faqCard) {
            box.replaceChildren(faqCard);
            if (list.length) box.insertAdjacentHTML('beforeend', '<p class="search-chat-faq-more">相關文章</p>');
          } else {
            box.replaceChildren();
          }
          if (!list.length) {
            if (!faqCard) box.innerHTML = '<p class="search-chat-empty">找不到符合的文章，請換個關鍵字再問一次。</p>';
          } else {
            box.insertAdjacentHTML('beforeend', list
              .slice(0, 5)
              .map(function (item, index) {
                return '<a href="' + escapeHtml(item.u) + '" data-search-result="' + index + '" data-ga-button="search_chat_result" data-ga-label="' + escapeHtml(item.t) + '" data-ga-location="search_chat" data-ga-action="open_result" class="search-chat-result ' + (index === 0 ? 'is-active' : '') + '">' +
                  '<strong>' + escapeHtml(item.t) + '</strong>' +
                  (item.d ? '<span>' + item.d + '</span>' : '') +
                  '</a>';
              })
              .join(''));
          }
        }
        // 按 Enter／送出時把結果捲到看得到的位置（手機上結果在入口清單下方，不捲就看不到 FAQ 答案）
        function revealResults() {
          var screen = box.closest('.search-chat-screen');
          if (!screen || box.hidden) return;
          screen.scrollTop += box.getBoundingClientRect().top - screen.getBoundingClientRect().top - 8;
        }
        function updateActiveResult() {
          box.querySelectorAll('.search-chat-result').forEach(function (item, index) {
            item.classList.toggle('is-active', index === activeResult);
          });
        }
        // search-index.json 的比對與排序（文章與服務站頁面一起）。
        // Pagefind 對中文詞（例如「題庫」）切詞不準，會漏掉標題明明有這個詞的文章，所以這裡用子字串補上，
        // 排在 Pagefind 結果前面。服務站頁面不在 Pagefind 裡，只能靠這裡找到。
        // 分數：標題含搜尋字、或服務頁的主要關鍵字命中＝100；次要關鍵字或文章標籤命中＝60；描述命中＝40。
        // 同分時服務頁在前、文章依索引順序（新到舊）。「某個關鍵字出現在搜尋字裡」也算命中（例如「我想找一對一課程」）。
        function scoreItem(item, q) {
          var title = item.t.toLowerCase();
          var primary = (item.s ? item.g : '').toLowerCase().split(' ').filter(function (w) { return w.length > 1; });
          var secondary = ((item.s ? item.g2 || '' : item.g) || '').toLowerCase().split(' ').filter(function (w) { return w.length > 1; });
          function hits(words) {
            return words.some(function (w) { return w.indexOf(q) !== -1 || q.indexOf(w) !== -1; });
          }
          if (title.indexOf(q) !== -1 || hits(primary)) return 100;
          if (hits(secondary)) return 60;
          if (item.d.toLowerCase().indexOf(q) !== -1) return 40;
          return 0;
        }
        function findPages(query) {
          var q = query.toLowerCase();
          return loadFallback().then(function (items) {
            return items.map(function (item, index) {
              return { item: item, score: scoreItem(item, q), index: index };
            }).filter(function (entry) {
              return entry.score > 0;
            }).sort(function (a, b) {
              return b.score - a.score || (b.item.s ? 1 : 0) - (a.item.s ? 1 : 0) || a.index - b.index;
            }).map(function (entry) {
              return { u: entry.item.u, t: entry.item.t, d: escapeHtml(entry.item.d) };
            });
          }).catch(function () { return []; });
        }
        function searchFallback(query, sequence, faqPromise, reveal) {
          return Promise.all([loadFallback(), faqPromise]).then(function (loaded) {
            if (sequence !== searchSequence) return;
            var items = loaded[0];
            var q = query.toLowerCase();
            render(items
              .filter(function (item) {
                return (item.t + item.d + item.g).toLowerCase().indexOf(q) !== -1;
              })
              .map(function (item) {
                return { u: item.u, t: item.t, d: escapeHtml(item.d) };
              }), loaded[1]);
            if (reveal) revealResults();
          });
        }
        function executeSearch(query, reveal) {
          var sequence = ++searchSequence;
          var faqPromise = findFaq(query);
          var pagesPromise = findPages(query);
          box.replaceChildren();
          loadPagefind().then(function (engine) {
            if (!engine) return searchFallback(query, sequence, faqPromise, reveal);
            return engine.search(query).then(function (search) {
              return Promise.all(search.results.slice(0, 8).map(function (result) {
                return result.data();
              }));
            }).then(function (results) {
              return Promise.all([faqPromise, pagesPromise]).then(function (loaded) {
                var faq = loaded[0];
                var pages = loaded[1];
                if (!results || sequence !== searchSequence) return;
                var articles = results.map(function (result) {
                  return {
                    u: result.url,
                    t: result.meta && result.meta.title ? result.meta.title : result.url,
                    d: result.excerpt || '',
                  };
                });
                render(pages.slice(0, 3).concat(articles.filter(function (article) {
                  return !pages.some(function (page) { return page.u === article.u; });
                })), faq);
                if (reveal) revealResults();
              });
            }).catch(function () {
              return searchFallback(query, sequence, faqPromise, reveal);
            });
          });
        }
        function searchFor(query, reveal) {
          var q = query.trim().toLowerCase();
          if (!q) {
            searchSequence++;
            if (box) {
              box.replaceChildren();
              box.hidden = true;
            }
            return;
          }
          executeSearch(q, reveal);
        }
        function closeAndRestoreFocus() {
          closeSearch();
          if (input && panel && panel.contains(document.activeElement)) {
            suppressOpen = true;
            input.focus();
            window.setTimeout(function () { suppressOpen = false; }, 0);
          }
        }
        syncPlaceholder();
        if (shortPlaceholder.addEventListener) shortPlaceholder.addEventListener('change', syncPlaceholder);
        if (input) {
          input.addEventListener('focus', function () {
            if (!suppressOpen) openSearch();
          });
          input.addEventListener('click', function () {
            if (panel && panel.hidden) openSearch();
          });
          window.addEventListener('resize', function () {
            if (panel && !panel.hidden) placePanel();
          });
        }
        if (closeButton) {
          closeButton.addEventListener('click', function () {
            closeAndRestoreFocus();
          });
        }
        if (input && box && form) {
          input.addEventListener('focus', function () {
            loadPagefind();
            loadFaqMatcher();
          });
          input.addEventListener('input', function () {
            if (panel && panel.hidden && input.value) openSearch();
            searchFor(input.value);
          });
          input.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
              e.preventDefault();
              closeAndRestoreFocus();
              return;
            }
            var results = box.querySelectorAll('.search-chat-result');
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              if (results.length) {
                activeResult = Math.min(activeResult + 1, results.length - 1);
                updateActiveResult();
                results[activeResult].scrollIntoView({ block: 'nearest' });
              }
              return;
            }
            if (e.key === 'ArrowUp') {
              e.preventDefault();
              if (results.length) {
                activeResult = Math.max(activeResult - 1, 0);
                updateActiveResult();
                results[activeResult].scrollIntoView({ block: 'nearest' });
              }
              return;
            }
          });
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (input.value.trim()) searchFor(input.value, true);
          });
          document.addEventListener('click', function (e) {
            if (!panel || panel.hidden || !container) return;
            if (container.contains(e.target) || (form && form.contains(e.target))) return;
            closeSearch();
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && panel && !panel.hidden) {
              closeAndRestoreFocus();
              return;
            }
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
              e.preventDefault();
              openSearch();
            }
          });
        }
      })();
    </script>

    <!-- 頁首改成 sticky（原本是 fixed）之後，main 不再需要用 padding 補回頁首高度。
         sticky 的另一個好處：沒有 JS 時導覽是一排展開的連結，它會把內容往下推而不是蓋住內容。 -->
    <main id="main" data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="ft-wrap">
        <div class="ft-grid">
          <div class="ft-brand">
            <p class="ft-mark">{SITE.title}</p>
            <p class="ft-desc">{SITE.footerDescription}</p>
          </div>
          <nav class="ft-nav" aria-label="頁尾導覽">
            {FOOTER_NAV.map((group) => (
              <div>
                <p class="ft-h">{group.label}</p>
                <ul class="ft-list">
                  {group.links.map((item) => (
                    <li><a href={item.href}>{item.label}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
          <!-- 這一欄的後 5 條就是 PERSON_SCHEMA.sameAs 那一組，一律帶 rel="me"：
               它們是身分驗證與 E-E-A-T 訊號，砍掉會少一層可信度來源。 -->
          <div>
            <p class="ft-h">找得到我</p>
            <ul class="ft-social" aria-label="社群與聯絡方式">
