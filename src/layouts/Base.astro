    <style is:global>
      /* ============================================================
         頁首／頁尾：2026-08 改版第二階段
         設計語言的唯一真實來源是 public/_preview/home-b4-lean.html，
         下面的數值全部照該原型（原型的數值又來自 jisto.tw 的 CSS bundle 實測）。

         這段刻意寫成 is:global 的原生 CSS 而不是 Tailwind utility：
         收合膠囊靠的是 max-width／grid-template-columns 的過渡與 :has()，
         用 utility 拼出來會散在十幾個 class 裡，看不出彼此的關係。

         ⚠ 這段是「無層級（unlayered）」CSS，在串接順序上贏過 Tailwind 的
         @layer utilities。因此絕對不要在這裡設 display——像 .search-pop
         這種靠 Tailwind 的 .hidden 開關的元素會被鎖死在顯示狀態。
         ============================================================ */
      :root {
        --bar: 68px; /* 頁首列高（jisto 實測值） */
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
      }
      @media (max-width: 767px) {
        :root {
          --bar: 62px;
        }
      }

      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 99;
        background: var(--color-ink);
        color: #fff;
        padding: 10px 16px;
        font-size: 14px;
        text-decoration: none;
      }
      .skip-link:focus {
        left: 12px;
        top: 12px;
      }

      /* ---------- 頁首外框 ---------- */
      /* sticky 不是 fixed：沒有 JS 時導覽是一排展開的連結，
         它必須把內容往下推，而不是永久蓋住第一屏。 */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 40;
        background: rgb(247 245 241 / 90%); /* = --color-paper 90% */
        -webkit-backdrop-filter: saturate(140%) blur(10px);
        backdrop-filter: saturate(140%) blur(10px);
        border-bottom: 1px solid var(--color-rule);
      }

      /* LINE 從導覽工具列獨立出來，固定在視窗右側中間。 */
      .floating-line {
        position: fixed;
        top: 50%;
        right: max(10px, env(safe-area-inset-right));
        z-index: 35;
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        border: 1px solid var(--color-accent-2);
        border-radius: 50%;
        background: var(--color-accent);
        color: #fff;
        text-decoration: none;
        box-shadow: 0 8px 24px rgb(22 22 26 / 18%);
        transform: translateY(-50%);
        transition:
          background-color 0.18s var(--ease),
          transform 0.18s var(--ease);
      }
      .floating-line svg {
        width: 23px;
        height: 23px;
      }
      .floating-line span {
        position: absolute;
        top: calc(100% + 5px);
        color: var(--color-accent-2);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.08em;
      }
      @media (max-width: 767px) {
        .floating-line {
          right: max(8px, env(safe-area-inset-right));
          width: 46px;
          height: 46px;
        }
        .floating-line svg {
          width: 21px;
          height: 21px;
        }
      }

      /* 一組 DOM 兩種版型，靠 flex-wrap 切換：
         手機（<1024px）wrap，導覽掉到第二列 → 下拉面板
         桌機（≥1024px）nowrap，導覽留在同一列 → 橫向膠囊 */
      .hd-cap {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        width: 100%;
        max-width: 72rem; /* 對齊各頁的 max-w-6xl */
        margin: 0 auto;
        padding: 0 20px;
        column-gap: 12px;
        row-gap: 0;
        min-height: var(--bar);
      }
      @media (min-width: 768px) {
        .hd-cap {
          padding: 0 40px;
        }
      }

      /* ---------- 字標 ---------- */
      .hd-mark {
        order: 1;
        margin-inline-end: auto;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px; /* 觸控目標：字標收成方塊時仍有 44px 高 */
        color: var(--color-ink);
        text-decoration: none;
        white-space: nowrap;
      }
      .hd-logo {
        width: 24px;
        height: 24px;
        flex: none;
      }
      .hd-mark-t {
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .hd-tools {
        order: 2;
        display: flex;
        align-items: center;
        gap: 6px;
        /* 42px 圓形裡有 12px 的視覺留白。用負 margin 吃掉它，
           讓圖示的墨跡切齊 .hd-cap 的右緣，而不是按鈕外框切齊——
           不補這 11px，頁首看起來會跟內文差一截、像沒對齊。 */
        margin-inline-end: -11px;
      }

      /* ---------- 42px 圓形圖示按鈕 ---------- */
      /* 文字欄用「確定長度 0px」而不是 0fr：0fr 展開成 minmax(auto, 0fr)，
         那個 auto 最小值會被文字欄自己的 padding 撐開，量到的軌道是 9px、
         整顆按鈕變 53px 的橢圓。確定長度不吃 automatic minimum size，
         溢出的部分由 overflow:hidden 切掉。 */
      .hicon {
        display: grid;
        grid-template-columns: 18px 0px;
        align-items: center;
        height: 42px;
        /* 1+11 + 18 + 11+1 = 42px 正圓。width 是 auto，box-sizing 不生效，
           所以邊框那 2px 要自己算進去；用 12px 會得到 44×42 的橢圓。 */
        padding: 0 11px;
        border: 1px solid var(--color-rule-3); /* 可操作元件邊界，對紙底 3.35:1 */
        border-radius: 999px;
        background: transparent;
        color: var(--color-ink-2);
        text-decoration: none;
        white-space: nowrap;
        overflow: hidden;
        cursor: pointer;
        transition:
          grid-template-columns 0.34s var(--ease),
          color 0.2s var(--ease),
          border-color 0.2s var(--ease),
          background-color 0.2s var(--ease);
      }
      .hicon--solo {
        grid-template-columns: 18px;
        justify-content: center;
        width: 42px;
      }
      .hicon-ic,
      .hicon-ic svg {
        display: block;
        width: 18px;
        height: 18px;
      }
      .hicon-tx {
        overflow: hidden;
        min-width: 0;
        padding-inline-start: 9px; /* 收合時連同 padding 一起被裁掉 */
        font-size: 12.5px;
        line-height: 1;
        font-weight: 500;
      }

      /* ---------- 收合選單開關 ---------- */
      .hd-cue {
        display: none; /* 沒有 JS 就不出現，導覽維持展開 */
        width: 42px;
        height: 42px;
        padding: 0;
        border: 1px solid var(--color-rule-3);
        border-radius: 999px;
        background: transparent;
        cursor: pointer;
        place-items: center;
        transition:
          border-color 0.2s var(--ease),
          background-color 0.2s var(--ease);
      }
      .nav-js .hd-cue {
        display: grid;
      }
      .hd-cue-b {
        position: relative;
        display: block;
        width: 15px;
        height: 9px;
      }
      .hd-cue-b i {
        position: absolute;
        left: 0;
        display: block;
        width: 15px;
        height: 1.3px;
        background: var(--color-ink);
        transform-origin: 50% 50%;
        transition:
          width 0.28s var(--ease),
          transform 0.28s var(--ease),
          top 0.28s var(--ease);
      }
      .hd-cue-b i:nth-child(1) {
        top: 0;
      }
      .hd-cue-b i:nth-child(2) {
        top: 7.7px;
      }
      .hd-cue[aria-expanded='true'] .hd-cue-b i {
        width: 15px;
        top: 3.85px;
      }
      .hd-cue[aria-expanded='true'] .hd-cue-b i:nth-child(1) {
        transform: rotate(45deg);
      }
      .hd-cue[aria-expanded='true'] .hd-cue-b i:nth-child(2) {
        transform: rotate(-45deg);
      }

      /* ---------- 導覽本體：手機下拉、桌機橫排，同一組 DOM ---------- */
      .mainnav {
        order: 3;
        flex-basis: 100%;
      }
      /* 內距放在 ul 上而且不隨開合改變：這樣 panel.scrollHeight 在任何時候
         量到的都是同一個完整高度。若把內距放在會過渡的 .mainnav 上，
         JS 讀 scrollHeight 的那一瞬間內距還停在起始值，算出來的 max-height
         會短一截，最後一顆連結就被 overflow:hidden 切掉。 */
      .mainnav ul {
        padding: 8px 0 16px;
      }
      .mainnav li + li {
        border-top: 1px solid var(--color-rule);
      }
      .mainnav a {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        padding: 15px 2px;
        text-decoration: none;
        font-size: 17px;
        font-weight: 500;
        color: var(--color-ink);
        transition: color 0.18s var(--ease);
      }
      .service-nav summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 15px 2px;
        color: var(--color-ink);
        font-size: 17px;
        font-weight: 500;
        cursor: pointer;
        list-style: none;
        background: transparent;
        transition:
          color 0.18s var(--ease),
          background-color 0.18s var(--ease);
      }
      .service-nav summary::-webkit-details-marker {
        display: none;
      }
      .service-nav-mark {
        color: currentColor;
        font-size: 16px;
        line-height: 1;
        transition: transform 0.2s var(--ease);
      }
      .service-nav[open] .service-nav-mark {
        transform: rotate(180deg);
      }
      .service-nav-item--accent .service-nav summary {
        padding-inline: 14px;
        background: var(--color-accent);
        color: #fff;
        font-weight: 700;
      }
      .service-menu {
        padding: 4px 0 16px;
      }
      .service-menu-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        padding: 0 2px 10px;
      }
      .service-menu-head > span {
        font-size: 13px;
        font-weight: 700;
        color: var(--color-ink);
      }
      .service-menu-head small {
        color: var(--color-ink-3);
        font-size: 11px;
      }
      .service-menu-grid {
        display: grid;
        gap: 10px;
      }
      .service-menu-links {
        display: grid;
        padding: 0;
      }
      .service-menu-links li + li {
        border-top: 1px solid var(--color-rule);
      }
      .mainnav .service-menu-links a {
        padding: 12px 2px;
        font-size: 14px;
      }
      .mainnav .service-preview {
        position: relative;
        display: grid;
        grid-template-columns: 104px minmax(0, 1fr) 14px;
        align-items: center;
        gap: 12px;
        padding: 10px;
        border: 1px solid var(--color-rule-2);
        background: var(--color-paper-2);
        color: var(--color-ink);
      }
      .service-preview img {
        display: block;
        width: 104px;
        height: auto;
        border: 1px solid var(--color-rule);
      }
      .service-preview-copy {
        display: grid;
        min-width: 0;
        gap: 3px;
      }
      .service-preview-copy small {
        color: var(--color-accent);
        font-size: 11px;
        font-weight: 600;
      }
      .service-preview-copy strong {
        font-size: 14px;
        line-height: 1.35;
      }
      .service-preview-copy > span {
        color: var(--color-ink-2);
        font-size: 12px;
        line-height: 1.55;
      }
      .service-preview-go {
        color: var(--color-accent);
        font-size: 13px;
      }
      .np-go {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 12px;
        color: var(--color-accent);
      }
      /* 收合時要一起加 visibility:hidden。只有 max-height:0 的話，
         看不見的連結仍然可以被 Tab 選到，鍵盤焦點會跑進收起來的面板裡。 */
      .nav-js .mainnav {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        transition:
          max-height 0.3s var(--ease),
          opacity 0.3s var(--ease),
          visibility 0s linear 0.3s;
      }
      .nav-js .site-header[data-open='true'] .mainnav {
        opacity: 1;
        visibility: visible;
        border-top: 1px solid var(--color-rule);
        transition:
          max-height 0.3s var(--ease),
          opacity 0.3s var(--ease),
          visibility 0s linear 0s;
      }

      /* ---------- 桌機（≥1024px）：Dean 式完整尺寸橫向導覽 ---------- */
      @media (min-width: 1024px) {
        .nav-js .hd-cue {
          display: none;
        }
        .nav-js .site-header {
          position: sticky;
          top: 0;
          margin: 0;
          width: 100%;
          height: 84px;
          border-width: 0 0 1px;
          border-radius: 0;
          background: rgb(247 245 241 / 96%);
          transition: none;
        }
        .nav-js .hd-cap {
          flex-wrap: nowrap;
          max-width: 72rem;
          height: 100%;
          padding: 0 40px;
          min-height: 0;
          column-gap: 0;
        }
        .nav-js .hd-mark {
          margin-inline-end: auto;
        }
        .nav-js .hd-mark-t {
          max-width: none;
          overflow: visible;
          font-size: 18px;
        }
        .nav-js .mainnav {
          order: 2;
          flex-basis: auto;
          margin-inline: auto 28px;
          max-height: none;
          max-width: none;
          padding-block: 0;
          border-top: 0;
          overflow: visible;
          opacity: 1;
          visibility: visible;
          transition: none;
        }
        .nav-js .site-header[data-open='true'] .mainnav {
          max-width: none;
          padding-block: 0;
          border-top: 0;
          overflow: visible;
        }
        .nav-js .mainnav ul {
          display: flex;
          align-items: center;
          gap: 30px;
          /* 上下 6px 不只是留白：.mainnav 要 overflow:hidden 才能做 max-width 收合，
             導覽列高度剛好等於連結高度時，:focus-visible 的外框（offset 3px）
             上下會被裁掉，實測只剩兩條直線。左右 12px 同理，給第一顆連結留位置。 */
          padding: 6px 0;
        }
        .nav-js .mainnav li + li {
          border-top: 0;
        }
        .nav-js .mainnav a {
          padding: 12px 0;
          font-size: 16px;
          white-space: nowrap;
          font-weight: 400;
        }
        .service-nav summary {
          align-items: baseline;
          gap: 4px;
          padding: 12px 0;
          font-size: 16px;
          font-weight: 500;
          white-space: nowrap;
        }
        .service-nav {
          position: relative;
        }
        .service-nav-item--accent .service-nav summary {
          padding-inline: 18px;
          border-radius: 4px;
          font-weight: 700;
        }
        .service-nav-mark {
          font-size: 12px;
        }
        .service-menu {
          position: fixed;
          top: 84px;
          left: 50%;
          z-index: 60;
          width: min(760px, calc(100vw - 32px));
          padding: 20px;
          border: 1px solid var(--color-rule-2);
          background: rgb(247 245 241 / 98%);
          box-shadow: 0 20px 50px rgb(37 32 27 / 14%);
          transform: translateX(-50%);
          -webkit-backdrop-filter: saturate(140%) blur(14px);
          backdrop-filter: saturate(140%) blur(14px);
        }
        .service-menu--plain {
          position: absolute;
          top: calc(100% + 10px);
          left: 50%;
          width: 260px;
          padding: 14px 18px;
          transform: translateX(-50%);
        }
        .service-menu--plain .service-menu-head {
          display: none;
        }
        .nav-js .mainnav .service-menu--plain .service-menu-links {
          display: grid;
          grid-template-columns: 1fr;
          gap: 0;
          padding: 0;
        }
        .nav-js .mainnav .service-menu--plain .service-menu-links li + li {
          border-top: 1px solid var(--color-rule);
        }
        .nav-js .mainnav .service-menu--plain a {
          justify-content: space-between;
          padding: 13px 4px;
          font-size: 14px;
          white-space: normal;
        }
        .service-menu-head {
          padding: 0 0 14px;
        }
        .service-menu-head > span {
          font-size: 15px;
        }
        .service-menu-head small {
          font-size: 12px;
        }
        .service-menu-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 14px;
        }
        .nav-js .mainnav .service-preview {
          grid-template-columns: 132px minmax(0, 1fr) 14px;
          gap: 14px;
          padding: 12px;
          white-space: normal;
        }
        .service-preview img {
          width: 132px;
        }
        .service-preview-copy strong {
          font-size: 15px;
        }
        .service-preview-copy > span {
          font-size: 12px;
        }
        .nav-js .mainnav .np-go {
          display: none;
        }
        .nav-js .hd-tools {
          order: 3;
          margin-inline-end: 0;
        }
      }

      /* ---------- 搜尋下拉面板 ---------- */
      /* 這裡不能設 display（會壓過 Tailwind 的 .hidden，見檔頭警告）。 */
      .search-pop {
        position: absolute;
        top: 100%;
        left: 20px;
        right: 20px;
        z-index: 50;
        margin-top: 10px;
        border: 1px solid var(--color-rule);
        background: var(--color-surface);
        padding: 12px;
        box-shadow: 0 18px 40px rgb(22 22 26 / 12%);
      }
      @media (min-width: 768px) {
        .search-pop {
          left: auto;
          right: 40px;
          width: 320px;
        }
      }
      @media (min-width: 1024px) {
        /* 桌機才把定位基準交給搜尋按鈕本身。手機維持 static，
           面板改以 sticky 的 .site-header 為基準拉成整條寬——
           不然 288px 的面板掛在最左邊那顆 42px 按鈕上，右對齊會直接溢出畫面左緣。 */
        .hd-search {
          position: relative;
        }
        .search-pop {
          right: 0;
          margin-top: 14px;
        }
      }
      .search-input {
        width: 100%;
        border: 1px solid var(--color-rule-3);
        background: var(--color-surface);
        padding: 9px 12px;
        font-size: 14px;
        line-height: 1.4;
        color: var(--color-ink-2);
      }
      .search-input:focus {
        border-color: var(--color-accent);
      }
      .search-ex {
        margin-top: 10px;
      }
      .search-ex-h {
        padding: 0 8px 4px;
        font-size: 12px;
        color: var(--color-ink-3);
      }
      .search-ex button {
        display: block;
        width: 100%;
        padding: 7px 8px;
        text-align: left;
        font-size: 14px;
        color: var(--color-ink-2);
        background: transparent;
        border: 0;
        cursor: pointer;
      }
      .search-res {
        margin-top: 10px;
        max-height: 20rem;
        overflow-y: auto;
        border-top: 1px solid var(--color-rule);
        padding-top: 6px;
      }

      /* ---------- 頁尾 ---------- */
      .site-footer {
        margin-top: 96px;
        border-top: 1px solid var(--color-rule);
        background: var(--color-paper-2);
        padding: 48px 0 36px;
      }
      .ft-wrap {
        width: 100%;
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 20px;
      }
      @media (min-width: 768px) {
        .ft-wrap {
          padding: 0 40px;
        }
      }
      .ft-grid {
        display: grid;
        gap: 30px;
      }
      @media (min-width: 1024px) {
        .ft-grid {
          grid-template-columns: minmax(300px, 1fr) 190px 268px;
          gap: 24px;
          align-items: start;
        }
      }
      .ft-mark {
        font-size: 15px;
        font-weight: 600;
        color: var(--color-ink);
      }
      .ft-desc {
        margin-top: 12px;
        max-width: 42ch;
        font-size: 13px;
        line-height: 1.85;
        color: var(--color-ink-3);
      }
      .ft-h {
        margin-bottom: 12px;
        font-size: 11.5px;
        letter-spacing: 0.12em;
        color: var(--color-ink-3);
      }
      .ft-list li + li {
        margin-top: 8px;
      }
      .ft-list a {
        font-size: 13.5px;
        color: var(--color-ink-2);
        text-decoration: none;
      }
      @media (min-width: 1024px) {
        .ft-list {
          display: flex;
          flex-wrap: wrap;
          gap: 8px 16px;
          max-width: 190px;
        }
        .ft-list li + li {
          margin-top: 0;
        }
      }
      .ft-social {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-width: 176px;
        padding: 0;
        list-style: none;
      }
      @media (min-width: 1024px) {
        .ft-social {
          flex-wrap: nowrap;
          max-width: none;
        }
      }
      .ft-social a {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 1px solid var(--color-rule-2);
        border-radius: 50%;
        color: var(--color-ink-2);
        text-decoration: none;
        transition:
          color 0.18s var(--ease),
          border-color 0.18s var(--ease),
          background-color 0.18s var(--ease);
      }
      .ft-social svg {
        display: block;
        width: 18px;
        height: 18px;
        fill: currentColor;
      }
      @media (min-width: 1024px) {
        .ft-social a {
          width: 32px;
          height: 32px;
        }
        .ft-social svg {
          width: 16px;
          height: 16px;
        }
      }
      .ft-bottom {
        margin-top: 34px;
        padding-top: 18px;
        border-top: 1px solid var(--color-rule-2);
        display: flex;
        flex-wrap: wrap;
        gap: 8px 20px;
        justify-content: space-between;
        font-size: 12px;
        color: var(--color-ink-3);
      }
      .ft-copy {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 11.5px;
      }
      .ft-legal {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 18px;
      }
      .ft-legal a {
        color: var(--color-ink-3);
        text-decoration: none;
      }

      /* ============================================================
         hover 一律加裝置條件：觸控裝置上 :hover 會「黏住」，
         點過的元件會停在 hover 狀態直到點別的地方。
         :focus-visible 另外寫一份、不設任何條件（見 global.css）。
         ============================================================ */
      @media (hover: hover) and (pointer: fine) {
        .floating-line:hover {
          background: var(--color-accent-2);
          transform: translateY(-50%) scale(1.06);
        }
        .hicon:hover {
          color: var(--color-accent);
          border-color: var(--color-accent);
          background: var(--color-accent-tint);
        }
        .hd-cue:hover {
          border-color: var(--color-ink);
        }
        /* jisto 的開關 hover：兩條線縮到 10px、旋轉 ±45°，往中線收成小 ✕ */
        .hd-cue:hover .hd-cue-b i {
          width: 10px;
          top: 3.85px;
        }
        .hd-cue:hover .hd-cue-b i:nth-child(1) {
          transform: rotate(45deg);
        }
        .hd-cue:hover .hd-cue-b i:nth-child(2) {
          transform: rotate(-45deg);
        }
        /* 已展開時 hover 維持完整 ✕，不要縮回 10px */
        .hd-cue[aria-expanded='true']:hover .hd-cue-b i {
          width: 15px;
        }
        .mainnav a:hover,
        .hd-mark:hover,
        .ft-list a:hover,
        .ft-legal a:hover {
          color: var(--color-accent);
        }
        .ft-social a:hover {
          color: var(--color-accent);
          border-color: var(--color-accent);
          background: var(--color-accent-tint);
        }
        .search-ex button:hover {
          background: var(--color-paper-2);
        }
      }

      /* 鍵盤焦點：不靠 hover 也要有等價的視覺回饋（不設裝置條件） */
      .hicon:focus-visible {
        color: var(--color-accent);
        border-color: var(--color-accent);
        background: var(--color-accent-tint);
      }
      .mainnav a:focus-visible {
        color: var(--color-accent);
      }
      .service-nav summary:focus-visible {
        color: var(--color-accent);
        background: var(--color-accent-tint);
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
      }
      .service-nav-item--accent .service-nav summary:focus-visible {
        color: #fff;
        background: var(--color-accent-2);
      }
      .floating-line:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 4px;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .site-header,
        .hicon,
        .hd-cue,
        .hd-cue-b i,
        .mainnav,
        .hd-mark-t {
          transition: none !important;
        }
        .service-nav-mark {
          transition: none !important;
        }
        .floating-line {
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
