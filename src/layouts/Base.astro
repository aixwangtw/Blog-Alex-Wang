    <style is:global>
      /* ============================================================
         頁首／頁尾：2026-08 改版第二階段
         設計語言的唯一真實來源是 public/_preview/home-b4-lean.html，
         下面的數值全部照該原型（原型的數值又來自 jisto.tw 的 CSS bundle 實測）。

         這段刻意寫成 is:global 的原生 CSS 而不是 Tailwind utility：
         收合膠囊靠的是 max-width／grid-template-columns 的過渡與 :has()，
         用 utility 拼出來會散在十幾個 class 裡，看不出彼此的關係。

         ⚠ 這段是「無層級（unlayered）」CSS，在串接順序上贏過 Tailwind 的
         @layer utilities。互動元件若要切換顯示，統一搭配 [hidden] 明確控制。
         ============================================================ */
      :root {
        --bar: 68px; /* 頁首列高（jisto 實測值） */
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
      }
      @media (max-width: 767px) {
        :root {
          --bar: 62px;
        }
      }

      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 99;
        background: var(--color-ink);
        color: #fff;
        padding: 10px 16px;
        font-size: 14px;
        text-decoration: none;
      }
      .skip-link:focus {
        left: 12px;
        top: 12px;
      }

      /* ---------- 頁首外框 ---------- */
      /* sticky 不是 fixed：沒有 JS 時導覽是一排展開的連結，
         它必須把內容往下推，而不是永久蓋住第一屏。 */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 40;
        background: rgb(247 245 241 / 90%); /* = --color-paper 90% */
        -webkit-backdrop-filter: saturate(140%) blur(10px);
        backdrop-filter: saturate(140%) blur(10px);
        border-bottom: 1px solid var(--color-rule);
      }

      /* LINE 與 AI 搜尋在右下角垂直排列：LINE 在上、Chatbot 在下。 */
      .floating-line {
        position: fixed;
        right: max(20px, env(safe-area-inset-right));
        bottom: calc(max(18px, env(safe-area-inset-bottom)) + 78px);
        z-index: 35;
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        border: 1px solid var(--color-accent-2);
        border-radius: 50%;
        background: var(--color-accent);
        color: #fff;
        text-decoration: none;
        box-shadow: 0 8px 24px rgb(22 22 26 / 18%);
        transition:
          background-color 0.18s var(--ease),
          opacity 0.18s var(--ease),
          transform 0.18s var(--ease),
          visibility 0.18s var(--ease);
      }
      body.search-chat-open .floating-line {
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transform: translateY(8px);
      }
      .floating-line svg {
        width: 23px;
        height: 23px;
      }
      .floating-line span {
        position: absolute;
        top: calc(100% + 5px);
        color: var(--color-accent-2);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.08em;
      }
      @media (max-width: 767px) {
        .floating-line {
          right: max(14px, env(safe-area-inset-right));
          bottom: calc(max(12px, env(safe-area-inset-bottom)) + 70px);
          width: 46px;
          height: 46px;
        }
        .floating-line svg {
          width: 21px;
          height: 21px;
        }
      }

      /* 一組 DOM 兩種版型，靠 flex-wrap 切換：
         手機（<1024px）wrap，導覽掉到第二列 → 下拉面板
         桌機（≥1024px）nowrap，導覽留在同一列 → 橫向膠囊 */
      .hd-cap {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        width: 100%;
        max-width: 72rem; /* 對齊各頁的 max-w-6xl */
        margin: 0 auto;
        padding: 0 20px;
        column-gap: 12px;
        row-gap: 0;
        min-height: var(--bar);
      }
      @media (min-width: 768px) {
        .hd-cap {
          padding: 0 40px;
        }
      }

      /* ---------- 字標 ---------- */
      .hd-mark {
        order: 1;
        margin-inline-end: auto;
        margin-inline-start: 8px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px; /* 觸控目標：字標收成方塊時仍有 44px 高 */
        color: var(--color-ink);
        text-decoration: none;
        white-space: nowrap;
      }
      .hd-logo {
        width: 24px;
        height: 24px;
        flex: none;
      }
      .hd-mark-t {
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .hd-tools {
        order: 2;
        display: flex;
        align-items: center;
        gap: 6px;
        /* 42px 圓形裡有 12px 的視覺留白。用負 margin 吃掉它，
           讓圖示的墨跡切齊 .hd-cap 的右緣，而不是按鈕外框切齊——
           不補這 11px，頁首看起來會跟內文差一截、像沒對齊。 */
        margin-inline-end: -11px;
      }

      /* ---------- 收合選單開關 ---------- */
      .hd-cue {
        display: none; /* 沒有 JS 就不出現，導覽維持展開 */
        width: 42px;
        height: 42px;
        padding: 0;
        border: 1px solid var(--color-rule-3);
        border-radius: 999px;
        background: transparent;
        cursor: pointer;
        place-items: center;
        transition:
          border-color 0.2s var(--ease),
          background-color 0.2s var(--ease);
      }
      .nav-js .hd-cue {
        display: grid;
      }
      .hd-cue-b {
        position: relative;
        display: block;
        width: 15px;
        height: 9px;
      }
      .hd-cue-b i {
        position: absolute;
        left: 0;
        display: block;
        width: 15px;
        height: 1.3px;
        background: var(--color-ink);
        transform-origin: 50% 50%;
        transition:
          width 0.28s var(--ease),
          transform 0.28s var(--ease),
          top 0.28s var(--ease);
      }
      .hd-cue-b i:nth-child(1) {
        top: 0;
      }
      .hd-cue-b i:nth-child(2) {
        top: 7.7px;
      }
      .hd-cue[aria-expanded='true'] .hd-cue-b i {
        width: 15px;
        top: 3.85px;
      }
      .hd-cue[aria-expanded='true'] .hd-cue-b i:nth-child(1) {
        transform: rotate(45deg);
      }
      .hd-cue[aria-expanded='true'] .hd-cue-b i:nth-child(2) {
        transform: rotate(-45deg);
      }

      /* ---------- 導覽本體：手機下拉、桌機橫排，同一組 DOM ---------- */
      .mainnav {
        order: 3;
        flex-basis: 100%;
      }
      /* 內距放在 ul 上而且不隨開合改變：這樣 panel.scrollHeight 在任何時候
         量到的都是同一個完整高度。若把內距放在會過渡的 .mainnav 上，
         JS 讀 scrollHeight 的那一瞬間內距還停在起始值，算出來的 max-height
         會短一截，最後一顆連結就被 overflow:hidden 切掉。 */
      .mainnav ul {
        padding: 8px 0 16px;
      }
      .mainnav li + li {
        border-top: 1px solid var(--color-rule);
      }
      .mainnav a {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        padding: 15px 2px;
        text-decoration: none;
        font-size: 18px;
        font-weight: 500;
        color: var(--color-ink);
        transition: color 0.18s var(--ease);
      }
      .service-nav-shell--split {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
      }
      .service-nav-shell--split .service-nav {
        display: contents;
      }
      .mainnav .service-nav-direct {
        min-width: 0;
      }
      .service-nav-shell--split .service-nav summary {
        padding-inline: 12px 2px;
      }
      .service-nav-shell--split .service-menu {
        grid-column: 1 / -1;
      }
      .service-nav summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 15px 2px;
        color: var(--color-ink);
        font-size: 18px;
        font-weight: 500;
        cursor: pointer;
        list-style: none;
        background: transparent;
        transition:
          color 0.18s var(--ease),
          background-color 0.18s var(--ease);
      }
      .service-nav summary::-webkit-details-marker {
        display: none;
      }
      .service-nav-mark {
        color: currentColor;
        font-size: 16px;
        line-height: 1;
        transition: transform 0.2s var(--ease);
      }
      .service-nav[open] .service-nav-mark {
        transform: rotate(180deg);
      }
      .service-nav-item--accent .service-nav summary {
        padding-inline: 14px;
        background: var(--color-accent);
        color: #fff;
        font-weight: 700;
      }
      .service-nav-item--accent .service-nav-shell--split {
        padding-inline-start: 14px;
        background: var(--color-accent);
      }
      .mainnav .service-nav-item--accent .service-nav-direct,
      .service-nav-item--accent .service-nav-shell--split .service-nav summary {
        color: #fff;
        font-weight: 700;
      }
      .service-nav-item--accent .service-nav-shell--split .service-nav summary {
        padding-inline: 10px 14px;
        background: transparent;
      }
      .service-menu {
        padding: 4px 0 16px;
      }
      .service-menu-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        padding: 0 2px 10px;
      }
      .service-menu-head > span {
        font-size: 13px;
        font-weight: 700;
        color: var(--color-ink);
      }
      .service-menu-head small {
        color: var(--color-ink-3);
        font-size: 11px;
      }
      .service-menu-grid {
        display: grid;
        gap: 10px;
      }
      .service-menu-links {
        display: grid;
        padding: 0;
      }
      .service-menu-links li + li {
        border-top: 1px solid var(--color-rule);
      }
      .mainnav .service-menu-links a {
        padding: 12px 2px;
        font-size: 14px;
      }
      .service-menu-link-copy {
        display: grid;
        min-width: 0;
      }
      .service-menu-link-copy strong {
        font-weight: 500;
      }
      .mainnav .service-menu-links .service-menu-link--icon {
        display: grid;
        grid-template-columns: 32px minmax(0, 1fr) auto;
        align-items: center;
        gap: 10px;
      }
      .service-menu-link--icon > img {
        display: block;
        width: 32px;
        height: 32px;
        object-fit: contain;
      }
      .service-menu-link-copy small {
        margin-top: 2px;
        color: var(--color-ink-3);
        font-size: 10px;
        line-height: 1.45;
      }
      .mainnav .service-preview {
        position: relative;
        display: grid;
        grid-template-columns: 104px minmax(0, 1fr);
        align-items: stretch;
        column-gap: 12px;
        row-gap: 3px;
        padding: 10px;
        border: 1px solid var(--color-rule-2);
        background: var(--color-paper-2);
        color: var(--color-ink);
      }
      .mainnav .service-preview-main {
        display: contents;
        padding: 0;
        color: inherit;
        white-space: normal;
      }
      .service-preview img {
        display: block;
        grid-column: 1;
        grid-row: 1 / span 2;
        width: 104px;
        height: 100%;
        min-height: 55px;
        border: 1px solid var(--color-rule);
        background: #fff;
        object-fit: cover;
      }
      .service-preview--icon img {
        padding: 5px;
        object-fit: contain;
      }
      .service-preview--tooka img {
        padding: 5px;
      }
      .service-preview-copy {
        display: grid;
        grid-column: 2;
        grid-row: 1;
        min-width: 0;
        gap: 3px;
      }
      .service-preview-copy small {
        color: var(--color-accent);
        font-size: 11px;
        font-weight: 600;
      }
      .service-preview-copy strong {
        font-size: 14px;
        line-height: 1.35;
      }
      .service-preview-copy > span {
        color: var(--color-ink-2);
        font-size: 12px;
        line-height: 1.55;
        overflow-wrap: anywhere;
      }
      .service-preview-cta {
        display: inline-flex;
        width: fit-content;
        min-height: 31px;
        align-items: center;
        gap: 8px;
        margin-top: 7px;
        padding: 5px 10px;
        border: 1px solid var(--color-accent);
        border-radius: 3px;
        color: var(--color-accent);
        font-size: 11px;
        font-weight: 600;
        line-height: 1.2;
      }
      button.service-preview-cta {
        appearance: none;
        background: transparent;
        font-family: inherit;
        cursor: pointer;
      }
      .service-preview > .service-preview-actions {
        display: flex;
        grid-column: 2;
        grid-row: 2;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px 10px;
        color: inherit;
        font-size: inherit;
        line-height: inherit;
      }
      .service-preview-actions em {
        color: var(--color-ink-3);
        font-size: 10px;
        font-style: normal;
        line-height: 1.45;
        overflow-wrap: anywhere;
      }
      .np-go {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 12px;
        color: var(--color-accent);
      }
      /* 收合時要一起加 visibility:hidden。只有 max-height:0 的話，
         看不見的連結仍然可以被 Tab 選到，鍵盤焦點會跑進收起來的面板裡。 */
      .nav-js .mainnav {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        transition:
          max-height 0.3s var(--ease),
          opacity 0.3s var(--ease),
          visibility 0s linear 0.3s;
      }
      .nav-js .site-header[data-open='true'] .mainnav {
        opacity: 1;
        visibility: visible;
        border-top: 1px solid var(--color-rule);
        transition:
          max-height 0.3s var(--ease),
          opacity 0.3s var(--ease),
          visibility 0s linear 0s;
      }

      /* ---------- 桌機（≥1024px）：Dean 式完整尺寸橫向導覽 ---------- */
      @media (min-width: 1024px) {
        .nav-js .hd-cue {
          display: none;
        }
        .nav-js .site-header {
          position: sticky;
          top: 0;
          margin: 0;
          width: 100%;
          height: 84px;
          border-width: 0 0 1px;
          border-radius: 0;
          background: rgb(247 245 241 / 96%);
          transition: none;
        }
        .nav-js .hd-cap {
          flex-wrap: nowrap;
          max-width: 72rem;
          height: 100%;
          padding: 0 40px;
          min-height: 0;
          column-gap: 0;
        }
        .nav-js .hd-mark {
          margin-inline-start: 16px;
          margin-inline-end: 0;
        }
        .nav-js .hd-mark-t {
          max-width: none;
          overflow: visible;
          font-size: 18px;
        }
        .nav-js .mainnav {
          order: 2;
          flex-basis: auto;
          margin-inline: auto 16px;
          max-height: none;
          max-width: none;
          padding-block: 0;
          border-top: 0;
          overflow: visible;
          opacity: 1;
          visibility: visible;
          transition: none;
        }
        .nav-js .site-header[data-open='true'] .mainnav {
          max-width: none;
          padding-block: 0;
          border-top: 0;
          overflow: visible;
        }
        .nav-js .mainnav ul {
          display: flex;
          align-items: center;
          gap: 30px;
          /* 上下 6px 不只是留白：.mainnav 要 overflow:hidden 才能做 max-width 收合，
             導覽列高度剛好等於連結高度時，:focus-visible 的外框（offset 3px）
             上下會被裁掉，實測只剩兩條直線。左右 12px 同理，給第一顆連結留位置。 */
          padding: 6px 0;
        }
        .nav-js .mainnav li + li {
          border-top: 0;
        }
        .nav-js .mainnav a {
          padding: 12px 0;
          font-size: 18px;
          white-space: nowrap;
          font-weight: 400;
        }
        .service-nav summary {
          align-items: baseline;
          gap: 4px;
          padding: 12px 0;
          font-size: 18px;
          font-weight: 500;
          white-space: nowrap;
        }
        .service-nav {
          position: relative;
        }
        .service-nav-shell--split {
          grid-template-columns: auto auto;
        }
        .mainnav .service-nav-direct {
          padding-right: 5px;
        }
        .service-nav-shell--split .service-nav summary {
          padding-left: 0;
        }
        .service-nav-item--accent .service-nav summary {
          padding-inline: 18px;
          border-radius: 4px;
          font-weight: 700;
        }
        .service-nav-item--accent .service-nav-shell--split {
          padding-inline-start: 18px;
          border-radius: 4px;
        }
        .nav-js .mainnav .service-nav-item--accent .service-nav-direct {
          padding-right: 5px;
        }
        .service-nav-item--accent .service-nav-shell--split .service-nav summary {
          padding-inline: 0 18px;
          border-radius: 0;
        }
        .service-nav-mark {
          font-size: 13px;
        }
        .service-menu {
          position: fixed;
          top: 84px;
          left: 50%;
          z-index: 60;
          width: min(860px, calc(100vw - 32px));
          padding: 24px;
          border: 1px solid var(--color-rule-2);
          background: rgb(247 245 241 / 98%);
          box-shadow: 0 20px 50px rgb(37 32 27 / 14%);
          transform: translateX(-50%);
          -webkit-backdrop-filter: saturate(140%) blur(14px);
          backdrop-filter: saturate(140%) blur(14px);
        }
        .service-menu--plain {
          position: absolute;
          top: calc(100% + 10px);
          left: 50%;
          width: 300px;
          padding: 14px 18px;
          transform: translateX(-50%);
        }
        .service-menu--plain .service-menu-head {
          display: none;
        }
        .nav-js .mainnav .service-menu--plain .service-menu-links {
          display: grid;
          grid-template-columns: 1fr;
          gap: 0;
          padding: 0;
        }
        .nav-js .mainnav .service-menu--plain .service-menu-links li + li {
          border-top: 1px solid var(--color-rule);
        }
        .nav-js .mainnav .service-menu--plain a {
          justify-content: space-between;
          padding: 13px 4px;
          font-size: 14px;
          white-space: normal;
        }
        .service-menu-head {
          padding: 0 0 14px;
        }
        .service-menu-head > span {
          font-size: 15px;
        }
        .service-menu-head small {
          font-size: 12px;
        }
        .service-menu-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 14px;
        }
        .nav-js .mainnav .service-preview {
          grid-template-columns: 152px minmax(0, 1fr);
          column-gap: 18px;
          padding: 15px;
          white-space: normal;
        }
        .nav-js .mainnav .service-preview-main {
          white-space: normal;
        }
        .service-preview img {
          width: 152px;
          min-height: 80px;
        }
        .service-preview--icon img {
          padding: 8px;
        }
        .service-preview--tooka img {
          padding: 8px;
        }
        .service-preview-copy strong {
          font-size: 16px;
        }
        .service-preview-copy > span {
          font-size: 12.5px;
        }
        .nav-js .mainnav .np-go {
          display: none;
        }
        .nav-js .hd-tools {
          order: 3;
          margin-inline-end: 0;
        }
      }

      /* ---------- 右下角 AI 終端機搜尋 ---------- */
      .search-chatbot {
        position: fixed;
        right: max(18px, env(safe-area-inset-right));
        bottom: max(18px, env(safe-area-inset-bottom));
        z-index: 80;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      .search-chat-toggle {
        display: grid;
        width: 56px;
        height: 56px;
        margin-left: auto;
        place-items: center;
        padding: 0;
        border: 1px solid #4b4643;
        border-radius: 50%;
        background: #1d1b1a;
        color: #f7f3ee;
        box-shadow: 0 12px 32px rgb(22 18 17 / 24%);
        cursor: pointer;
      }
      .search-chat-toggle svg {
        width: 25px;
        height: 25px;
        fill: currentColor;
      }
      .search-chat-toggle svg circle {
        fill: #1d1b1a;
      }
      .search-chat-toggle > span {
        position: absolute;
        top: calc(100% + 3px);
        color: var(--color-accent-2);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.1em;
        white-space: nowrap;
      }
      .search-chat-panel {
        position: absolute;
        right: 0;
        bottom: 72px;
        width: min(400px, calc(100vw - 24px));
        max-height: min(640px, calc(100svh - 104px));
        flex-direction: column;
        overflow: hidden;
        border: 1px solid #3f3b39;
        border-radius: 8px;
        background: #151414;
        color: #f5f1eb;
        box-shadow: 0 24px 70px rgb(22 18 17 / 28%);
      }
      .search-chat-panel:not([hidden]) {
        display: flex;
      }
      .search-chat-bar {
        display: grid;
        min-height: 40px;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 10px;
        padding: 0 10px 0 13px;
        border-bottom: 1px solid #393635;
        background: #242120;
      }
      .search-chat-dots {
        display: flex;
        gap: 5px;
      }
      .search-chat-dots i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #a94d59;
      }
      .search-chat-dots i:nth-child(2) { background: #b8924f; }
      .search-chat-dots i:nth-child(3) { background: #5d9975; }
      .search-chat-bar b {
        overflow: hidden;
        color: #aaa29d;
        font-size: 9px;
        font-weight: 400;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .search-chat-bar button {
        display: grid;
        width: 32px;
        height: 32px;
        place-items: center;
        padding: 0;
        border: 0;
        background: transparent;
        color: #aaa29d;
        font: 300 22px/1 sans-serif;
        cursor: pointer;
      }
      .search-chat-screen {
        min-height: 0;
        flex: 1;
        overflow-y: auto;
        padding: 18px;
        overscroll-behavior: contain;
      }
      .search-chat-boot {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin: 0 0 20px;
        color: #716b67;
        font-size: 8px;
        letter-spacing: 0.1em;
      }
      .search-chat-dialog,
      .search-chat-response {
        display: grid;
        grid-template-columns: 29px minmax(0, 1fr);
        align-items: start;
        gap: 9px;
      }
      .search-chat-ai {
        display: grid;
        width: 29px;
        height: 22px;
        place-items: center;
        border: 1px solid #bc6472;
        border-radius: 3px;
        color: #f09aa7;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.06em;
      }
      .search-chat-dialog p {
        margin: 0;
        color: #f7f3ee;
        font-family: var(--font-display);
        font-size: 17px;
        font-weight: 600;
        line-height: 1.5;
      }
      .search-chat-examples {
        display: grid;
        gap: 3px;
        margin: 13px 0 0 38px;
      }
      .search-chat-examples[hidden],
      .search-chat-answer[hidden] {
        display: none;
      }
      .search-chat-examples button {
        min-height: 40px;
        padding: 7px 9px;
        border: 1px solid transparent;
        border-radius: 3px;
        background: transparent;
        color: #aaa39e;
        font: 500 11px/1.5 var(--font-display);
        text-align: left;
        cursor: pointer;
      }
      .search-chat-examples button:first-child {
        border-color: #514b48;
        background: #272322;
        color: #fffaf4;
      }
      .search-chat-examples button span,
      .search-chat-command > span {
        margin-right: 6px;
        color: #ef8998;
      }
      .search-chat-answer {
        margin-top: 18px;
      }
      .search-chat-command {
        margin: 0 0 13px 38px;
        color: #d7d0ca;
        font-size: 11px;
        line-height: 1.5;
      }
      .search-chat-command b {
        font-weight: 500;
      }
      .search-chat-results {
        display: grid;
        min-width: 0;
        gap: 4px;
      }
      .search-chat-result {
        display: grid;
        gap: 3px;
        padding: 8px 9px;
        border: 1px solid transparent;
        border-radius: 3px;
        color: #d8d1cb;
        text-decoration: none;
      }
      .search-chat-result.is-active {
        border-color: #514b48;
        background: #272322;
      }
      .search-chat-result strong {
        color: #f1ebe5;
        font-family: var(--font-display);
        font-size: 11px;
        font-weight: 600;
        line-height: 1.45;
      }
      .search-chat-result span {
        display: -webkit-box;
        overflow: hidden;
        color: #918a84;
        font-family: var(--font-display);
        font-size: 9px;
        line-height: 1.5;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
      }
      .search-chat-empty {
        margin: 0;
        color: #918a84;
        font-family: var(--font-display);
        font-size: 10px;
        line-height: 1.6;
      }
      .search-chat-line {
        display: grid;
        min-height: 58px;
        grid-template-columns: 38px minmax(0, 1fr) auto;
        align-items: center;
        gap: 10px;
        margin-top: 18px;
        padding: 9px 11px;
        border: 1px solid #3d654c;
        border-radius: 4px;
        background: #1e2922;
        color: #eef7f1;
        text-decoration: none;
      }
      .search-chat-line img {
        display: block;
        width: 38px;
        height: 38px;
        border-radius: 8px;
      }
      .search-chat-line span,
      .search-chat-line small,
      .search-chat-line b {
        display: block;
        min-width: 0;
      }
      .search-chat-line small {
        margin-bottom: 2px;
        color: #91ad9b;
        font-family: var(--font-display);
        font-size: 9px;
      }
      .search-chat-line b {
        color: #f3faf5;
        font-family: var(--font-display);
        font-size: 12px;
        font-weight: 600;
      }
      .search-chat-line > i {
        color: #72bf8e;
        font-size: 13px;
        font-style: normal;
      }
      .search-chat-form {
        display: grid;
        min-height: 52px;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 7px;
        padding: 6px 9px 6px 12px;
        border-top: 1px solid #393635;
        background: #181716;
      }
      .search-chat-form > span {
        color: #827b76;
        font-size: 8px;
      }
      .search-chat-form input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: #f2ece5;
        font: 400 11px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      .search-chat-form input::placeholder { color: #716b67; }
      .search-chat-form button {
        display: grid;
        width: 34px;
        height: 34px;
        place-items: center;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: #eee8e1;
        color: #1a1817;
        cursor: pointer;
      }
      .search-chat-form button svg {
        width: 17px;
        height: 17px;
        stroke-width: 1.9;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .search-chat-status {
        display: flex;
        min-height: 27px;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 0 12px;
        border-top: 1px solid #302e2c;
        background: #211f1e;
        color: #716b67;
        font-size: 7px;
        letter-spacing: 0.08em;
      }
      .search-chat-status span:first-child { color: #71b58a; }
      @media (max-width: 767px) {
        .search-chatbot {
          right: max(12px, env(safe-area-inset-right));
          bottom: max(12px, env(safe-area-inset-bottom));
        }
        .search-chat-toggle {
          width: 50px;
          height: 50px;
        }
        .search-chat-panel {
          bottom: 64px;
          max-height: calc(100svh - 88px - env(safe-area-inset-bottom));
        }
        .search-chat-screen { padding: 14px 12px; }
        .search-chat-dialog p { font-size: 15px; }
        .search-chat-examples { margin-left: 0; }
        .search-chat-command { margin-left: 0; }
      }

      /* ---------- 頁尾 ---------- */
      .site-footer {
        margin-top: 96px;
        border-top: 1px solid var(--color-rule);
        background: var(--color-paper-2);
        padding: 48px 0 36px;
      }
      .ft-wrap {
        width: 100%;
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 20px;
      }
      @media (min-width: 768px) {
        .ft-wrap {
          padding: 0 40px;
        }
      }
      .ft-grid {
        display: grid;
        gap: 30px;
      }
      @media (min-width: 1024px) {
        .ft-grid {
          grid-template-columns: minmax(300px, 1fr) 190px 268px;
          gap: 24px;
          align-items: start;
        }
      }
      .ft-mark {
        font-size: 15px;
        font-weight: 600;
        color: var(--color-ink);
      }
      .ft-desc {
        margin-top: 12px;
        max-width: 42ch;
        font-size: 13px;
        line-height: 1.85;
        color: var(--color-ink-3);
      }
      .ft-h {
        margin-bottom: 12px;
        font-size: 11.5px;
        letter-spacing: 0.12em;
        color: var(--color-ink-3);
      }
      .ft-list li + li {
        margin-top: 8px;
      }
      .ft-list a {
        font-size: 13.5px;
        color: var(--color-ink-2);
        text-decoration: none;
      }
      @media (min-width: 1024px) {
        .ft-list {
          display: flex;
          flex-wrap: wrap;
          gap: 8px 16px;
          max-width: 190px;
        }
        .ft-list li + li {
          margin-top: 0;
        }
      }
      .ft-social {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-width: 176px;
        padding: 0;
        list-style: none;
      }
      @media (min-width: 1024px) {
        .ft-social {
          flex-wrap: nowrap;
          max-width: none;
        }
      }
      .ft-social a {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 1px solid var(--color-rule-2);
        border-radius: 50%;
        color: var(--color-ink-2);
        text-decoration: none;
        transition:
          color 0.18s var(--ease),
          border-color 0.18s var(--ease),
          background-color 0.18s var(--ease);
      }
      .ft-social svg {
        display: block;
        width: 18px;
        height: 18px;
        fill: currentColor;
      }
      @media (min-width: 1024px) {
        .ft-social a {
          width: 32px;
          height: 32px;
        }
        .ft-social svg {
          width: 16px;
          height: 16px;
        }
      }
      .ft-bottom {
        margin-top: 34px;
        padding-top: 18px;
        border-top: 1px solid var(--color-rule-2);
        display: flex;
        flex-wrap: wrap;
        gap: 8px 20px;
        justify-content: space-between;
        font-size: 12px;
        color: var(--color-ink-3);
      }
      .ft-copy {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 11.5px;
      }
      .ft-legal {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 18px;
      }
      .ft-legal a {
        color: var(--color-ink-3);
        text-decoration: none;
      }

      /* ============================================================
         hover 一律加裝置條件：觸控裝置上 :hover 會「黏住」，
         點過的元件會停在 hover 狀態直到點別的地方。
         :focus-visible 另外寫一份、不設任何條件（見 global.css）。
         ============================================================ */
      @media (hover: hover) and (pointer: fine) {
        .floating-line:hover {
          background: var(--color-accent-2);
          transform: scale(1.06);
        }
        .search-chat-toggle:hover {
          border-color: #bc6472;
          background: #292524;
          transform: translateY(-2px);
        }
        .hd-cue:hover {
          border-color: var(--color-ink);
        }
        /* jisto 的開關 hover：兩條線縮到 10px、旋轉 ±45°，往中線收成小 ✕ */
        .hd-cue:hover .hd-cue-b i {
          width: 10px;
          top: 3.85px;
        }
        .hd-cue:hover .hd-cue-b i:nth-child(1) {
          transform: rotate(45deg);
        }
        .hd-cue:hover .hd-cue-b i:nth-child(2) {
          transform: rotate(-45deg);
        }
        /* 已展開時 hover 維持完整 ✕，不要縮回 10px */
        .hd-cue[aria-expanded='true']:hover .hd-cue-b i {
          width: 15px;
        }
        .mainnav a:hover,
        .hd-mark:hover,
        .ft-list a:hover,
        .ft-legal a:hover {
          color: var(--color-accent);
        }
        .ft-social a:hover {
          color: var(--color-accent);
          border-color: var(--color-accent);
          background: var(--color-accent-tint);
        }
        .search-chat-examples button:hover,
        .search-chat-result:hover {
          border-color: #514b48;
          background: #272322;
          color: #fffaf4;
        }
        .search-chat-line:hover {
          border-color: #72bf8e;
          background: #24362a;
        }
      }

      /* 鍵盤焦點：不靠 hover 也要有等價的視覺回饋（不設裝置條件） */
      .search-chat-toggle:focus-visible,
      .search-chat-bar button:focus-visible,
      .search-chat-examples button:focus-visible,
      .search-chat-result:focus-visible,
      .search-chat-line:focus-visible,
      .search-chat-form button:focus-visible {
        outline: 2px solid #f09aa7;
        outline-offset: 3px;
      }
      .mainnav a:focus-visible {
        color: var(--color-accent);
      }
      .service-nav summary:focus-visible {
        color: var(--color-accent);
        background: var(--color-accent-tint);
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
      }
      .service-nav-item--accent .service-nav summary:focus-visible {
        color: #fff;
        background: var(--color-accent-2);
      }
      .floating-line:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 4px;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .site-header,
        .search-chat-toggle,
        .hd-cue,
        .hd-cue-b i,
        .mainnav,
        .hd-mark-t {
          transition: none !important;
        }
        .service-nav-mark {
          transition: none !important;
        }
        .floating-line {
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
