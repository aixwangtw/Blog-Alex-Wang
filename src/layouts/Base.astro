---
import ogBanner from '../assets/banner-v2.png';
import { NAV, LINKS, SITE, SERVICE_SITE, AUTHOR, PERSON_SCHEMA, pageBannerUrl, speakingBannerUrl } from '../consts';
import '../styles/global.css';

// 頁首導覽不放「首頁」：字標本身就是回首頁的連結，重複一次是浪費連結預算。
// 頁尾的網站導覽仍然列出完整 NAV（含首頁）。
const HEADER_NAV = [
  { href: '/about/', label: '關於' },
];
const DROPDOWN_NAV = [
  {
    key: 'articles',
    label: '文章',
    subtitle: '從新手入門、工具安裝到社群自動化',
    previews: [
      {
        href: '/blog/',
        eyebrow: '全部文章',
        title: 'AI 新手部落格',
        description: '每篇文章解決一個真實問題，依發佈時間完整瀏覽。',
        image: new URL(pageBannerUrl('blog')).pathname,
      },
      {
        href: '/blog/codex-windows-wsl-install/',
        eyebrow: '工具安裝',
        title: 'Codex 新手安裝',
        description: '從 VS Code 插件開始，不用先學終端機操作。',
        image: '/images/blog/codex-windows-wsl-install.png',
      },
      {
        href: '/blog/threads-api-tutorial/',
        eyebrow: '社群自動化',
        title: 'Meta API 實戰',
        description: 'Threads、Instagram 申請與自動發文工作流。',
        image: '/images/blog/threads-api-tutorial.png',
      },
    ],
  },
  {
    key: 'resources',
    label: '領取',
    subtitle: '免費教學影片、開源工具與學習路線',
    previews: [
      {
        href: '/resources/',
        eyebrow: '免費專區',
        title: '全部免費資源',
        description: '把免費工具、影片與建議的學習順序整理在同一頁。',
        image: new URL(pageBannerUrl('resources')).pathname,
      },
      {
        href: '/blog/why-i-built-tooka/',
        eyebrow: '開源工具',
        title: 'Tooka 社群圖文',
        description: '用對話生成不跑版的 IG、Facebook 與 Threads 圖文。',
        image: '/images/blog/why-i-built-tooka.png',
      },
    ],
  },
  {
    key: 'services',
    label: '服務',
    subtitle: '先看內容，再選適合你的合作方式',
    accent: true,
    previews: [
      {
        href: `${SERVICE_SITE.url}/course/`,
        eyebrow: '3 小時課程',
        title: 'AI 新手實戰課',
        description: '從工具安裝、專案規則到除錯解耦，帶你從 0 到 1 完成第一個專案。',
        image: new URL(pageBannerUrl('one-on-one')).pathname,
      },
      {
        href: `${SERVICE_SITE.url}/services/speaking/`,
        eyebrow: '演講與實作',
        title: 'AI 主題演講',
        description: 'AI Agent、社群自動化與對話式拍片，可依企業、協會或社群需求規劃。',
        image: new URL(speakingBannerUrl()).pathname,
      },
    ],
  },
];

interface Props {
  title: string;
  description: string;
  /** 頁面專屬的 JSON-LD（Article、Service、FAQPage 等），會與全站 Person 一起輸出 */
  schema?: object[];
  ogType?: string;
  /** 社群分享預覽圖，預設用全站橫幅 */
  ogImage?: string;
  /** og:image 的像素尺寸與替代文字；自訂 ogImage（文章橫幅固定 1200×630）時沿用預設即可 */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  /** 不公開頁面：禁止搜尋引擎索引（unlisted 文章用） */
  noindex?: boolean;
}

const {
  title,
  description,
  schema = [],
  ogType = 'website',
  noindex = false,
  ogImage: pageOgImage,
  ogImageWidth = pageOgImage ? 1200 : ogBanner.width,
  ogImageHeight = pageOgImage ? 630 : ogBanner.height,
  ogImageAlt = title,
} = Astro.props;
const ogImage = pageOgImage ?? new URL(ogBanner.src, SITE.url).href;
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.title,
      alternateName: [SITE.titleEn, 'aixwang'],
      url: SITE.url,
      description: SITE.description,
      inLanguage: SITE.locale,
      publisher: { '@id': PERSON_SCHEMA['@id'] },
    },
    PERSON_SCHEMA,
    ...schema,
  ],
};
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <!-- Google Analytics（GA4）流量統計：gtag.js 延到頁面載入完才注入，避免佔用首次渲染的主執行緒；
         事件在此之前先排入 dataLayer，載入後照樣送出。
         noindex 頁面（草稿／不公開頁）完全不輸出 GA 腳本，不會被統計 -->
    {!noindex && <script is:inline>
      // 只統計正式網站；localhost、區域網路 IP 與其他預覽網址完全不載入 GA4。
      var analyticsHosts = ['aixwang.dev', 'www.aixwang.dev'];
      if (analyticsHosts.indexOf(window.location.hostname) !== -1) {
        var preconnect = document.createElement('link');
        preconnect.rel = 'preconnect';
        preconnect.href = 'https://www.googletagmanager.com';
        preconnect.crossOrigin = 'anonymous';
        document.head.appendChild(preconnect);

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', 'G-91Z2F673C0');

        window.addEventListener('load', function () {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-91Z2F673C0';
          document.head.appendChild(s);
        });

        // 自訂事件：追蹤關鍵轉換點擊（LINE 諮詢 / Tooka / YouTube）
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          var href = a.href || '';
          if (href.indexOf('line.me') !== -1) {
            window.gtag('event', 'line_click', { link_url: href, page_path: location.pathname });
          } else if (href.indexOf('/course') !== -1) {
            window.gtag('event', 'one_on_one_click', { link_url: href, page_path: location.pathname });
          } else if (href.indexOf('/services/speaking') !== -1) {
            window.gtag('event', 'speaking_click', { link_url: href, page_path: location.pathname });
          } else if (href.indexOf('tooka') !== -1) {
            window.gtag('event', 'tooka_click', { link_url: href, page_path: location.pathname });
          } else if (href.indexOf('youtube.com') !== -1 || href.indexOf('youtu.be') !== -1) {
            window.gtag('event', 'youtube_click', { link_url: href, page_path: location.pathname });
          }
        });
      }
    </script>}

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- 允許 Google 搜尋／Discover 使用大圖預覽；unlisted 頁面則完全禁止索引 -->
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'max-image-preview:large'} />
    <link rel="icon" type="image/png" sizes="any" href="/favicon.png?v=2" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/aixwang-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <!-- 底色維持純色紙感（原型 home-b4-lean.html 的 body 就是 background:var(--paper)）。
       改版前這裡有兩道 radial-gradient 粉色暈染，跟髮絲線列的版面語言互相干擾：
       髮絲線靠的是「線在乾淨紙上」的對比，底下有漸層時線的視覺重量會隨位置浮動。 -->
  <body
    data-pagefind-ignore={noindex ? 'all' : undefined}
    class="min-h-screen bg-paper font-display text-ink antialiased"
  >
    <a class="skip-link" href="#main">跳到主要內容</a>

    <header class="site-header" id="site-header" data-open="false">
      <div class="hd-cap">
        <a class="hd-mark" href="/" aria-label={`回首頁 — ${SITE.title}`}>
          <img class="hd-logo" src="/aixwang-icon.png" width="24" height="24" alt="" aria-hidden="true" />
          <span class="hd-mark-t">Aix</span>
        </a>

        <nav class="mainnav" id="mainnav" aria-label="主要導覽">
          <ul>
            {HEADER_NAV.map((item) => (
              <li>
                <a href={item.href}>{item.label}<span class="np-go" aria-hidden="true">→</span></a>
              </li>
            ))}
            {DROPDOWN_NAV.map((menu) => (
              <li class:list={['service-nav-item', { 'service-nav-item--accent': menu.accent }]}>
                <details class="service-nav nav-dropdown" id={`nav-dropdown-${menu.key}`}>
                  <summary>
                    <span>{menu.label}</span>
                    <span class="service-nav-mark" aria-hidden="true">▾</span>
                  </summary>
                  <div class:list={['service-menu', { 'service-menu--plain': !menu.accent, 'service-menu--featured': menu.accent }]}>
                    <div class="service-menu-head">
                      <span>{menu.label}</span>
                      <small>{menu.subtitle}</small>
                    </div>
                    {menu.accent ? (
                      <div class="service-menu-grid">
                        {menu.previews.map((item) => (
                          <a class="service-preview" href={item.href}>
                            <img src={item.image} alt="" width="1200" height="630" loading="lazy" />
                            <span class="service-preview-copy">
                              <small>{item.eyebrow}</small>
                              <strong>{item.title}</strong>
                              <span>{item.description}</span>
                            </span>
                            <span class="service-preview-go" aria-hidden="true">→</span>
                          </a>
                        ))}
                      </div>
                    ) : (
                      <ul class="service-menu-links">
                        {menu.previews.map((item) => (
                          <li><a href={item.href}>{item.title}<span aria-hidden="true">→</span></a></li>
                        ))}
                      </ul>
                    )}
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </nav>

        <div class="hd-tools">
          <div id="search-container" class="hd-search">
            <button
              id="search-toggle"
              type="button"
              aria-label="開啟搜尋"
              aria-expanded="false"
              aria-controls="search-popover"
              class="hicon hicon--solo"
            >
              <span class="hicon-ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" focusable="false">
                  <circle cx="11" cy="11" r="7" />
                  <line x1="16.2" y1="16.2" x2="21" y2="21" />
                </svg>
              </span>
            </button>
            <div id="search-popover" class="search-pop hidden">
              <input
                id="site-search"
                type="search"
                aria-label="搜尋文章"
                autocomplete="off"
                placeholder="搜尋文章"
                class="search-input"
              />
              <div id="search-examples" class="search-ex">
                <div class="search-ex-h">搜尋範例</div>
                <button type="button" data-search-example="新手要怎麼學 AI" data-search-query="AI 入門">新手要怎麼學 AI</button>
                <button type="button" data-search-example="如何做自動發文" data-search-query="自動發文">如何做自動發文</button>
                <button type="button" data-search-example="如何自動拍片" data-search-query="教學影片">如何自動拍片</button>
              </div>
              <div id="search-results" class="search-res hidden"></div>
            </div>
          </div>

          <button
            class="hd-cue"
            id="nav-cue"
            type="button"
            aria-expanded="false"
            aria-controls="mainnav"
            aria-label="開啟選單"
          >
            <span class="hd-cue-b" aria-hidden="true"><i></i><i></i></span>
          </button>
        </div>
      </div>
    </header>

    <a
      class="floating-line"
      href={LINKS.line}
      target="_blank"
      rel="noreferrer"
      aria-label="加 LINE 免費諮詢（開新分頁）"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
      </svg>
      <span>LINE</span>
    </a>

    <script is:inline>
      /* 收合選單：獨立的 try 區塊，跟下面的搜尋互不影響。
         關鍵順序——`nav-js` 這個 class 只在「開關確定接好」之後才加到 <html>。
         反過來寫的話，只要下面任何一行拋例外，選單會被 CSS 收起來卻沒有東西能打開它，
         導覽就永久消失了。沒有 JS（或 JS 爆炸）時 .nav-js 不存在，
         導覽就是一排正常可見、可點的連結——連結一律寫在初始 HTML 裡，爬蟲讀得到。 */
      (function () {
        try {
          var header = document.getElementById('site-header');
          var cue = document.getElementById('nav-cue');
          var panel = document.getElementById('mainnav');
          var dropdowns = panel ? panel.querySelectorAll('.nav-dropdown') : [];
          if (!header || !cue || !panel) return;

          // 桌機導覽固定展開，手機則是「下拉面板」（用 max-height）。
          // max-height 必須用 scrollHeight 算，所以只能在 JS 裡設；
          // 換到桌機時要把 inline 的 max-height 清掉，免得殘值把橫排導覽壓扁。
          var mqDesktop = window.matchMedia('(min-width:1024px)');

          function applyHeight(open) {
            if (mqDesktop.matches) {
              panel.style.maxHeight = '';
              return;
            }
            // +28px 留給最後一顆連結的 :focus-visible 外框，不然 overflow:hidden 會切掉它
            panel.style.maxHeight = open ? panel.scrollHeight + 28 + 'px' : '0px';
          }

          // 開啟時把焦點送進第一個連結。原因是 DOM 順序：導覽排在工具列之前
          // （桌機膠囊的視覺順序要求如此），開關按鈕卻在工具列裡。焦點若留在按鈕上，
          // 按 Tab 會直接跳過剛展開的六個連結跑進內文——鍵盤使用者等於打不開選單。
          // 關閉時若焦點還在面板裡，收回按鈕上，不讓焦點掉到 body。
          function setOpen(open, moveFocus) {
            // 桌機版不提供收合；僅手機版的選單開關會改變狀態。
            if (mqDesktop.matches) open = true;
            var focusInside = panel.contains(document.activeElement);
            header.setAttribute('data-open', open ? 'true' : 'false');
            cue.setAttribute('aria-expanded', open ? 'true' : 'false');
            cue.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
            applyHeight(open);
            if (open && moveFocus) {
              var first = panel.querySelector('a');
              if (first) first.focus();
            } else if (!open && focusInside) {
              cue.focus();
            }
          }

          // 保留尺寸重算給舊版膠囊的漸進增強；目前 Dean 式桌機導覽使用完整容器寬。
          // 寫死的版本（原本 636px，依五個連結算的）在 NAV 加入第六項時被
          // overflow:hidden 直接切掉 44px，而且沒有任何警告。
          // 量的是收合狀態下 nav 的 scrollWidth（此時 CSS 把可視寬壓成 0/384，
          // 但 scrollWidth 仍反映內容的自然寬），加上膠囊其餘元件的固定佔用。
          // 字型載入會改變寬度，所以等 document.fonts.ready 之後再量一次。
          function sizeCapsule() {
            if (!window.matchMedia('(min-width: 1024px)').matches) return;
            var list = panel.querySelector('ul');
            if (!list) return;
            // 22 左內距 + 32 字標（展開只剩 logo）+ 42 搜尋 + 10 右內距 + 2 邊框
            var CHROME = 108;
            var need = Math.ceil(list.scrollWidth) + CHROME;
            header.style.setProperty('--capw-open', need + 'px');
          }
          sizeCapsule();
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(sizeCapsule).catch(function () {});
          }
          window.addEventListener('resize', sizeCapsule);

          // 斷點換邊時重算一次，避免手機展開後轉成桌機、殘留 max-height
          var onMQ = function () {
            sizeCapsule();
            setOpen(mqDesktop.matches, false);
          };
          if (mqDesktop.addEventListener) mqDesktop.addEventListener('change', onMQ);
          else if (mqDesktop.addListener) mqDesktop.addListener(onMQ);
          window.addEventListener('resize', onMQ);

          cue.addEventListener('click', function (e) {
            e.stopPropagation();
            setOpen(cue.getAttribute('aria-expanded') !== 'true', true);
          });

          // Esc 關閉並把焦點還給開關（鍵盤使用者不會迷路）
          document.addEventListener('keydown', function (e) {
            if (mqDesktop.matches) return;
            if (e.key !== 'Escape' && e.keyCode !== 27) return;
            if (cue.getAttribute('aria-expanded') !== 'true') return;
            setOpen(false);
            cue.focus();
          });

          // 點面板外面關閉
          document.addEventListener('click', function (e) {
            if (mqDesktop.matches) return;
            if (cue.getAttribute('aria-expanded') !== 'true') return;
            if (panel.contains(e.target) || cue.contains(e.target)) return;
            setOpen(false);
          });

          // 點面板裡的連結後關閉（同頁錨點時才看得出差別，但成本是零）
          panel.addEventListener('click', function (e) {
            if (mqDesktop.matches) return;
            if (e.target.closest && e.target.closest('a')) setOpen(false);
          });

          // 手機版展開任一子選單後內容高度會增加，必須同步重算外層選單高度，
          // 否則預覽卡片會被原本的 max-height 裁掉。
          Array.prototype.forEach.call(dropdowns, function (dropdown) {
            dropdown.addEventListener('toggle', function () {
              if (mqDesktop.matches || header.getAttribute('data-open') !== 'true') return;
              window.requestAnimationFrame(function () { applyHeight(true); });
            });
          });

          setOpen(mqDesktop.matches, false);
          document.documentElement.classList.add('nav-js'); // 全部接好了才收合
        } catch (err) {
          /* 沒接上就維持展開：一排正常可見、可點的導覽連結 */
        }
      })();

      (function () {
        // 參考 DR.DEAN：桌機游標移入即開啟，移出後稍延遲關閉；
        // 觸控裝置維持 details 原生點擊，鍵盤則以 focus 開啟。
        var dropdowns = Array.prototype.slice.call(document.querySelectorAll('.nav-dropdown'));
        if (!dropdowns.length) return;
        var hoverMenu = window.matchMedia('(min-width:1024px) and (hover:hover) and (pointer:fine)');
        var closeTimers = new WeakMap();

        function closeOthers(current) {
          dropdowns.forEach(function (dropdown) {
            if (dropdown !== current) dropdown.removeAttribute('open');
          });
        }

        dropdowns.forEach(function (dropdown) {
          var summary = dropdown.querySelector('summary');
          dropdown.addEventListener('mouseenter', function () {
            if (!hoverMenu.matches) return;
            window.clearTimeout(closeTimers.get(dropdown));
            closeOthers(dropdown);
            dropdown.setAttribute('open', '');
          });
          dropdown.addEventListener('mouseleave', function () {
            if (!hoverMenu.matches) return;
            closeTimers.set(dropdown, window.setTimeout(function () {
              dropdown.removeAttribute('open');
            }, 120));
          });
          summary.addEventListener('click', function (event) {
            if (!hoverMenu.matches) return;
            event.preventDefault();
            closeOthers(dropdown);
            dropdown.setAttribute('open', '');
          });
          dropdown.addEventListener('focusin', function () {
            if (!window.matchMedia('(min-width:1024px)').matches) return;
            closeOthers(dropdown);
            dropdown.setAttribute('open', '');
          });
          dropdown.addEventListener('focusout', function () {
            window.setTimeout(function () {
              if (!dropdown.contains(document.activeElement)) dropdown.removeAttribute('open');
            }, 0);
          });
          dropdown.addEventListener('toggle', function () {
            if (dropdown.open) closeOthers(dropdown);
          });
        });

        document.addEventListener('click', function (e) {
          dropdowns.forEach(function (dropdown) {
            if (dropdown.open && !dropdown.contains(e.target)) dropdown.removeAttribute('open');
          });
        });
        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape' && e.keyCode !== 27) return;
          var openDropdown = dropdowns.find(function (dropdown) { return dropdown.open; });
          if (!openDropdown) return;
          openDropdown.removeAttribute('open');
          var summary = openDropdown.querySelector('summary');
          if (summary) summary.focus();
        });
      })();

      (function () {
        // 全站搜尋
        var container = document.getElementById('search-container');
        var toggle = document.getElementById('search-toggle');
        var popover = document.getElementById('search-popover');
        var input = document.getElementById('site-search');
        var box = document.getElementById('search-results');
        var examples = document.getElementById('search-examples');
        var pagefind = null;
        var pagefindPromise = null;
        var fallbackIndex = null;
        var debounceTimer = null;
        var searchSequence = 0;
        var activeResult = -1;
        // 改版後搜尋在所有斷點都是「42px 圓形按鈕 → 下拉面板」，
        // 不再有桌機常駐輸入框那個版本，因此開關邏輯不分斷點。
        function openSearch() {
          if (!popover) return;
          popover.classList.remove('hidden');
          if (toggle) {
            toggle.setAttribute('aria-expanded', 'true');
            toggle.setAttribute('aria-label', '關閉搜尋');
          }
          window.setTimeout(function () { input && input.focus(); }, 0);
        }
        function closeSearch() {
          if (popover) popover.classList.add('hidden');
          if (toggle) {
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', '開啟搜尋');
          }
          if (box) box.classList.add('hidden');
        }
        function loadFallback() {
          if (fallbackIndex) return Promise.resolve(fallbackIndex);
          return fetch('/search-index.json')
            .then(function (r) { return r.json(); })
            .then(function (d) { fallbackIndex = d; return d; });
        }
        function loadPagefind() {
          if (pagefind) return Promise.resolve(pagefind);
          if (pagefindPromise) return pagefindPromise;
          pagefindPromise = new Function('return import("/pagefind/pagefind.js")')()
            .then(function (module) {
              pagefind = module;
              return pagefind.init().then(function () { return pagefind; });
            })
            .catch(function () {
              pagefind = null;
              pagefindPromise = null;
              return null;
            });
          return pagefindPromise;
        }
        function escapeHtml(value) {
          return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }
        function render(list) {
          activeResult = list.length ? 0 : -1;
          if (!list.length) {
            box.innerHTML = '<div class="px-3 py-2 text-sm text-ink-3">沒有符合的文章</div>';
          } else {
            box.innerHTML = list
              .slice(0, 8)
              .map(function (item, index) {
                return '<a href="' + escapeHtml(item.u) + '" data-search-result="' + index + '" class="search-result-item block px-3 py-2 leading-5 text-ink-2 hover:bg-paper-2 ' + (index === 0 ? 'bg-paper-2' : '') + '">' +
                  '<span class="block text-sm font-medium">' + escapeHtml(item.t) + '</span>' +
                  (item.d ? '<span class="mt-1 block text-xs leading-5 text-ink-3">' + item.d + '</span>' : '') +
                  '</a>';
              })
              .join('');
          }
          box.classList.remove('hidden');
        }
        function renderLoading() {
          box.innerHTML = '<div class="px-3 py-2 text-sm text-ink-3">搜尋中…</div>';
          box.classList.remove('hidden');
        }
        function updateActiveResult() {
          box.querySelectorAll('.search-result-item').forEach(function (item, index) {
            item.classList.toggle('bg-paper-2', index === activeResult);
          });
        }
        function searchFallback(query, sequence) {
          return loadFallback().then(function (items) {
            if (sequence !== searchSequence) return;
            var q = query.toLowerCase();
            render(items
              .filter(function (item) {
                return (item.t + item.d + item.g).toLowerCase().indexOf(q) !== -1;
              })
              .map(function (item) {
                return { u: item.u, t: item.t, d: escapeHtml(item.d) };
              }));
          });
        }
        function executeSearch(query) {
          var sequence = ++searchSequence;
          renderLoading();
          loadPagefind().then(function (engine) {
            if (!engine) return searchFallback(query, sequence);
            return engine.search(query).then(function (search) {
              return Promise.all(search.results.slice(0, 8).map(function (result) {
                return result.data();
              }));
            }).then(function (results) {
              if (!results || sequence !== searchSequence) return;
              render(results.map(function (result) {
                return {
                  u: result.url,
                  t: result.meta && result.meta.title ? result.meta.title : result.url,
                  d: result.excerpt || '',
                };
              }));
            }).catch(function () {
              return searchFallback(query, sequence);
            });
          });
        }
        function searchFor(query, immediate) {
          var q = query.trim().toLowerCase();
          if (examples) examples.classList.toggle('hidden', !!q);
          window.clearTimeout(debounceTimer);
          if (!q) {
            searchSequence++;
            box.classList.add('hidden');
            return;
          }
          if (immediate) executeSearch(q);
          else debounceTimer = window.setTimeout(function () { executeSearch(q); }, 200);
        }
        if (toggle) {
          toggle.addEventListener('click', function () {
            var open = toggle.getAttribute('aria-expanded') === 'true';
            if (open) closeSearch();
            else openSearch();
          });
        }
        if (input && box) {
          input.addEventListener('focus', loadPagefind);
          input.addEventListener('input', function () {
            searchFor(input.value, false);
          });
          input.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
              closeSearch();
              if (toggle) toggle.focus();
              return;
            }
            var results = box.querySelectorAll('.search-result-item');
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              if (results.length) {
                activeResult = Math.min(activeResult + 1, results.length - 1);
                updateActiveResult();
                results[activeResult].scrollIntoView({ block: 'nearest' });
              }
              return;
            }
            if (e.key === 'ArrowUp') {
              e.preventDefault();
              if (results.length) {
                activeResult = Math.max(activeResult - 1, 0);
                updateActiveResult();
                results[activeResult].scrollIntoView({ block: 'nearest' });
              }
              return;
            }
            if (e.key === 'Enter') {
              e.preventDefault();
              var a = results[activeResult] || results[0];
              if (a) location.href = a.getAttribute('href');
            }
          });
          if (examples) {
            examples.addEventListener('click', function (e) {
              var button = e.target.closest('[data-search-example]');
              if (!button) return;
              input.value = button.getAttribute('data-search-example') || '';
              searchFor(button.getAttribute('data-search-query') || input.value, true);
              input.focus();
            });
          }
          document.addEventListener('click', function (e) {
            if (container && !container.contains(e.target)) closeSearch();
          });
          document.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
              e.preventDefault();
              openSearch();
            }
          });
        }
      })();
    </script>

