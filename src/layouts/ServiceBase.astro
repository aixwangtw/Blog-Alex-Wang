---
import { findMarkdownAlternate } from '../lib/agent-docs';
import { DEVELOPMENT_SERVICE, PERSON_SCHEMA, SERVICE_SITE, SITE, TEACHING_GROUP, pageBannerUrl, COURSE_SERVICE_URL, SPEAKING_SERVICE_URL, servicePath, SECTION_NAMES, GA_MEASUREMENT_ID } from '../consts';
import SiteHeader from '../components/SiteHeader.astro';
import FloatingLine from '../components/FloatingLine.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  ogImage?: string;
  ogImageAlt?: string;
  canonicalPath?: string;
  /** 教學頁用 'teaching'：頁尾改列分類文章，不放系統開發入口 */
  footerVariant?: 'service' | 'teaching';
  /** teaching 頁尾的「AI 教學」文章（由頁面依 CMS tags 算出） */
  footerArticles?: { href: string; title: string }[];
}

const {
  title,
  description,
  schema = [],
  ogImage = pageBannerUrl('service-home'),
  ogImageAlt = title,
  canonicalPath = Astro.url.pathname,
  footerVariant = 'service',
  footerArticles = [],
} = Astro.props;

const canonical = new URL(canonicalPath, SERVICE_SITE.url);
// 主要頁面有 Markdown 版（給 AI 讀），用 <link rel="alternate"> 指過去；對照表在 src/lib/agent-docs.ts
const markdownAlternate = findMarkdownAlternate(canonical.href);
const serviceHomeHref = import.meta.env.DEV ? '/services/' : '/';
// 開發案例＝主站的題庫系統案例文章（服務站與主站不同網域，必須帶完整網址）
const developmentCaseHref = `${SITE.url}${DEVELOPMENT_SERVICE.caseArticle}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SERVICE_SITE.url}/#website`,
      name: SERVICE_SITE.title,
      url: SERVICE_SITE.url,
      description: SERVICE_SITE.description,
      inLanguage: 'zh-TW',
      publisher: { '@id': PERSON_SCHEMA['@id'] },
    },
    PERSON_SCHEMA,
    ...schema,
  ],
};
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="max-image-preview:large" />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/aixwang-icon.png" />
    <link rel="canonical" href={canonical} />
    {markdownAlternate && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={SERVICE_SITE.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID, serviceHostname: new URL(SERVICE_SITE.url).hostname, demoHostname: new URL(DEVELOPMENT_SERVICE.demoUrl).hostname }}>
      // 與主站共用內部流量排除 Cookie：在任一子網域開 ?analytics=off 即可停用。
      var analyticsControl = new URLSearchParams(window.location.search).get('analytics');
      if (analyticsControl === 'off') {
        document.cookie = 'aixwang_ga_opt_out=1; Max-Age=315360000; Path=/; Domain=.aixwang.dev; SameSite=Lax; Secure';
      } else if (analyticsControl === 'on') {
        document.cookie = 'aixwang_ga_opt_out=; Max-Age=0; Path=/; Domain=.aixwang.dev; SameSite=Lax; Secure';
      }
      if (analyticsControl === 'off' || analyticsControl === 'on' || analyticsControl === 'status') {
        var cleanAnalyticsUrl = new URL(window.location.href);
        cleanAnalyticsUrl.searchParams.delete('analytics');
        window.history.replaceState({}, '', cleanAnalyticsUrl.pathname + cleanAnalyticsUrl.search + cleanAnalyticsUrl.hash);
      }
      var analyticsOptedOut = /(?:^|;\s*)aixwang_ga_opt_out=1(?:;|$)/.test(document.cookie);
      var analyticsAutomation = navigator.webdriver === true || /HeadlessChrome|Playwright|Puppeteer|Selenium|Aixwang[^\s]*Bot/i.test(navigator.userAgent);
      if (analyticsControl === 'status') {
        document.addEventListener('DOMContentLoaded', function () {
          var disabled = analyticsOptedOut || analyticsAutomation;
          var notice = document.createElement('div');
          var copy = document.createElement('span');
          var title = document.createElement('strong');
          var detail = document.createElement('small');
          var close = document.createElement('button');
          notice.setAttribute('role', 'status');
          notice.setAttribute('aria-live', 'polite');
          notice.style.cssText = 'position:fixed;z-index:2147483647;top:max(16px,env(safe-area-inset-top));left:50%;display:flex;width:min(440px,calc(100vw - 32px));transform:translateX(-50%);align-items:center;gap:14px;padding:14px 16px;border:1px solid ' + (disabled ? '#78b894' : '#d38b8b') + ';border-radius:6px;background:#171615;color:#fff;box-shadow:0 16px 48px rgba(0,0,0,.28);font-family:system-ui,-apple-system,sans-serif';
          copy.style.cssText = 'display:grid;min-width:0;flex:1;gap:3px';
          title.style.cssText = 'font-size:15px;line-height:1.4;color:' + (disabled ? '#91d6ae' : '#ffb3b3');
          detail.style.cssText = 'font-size:12px;line-height:1.55;color:#d4d0cc';
          close.type = 'button';
          close.setAttribute('aria-label', '關閉 GA4 狀態提示');
          close.textContent = '×';
          close.style.cssText = 'width:34px;height:34px;padding:0;border:1px solid #5b5753;border-radius:50%;background:transparent;color:#fff;font-size:20px;cursor:pointer';
          title.textContent = disabled ? '✓ GA4：已排除' : '● GA4：仍在統計';
          detail.textContent = analyticsOptedOut
            ? '這個瀏覽器已設定排除，不會送出 GA4 資料。'
            : analyticsAutomation
              ? '已辨識為自動化瀏覽器，不會送出 GA4 資料。'
              : '這個瀏覽器目前會送出 GA4 資料。';
          close.addEventListener('click', function () { notice.remove(); });
          copy.append(title, detail);
          notice.append(copy, close);
          document.body.appendChild(notice);
        });
      }
      if (window.location.hostname === serviceHostname && !analyticsOptedOut && !analyticsAutomation) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        var gaConfig = {};
        try {
          var gaUrl = new URL(window.location.href);
          if (gaUrl.searchParams.get('s') === 'line') {
            gaUrl.searchParams.delete('s');
            gaConfig = { campaign_source: 'line', campaign_medium: 'social', campaign_name: 'article_share', page_location: gaUrl.href };
            window.gtag('config', gaId, gaConfig);
            window.history.replaceState(window.history.state, '', gaUrl.pathname + gaUrl.search + gaUrl.hash);
            gaConfig = null;
          }
        } catch (e) {}
        if (gaConfig) window.gtag('config', gaId);
        window.addEventListener('load', function () {
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(script);
        });

        function trackButton(control) {
          if (!control) return;
          var label = control.getAttribute('data-ga-label') || control.textContent || '';
          var parameters = {
            button_id: control.getAttribute('data-ga-button') || 'unknown',
            button_label: label.replace(/\s+/g, ' ').trim().slice(0, 100),
            button_location: control.getAttribute('data-ga-location') || 'unknown',
            button_action: control.getAttribute('data-ga-action') || 'click',
            destination_url: control.href || '',
            page_path: location.pathname,
          };
          window.gtag('event', 'button_click', parameters);
          var buttonEventName = ('btn_' + parameters.button_id).replace(/[^a-zA-Z0-9_]/g, '_').slice(0, 40);
          window.gtag('event', buttonEventName, {
            button_label: parameters.button_label,
            button_location: parameters.button_location,
            page_path: parameters.page_path,
          });

          var cmsPayload = JSON.stringify(parameters);
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/button-click', new Blob([cmsPayload], { type: 'application/json' }));
          } else {
            fetch('/api/button-click', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: cmsPayload,
              keepalive: true,
            }).catch(function () {});
          }
        }


        // Demo → 聊聊需求 轉換追蹤：點過題庫 Demo 就記一個旗標（不含個資），之後每次 LINE 事件帶 after_demo。
        // 旗標寫成 .aixwang.dev 共用 Cookie（主站與服務站 localStorage 不互通），並同步寫 localStorage 當備援；讀寫都包 try/catch。
        function hasClickedDemo() {
          try { if (/(?:^|;\s*)aixwang_demo_clicked=1(?:;|$)/.test(document.cookie)) return true; } catch (e) {}
          try { if (window.localStorage.getItem('aixwang_demo_clicked') === '1') return true; } catch (e) {}
          return false;
        }
        function markDemoClicked() {
          try { document.cookie = 'aixwang_demo_clicked=1; Max-Age=15552000; Path=/; Domain=.aixwang.dev; SameSite=Lax; Secure'; } catch (e) {}
          try { window.localStorage.setItem('aixwang_demo_clicked', '1'); } catch (e) {}
        }
        function isDemoHref(href) {
          try { return new URL(href, location.href).hostname === demoHostname; } catch (e) { return false; }
        }
        function isLineHref(href) {
          return href.indexOf('line.me') !== -1 || href.indexOf('lin.ee') !== -1;
        }
        function trackDemoLink(a, control, extra) {
          window.gtag('event', 'demo_click', Object.assign({
            link_url: a.href || '',
            button_id: control ? control.getAttribute('data-ga-button') || 'unknown' : 'none',
            demo_location: control ? control.getAttribute('data-ga-location') || 'unknown' : 'other',
            page_path: location.pathname,
          }, extra || {}));
          markDemoClicked();
        }

        document.addEventListener('click', function (event) {
          var control = event.target.closest && event.target.closest('[data-ga-button]');
          if (control) trackButton(control);
          var a = event.target.closest && event.target.closest('a[href]');
          if (!a) return;
          var href = a.href || '';
          if (isDemoHref(href)) {
            trackDemoLink(a, control);
          } else if (isLineHref(href)) {
            window.gtag('event', 'line_click', {
              link_url: href,
              page_path: location.pathname,
              link_location: control ? control.getAttribute('data-ga-location') || 'button' : 'other',
              button_id: control ? control.getAttribute('data-ga-button') || 'unknown' : 'none',
              after_demo: hasClickedDemo(),
            });
          }
        });
      }
    </script>
  </head>
  <body class="min-h-screen bg-paper font-display text-ink antialiased">
    <a class="service-skip" href="#main">跳到主要內容</a>

    <SiteHeader site="service" homeHref={serviceHomeHref} />

    <FloatingLine />

    <main id="main"><slot /></main>

    <footer class="service-footer">
      {footerVariant === 'teaching' ? (
        <div>
          <section>
            <a class="service-brand" href={serviceHomeHref}>
              <img src="/aixwang-icon.png" width="30" height="30" alt="" />
              <span><strong>AIX</strong></span>
            </a>
          </section>
          <section>
            <h2>{TEACHING_GROUP}</h2>
            {footerArticles.map((article) => (
              <a href={article.href}>{article.title}</a>
            ))}
          </section>
          <section>
            <h2>站內導覽</h2>
            <a href={serviceHomeHref}>服務首頁</a>
            <a class="service-footer-minor" href={servicePath(COURSE_SERVICE_URL)}>一對一教學</a>
            <a class="service-footer-minor" href={servicePath(SPEAKING_SERVICE_URL)}>演講邀約</a>
          </section>
        </div>
      ) : (
        <div>
          <section>
            <a class="service-brand" href={serviceHomeHref}>
              <img src="/aixwang-icon.png" width="30" height="30" alt="" />
              <span><strong>AIX</strong><small>系統開發</small></span>
            </a>
          </section>
          <section>
            <h2>服務項目</h2>
            <a href={servicePath(DEVELOPMENT_SERVICE.url)}>客製系統開發</a>
          </section>
          <section>
            <h2>站內導覽</h2>
            <a href={serviceHomeHref}>服務首頁</a>
            <a href={developmentCaseHref} data-ga-button="service_footer_case" data-ga-label={SECTION_NAMES.cases} data-ga-location="service_footer" data-ga-action="navigate">{SECTION_NAMES.cases}</a>
            <a class="service-footer-minor" href={servicePath(COURSE_SERVICE_URL)} data-ga-button="service_footer_course" data-ga-label="一對一教學" data-ga-location="service_footer" data-ga-action="navigate">一對一教學</a>
            <a class="service-footer-minor" href={servicePath(SPEAKING_SERVICE_URL)} data-ga-button="service_footer_speaking" data-ga-label="演講邀約" data-ga-location="service_footer" data-ga-action="navigate">演講邀約</a>
          </section>
        </div>
      )}
      <p>© {new Date().getFullYear()} {SERVICE_SITE.title}</p>
    </footer>

    <style is:global>
      .service-skip { position:absolute; left:-9999px; top:0; z-index:100; padding:10px 16px; background:var(--color-ink); color:#fff; }
      .service-skip:focus { left:12px; top:12px; }
      .service-brand { display:inline-flex; align-items:center; gap:10px; color:var(--color-ink); text-decoration:none; }
      .service-brand img { width:30px; height:30px; }
      .service-brand > span { display:flex; align-items:center; gap:5px; line-height:1; }
      .service-brand strong, .service-brand small { font-family:inherit; font-size:18px; font-weight:700; }
      .service-brand strong { letter-spacing:.16em; }
      .service-brand small { padding:2px 3px 1px; border:1px solid currentColor; color:inherit; line-height:1; letter-spacing:.04em; white-space:nowrap; }
      .service-footer { margin-top:96px; padding:54px 24px 28px; background:var(--color-ink); color:#fff; }
      .service-footer > div { display:grid; grid-template-columns:1.6fr 1fr 1fr; gap:48px; width:min(1120px, 100%); margin:auto; }
      .service-footer .service-brand { color:#fff; }
      .service-footer section > p { max-width:45ch; margin-top:16px; color:#bdb9b3; font-size:13px; line-height:1.8; }
      .service-footer h2 { margin-bottom:14px; color:#bdb9b3; font-size:11px; letter-spacing:.14em; }
      .service-footer section > a:not(.service-brand) { display:block; margin-top:9px; color:#fff; font-size:14px; text-decoration:none; }
      .service-footer section > a.service-footer-minor { color:#bdb9b3; font-size:12px; }
      .service-footer > p { width:min(1120px, 100%); margin:38px auto 0; padding-top:18px; border-top:1px solid #3b3939; color:#8f8b86; font:11px/1.4 ui-monospace, monospace; }
      @media (max-width:899px) {
        .service-footer > div { grid-template-columns:1fr; gap:34px; }
      }
      @media (max-width:360px) {
        .service-brand strong, .service-brand small { font-size:16px; }
      }
    </style>
  </body>
</html>
