---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import FaqList from '../components/FaqList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE, breadcrumbSchema, pageBannerUrl } from '../consts';
import { HOME_FAQS, RESOURCES_FAQS } from '../data/faqs';
import Base from '../layouts/Base.astro';

// 文章 FAQ：依文章分組，只列有 FAQ 的文章（來源同各文章頁的 FAQPage）
const posts = (await getCollection('blog', ({ data }) => !data.unlisted))
  .filter((post) => post.data.faqs.length > 0)
  .sort(
    (a, b) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
      (b.data.cmsId ?? 0) - (a.data.cmsId ?? 0),
  );

// 首頁服務 FAQ、免費資源 FAQ 與文章 FAQ 都從各自頁面的同一份資料來源組合，
// 避免其中一頁改版後，總整理仍停留在舊內容。
const allFaqs = [...HOME_FAQS, ...RESOURCES_FAQS, ...posts.flatMap((post) => post.data.faqs)];

const schema = [
  breadcrumbSchema([{ name: '首頁', item: `${SITE.url}/` }, { name: '常見問題' }]),
  {
    '@type': 'FAQPage',
    '@id': `${SITE.url}/faq/#webpage`,
    name: 'AI 新手常見問題總整理',
    url: `${SITE.url}/faq/`,
    mainEntity: allFaqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<Base
  title={`常見問題總整理｜${SITE.title}`}
  description="新手學 AI 最常問的問題總整理：私人家教、Vibe Coding、AI 拍片、免費 Codex 與 Skills 資源、Meta API 及社群自動化。"
  ogImage={pageBannerUrl('faq')}
  ogImageAlt="AI 新手常見問題總整理"
  schema={schema}
>
  <div class="mx-auto max-w-3xl px-6 py-12">
    <Breadcrumbs items={[{ name: '首頁', href: '/' }, { name: '常見問題' }]} />

    <h1 class="t-h1 mt-8 font-semibold text-ink">常見問題總整理</h1>
    <p class="mt-6 text-lg leading-8 text-ink-2">
      這裡的問題大多來自真實社群的提問——主要是 Threads 貼文底下的留言，也有 YouTube
      留言和一對一教學學員問過的問題（見<a href="/editorial-policy/" class="text-accent underline underline-offset-4">編輯政策</a>）。找不到答案可以加 LINE 免費問；講課或開發邀約也可以直接寄 Email。
    </p>

    <SectionHeading size="md" class="mt-12">我提供什麼教學？</SectionHeading>
    <!-- 改版前這是一個 rounded-[1.75rem] ＋ bg-surface ＋ shadow 的卡片盒。
         它包著的本來就是一份三項清單，所以不是把盒子換成別的盒子，而是把盒子拆掉、
         讓清單自己用髮絲線分項（同 resources.astro 的 <ol> 與 CheckItem 的做法）。
         最後一項補 last:border-b 收尾：後面緊接著一個「→」連結，
         沒有收尾線時那個連結會讀起來像清單的第四項。 -->
    <ul class="mt-6">
      <li class="border-t border-rule px-0.5 py-5 leading-8 text-ink-2 last:border-b">
        <strong class="text-ink">Vibe Coding</strong>——從 AI Agent 安裝、操作到排錯，用提示詞拆解需求，避免改 A 壞 B，完成第一個能實際使用的作品。
      </li>
      <li class="border-t border-rule px-0.5 py-5 leading-8 text-ink-2 last:border-b">
        <strong class="text-ink">AI 拍片</strong>——依照自己的題材建立從腳本、配音、剪輯到發布的工作流，不需要每支影片都從頭手動製作。
      </li>
      <li class="border-t border-rule px-0.5 py-5 leading-8 text-ink-2 last:border-b">
        <strong class="text-ink">社群自動化</strong>——串接 Facebook、Instagram、Threads、LINE 等帳號，完成自動發文、留言、私訊、排程與通知流程。
      </li>
    </ul>
    <p class="mt-5 px-0.5 text-sm">
      <a href="/services/one-on-one/" class="text-accent underline underline-offset-4">看一對一教學的完整說明與上課形式 →</a>
    </p>

    <SectionHeading size="md" class="mt-14">課程與服務</SectionHeading>
    <div class="mt-6">
      <FaqList faqs={HOME_FAQS} />
    </div>

    <SectionHeading size="md" class="mt-14">免費資源</SectionHeading>
    <p class="mt-5 leading-8 text-ink-2">
      從 Codex 安裝、Skills 到 API 串接與開源工具，以下內容會與<a href="/resources/" class="text-accent underline underline-offset-4">免費資源頁</a>同步更新。
    </p>
    <div class="mt-6">
      <FaqList faqs={RESOURCES_FAQS} />
    </div>

    <SectionHeading size="md" class="mt-14">依主題整理的文章 FAQ</SectionHeading>
    <div class="mt-6 space-y-10">
      {posts.map((post) => (
        <section>
          <h3 class="text-lg font-semibold text-ink">
            <a href={`/blog/${post.id}/`} class="hover:text-accent">{post.data.title}</a>
          </h3>
          <div class="mt-4">
            <FaqList faqs={post.data.faqs} />
          </div>
          <p class="mt-3 text-sm">
            <a href={`/blog/${post.id}/`} class="text-accent underline underline-offset-4 hover:text-accent-2">閱讀完整教學 →</a>
          </p>
        </section>
      ))}
    </div>

    <Cta />
  </div>
</Base>
