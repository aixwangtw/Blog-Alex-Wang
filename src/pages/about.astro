---
import { Image } from 'astro:assets';
import instructorPortrait from '../assets/instructor-shirt.jpg';
import Card from '../components/Card.astro';
import CheckItem from '../components/CheckItem.astro';
import Cta from '../components/Cta.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { AUTHOR, SITE, breadcrumbSchema, pageBannerUrl } from '../consts';
import { EXPERIENCE } from '../data/instructor';
import { SPEAKING_ENGAGEMENTS, TEACHING_CASES } from '../data/services';
import Base from '../layouts/Base.astro';

const schema = [
  breadcrumbSchema([{ name: '首頁', item: `${SITE.url}/` }, { name: '關於講師' }]),
  {
    '@type': 'ProfilePage',
    '@id': `${SITE.url}/about/#webpage`,
    name: `關於講師 ${AUTHOR.name}`,
    url: `${SITE.url}/about/`,
    mainEntity: { '@id': AUTHOR.id },
  },
];
---

<Base
  title={`關於講師 ${AUTHOR.name}｜AI 應用講師、一對一教學與演講`}
  description={AUTHOR.description}
  ogType="profile"
  ogImage={pageBannerUrl('about')}
  ogImageAlt={`關於 AI 講師 ${AUTHOR.name}`}
  schema={schema}
>
  <div class="mx-auto max-w-4xl px-6 py-12">
    <Breadcrumbs items={[{ name: '首頁', href: '/' }, { name: '關於講師' }]} class="mb-8" />
    <h1 class="text-3xl font-semibold text-stone-50 md:text-5xl">關於講師 {AUTHOR.name}</h1>

    <figure class="mx-auto mt-8 max-w-md overflow-hidden rounded-[1.75rem] border border-sky-200/80 bg-white/80 shadow-[0_8px_30px_rgba(30,64,175,0.05)]">
      <Image
        src={instructorPortrait}
        alt={`AI 講師 ${AUTHOR.name} 形象照`}
        class="w-full object-cover"
      />
    </figure>

    <p class="mt-8 text-lg leading-9 text-stone-200/90">
      {AUTHOR.name}（本名王士麟，英文名 Alex Wang，網路上也叫艾克斯王）是 AI 講師，也是全職接案工程師與 21 萬人 OpenClaw 中文社群的版主。我教 AI Agent 工具使用、做自動發文、AI 生圖模板、對話式拍片——把工作流程簡化成對話就能完成，只需第一次使用前的安裝、串接成本，一次性教學，受用好幾次。目前提供<strong class="text-amber-200">付費一對一私人教學</strong>（雙北實體或線上）與<strong class="text-amber-200">企業、學校、社群的公開演講</strong>。我沒進過軟體業，是靠 AI 一步一步自學到全職接案的——完整過程寫在<a href="/blog/from-part-time-to-freelance/" class="text-amber-300 underline underline-offset-4 hover:text-amber-200">我的轉職故事</a>。
    </p>

    <SectionHeading size="md" class="mt-14">一對一教學經歷</SectionHeading>
    <a
      href="/services/one-on-one/"
      class="mt-4 inline-block rounded-full bg-[#1688e8] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0874c9]"
    >
      查看完整教學案例與收費方式 →
    </a>
    <p class="mt-4 leading-8 text-stone-300/85">帶過的學員從工程師到完全非技術背景都有，雙北實體與線上教學皆可預約。</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {TEACHING_CASES.map((item) => (
        <Card class="p-5">
          <div class="flex items-center gap-3">
            <Image src={item.image} alt={item.imageAlt} width={96} class="h-10 w-10 shrink-0 rounded-xl object-contain" />
            <h3 class="font-semibold leading-snug text-slate-900">{item.topic}</h3>
          </div>
          <p class="mt-3 text-sm text-sky-700">學員背景：{item.student}</p>
        </Card>
      ))}
    </div>

    <SectionHeading size="md" class="mt-14">公眾演講經歷</SectionHeading>
    <a
      href="/services/speaking/"
      class="mt-4 inline-block rounded-full bg-[#1688e8] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0874c9]"
    >
      查看演講紀錄與邀約方式 →
    </a>
    <p class="mt-4 leading-8 text-stone-300/85">全部現場實機演示、帶聽眾動手做；企業、學校與社群的演講或工作坊都可規劃。</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {SPEAKING_ENGAGEMENTS.map((item) => (
        <Card class="p-5">
          <p class="text-xs uppercase tracking-[0.26em] text-sky-700">{item.host}</p>
          <h3 class="mt-2 font-semibold leading-snug text-slate-900">{item.topic}</h3>
        </Card>
      ))}
    </div>

    <SectionHeading size="md" class="mt-14">代表作品：Tooka</SectionHeading>
    <Card padded={false} class="mt-6 overflow-hidden">
      <video
        src="/videos/tooka-workflow-demo.mp4"
        controls
        preload="metadata"
        playsinline
        class="w-full"
      ></video>
      <div class="p-6">
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl border border-sky-200/80 bg-sky-50/60 px-4 py-3">
            <p class="font-semibold text-slate-900">中文描述需求</p>
            <p class="mt-1 text-sm leading-6 text-slate-600">AI Agent 生成整組 1080×1350 IG 輪播圖文</p>
          </div>
          <div class="rounded-2xl border border-sky-200/80 bg-sky-50/60 px-4 py-3">
            <p class="font-semibold text-slate-900">不跑版、不失真</p>
            <p class="mt-1 text-sm leading-6 text-slate-600">文字用程式渲染、版型用模板鎖定</p>
          </div>
          <div class="rounded-2xl border border-sky-200/80 bg-sky-50/60 px-4 py-3">
            <p class="font-semibold text-slate-900">一鍵發佈</p>
            <p class="mt-1 text-sm leading-6 text-slate-600">Facebook、Instagram、Threads 同步上稿</p>
          </div>
        </div>
        <div class="mt-5 flex flex-wrap gap-4">
          <a
            href="https://tooka.js0980420.workers.dev/"
            target="_blank"
            rel="noreferrer"
            class="rounded-full bg-[#1688e8] px-5 py-2.5 font-semibold text-white transition hover:bg-[#0874c9]"
          >
            線上直接使用 Tooka →
          </a>
          <a
            href="https://github.com/js0980420/tooka"
            target="_blank"
            rel="noreferrer"
            class="rounded-full border border-sky-200 bg-white px-5 py-2.5 font-semibold text-[#1688e8] transition hover:border-sky-400 hover:bg-sky-50"
          >
            查看 GitHub 原始碼 →
          </a>
        </div>
      </div>
    </Card>

    <SectionHeading size="md" class="mt-14">經歷與代表作品</SectionHeading>
    <ul class="mt-6 space-y-4">
      {EXPERIENCE.map((item) => <CheckItem>{item.text}</CheckItem>)}
    </ul>

    <SectionHeading size="md" class="mt-14">教學主題</SectionHeading>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {AUTHOR.knowsAbout.map((topic) => (
        <li class="rounded-2xl border border-sky-200/80 bg-white/80 px-5 py-3 text-slate-700 shadow-[0_6px_20px_rgba(30,64,175,0.04)]">{topic}</li>
      ))}
    </ul>

    <Cta />
  </div>
</Base>
