---
import { Image } from 'astro:assets';
import teachingOneOnOne from '../assets/teaching-one-on-one.jpg';
import Cta from '../components/Cta.astro';
import FaqList from '../components/FaqList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { AUTHOR, LINKS, SERVICE_SITE, SITE, breadcrumbSchema, pageBannerUrl } from '../consts';
import { ONE_ON_ONE_FAQS } from '../data/faqs';
import { CLASS_FORMATS, TEACHING_CONTENT } from '../data/services';
import ServiceBase from '../layouts/ServiceBase.astro';

const schema = [
  breadcrumbSchema([
    { name: '服務首頁', item: `${SERVICE_SITE.url}/` },
    { name: 'AI 一對一私人教學' },
  ]),
  {
    '@type': 'Service',
    '@id': `${SERVICE_SITE.url}/course/#service`,
    name: 'AI 一對一私人教學',
    serviceType: 'AI 教學 / 一對一家教',
    description:
      '付費一對一 AI 私人教學，主題是「跟 AI 對話就能拍片」：用開源工具 HyperFrames，從腳本、剪輯、字幕、配音、封面圖到多平台發佈，只靠對話完成。雙北咖啡廳實體課或 Google Meet / Discord 線上課。',
    provider: { '@id': AUTHOR.id },
    areaServed: ['台北市', '新北市', '線上（台灣與海外皆可）'],
    availableChannel: [
      { '@type': 'ServiceChannel', name: '實體課（雙北咖啡廳）' },
      { '@type': 'ServiceChannel', name: '線上課（Google Meet / Discord）' },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: ONE_ON_ONE_FAQS.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];

const pageToc = [
  { id: 'course-content', label: '教學內容' },
  { id: 'course-formats', label: '形式與費用' },
  { id: 'faq', label: '常見問題' },
];

const courseBanner = pageBannerUrl('one-on-one');
const courseBannerPath = new URL(courseBanner).pathname;
---

<ServiceBase
  title="AI 一對一私人教學｜雙北實體、線上皆可的付費 AI 家教"
  description="付費一對一 AI 私人教學，主題是「跟 AI 對話就能拍片」：用開源工具 HyperFrames，從腳本、剪輯、字幕、配音、封面圖到多平台發佈，只靠對話完成。雙北咖啡廳實體課或 Google Meet / Discord 線上課。"
  ogImage={courseBanner}
  ogImageAlt="AI 一對一私人教學｜講師 Alex"
  schema={schema}
>
  <div class="mx-auto w-full max-w-6xl px-5 py-8 sm:px-6 sm:py-12">
    <Breadcrumbs items={[{ name: '服務首頁', href: `${SERVICE_SITE.url}/` }, { name: 'AI 一對一私人教學' }]} class="mb-7 sm:mb-10" />

    <section class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(320px,0.8fr)] lg:items-start lg:gap-16">
      <div class="pt-2 lg:pt-6">
        <p class="font-mono text-xs font-medium tracking-[0.12em] text-accent">付費一對一 AI 私人教學</p>
        <h1 class="mt-5 max-w-[11ch] font-serif text-[clamp(2.5rem,6.5vw,4.5rem)] font-semibold leading-[1.12] tracking-[-0.045em] text-ink">
          AI 一對一私人教學
        </h1>
        <p class="mt-6 max-w-[38rem] text-base leading-8 text-ink-2 sm:text-lg sm:leading-9">
          這是付費的一對一 AI 私人教學服務：由我（<a href={`${SITE.url}/about/`} target="_blank" rel="noreferrer" class="font-semibold text-accent underline underline-offset-4">{AUTHOR.name}</a>）手把手帶你，在<strong class="font-semibold text-ink">你自己的電腦</strong>上，學會<strong class="font-semibold text-ink">跟 AI 對話就能拍片</strong>——從腳本、剪輯、字幕、配音、封面圖到多平台發佈，都用說的完成。
        </p>
        <ul class="mt-7 grid gap-3 text-[15px] leading-7 text-ink sm:grid-cols-2">
          <li class="flex gap-3 border-t border-rule pt-3"><span class="font-mono text-accent" aria-hidden="true">01</span><span>雙北實體或線上教學</span></li>
          <li class="flex gap-3 border-t border-rule pt-3"><span class="font-mono text-accent" aria-hidden="true">02</span><span>一次 3 小時，依目標安排</span></li>
        </ul>
        <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap">
          <a href="#course-content" class="inline-flex min-h-13 items-center justify-center border border-rule-3 px-7 font-semibold text-ink no-underline transition hover:bg-paper-2">看教學內容</a>
        </div>
      </div>

      <aside class="border border-rule-2 bg-paper-2" aria-label="課程預約摘要">
        <img src={courseBannerPath} alt="AI 一對一私人教學｜講師 Alex" width="1200" height="630" fetchpriority="high" class="h-auto w-full border-b border-rule-2" />
        <div class="p-5 sm:p-6">
          <p class="font-mono text-[11px] tracking-[0.12em] text-accent">預約摘要</p>
          <dl class="mt-4 divide-y divide-rule border-y border-rule">
            <div class="grid grid-cols-[5rem_1fr] gap-4 py-3.5">
              <dt class="text-sm text-ink-3">時間</dt>
              <dd class="font-semibold text-ink">3 小時</dd>
            </div>
            <div class="grid grid-cols-[5rem_1fr] gap-4 py-3.5">
              <dt class="text-sm text-ink-3">費用</dt>
              <dd><strong class="font-semibold text-ink">NT$1,000／小時起</strong><span class="mt-1 block text-xs leading-5 text-ink-3">第二位起每位 NT$800／小時</span></dd>
            </div>
            <div class="grid grid-cols-[5rem_1fr] gap-4 py-3.5">
              <dt class="text-sm text-ink-3">地點</dt>
              <dd class="text-sm leading-6 text-ink">雙北咖啡廳／線上</dd>
            </div>
          </dl>
          <p class="mt-4 text-sm leading-6 text-ink-3">先告訴我想完成的目標，我會回覆適合的主題與堂數。</p>
        </div>
      </aside>
    </section>

    <nav aria-label="課程目錄" class="mt-12 overflow-x-auto border-y border-rule lg:mt-16">
      <ul class="flex min-w-max sm:grid sm:min-w-0 sm:grid-cols-3">
        {pageToc.map((item) => (
          <li class="min-w-28 flex-1">
            <a
              href={`#${item.id}`}
              class="block px-3 py-4 text-center font-semibold text-ink transition hover:bg-paper-2 hover:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <section id="course-content" class="scroll-mt-24 pt-16 lg:pt-24">
      <div class="grid gap-8 lg:grid-cols-[minmax(280px,0.78fr)_minmax(0,1.22fr)] lg:items-start lg:gap-12">
        <figure>
          <Image
            src={teachingOneOnOne}
            alt="Alex 與學員進行一對一 AI 實體教學"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 38vw, 100vw"
            class="aspect-[4/5] w-full border border-rule-2 object-cover object-[center_62%]"
          />
          <figcaption class="px-0.5 pt-3 text-sm leading-6 text-ink-3">
            一對一實體上課紀錄；課程會直接使用學員自己的電腦完成設定。學員影像已做隱私處理。
          </figcaption>
        </figure>
        <div>
          <p class="font-mono text-xs tracking-[0.12em] text-accent">教學內容</p>
          <SectionHeading size="md" class="mt-3">可以一起完成的內容</SectionHeading>
          <ol class="mt-6 border-t border-rule">
            {TEACHING_CONTENT.map((item, index) => (
              <li class="grid gap-3 border-b border-rule py-6 sm:grid-cols-[3rem_1fr] sm:gap-5">
                <span class="font-mono text-xs text-accent">0{index + 1}</span>
                <div>
                  <h3 class="text-lg font-semibold leading-7 text-ink">{item.category}</h3>
                  <p class="mt-2 text-[15px] leading-7 text-ink-2">{item.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section id="course-formats" class="scroll-mt-24 pt-16 lg:pt-24">
      <p class="font-mono text-xs tracking-[0.12em] text-accent">上課資訊</p>
      <SectionHeading size="md" class="mt-3">選擇適合你的上課方式</SectionHeading>
      <div class="mt-8 grid border-y border-rule sm:grid-cols-2">
        {CLASS_FORMATS.map((format, index) => (
          <article class:list={['py-7', index === 0 ? 'sm:border-r sm:pr-8' : 'border-t border-rule sm:border-t-0 sm:pl-8']}>
            <p class="font-mono text-xs text-accent">0{index + 1}</p>
            <h3 class="mt-3 text-xl font-semibold text-ink">{format.title}</h3>
            <p class="mt-3 leading-7 text-ink-2">{format.description}</p>
          </article>
        ))}
      </div>
      <div class="mt-8 grid gap-6 bg-ink p-6 text-white sm:grid-cols-[1fr_auto] sm:items-center sm:p-8">
        <div>
          <p class="text-sm text-[#c9c5c0]">3 小時一對一教學</p>
          <p class="mt-2 text-2xl font-semibold">NT$1,000／小時起</p>
          <p class="mt-2 text-sm leading-6 text-[#c9c5c0]">可安排一對多；第二位起每位 NT$800／小時。</p>
        </div>
      </div>
    </section>

    <SectionHeading id="faq" size="md" class="mt-16 scroll-mt-24 lg:mt-24">常見問題</SectionHeading>
    <div class="mt-7">
      <FaqList faqs={ONE_ON_ONE_FAQS} />
    </div>

    <Cta
      title="想預約或先問問題？"
      text="用 Email 告訴我你的目標和目前程度，我會建議適合的上課方式與堂數。"
      href={LINKS.email}
      label={'Email\n詢問'}
      external={false}
      links={[]}
    />
  </div>
</ServiceBase>
