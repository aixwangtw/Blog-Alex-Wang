---
import { Image } from 'astro:assets';
import teachingOneOnOne from '../assets/teaching-one-on-one.jpg';
import Cta from '../components/Cta.astro';
import FaqList from '../components/FaqList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TeachingTools from '../components/TeachingTools.astro';
import { AUTHOR, LINKS, SERVICE_SITE, SITE, breadcrumbSchema, pageBannerUrl } from '../consts';
import { ONE_ON_ONE_FAQS } from '../data/faqs';
import {
  CLASS_FORMATS,
  TEACHING_CASES,
  TEACHING_CONTENT,
  TEACHING_TOOLS,
} from '../data/services';
import ServiceBase from '../layouts/ServiceBase.astro';

const schema = [
  breadcrumbSchema([
    { name: '服務首頁', item: `${SERVICE_SITE.url}/` },
    { name: 'AI 一對一私人教學' },
  ]),
  {
    '@type': 'Service',
    '@id': `${SERVICE_SITE.url}/course/#service`,
    name: 'AI 一對一私人教學',
    serviceType: 'AI 教學 / 一對一家教',
    description:
      '付費一對一 AI 私人教學：手把手帶零基礎學員完成桌面版 Claude Code / Codex、OpenClaw（龍蝦）、Hermes（愛馬仕）安裝、Meta API 串接與社群自動發文系統。雙北咖啡廳實體課或 Google Meet / Discord 線上課。',
    provider: { '@id': AUTHOR.id },
    areaServed: ['台北市', '新北市', '線上（台灣與海外皆可）'],
    availableChannel: [
      { '@type': 'ServiceChannel', name: '實體課（雙北咖啡廳）' },
      { '@type': 'ServiceChannel', name: '線上課（Google Meet / Discord）' },
    ],
  },
  {
    '@type': 'ItemList',
    '@id': `${SERVICE_SITE.url}/course/#cases`,
    name: '一對一教學實際案例',
    itemListElement: TEACHING_CASES.map((c, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${c.topic}｜學員背景：${c.student}`,
      description: c.description,
      image: new URL(c.image.src, SITE.url).href,
    })),
  },
  {
    '@type': 'ItemList',
    '@id': `${SERVICE_SITE.url}/course/#tools`,
    name: '可教學工具',
    itemListElement: TEACHING_TOOLS.map((t, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: t.note ? `${t.name}（${t.note}）` : t.name,
      image: new URL(t.image.src, SITE.url).href,
    })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: ONE_ON_ONE_FAQS.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];

const pageToc = [
  { id: 'course-cases', label: '實際案例' },
  { id: 'course-content', label: '教學內容' },
  { id: 'course-formats', label: '形式與費用' },
  { id: 'faq', label: '常見問題' },
];

const courseBanner = pageBannerUrl('one-on-one');
const courseBannerPath = new URL(courseBanner).pathname;
---

<ServiceBase
  title="AI 一對一私人教學｜雙北實體、線上皆可的付費 AI 家教"
  description="Alex 提供付費一對一 AI 私人教學：手把手帶你完成 Claude Code / Codex、OpenClaw（龍蝦）、Hermes（愛馬仕）安裝、Meta API 串接與自動發文系統。雙北咖啡廳實體課，或 Google Meet / Discord 線上課。"
  ogImage={courseBanner}
  ogImageAlt="AI 一對一私人教學｜講師 Alex"
  schema={schema}
>
  <div class="mx-auto w-full max-w-6xl px-5 py-8 sm:px-6 sm:py-12">
    <Breadcrumbs items={[{ name: '服務首頁', href: `${SERVICE_SITE.url}/` }, { name: 'AI 一對一私人教學' }]} class="mb-7 sm:mb-10" />

    <section class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(320px,0.8fr)] lg:items-start lg:gap-16">
      <div class="pt-2 lg:pt-6">
        <p class="font-mono text-xs font-medium tracking-[0.12em] text-accent">付費一對一 AI 私人教學</p>
        <h1 class="mt-5 max-w-[11ch] font-serif text-[clamp(2.5rem,6.5vw,4.5rem)] font-semibold leading-[1.12] tracking-[-0.045em] text-ink">
          AI 一對一私人教學
        </h1>
        <p class="mt-6 max-w-[38rem] text-base leading-8 text-ink-2 sm:text-lg sm:leading-9">
          這是付費的一對一 AI 私人教學服務：由我（<a href={`${SITE.url}/about/`} target="_blank" rel="noreferrer" class="font-semibold text-accent underline underline-offset-4">{AUTHOR.name}</a>）手把手帶你，在<strong class="font-semibold text-ink">你自己的電腦、你自己的帳號</strong>上，把 AI 自動化流程真正跑通一次——從四大 AI Agent（Claude Code、Codex、OpenClaw 龍蝦、Hermes 愛馬仕）的安裝使用、<strong class="font-semibold text-ink">讓 AI 可以跟你的社群軟體互動的 API 串接</strong>（例如用 LINE 跟 AI 對話，整理其他平台的訊息），到做出可排程的社群自動發文系統，以及打造你的生圖、拍片工作流。
        </p>
        <ul class="mt-7 grid gap-3 text-[15px] leading-7 text-ink sm:grid-cols-2">
          <li class="flex gap-3 border-t border-rule pt-3"><span class="font-mono text-accent" aria-hidden="true">01</span><span>雙北實體或線上教學</span></li>
          <li class="flex gap-3 border-t border-rule pt-3"><span class="font-mono text-accent" aria-hidden="true">02</span><span>一次 3 小時，依目標安排</span></li>
        </ul>
        <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap">
          <a href={LINKS.line} target="_blank" rel="noreferrer" class="inline-flex min-h-13 items-center justify-center bg-accent px-7 font-semibold text-white no-underline transition hover:bg-accent-2">LINE 免費諮詢</a>
          <a href="#course-cases" class="inline-flex min-h-13 items-center justify-center border border-rule-3 px-7 font-semibold text-ink no-underline transition hover:bg-paper-2">先看實際案例</a>
        </div>
      </div>

      <aside class="border border-rule-2 bg-paper-2" aria-label="課程預約摘要">
        <img src={courseBannerPath} alt="AI 一對一私人教學｜講師 Alex" width="1200" height="630" fetchpriority="high" class="h-auto w-full border-b border-rule-2" />
        <div class="p-5 sm:p-6">
          <p class="font-mono text-[11px] tracking-[0.12em] text-accent">預約摘要</p>
          <dl class="mt-4 divide-y divide-rule border-y border-rule">
            <div class="grid grid-cols-[5rem_1fr] gap-4 py-3.5">
              <dt class="text-sm text-ink-3">時間</dt>
              <dd class="font-semibold text-ink">3 小時</dd>
            </div>
            <div class="grid grid-cols-[5rem_1fr] gap-4 py-3.5">
              <dt class="text-sm text-ink-3">費用</dt>
              <dd><strong class="font-semibold text-ink">NT$1,000／小時起</strong><span class="mt-1 block text-xs leading-5 text-ink-3">第二位起每位 NT$800／小時</span></dd>
            </div>
            <div class="grid grid-cols-[5rem_1fr] gap-4 py-3.5">
              <dt class="text-sm text-ink-3">地點</dt>
              <dd class="text-sm leading-6 text-ink">雙北咖啡廳／線上</dd>
            </div>
          </dl>
          <p class="mt-4 text-sm leading-6 text-ink-3">先告訴我想完成的目標，我會回覆適合的主題與堂數。</p>
        </div>
      </aside>
    </section>

    <nav aria-label="課程目錄" class="mt-12 overflow-x-auto border-y border-rule lg:mt-16">
      <ul class="flex min-w-max sm:grid sm:min-w-0 sm:grid-cols-4">
        {pageToc.map((item) => (
          <li class="min-w-28 flex-1">
            <a
              href={`#${item.id}`}
              class="block px-3 py-4 text-center font-semibold text-ink transition hover:bg-paper-2 hover:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <section id="course-cases" class="scroll-mt-24 pt-16 lg:pt-24">
      <p class="font-mono text-xs tracking-[0.12em] text-accent">實際教學案例</p>
      <div class="mt-3 grid gap-4 lg:grid-cols-[1fr_0.8fr] lg:items-end">
        <SectionHeading size="md">實際教學案例</SectionHeading>
        <p class="leading-7 text-ink-2 lg:text-right">以下是四個實際的一對一教學案例，涵蓋不同背景的學員與客製化主題。</p>
      </div>
      <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(280px,0.78fr)_minmax(0,1.22fr)] lg:items-start lg:gap-8">
        <figure class="overflow-hidden border border-rule-2 bg-paper-2">
          <Image
            src={teachingOneOnOne}
            alt="Alex 與學員進行一對一 AI 實體教學"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 38vw, 100vw"
            class="aspect-[4/5] w-full object-cover object-[center_62%]"
          />
          <figcaption class="border-t border-rule px-5 py-4 text-sm leading-6 text-ink-3">
            一對一實體上課紀錄；課程會直接使用學員自己的電腦完成設定。學員影像已做隱私處理。
          </figcaption>
        </figure>
        <ol class="grid gap-4 sm:grid-cols-2">
          {TEACHING_CASES.map((item, index) => (
            <li class="flex min-h-full flex-col border border-rule-2 bg-paper-2 p-5 sm:p-6">
              <div class="flex items-center justify-between gap-4 border-b border-rule pb-4">
                <span class="font-mono text-xs text-accent">CASE 0{index + 1}</span>
                <Image src={item.image} alt={item.imageAlt} width={96} class="h-9 w-9 object-contain" />
              </div>
              <p class="mt-5 text-xs font-semibold tracking-[0.08em] text-accent">{item.student}</p>
              <h3 class="mt-2 text-lg font-semibold leading-8 text-ink">{item.topic}</h3>
              <p class="mt-3 text-[15px] leading-7 text-ink-2">{item.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="course-content" class="scroll-mt-24 pt-16 lg:pt-24">
      <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
        <div>
          <p class="font-mono text-xs tracking-[0.12em] text-accent">依需求選擇主題</p>
          <SectionHeading size="md" class="mt-3">可以一起完成的內容</SectionHeading>
          <p class="mt-4 max-w-md leading-8 text-ink-2">不必一次學完所有工具。預約前先說明目標，再把 3 小時集中在最需要的主題。</p>
        </div>
        <ol class="border-t border-rule">
          {TEACHING_CONTENT.map((item, index) => (
            <li class="grid gap-3 border-b border-rule py-6 sm:grid-cols-[3rem_1fr_auto] sm:gap-5">
              <span class="font-mono text-xs text-accent">0{index + 1}</span>
              <div>
                <h3 class="text-lg font-semibold leading-7 text-ink">{item.category}</h3>
                <p class="mt-2 text-[15px] leading-7 text-ink-2">{item.detail}</p>
              </div>
              {item.logos && (
                <div class="flex gap-2 sm:justify-end">
                  {item.logos.map((logo) => (
                    <Image src={logo.image} alt={logo.alt} width={96} class="h-8 w-8 object-cover" />
                  ))}
                </div>
              )}
            </li>
          ))}
        </ol>
      </div>
      <div class="mt-10 border-l-2 border-accent pl-5 sm:pl-7">
        <h3 class="text-lg font-semibold text-ink">目前可教學工具</h3>
        <TeachingTools />
      </div>
    </section>

    <section id="course-formats" class="scroll-mt-24 pt-16 lg:pt-24">
      <p class="font-mono text-xs tracking-[0.12em] text-accent">上課資訊</p>
      <SectionHeading size="md" class="mt-3">選擇適合你的上課方式</SectionHeading>
      <div class="mt-8 grid border-y border-rule sm:grid-cols-2">
        {CLASS_FORMATS.map((format, index) => (
          <article class:list={['py-7', index === 0 ? 'sm:border-r sm:pr-8' : 'border-t border-rule sm:border-t-0 sm:pl-8']}>
            <p class="font-mono text-xs text-accent">0{index + 1}</p>
            <h3 class="mt-3 text-xl font-semibold text-ink">{format.title}</h3>
            <p class="mt-3 leading-7 text-ink-2">{format.description}</p>
          </article>
        ))}
      </div>
      <div class="mt-8 grid gap-6 bg-ink p-6 text-white sm:grid-cols-[1fr_auto] sm:items-center sm:p-8">
        <div>
          <p class="text-sm text-[#c9c5c0]">3 小時一對一教學</p>
          <p class="mt-2 text-2xl font-semibold">NT$1,000／小時起</p>
          <p class="mt-2 text-sm leading-6 text-[#c9c5c0]">可安排一對多；第二位起每位 NT$800／小時。</p>
        </div>
        <a href={LINKS.line} target="_blank" rel="noreferrer" class="inline-flex min-h-13 items-center justify-center bg-accent px-7 font-semibold text-white no-underline transition hover:bg-accent-2">詢問適合堂數</a>
      </div>
    </section>

    <SectionHeading id="faq" size="md" class="mt-16 scroll-mt-24 lg:mt-24">常見問題</SectionHeading>
    <div class="mt-7">
      <FaqList faqs={ONE_ON_ONE_FAQS} />
    </div>

    <Cta
      title="想預約或先問問題？"
      text="加 LINE 告訴我你的目標和目前程度，我會建議適合的上課方式與堂數。"
      links={[{ href: LINKS.email, label: 'Email 聯絡' }]}
    />
  </div>
</ServiceBase>
