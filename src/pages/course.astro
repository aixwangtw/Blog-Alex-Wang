---
import { Image } from 'astro:assets';
import Card from '../components/Card.astro';
import Cta from '../components/Cta.astro';
import FaqList from '../components/FaqList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TeachingTools from '../components/TeachingTools.astro';
import { AUTHOR, LINKS, SERVICE_SITE, SITE, breadcrumbSchema, pageBannerUrl } from '../consts';
import { ONE_ON_ONE_FAQS } from '../data/faqs';
import {
  CLASS_FORMATS,
  TEACHING_CASES,
  TEACHING_CONTENT,
  TEACHING_TOOLS,
} from '../data/services';
import ServiceBase from '../layouts/ServiceBase.astro';

const schema = [
  breadcrumbSchema([
    { name: '服務首頁', item: `${SERVICE_SITE.url}/` },
    { name: 'AI 一對一私人教學' },
  ]),
  {
    '@type': 'Service',
    '@id': `${SERVICE_SITE.url}/course/#service`,
    name: 'AI 一對一私人教學',
    serviceType: 'AI 教學 / 一對一家教',
    description:
      '付費一對一 AI 私人教學：手把手帶零基礎學員完成桌面版 Claude Code / Codex、OpenClaw（龍蝦）、Hermes（愛馬仕）安裝、Meta API 串接與社群自動發文系統。雙北咖啡廳實體課或 Google Meet / Discord 線上課。',
    provider: { '@id': AUTHOR.id },
    areaServed: ['台北市', '新北市', '線上（台灣與海外皆可）'],
    availableChannel: [
      { '@type': 'ServiceChannel', name: '實體課（雙北咖啡廳）' },
      { '@type': 'ServiceChannel', name: '線上課（Google Meet / Discord）' },
    ],
  },
  {
    '@type': 'ItemList',
    '@id': `${SERVICE_SITE.url}/course/#cases`,
    name: '一對一教學實際案例',
    itemListElement: TEACHING_CASES.map((c, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${c.topic}｜學員背景：${c.student}`,
      description: c.description,
      image: new URL(c.image.src, SITE.url).href,
    })),
  },
  {
    '@type': 'ItemList',
    '@id': `${SERVICE_SITE.url}/course/#tools`,
    name: '可教學工具',
    itemListElement: TEACHING_TOOLS.map((t, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: t.note ? `${t.name}（${t.note}）` : t.name,
      image: new URL(t.image.src, SITE.url).href,
    })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: ONE_ON_ONE_FAQS.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];

const pageToc = [
  { id: 'course-formats', label: '上課形式' },
  { id: 'course-cases', label: '實際案例' },
  { id: 'course-content', label: '教學內容' },
  { id: 'faq', label: '常見問題' },
];

const courseBanner = pageBannerUrl('one-on-one');
const courseBannerPath = new URL(courseBanner).pathname;
---

<ServiceBase
  title="AI 一對一私人教學｜雙北實體、線上皆可的付費 AI 家教"
  description="Alex 提供付費一對一 AI 私人教學：手把手帶你完成 Claude Code / Codex、OpenClaw（龍蝦）、Hermes（愛馬仕）安裝、Meta API 串接與自動發文系統。雙北咖啡廳實體課，或 Google Meet / Discord 線上課。"
  ogImage={courseBanner}
  ogImageAlt="AI 一對一私人教學｜講師 Alex"
  schema={schema}
>
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-6 sm:py-14">
    <Breadcrumbs items={[{ name: '服務首頁', href: `${SERVICE_SITE.url}/` }, { name: 'AI 一對一私人教學' }]} class="mb-8" />

    <section class="grid items-center gap-9 lg:grid-cols-[1fr_0.92fr] lg:gap-14">
      <div>
        <p class="text-sm font-semibold text-accent">付費一對一 AI 私人教學</p>
        <h1 class="t-h1 mt-3 font-semibold text-ink">AI 一對一私人教學</h1>
        <p class="mt-6 text-base leading-8 text-ink sm:text-lg sm:leading-9">
          這是付費的一對一 AI 私人教學服務：由我（<a href={`${SITE.url}/about/`} class="text-accent underline underline-offset-4">{AUTHOR.name}</a>）手把手帶你，在<strong class="text-accent">你自己的電腦、你自己的帳號</strong>上，把 AI 自動化流程真正跑通一次——從四大 AI Agent（Claude Code、Codex、OpenClaw 龍蝦、Hermes 愛馬仕）的安裝使用、<strong class="text-accent">讓 AI 可以跟你的社群軟體互動的 API 串接</strong>（例如用 LINE 跟 AI 對話，整理其他平台的訊息），到做出可排程的社群自動發文系統，以及打造你的生圖、拍片工作流。
        </p>
        <dl class="mt-7 grid gap-4 sm:grid-cols-2">
          <div class="border-t-2 border-accent py-4">
            <dt class="text-sm text-ink-3">課程時間</dt>
            <dd class="mt-2 text-xl font-semibold text-ink">3 小時</dd>
          </div>
          <div class="border-t-2 border-accent py-4">
            <dt class="text-sm text-ink-3">教學費用</dt>
            <dd class="mt-2 text-xl font-semibold text-ink">NT$1,000／小時起</dd>
            <dd class="mt-1 text-sm leading-6 text-ink-2">第二位起每位 NT$800／小時</dd>
          </div>
        </dl>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={LINKS.line} target="_blank" rel="noreferrer" class="inline-flex min-h-12 items-center bg-[#06c755] px-6 font-semibold text-white no-underline">LINE 免費諮詢</a>
          <a href={LINKS.email} class="inline-flex min-h-12 items-center border border-rule-2 px-6 font-semibold text-ink no-underline">Email 聯絡</a>
        </div>
      </div>
      <img src={courseBannerPath} alt="AI 一對一私人教學｜講師 Alex" width="1200" height="630" fetchpriority="high" class="h-auto w-full border border-rule" />
    </section>

    <nav aria-label="課程目錄" class="mt-10 overflow-x-auto border-y border-rule">
      <ul class="flex min-w-max sm:grid sm:min-w-0 sm:grid-cols-4">
        {pageToc.map((item) => (
          <li class="min-w-28 flex-1">
            <a
              href={`#${item.id}`}
              class="block px-3 py-4 text-center font-semibold text-ink transition hover:bg-paper-2 hover:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <SectionHeading id="course-formats" size="md" class="mt-16 scroll-mt-24">上課形式</SectionHeading>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {CLASS_FORMATS.map((format) => (
        <Card>
          <h3 class="text-xl font-semibold text-ink">{format.title}</h3>
          <p class="mt-3 leading-7 text-ink-2">{format.description}</p>
        </Card>
      ))}
    </div>
    <p class="mt-5 border-l-2 border-accent pl-4 leading-7 text-ink-2">
      也可安排一對多教學：第一位學員依原價計費，<strong class="font-semibold text-ink">第二位起每位教學費用享八折</strong>。
    </p>

    <SectionHeading id="course-cases" size="md" class="mt-16 scroll-mt-24">實際教學案例</SectionHeading>
    <p class="mt-4 leading-7 text-ink-2">
      以下是四個實際的一對一教學案例，涵蓋不同背景的學員與客製化主題：
    </p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {TEACHING_CASES.map((item) => (
        <Card>
          <div class="flex items-center gap-3">
            <Image src={item.image} alt={item.imageAlt} width={96} class="h-10 w-10 shrink-0 object-contain" />
            <h3 class="text-lg font-semibold leading-snug text-ink">{item.topic}</h3>
          </div>
          <p class="mt-3 text-sm text-accent">學員背景：{item.student}</p>
          <p class="mt-3 leading-7 text-ink-2">{item.description}</p>
        </Card>
      ))}
    </div>

    <SectionHeading id="course-content" size="md" class="mt-16 scroll-mt-24">教學內容</SectionHeading>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {TEACHING_CONTENT.map((item) => (
        <Card>
          <h3 class="text-xl font-semibold text-ink">{item.category}</h3>
          {item.logos && (
            <div class="mt-4 flex gap-2.5">
              {item.logos.map((logo) => (
                <Image src={logo.image} alt={logo.alt} width={96} class="h-9 w-9 object-cover" />
              ))}
            </div>
          )}
          <p class="mt-3 leading-7 text-ink-2">{item.detail}</p>
        </Card>
      ))}
    </div>
    <h3 class="mt-9 text-xl font-semibold text-ink">可教學工具</h3>
    <TeachingTools />

    <SectionHeading id="faq" size="md" class="mt-16 scroll-mt-24">常見問題</SectionHeading>
    <div class="mt-6">
      <FaqList faqs={ONE_ON_ONE_FAQS} />
    </div>

    <Cta
      title="想預約或先問問題？"
      text="加 LINE 告訴我你的目標和目前程度，我會建議適合的上課方式與堂數。"
      links={[{ href: LINKS.email, label: 'Email 聯絡' }]}
    />
  </div>
</ServiceBase>
