---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import FaqList from '../../components/FaqList.astro';
import { AUTHOR, AUTHOR_INTROS, CTA_VARIANTS, SITE, pickVariant } from '../../consts';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, faqs } = post.data;

const postUrl = `${SITE.url}/blog/${post.id}/`;
// 每篇文章使用已定案的 1200×630 靜態橫幅，檔名與 Directus slug 相同。
const postImage = new URL(`/images/blog/${post.id}.png`, SITE.url).href;
// 多長寬比 schema image（Google 文章富摘要建議的 16:9、4:3、1:1）與頁面用 WebP，
// 皆由 tools/optimize-blog-banners.mjs 從 PNG 自動衍生
const schemaImages = [
  new URL(`/images/blog/${post.id}-16x9.webp`, SITE.url).href,
  new URL(`/images/blog/${post.id}-4x3.webp`, SITE.url).href,
  new URL(`/images/blog/${post.id}-1x1.webp`, SITE.url).href,
];

// 文章目錄：從已渲染的 HTML 抽出 h2 錨點（id 由 content.config.ts 的 marked renderer 產生）
const toc = [...(post.rendered?.html ?? '').matchAll(/<h2 id="([^"]+)">(.*?)<\/h2>/g)].map(
  (m) => ({ id: m[1], text: m[2].replace(/<[^>]+>/g, '') }),
);
if (faqs.length > 0 && !toc.some((item) => item.id === 'faq')) {
  toc.push({ id: 'faq', text: 'FAQ 常見問題' });
}

const schema: object[] = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${postUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: '部落格', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
  {
    '@type': 'BlogPosting',
    '@id': `${postUrl}#article`,
    headline: title,
    description,
    inLanguage: 'zh-TW',
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: { '@id': AUTHOR.id },
    publisher: { '@id': AUTHOR.id },
    mainEntityOfPage: postUrl,
    image: schemaImages,
  },
];

if (faqs.length > 0) {
  schema.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}

const dateText = pubDate.toLocaleDateString('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
// 發佈與更新時間並列顯示：時效訊號對搜尋結果點擊率有幫助
const updatedText = updatedDate
  ? updatedDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<Base
  title={`${title}｜${SITE.title}`}
  description={description}
  schema={schema}
  ogType="article"
  ogImage={postImage}
  noindex={post.data.unlisted}
>
  <article class="mx-auto max-w-3xl px-6 py-12">
    {/* 這裡原本是手寫的麵包屑（「›」分隔、text-sm），跟其他 8 個頁面用的
        Breadcrumbs 元件不一致——分隔符、字級、aria-current 都不同。
        改用元件後全站同一套：等寬「/」分隔、13px、最後一項帶 aria-current="page"。 */}
    <Breadcrumbs
      items={[{ name: '首頁', href: '/' }, { name: '部落格', href: '/blog/' }, { name: title }]}
    />

    <header class="mt-8">
      <h1 class="t-h1 font-semibold text-ink">{title}</h1>
      {/* 中繼資料：改版前是四行藥丸標籤（發佈日 bg-paper-2、更新日 bg-accent-tint、
          每個 tag 一顆 rounded-full 外框）。改成 PostCard 已經在用的「一行、以・分隔」。
          兩個理由：
          1. /blog/ 列表跟文章頁呈現的是同一組欄位（發佈日／更新日／tags）。
             列表已經是一行純文字，文章頁還是四行藥丸，讀者從列表點進來會看到
             同一份資料的兩種樣子。
          2. 藥丸標籤是舊語言的殘留（見 resources.astro 的註解：改版後卡片與
             藥丸標籤全站移除，分類靠字級與字距分出來）。
          <time datetime> 完全保留，時效訊號與結構化資料不受影響。 */}
      <p class="mt-5 text-[13px] leading-7 text-ink-3">
        <span>作者：<a href="/about/" class="text-ink-2 transition-colors hover:text-accent">{AUTHOR.name}</a></span>
        <span class="px-1.5 text-rule-3" aria-hidden="true">・</span>
        <span>發佈於 <time datetime={pubDate.toISOString()}>{dateText}</time></span>
        {updatedText && (
          <>
            <span class="px-1.5 text-rule-3" aria-hidden="true">・</span>
            <span>更新於 <time datetime={updatedDate!.toISOString()}>{updatedText}</time></span>
          </>
        )}
        {post.data.tags.map((tag) => (
          <>
            <span class="px-1.5 text-rule-3" aria-hidden="true">・</span>
            <span>{tag}</span>
          </>
        ))}
      </p>

      {/* 目錄：改版前是 rounded-[1.75rem] ＋ bg-surface ＋ shadow 的卡片盒。
          改成上下各一條髮絲線夾住的區塊（border-y），不加底色也不加陰影。
          這裡用 border-y 而不是 Card 慣用的 border-t：Card 的 border-t 是給
          連續列表用的（線畫在每一列頭上，最後一列不多出懸空的收尾線）；
          目錄是一個「單獨的、要跟前後內容分開」的單元，只有一條頭線時
          它會跟上面的中繼資料黏成一塊，讀不出是一個獨立的區塊。
          「目錄」二字改用全站的等寬小標，序號用等寬數字左對齊——
          目錄本來就是一份索引，等寬數字讓序號欄自己對齊，不必給固定寬度。
          連結維持 accent：這一頁是搜尋落地頁，目錄是讀者第一個要點的東西，
          不能靠 hover 才看得出可點。 */}
      <nav aria-label="文章目錄" class="mt-8 border-y border-rule px-0.5 py-6">
        <p class="font-mono text-[11.5px] tracking-[0.12em] text-ink-3">目錄</p>
        <ol class="mt-4 space-y-2.5">
          {toc.map((item, i) => (
            <li class="flex gap-3 leading-7">
              <span class="shrink-0 font-mono text-[13px] tabular-nums text-ink-3" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <a href={`#${item.id}`} class="text-accent underline-offset-4 hover:underline">{item.text}</a>
            </li>
          ))}
        </ol>
      </nav>

      {/* 橫幅圖：拿掉圓角與陰影，只留 1px 邊框（同 PostCard 的縮圖與 about 的人像）。
          不套灰階——橫幅是文章的內容識別，不是裝飾。 */}
      <img
        src={`/images/blog/${post.id}.webp`}
        alt={title}
        width="1200"
        height="630"
        fetchpriority="high"
        class="mt-8 w-full border border-rule"
      />
    </header>

    <div class="prose-blog mt-10">
      <Content />
    </div>

    {faqs.length > 0 && (
      <section id="faq" class="mt-14 scroll-mt-24">
        <h2 class="mb-6 text-2xl font-semibold text-ink">FAQ 常見問題</h2>
        <FaqList faqs={faqs} />
      </section>
    )}

    {/* 關於作者：改版前是 rounded-[1.75rem] ＋ bg-surface ＋ shadow 的卡片盒。
        改成一條頭線的區塊（border-t），不加收尾線——後面緊接著 Cta，
        而 Cta 自己的第一件事就是畫一條 border-top，補了會變成兩條並排的線。
        標題從 18px 粗體降成等寬小標：這一段是文末的作者署名，
        不是一個要跟上面 FAQ 同級的內容章節，字級要說出這件事。 */}
    <section class="mt-14 border-t border-rule px-0.5 pt-7">
      <h2 class="font-mono text-[11.5px] tracking-[0.12em] text-ink-3">關於作者</h2>
      <p class="mt-3 leading-8 text-ink-2">
        {AUTHOR.name}——{AUTHOR_INTROS[pickVariant(post.id, AUTHOR_INTROS.length)]}
        <a href="/about/" class="text-accent underline underline-offset-4">完整介紹</a>
      </p>
    </section>

    <Cta {...CTA_VARIANTS[pickVariant(`cta:${post.id}`, CTA_VARIANTS.length)]} />
  </article>

  <script is:inline>
    // 幫程式碼區塊與引用區塊（提示詞）加上「複製」按鈕與語言標籤。
    // 按鈕的價值來自稀有：output 區塊（指令輸出、錯誤訊息等噪音）不進這個 querySelector，
    // 就不會被加上按鈕——data-code-kind="output" 由 content.config.ts 的 marked renderer 標記。
    (function () {
      function copyText(text) {
        if (navigator.clipboard && window.isSecureContext) {
          return navigator.clipboard.writeText(text);
        }
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
          document.execCommand('copy');
          return Promise.resolve();
        } catch (e) {
          return Promise.reject(e);
        } finally {
          document.body.removeChild(textarea);
        }
      }

      document
        .querySelectorAll(
          '.prose-blog pre:not([data-code-kind="output"]), .prose-blog blockquote:not([data-no-copy])'
        )
        .forEach(function (block) {
          var isPre = block.tagName === 'PRE';
          // 提示詞區塊（fence 或既有 blockquote 寫法）跟 blockquote 一樣用淺色按鈕；
          // 終端機／AI 工具介面指令／其他語言的深色區塊用預設（深色）按鈕
          var isLight = !isPre || block.dataset.codeKind === 'prompt';

          var wrapper = document.createElement('div');
          wrapper.className = 'code-block-wrapper';
          block.parentNode.insertBefore(wrapper, block);
          wrapper.appendChild(block);

          var label = isPre ? block.dataset.codeLabel : null;
          if (label) {
            var tag = document.createElement('span');
            var labelClass = 'code-block-label';
            // AI 工具介面指令（```codex``` ```claude-code```）標籤用強調色，跟終端機的中性灰區分
            if (isLight) labelClass += ' code-block-label--light';
            else if (isPre && block.dataset.codeKind === 'toolcmd') labelClass += ' code-block-label--toolcmd';
            tag.className = labelClass;
            tag.textContent = label;
            wrapper.appendChild(tag);
          }

          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = isLight ? 'copy-code-btn copy-code-btn--light' : 'copy-code-btn';
          btn.textContent = '複製';
          btn.setAttribute('aria-label', label ? '複製' + label : isPre ? '複製程式碼' : '複製內容');
          btn.addEventListener('click', function () {
            var text = block.innerText.replace(/\n$/, '');
            copyText(text).then(
              function () {
                btn.textContent = '已複製 ✓';
                setTimeout(function () { btn.textContent = '複製'; }, 1500);
              },
              function () {
                btn.textContent = '複製失敗';
                setTimeout(function () { btn.textContent = '複製'; }, 1500);
              }
            );
          });
          wrapper.appendChild(btn);
        });
    })();
  </script>
</Base>
