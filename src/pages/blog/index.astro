---
import { blogBannerPath } from '../../lib/blog-banner';
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import PostCard from '../../components/PostCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { DEVELOPMENT_SERVICE, SITE, breadcrumbSchema, pageBannerUrl } from '../../consts';
import Base from '../../layouts/Base.astro';

const schema = [
  breadcrumbSchema([{ name: '首頁', item: `${SITE.url}/` }, { name: '部落格' }]),
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/blog/#webpage`,
    name: '系統開發案例與 AI 實作部落格',
    url: `${SITE.url}/blog/`,
  },
];

const posts = (await getCollection('blog', ({ data }) => !data.unlisted)).sort(
  (a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
    (b.data.cmsId ?? 0) - (a.data.cmsId ?? 0),
);
// 置頂文章：系統開發代表案例，固定排在部落格最上方，不再重複出現在精選格線
const PINNED_ID = 'math-teacher-question-bank';
const pinned = posts.find((post) => post.id === PINNED_ID);
// 精選文章的顯示順序
const FEATURED_ORDER = [
  'how-to-start-learning-ai',
  'free-resources',
  'from-part-time-to-freelance',
  'threads-api-tutorial',
  'instagram-api-tutorial',
];
const featured = posts
  .filter((post) => post.data.featured && post.id !== PINNED_ID)
  .sort((a, b) => FEATURED_ORDER.indexOf(a.id) - FEATURED_ORDER.indexOf(b.id));
const rest = posts.filter((post) => !post.data.featured && post.id !== PINNED_ID);
---

<Base
  title="部落格｜系統開發案例與 AI 實作"
  description="Alex 的系統開發案例與 AI 實作紀錄：置頂的數學題庫系統介紹考卷匯入、AI 出題、AI 詳解；其他文章整理 Claude Code／Codex、Meta API、自動發文與 Skill 工作流的實作做法。"
  ogImage={pageBannerUrl('blog')}
  ogImageAlt="Aix 部落格｜系統開發案例與 AI 實作"
  schema={schema}
>
  <div class="mx-auto max-w-6xl px-6 py-12">
    <Breadcrumbs items={[{ name: '首頁', href: '/' }, { name: '部落格' }]} class="mb-8" />
    <h1 class="t-h1 font-semibold text-ink">部落格</h1>
    <p class="mt-6 text-lg leading-8 text-ink-2">
      這裡記錄我和開發夥伴做過的系統開發案例，以及每天在用的 AI 實作做法。想把手上重複的工作改成 AI 自動化，可以先看<a href={DEVELOPMENT_SERVICE.url} class="text-accent underline underline-offset-4" data-ga-button="blog_intro_development" data-ga-label="系統開發服務" data-ga-location="blog_intro" data-ga-action="navigate">系統開發服務</a>。
    </p>
    {pinned && (
      <section class="mt-12 border-t border-rule pt-8" aria-labelledby="pinned-h">
        <p class="font-mono text-[11.5px] tracking-[0.12em] text-accent">置頂｜系統開發代表案例</p>
        <a href={`/blog/${pinned.id}/`} class="group mt-4 grid items-center gap-6 md:grid-cols-[1.1fr_1fr] md:gap-10" data-ga-button="blog_pinned_article" data-ga-label={pinned.data.title} data-ga-location="blog_pinned" data-ga-action="open_content">
          <img src={blogBannerPath(pinned.id, '.webp')} alt={pinned.data.title} width="1200" height="630" class="w-full border border-rule" />
          <div>
            <h2 id="pinned-h" class="text-2xl font-semibold leading-snug text-ink transition-colors group-hover:text-accent sm:text-3xl">{pinned.data.title}</h2>
            <p class="mt-4 leading-8 text-ink-2">{pinned.data.description}</p>
            <span class="mt-5 inline-block font-mono text-[13px] text-accent" aria-hidden="true">閱讀全文 →</span>
          </div>
        </a>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
          <a href={DEVELOPMENT_SERVICE.url} class="font-semibold text-accent no-underline" data-ga-button="blog_pinned_service" data-ga-label="看系統開發服務" data-ga-location="blog_pinned" data-ga-action="navigate">看系統開發服務 →</a>
          <a href={DEVELOPMENT_SERVICE.demoUrl} target="_blank" rel="noreferrer" class="font-semibold text-accent no-underline" data-ga-button="blog_pinned_demo" data-ga-label="試用題庫系統 Demo" data-ga-location="blog_pinned" data-ga-action="external">試用 Demo ↗</a>
        </div>
      </section>
    )}
    {featured.length > 0 && (
      <>
        <SectionHeading size="md" class="mt-14">精選文章</SectionHeading>
        {/*
          改版前這一排是 rounded-2xl ＋ bg-surface ＋ shadow 的卡片，橫向捲動。
          兩件事一起改：

          1. 卡片盒 → 髮絲線格。每一格只有頭上一條線、沒有底色也沒有陰影，
             多欄時各欄的頭線落在同一條水平線上（Card.astro 說明的同一個道理），
             第二列的頭線又把兩列分開，整組讀起來是一張表。

          2. 拿掉 overflow-x-auto 的橫向捲動。理由不是「捲動不好看」，而是
             下面「全部文章」已經是 PostCard 的髮絲線橫列——一個純靠 1px 線
             構成的版面裡，多出一個會橫向移動的區域，讀者無從判斷那條線
             是不是還在原位。捲動容器也是舊語言唯一還在用「卡片有邊界」
             這個假設的地方（要有邊界才知道被切掉一半的是什麼）。
             改成 2／3 欄的響應式格線：6 篇精選在 1440px 下是 3×2，
             375px 下是 2 欄——縮圖仍有 160px 上下，認得出是哪一篇。

          縮圖維持 border border-rule、不套灰階：同 PostCard，這些是教學截圖，
          讀者靠它認出「是不是我在找的那個工具」。
        */}
        <ul class="mt-6 grid grid-cols-2 gap-x-6 sm:gap-x-8 lg:grid-cols-3">
          {featured.map((post) => (
            <li class="border-t border-rule">
              <a href={`/blog/${post.id}/`} class="group flex h-full flex-col px-0.5 py-6">
                <img
                  src={blogBannerPath(post.id, '-thumb.webp')}
                  alt={post.data.title}
                  width="640"
                  height="336"
                  loading="lazy"
                  class="w-full border border-rule"
                />
                <p class="mt-4 font-mono text-[11.5px] tracking-[0.12em] text-ink-3">{post.data.tags[0]}</p>
                <h3 class="mt-2 text-[15px] font-semibold leading-7 text-ink transition-colors group-hover:text-accent">
                  {post.data.title}
                </h3>
                <span class="mt-auto pt-4 font-mono text-[13px] text-accent" aria-hidden="true">閱讀全文 →</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
    <SectionHeading size="md" class="mt-16">全部文章</SectionHeading>
    <div class="mt-6">
      {rest.map((post) => <PostCard post={post} />)}
    </div>
    <Cta
      title="想把手上的工作改成 AI 自動化？"
      text="先看數學題庫系統的完整介紹，再看系統開發服務的流程與費用。"
      href={DEVELOPMENT_SERVICE.url}
      label={'了解系統\n開發服務'}
      links={[{ href: DEVELOPMENT_SERVICE.caseArticle, label: '看題庫系統介紹' }]}
    />
  </div>
</Base>
