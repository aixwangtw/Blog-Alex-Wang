---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE, breadcrumbSchema, pageBannerUrl } from '../../consts';
import Base from '../../layouts/Base.astro';

const schema = [
  breadcrumbSchema([{ name: '首頁', item: `${SITE.url}/` }, { name: '部落格' }]),
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/blog/#webpage`,
    name: 'AI 新手部落格',
    url: `${SITE.url}/blog/`,
  },
];

const posts = (await getCollection('blog', ({ data }) => !data.unlisted)).sort(
  (a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
    (b.data.cmsId ?? 0) - (a.data.cmsId ?? 0),
);
// 精選文章的顯示順序
const FEATURED_ORDER = [
  'how-to-start-learning-ai',
  'free-resources',
  'from-part-time-to-freelance',
  'why-i-built-tooka',
  'threads-api-tutorial',
  'instagram-api-tutorial',
];
const featured = posts
  .filter((post) => post.data.featured)
  .sort((a, b) => FEATURED_ORDER.indexOf(a.id) - FEATURED_ORDER.indexOf(b.id));
const rest = posts.filter((post) => !post.data.featured);
---

<Base
  title="部落格｜AI 新手常見問題全解答"
  description="用問答形式解答新手學 AI 最常見的問題：Claude Code / Codex 怎麼選、Meta API 怎麼申請、自動發文怎麼做、Skill 是什麼。每篇文章聚焦解決一個新手最常遇到的問題。"
  ogImage={pageBannerUrl('blog')}
  ogImageAlt="AI 新手部落格｜常見問題全解答"
  schema={schema}
>
  <div class="mx-auto max-w-6xl px-6 py-12">
    <Breadcrumbs items={[{ name: '首頁', href: '/' }, { name: '部落格' }]} class="mb-8" />
    <h1 class="t-h1 font-semibold text-ink">部落格</h1>
    <p class="mt-6 text-lg leading-8 text-ink-2">
      每篇文章回答一個新手學 AI 時最常問的問題——從工具選擇、Meta API 申請到自動發文與
      Skill 工作流。看完還有問題，歡迎<a href="/services/one-on-one/" class="text-accent underline underline-offset-4">約一對一教學</a>。
    </p>
    {featured.length > 0 && (
      <>
        <h2 class="mt-12 text-xl font-semibold text-ink">精選文章</h2>
        <div class="mt-6 grid grid-flow-col auto-cols-[minmax(220px,1fr)] gap-4 overflow-x-auto pb-3 xl:auto-cols-fr">
          {featured.map((post) => (
            <a
              href={`/blog/${post.id}/`}
              class="flex flex-col rounded-2xl border border-rule bg-surface/80 p-5 shadow-[0_8px_24px_rgba(22,22,26,0.05)] transition hover:border-accent-line-2 hover:shadow-[0_10px_28px_rgba(22,22,26,0.1)]"
            >
              <img
                src={`/images/blog/${post.id}-thumb.webp`}
                alt={post.data.title}
                width="640"
                height="336"
                loading="lazy"
                class="mb-4 w-full rounded-xl border border-rule"
              />
              <span class="text-xs uppercase tracking-wide text-accent">{post.data.tags[0]}</span>
              <h3 class="mt-3 text-sm font-semibold leading-6 text-ink">{post.data.title}</h3>
              <span class="mt-4 text-xs font-semibold text-accent">閱讀全文 →</span>
            </a>
          ))}
        </div>
      </>
    )}
    <h2 class="mt-12 text-xl font-semibold text-ink">全部文章</h2>
    <div class="mt-6 grid gap-5">
      {rest.map((post) => <PostCard post={post} />)}
    </div>
    <Cta />
  </div>
</Base>
