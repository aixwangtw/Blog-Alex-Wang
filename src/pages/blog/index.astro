---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import PostCard from '../../components/PostCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { SITE, breadcrumbSchema, pageBannerUrl } from '../../consts';
import Base from '../../layouts/Base.astro';

const schema = [
  breadcrumbSchema([{ name: '首頁', item: `${SITE.url}/` }, { name: '部落格' }]),
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/blog/#webpage`,
    name: 'AI 新手部落格',
    url: `${SITE.url}/blog/`,
  },
];

const posts = (await getCollection('blog', ({ data }) => !data.unlisted)).sort(
  (a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
    (b.data.cmsId ?? 0) - (a.data.cmsId ?? 0),
);
// 精選文章的顯示順序
const FEATURED_ORDER = [
  'how-to-start-learning-ai',
  'free-resources',
  'from-part-time-to-freelance',
  'why-i-built-tooka',
  'threads-api-tutorial',
  'instagram-api-tutorial',
];
const featured = posts
  .filter((post) => post.data.featured)
  .sort((a, b) => FEATURED_ORDER.indexOf(a.id) - FEATURED_ORDER.indexOf(b.id));
const rest = posts.filter((post) => !post.data.featured);
---

<Base
  title="部落格｜AI 新手常見問題全解答"
  description="用問答形式解答新手學 AI 最常見的問題：Claude Code / Codex 怎麼選、Meta API 怎麼申請、自動發文怎麼做、Skill 是什麼。每篇文章聚焦解決一個新手最常遇到的問題。"
  ogImage={pageBannerUrl('blog')}
  ogImageAlt="AI 新手部落格｜常見問題全解答"
  schema={schema}
>
  <div class="mx-auto max-w-6xl px-6 py-12">
    <Breadcrumbs items={[{ name: '首頁', href: '/' }, { name: '部落格' }]} class="mb-8" />
    <h1 class="t-h1 font-semibold text-ink">部落格</h1>
    <p class="mt-6 text-lg leading-8 text-ink-2">
      每篇文章回答一個新手學 AI 時最常問的問題——從工具選擇、Meta API 申請到自動發文與
      Skill 工作流。看完還有問題，歡迎<a href="/services/ai-tutor/" class="text-accent underline underline-offset-4">約一對一教學</a>。
    </p>
    {featured.length > 0 && (
      <>
        <SectionHeading size="md" class="mt-14">精選文章</SectionHeading>
        {/*
          改版前這一排是 rounded-2xl ＋ bg-surface ＋ shadow 的卡片，橫向捲動。
          兩件事一起改：

          1. 卡片盒 → 髮絲線格。每一格只有頭上一條線、沒有底色也沒有陰影，
             多欄時各欄的頭線落在同一條水平線上（Card.astro 說明的同一個道理），
             第二列的頭線又把兩列分開，整組讀起來是一張表。

          2. 拿掉 overflow-x-auto 的橫向捲動。理由不是「捲動不好看」，而是
             下面「全部文章」已經是 PostCard 的髮絲線橫列——一個純靠 1px 線
             構成的版面裡，多出一個會橫向移動的區域，讀者無從判斷那條線
             是不是還在原位。捲動容器也是舊語言唯一還在用「卡片有邊界」
             這個假設的地方（要有邊界才知道被切掉一半的是什麼）。
             改成 2／3 欄的響應式格線：6 篇精選在 1440px 下是 3×2，
             375px 下是 2 欄——縮圖仍有 160px 上下，認得出是哪一篇。

          縮圖維持 border border-rule、不套灰階：同 PostCard，這些是教學截圖，
          讀者靠它認出「是不是我在找的那個工具」。
        */}
        <ul class="mt-6 grid grid-cols-2 gap-x-6 sm:gap-x-8 lg:grid-cols-3">
          {featured.map((post) => (
            <li class="border-t border-rule">
              <a href={`/blog/${post.id}/`} class="group flex h-full flex-col px-0.5 py-6">
                <img
                  src={`/images/blog/${post.id}-thumb.webp`}
                  alt={post.data.title}
                  width="640"
                  height="336"
                  loading="lazy"
                  class="w-full border border-rule"
                />
                <p class="mt-4 font-mono text-[11.5px] tracking-[0.12em] text-ink-3">{post.data.tags[0]}</p>
                <h3 class="mt-2 text-[15px] font-semibold leading-7 text-ink transition-colors group-hover:text-accent">
                  {post.data.title}
                </h3>
                <span class="mt-auto pt-4 font-mono text-[13px] text-accent" aria-hidden="true">閱讀全文 →</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
    <SectionHeading size="md" class="mt-16">全部文章</SectionHeading>
    <div class="mt-6">
      {rest.map((post) => <PostCard post={post} />)}
    </div>
    <Cta />
  </div>
</Base>
