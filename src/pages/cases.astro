---
// /cases/ — 開發案例列表（2026-10-31 新增）
// 導覽「開發案例」比照 service.deanlife.blog 的「品牌案例」直接連到這一頁；
// 版型比照 joinx.co/case-studies/ 的卡片列表：頁首標籤篩選＋等寬等高卡片格線（桌機 3 欄、平板 2 欄、手機 1 欄）。
// 規則（AGENTS.md「開發案例頁」）：
// - 只放有真實系統截圖、而且可以公開的案例；客戶的系統要客戶同意才放。
// - 截圖統一 16:10（1440×900 拍），資料用 Demo 站或本機偽真資料，不得有真實個資或老師資料。
// - 標籤只寫真實屬性（產業／系統類型／技術特色），篩選按鈕由案例標籤自動產生。
import CasesBeyondNote from '../components/CasesBeyondNote.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { CASES_BEYOND_NOTE, SECTION_NAMES, SITE, breadcrumbSchema, lineCategoryUrl } from '../consts';
import { DEV_CASES, DEV_CATEGORIES, FEATURE_TAGS, caseFeatureTags, devCategoryTitle } from '../data/cases';
import Base from '../layouts/Base.astro';
import CaseCarousel from '../components/CaseCarousel.astro';

const CASES = DEV_CASES;
// 篩選用類別名稱（與首頁類別卡同一套）；沒有案例的類別點選時顯示「聊聊需求」卡
const CATEGORIES = DEV_CATEGORIES.map((item) => item.title);
const EMPTY_CATEGORIES = DEV_CATEGORIES.filter((category) => !CASES.some((item) => item.categories.includes(category.key)));

const schema = [
  breadcrumbSchema([{ name: '首頁', item: `${SITE.url}/` }, { name: SECTION_NAMES.cases }]),
  {
    '@type': 'ItemList',
    name: SECTION_NAMES.cases,
    itemListElement: CASES.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      url: item.link.href,
    })),
  },
];
---

<Base
  title={`${SECTION_NAMES.cases}｜Aix 系統開發做過的系統`}
  description="Aix 系統開發做過的系統，每個案例附真實系統畫面，可依系統類型篩選；數學題庫系統可以直接試用 Demo。"
  schema={schema}
>
  <div class="cases-page">
    <Breadcrumbs items={[{ name: '首頁', href: '/' }, { name: SECTION_NAMES.cases }]} />

    <h1 class="t-h1 mt-8 font-semibold text-ink">{SECTION_NAMES.cases}</h1>
    <p class="cases-lead">每個案例附系統的真實畫面。需要登入的後台用示範資料拍，公開網站直接拍線上畫面；可以試用或已上線的系統附連結。<CasesBeyondNote /></p>

    <div class="cases-filter" role="group" aria-label="依標籤篩選案例" hidden data-cases-filter data-feature-names={JSON.stringify(FEATURE_TAGS)}>
      <button type="button" class="cases-pill" aria-pressed="true" data-tag="" data-ga-button="cases_filter_all" data-ga-label="篩選：全部" data-ga-location="cases_filter" data-ga-action="filter">全部</button>
      {CATEGORIES.map((tag) => (
        <button type="button" class="cases-pill" aria-pressed="false" data-tag={tag} data-ga-button={`cases_filter_${tag}`} data-ga-label={`篩選：${tag}`} data-ga-location="cases_filter" data-ga-action="filter">{tag}</button>
      ))}
    </div>

    <p class="cases-feature" hidden data-cases-feature>功能篩選：<strong data-cases-feature-label></strong><a href="/cases/" data-cases-feature-clear data-ga-button="cases_feature_clear" data-ga-label="清除功能篩選" data-ga-location="cases_filter" data-ga-action="filter">清除</a></p>
    <ul class="cases-grid" data-cases-grid>
      {CASES.map((item) => (
        <li data-tags={item.categories.map(devCategoryTitle).join('|')} data-features={[...new Set(item.images.map((image) => image.featureTag))].join('|')}>
          <article class="cases-card">
            <CaseCarousel class="cases-card-thumb" groupKey={item.key} gaLocation="cases_grid" slides={item.images.map((image) => ({ src: image.src, alt: image.alt, label: FEATURE_TAGS[image.featureTag] }))} />
            <div class="cases-card-body">
              <h2>{item.title}</h2>
              <p>{item.summary}</p>
              <div class="cases-card-foot">
              <ul class="cases-tags" aria-label="標籤">
                {item.categories.map((key) => <li class="is-category">{devCategoryTitle(key)}</li>)}
                {caseFeatureTags(item).map((tag) => <li>{FEATURE_TAGS[tag]}</li>)}
              </ul>
              <a
                class="cases-card-link"
                href={item.link.href}
                target={item.link.external ? '_blank' : undefined}
                rel={item.link.external ? 'noreferrer' : undefined}
                data-ga-button={`cases_${item.key}`}
                data-ga-label={`${item.title}：${item.link.label}`}
                data-ga-location="cases_grid"
                data-ga-action={item.link.external ? 'external' : 'navigate'}
              >{item.link.label} <span aria-hidden="true">{item.link.external ? '↗' : '→'}</span></a>
              </div>
            </div>
          </article>
        </li>
      ))}
      {EMPTY_CATEGORIES.map(({ title: category, emptyNote }) => (
        <li data-tags={category} data-empty-card hidden>
          <article class="cases-card cases-card--empty">
            <div class="cases-card-thumb cases-card-placeholder" aria-hidden="true">{category}</div>
            <div class="cases-card-body">
              <h2>{category}</h2>
              <p>{emptyNote}聊聊需求，聊完可以先提供試用 Demo。</p>
              <a
                class="cases-card-link"
                href={lineCategoryUrl(category)}
                target="_blank"
                rel="noreferrer"
                data-ga-button={`cases_empty_${category}`}
                data-ga-label={`${category}：聊聊需求`}
                data-ga-location="cases_grid"
                data-ga-action="external"
              >LINE 聊聊需求 <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        </li>
      ))}
    </ul>

  </div>
</Base>

<style>
  .cases-page { max-width: 1200px; margin: 0 auto; padding: 48px 24px 64px; }
  .cases-lead { margin-top: 20px; max-width: 48rem; font-size: 17px; line-height: 1.8; color: var(--color-ink-2); }
  .cases-filter { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .cases-filter[hidden] { display: none; }
  .cases-pill { min-height: 40px; padding: 8px 18px; border: 1px solid var(--color-rule-2); border-radius: 999px; background: transparent; font-size: 15px; color: var(--color-ink-2); cursor: pointer; }
  .cases-pill:hover { border-color: var(--color-ink-3); }
  .cases-pill[aria-pressed='true'] { border-color: var(--color-ink); background: var(--color-ink); color: var(--color-bg, #fff); }
  .cases-grid { display: grid; grid-template-columns: minmax(0, 1fr); grid-auto-rows: 1fr; gap: 24px; margin: 28px 0 0; padding: 0; list-style: none; }
  @media (min-width: 768px) { .cases-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .cases-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cases-grid > li { display: flex; min-width: 0; }
  .cases-grid > li[hidden] { display: none; }
  .cases-card { display: flex; flex: 1; flex-direction: column; overflow: hidden; border: 1px solid var(--color-rule-2); border-radius: 8px; background: rgb(255 255 255 / 40%); }
  .cases-card-thumb { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: left top; border-bottom: 1px solid var(--color-rule-2); }
  .cases-card-body { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 20px 22px 22px; }
  /* 全頁卡片同尺寸：標題固定 2 行、說明固定行數（line-clamp），標籤與連結在貼底區塊，卡內元素相對位置每張相同 */
  .cases-card-body h2 { display: -webkit-box; height: calc(1.4em * 2); overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font-size: 20px; line-height: 1.4; font-weight: 700; color: var(--color-ink); }
  .cases-card-body > p { --desc-lines: 3; display: -webkit-box; height: calc(1.75em * var(--desc-lines)); margin-top: 8px; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: var(--desc-lines); line-height: 1.75; color: var(--color-ink-2); }
  @media (max-width: 1023px) and (min-width: 768px), (max-width: 360px) { .cases-card-body > p { --desc-lines: 4; } }
  .cases-card-foot { display: flex; flex-direction: column; margin-top: auto; padding-top: 14px; }
  .cases-tags { display: flex; flex-wrap: wrap; align-content: flex-start; height: 62px; overflow: hidden; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .cases-tags li { flex: none; white-space: nowrap; padding: 3px 10px; border-radius: 999px; background: rgb(0 0 0 / 5%); font-size: 13px; color: var(--color-ink-2); }
  .cases-card-link { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; margin-top: 12px; font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .cases-tags li.is-category { background: var(--color-ink); color: var(--color-bg, #fff); }
  .cases-card--empty { border-style: dashed; }
  .cases-feature { margin-top: 16px; font-size: 15px; color: var(--color-ink-2); }
  .cases-feature[hidden] { display: none; }
  .cases-feature a { display: inline-flex; align-items: center; min-height: 44px; margin-left: 12px; color: var(--color-accent); }
  .cases-card--empty .cases-card-link { margin-top: auto; }
  .cases-card-placeholder { display: flex; align-items: center; justify-content: center; background: rgb(0 0 0 / 3%); font-size: 22px; font-weight: 600; color: var(--color-ink-3); }
  @media (max-width: 767px) { .cases-page { padding: 32px 16px 48px; } }
</style>

<script>
  // 標籤篩選：無 JS 時按鈕列維持 hidden、卡片全部顯示
  const filter = document.querySelector<HTMLElement>('[data-cases-filter]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-cases-grid] > li')];
  if (filter) {
    filter.hidden = false;
    const applyTag = (button: HTMLButtonElement) => {
      const tag = button.dataset.tag ?? '';
      filter.querySelectorAll('button').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      // 聊聊需求卡要和案例卡等高：顯示前先量一張可見案例卡的高度
      const sample = items.find((item) => !item.hidden && !item.hasAttribute('data-empty-card'));
      const caseHeight = sample ? sample.getBoundingClientRect().height : 0;
      for (const item of items) {
        if (item.hasAttribute('data-empty-card') && caseHeight) item.style.minHeight = `${caseHeight}px`;
        const isEmptyCard = item.hasAttribute('data-empty-card');
        // 「全部」只列真實案例；聊聊需求卡只在點到沒有案例的類別時出現
        item.hidden = tag ? !(item.dataset.tags ?? '').split('|').includes(tag) : isEmptyCard;
      }
    };
    filter.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-tag]');
      if (button) applyTag(button);
    });
    // 網址帶 ?tag=<類別> 時直接篩選（首頁「AI 應用」類別卡用）
    const initialTag = new URLSearchParams(location.search).get('tag');
    const initialButton = initialTag
      ? [...filter.querySelectorAll<HTMLButtonElement>('button[data-tag]')].find((button) => button.dataset.tag === initialTag)
      : undefined;
    if (initialButton) applyTag(initialButton);
    // 網址帶 ?feature=<功能 key> 時，只顯示含該功能截圖的案例（首頁輪播的功能標籤用；可與類別篩選並存）
    const featureKey = new URLSearchParams(location.search).get('feature');
    const featureNames: Record<string, string> = JSON.parse(filter.dataset.featureNames ?? '{}');
    if (featureKey && featureNames[featureKey]) {
      const note = document.querySelector<HTMLElement>('[data-cases-feature]');
      const label = document.querySelector<HTMLElement>('[data-cases-feature-label]');
      if (note && label) { label.textContent = featureNames[featureKey]; note.hidden = false; }
      const applyFeature = () => items.forEach((item) => {
        if (!item.hidden && !(item.dataset.features ?? '').split('|').includes(featureKey)) item.hidden = true;
      });
      applyFeature();
      filter.addEventListener('click', () => window.setTimeout(applyFeature, 0));
    }
  }
</script>
