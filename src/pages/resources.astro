---
import { blogBannerPath } from '../lib/blog-banner';
// ============================================================
// /resources/ — 免費資源專區（2026-08 改版第三階段一併新建）
// ------------------------------------------------------------
// 為什麼要有這一頁：改版後的首頁四個入口第一個就是「免費資源 → /resources/」，
// Hero 的主 CTA 也指向這裡。沒有這一頁，首頁最主要的兩個行動點都是 404。
//
// 內容從何而來：CMS 文章 free-resources 的內文，改寫成常設頁面的結構。
// 事實（影片、工具、連結、動機說明）跟原文一致，沒有新增也沒有更動；
// 改的只是敘事順序——原本是一篇「我來介紹一下」的文章，現在是一份常設清單。
//
// 為什麼不從 CMS 撈：那篇文章之後要下架，而公開 API 不回傳草稿，
// 撈法會在下架當天讓這一頁沒有內容。頁面之後由站主直接改這個檔維護。
//
// 資料仍然集中在 src/data/：
//   FAQ  → src/data/faqs.ts 的 RESOURCES_FAQS
//
// ⚠ 已知的中間狀態：/resources/ 與 /blog/free-resources/ 會同時存在、內容重複。
//    下架那篇文章與加轉址不在本階段範圍，由 coordinator 收尾。
// ============================================================
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import FaqList from '../components/FaqList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { LINKS, SITE, breadcrumbSchema, pageBannerUrl } from '../consts';
import { RESOURCES_FAQS } from '../data/faqs';
import Base from '../layouts/Base.astro';
import { CODEX_RESOURCE, FEEDBACK_DESK_RESOURCE, GRILL_ME_RESOURCE, RESOURCES_INTRO } from '../data/resources';

// 這裡原本有一段 HyperFrames（站主是該開源專案的協作者）。2026-08-06 移除，
// 理由：這是「免費資源」頁，每一項都應該點得進去用。而站上沒有 HyperFrames 的
// 教學文章或示範影片、repo 裡也沒有它的網址，那一段只能寫「我是協作者」——
// 一個點不了的免費資源，對讀者沒有用。
// 之後若有了對應的文章、影片或可公開的連結，再加回來。

const schema = [
  breadcrumbSchema([{ name: '首頁', item: `${SITE.url}/` }, { name: '免費資源' }]),
  // 免費資源頁輸出與畫面一致的 FAQPage；/faq/ 也會從同一份 RESOURCES_FAQS
  // 彙整顯示，因此之後增修免費資源問題時不需要再手動複製到總整理頁。
  {
    '@type': 'FAQPage',
    '@id': `${SITE.url}/resources/#faq`,
    mainEntity: RESOURCES_FAQS.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<Base
  title="免費資源｜Claude Code、Codex 安裝教學與開源工具"
  description="Claude Code、Codex 兩個工具都有安裝教學，再免費取得可直接交給 AI 安裝的 Skills。先自己動手做，卡關再來問。"
  ogImage={pageBannerUrl('resources')}
  ogImageAlt="免費資源：Claude Code、Codex 安裝教學與開源工具"
  schema={schema}
>
  <div class="mx-auto max-w-3xl px-6 py-12">
    <Breadcrumbs items={[{ name: '首頁', href: '/' }, { name: '免費資源' }]} />

    <h1 class="t-h1 mt-8 font-semibold text-ink">免費資源</h1>
    <p class="mt-6 text-lg leading-8 text-ink-2">
      {RESOURCES_INTRO}
    </p>

    <!-- ---------- 第一步：Claude Code／Codex 安裝 ---------- -->
    <SectionHeading size="md" class="mt-14">{CODEX_RESOURCE.heading}</SectionHeading>
    <p class="mt-5 leading-8 text-ink-2">
      {CODEX_RESOURCE.intro}
    </p>
    <ul class="mt-7 grid gap-5">
      {CODEX_RESOURCE.tools.map((tool) => (
        <li class="overflow-hidden border border-rule bg-white/40">
          <div class="grid h-full items-center sm:grid-cols-2">
            <img
              src={blogBannerPath(tool.thumbSlug, '-thumb.webp')}
              alt={tool.alt}
              class="aspect-video w-full object-cover"
              loading="lazy"
              width="640"
              height="360"
            />
            <div class="p-5">
              <strong class="t-h3 block font-semibold text-ink">{tool.name}</strong>
              <p class="mt-2 leading-7 text-ink-2">{tool.description}</p>
              <ul class="mt-3 grid gap-1">
                {tool.links.map((link) => (
                  <li><a href={`/blog/${link.slug}/`} class="inline-block py-2.5 font-semibold text-accent underline underline-offset-4" data-ga-button={`resources_install_${link.slug}`} data-ga-label={link.label} data-ga-location="resources_install" data-ga-action="navigate">{link.label}<span aria-hidden="true"> →</span></a></li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <!-- ---------- 第二步：Skills ---------- -->
    <SectionHeading size="md" class="mt-16">{GRILL_ME_RESOURCE.heading}</SectionHeading>
    <div class="mt-6 grid items-stretch overflow-hidden border border-rule bg-white/40 sm:grid-cols-[minmax(280px,0.9fr)_minmax(0,1.1fr)]">
      <div class="flex min-w-0 justify-center bg-ink">
        <video
          class="aspect-[9/16] h-auto w-full object-cover"
          src="/videos/grill-me-reel.mp4"
          poster="/images/grill-me-reel-poster.webp"
          controls
          preload="metadata"
          playsinline
          aria-label="grill-me Skill Instagram Reels"
        />
      </div>
      <div class="flex h-full flex-col justify-center p-6 sm:p-7">
        <p class="font-mono text-[11.5px] tracking-[0.12em] text-accent">{GRILL_ME_RESOURCE.label}</p>
        <h3 class="t-h3 mt-2 font-semibold text-ink"><code>{GRILL_ME_RESOURCE.name}</code>{GRILL_ME_RESOURCE.titleSuffix}</h3>
        <p class="mt-3 leading-7 text-ink-2">
          {GRILL_ME_RESOURCE.descriptionBefore}<code class="rounded bg-paper-2 px-1.5 py-0.5 text-sm text-ink">{GRILL_ME_RESOURCE.command}</code>{GRILL_ME_RESOURCE.descriptionAfter}
        </p>
        <ul class="mt-3 grid gap-1.5 text-sm leading-6 text-ink-2">
          {GRILL_ME_RESOURCE.points.map((point) => <li>— {point}</li>)}
        </ul>
        <dl class="mt-4 grid grid-cols-4 border-y border-rule">
          <div class="py-3 pr-2">
            <dt class="text-xs text-ink-3">{GRILL_ME_RESOURCE.stats[0].label}</dt>
            <dd class="mt-1 font-mono text-lg font-semibold text-ink">{GRILL_ME_RESOURCE.stats[0].value}</dd>
          </div>
          <div class="border-l border-rule px-3 py-3">
            <dt class="text-xs text-ink-3">{GRILL_ME_RESOURCE.stats[1].label}</dt>
            <dd class="mt-1 font-mono text-lg font-semibold text-ink">{GRILL_ME_RESOURCE.stats[1].value}</dd>
          </div>
          <div class="border-l border-rule px-3 py-3">
            <dt class="text-xs text-ink-3">{GRILL_ME_RESOURCE.stats[2].label}</dt>
            <dd class="mt-1 font-mono text-lg font-semibold text-ink">{GRILL_ME_RESOURCE.stats[2].value}</dd>
          </div>
          <div class="border-l border-rule py-3 pl-3">
            <dt class="text-xs text-ink-3">{GRILL_ME_RESOURCE.stats[3].label}</dt>
            <dd class="mt-1 font-mono text-lg font-semibold text-ink">{GRILL_ME_RESOURCE.stats[3].value}</dd>
          </div>
        </dl>
        <p class="mt-2 text-xs leading-5 text-ink-3">{GRILL_ME_RESOURCE.statsSource}</p>
        <div class="mt-4 flex flex-wrap gap-3">
          {/* 文章草稿下線中，按鈕暫時隱藏。重新上線時取消註解：
          <a
            href="/blog/matt-pocock-skills/"
            class="inline-flex min-h-11 items-center rounded-[3px] bg-accent px-5 py-2.5 font-semibold text-white no-underline transition hover:bg-accent-2"
          >看完整介紹與流程</a>
          */}
          <a
            href={GRILL_ME_RESOURCE.repoUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex min-h-11 items-center rounded-[3px] border border-rule-2 px-5 py-2.5 font-semibold text-ink no-underline transition hover:border-accent hover:text-accent"
          >查看 Skills 原始碼</a>
          <a
            href={GRILL_ME_RESOURCE.instagramUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex min-h-11 items-center px-1 py-2.5 font-semibold text-accent underline underline-offset-4"
          >在 Instagram 查看</a>
        </div>
        <p class="mt-5 font-semibold text-ink">複製這段，貼給你的 AI：</p>
        <div class="relative mt-3 overflow-hidden rounded-[3px] border border-rule-2 bg-paper-2">
          <pre id="grill-me-install-prompt" class="overflow-x-auto whitespace-pre-wrap px-4 py-4 pr-20 text-sm leading-7 text-ink"><code>{GRILL_ME_RESOURCE.installPrompt}</code></pre>
          <button
            type="button"
            class="absolute right-2 top-2 min-h-9 rounded-[3px] border border-rule-2 bg-white px-3 text-xs font-semibold text-accent"
            data-copy-target="grill-me-install-prompt"
            data-ga-button="resources_copy_grill_me_skill"
            data-ga-label="複製 grill-me 安裝提示"
            data-ga-location="resources_skills"
            data-ga-action="copy_prompt"
            aria-label="複製 grill-me 安裝提示"
          >複製</button>
        </div>
        <p class="mt-3 text-sm leading-6 text-ink-3">{GRILL_ME_RESOURCE.installNote}</p>
      </div>
    </div>

    <!-- ---------- 開源工具：feedback-desk ---------- -->
    <SectionHeading size="md" class="mt-16">{FEEDBACK_DESK_RESOURCE.heading}</SectionHeading>
    <p class="mt-5 leading-8 text-ink-2">
      {FEEDBACK_DESK_RESOURCE.intro}
    </p>
    <div class="mt-7 overflow-hidden border border-rule bg-white/40">
      <a href={FEEDBACK_DESK_RESOURCE.articleHref} class="group grid h-full items-center no-underline sm:grid-cols-2">
        <img
          src={blogBannerPath('feedback-desk', '-thumb.webp')}
          alt="feedback-desk 開源 PM溝通工具介紹文章縮圖"
          class="aspect-video w-full object-cover"
          loading="lazy"
          width="640"
          height="360"
        />
        <span class="block p-5">
          <span class="font-mono text-[11.5px] tracking-[0.12em] text-accent">{FEEDBACK_DESK_RESOURCE.label}</span>
          <strong class="t-h3 mt-2 block font-semibold text-ink group-hover:text-accent">{FEEDBACK_DESK_RESOURCE.title}</strong>
          <span class="mt-2 block leading-7 text-ink-2">{FEEDBACK_DESK_RESOURCE.description}</span>
        </span>
      </a>
      <div class="border-t border-rule p-6 sm:p-7">
        <div class="flex flex-wrap gap-3">
          <a
            href={FEEDBACK_DESK_RESOURCE.repoUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex min-h-11 items-center rounded-[3px] border border-rule-2 px-5 py-2.5 font-semibold text-ink no-underline transition hover:border-accent hover:text-accent"
          >查看 GitHub 原始碼</a>
        </div>
        <p class="mt-5 font-semibold text-ink">複製這段，貼給你的 AI：</p>
        <div class="relative mt-3 overflow-hidden rounded-[3px] border border-rule-2 bg-paper-2">
          <pre id="feedback-desk-install-prompt" class="overflow-x-auto whitespace-pre-wrap break-all px-4 py-4 pr-20 text-sm leading-7 text-ink"><code>{FEEDBACK_DESK_RESOURCE.installPrompt}</code></pre>
          <button
            type="button"
            class="absolute right-2 top-2 min-h-9 rounded-[3px] border border-rule-2 bg-white px-3 text-xs font-semibold text-accent"
            data-copy-target="feedback-desk-install-prompt"
            data-ga-button="resources_copy_feedback_desk"
            data-ga-label="複製 feedback-desk 安裝提示"
            data-ga-location="resources_open_source"
            data-ga-action="copy_prompt"
            aria-label="複製 feedback-desk 安裝提示"
          >複製</button>
        </div>
        <p class="mt-3 text-sm leading-6 text-ink-3">{FEEDBACK_DESK_RESOURCE.installNote}</p>
      </div>
    </div>

    <!-- ---------- FAQ ---------- -->
    <!-- 這三題的 FAQPage schema 在上面的 frontmatter 輸出，理由見那裡的註解：
         原本的宣告來源（CMS 文章 free-resources）已下架，這裡是現在唯一的宣告。
         注意這跟「首頁移除 FAQPage」不衝突：首頁那份是重複宣告，這份是唯一宣告。 -->
    <SectionHeading size="md" class="mt-16">常見問題</SectionHeading>
    <div class="mt-6">
      <FaqList faqs={RESOURCES_FAQS} />
    </div>

    <Cta
      title="有問題想問？"
      text="先裝好 Claude Code 或 Codex，再試用 Skills。卡住了可以到 Facebook 社團發問；如果你想的是為自己的工作做一套系統，也可以看看系統開發服務。"
      hint="免費資源用完還卡關，右下角官方 LINE 和 Facebook 社團都能問"
      links={[{ href: LINKS.facebookGroup, label: 'Facebook 社團', external: true }]}
    />
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach((button) => {
      button.addEventListener('click', async () => {
        const targetId = button.dataset.copyTarget;
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;

        const text = target.textContent?.trim() ?? '';
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
          } else {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            textarea.remove();
          }
          (window as any).siteToast?.({ title: '已複製安裝提示', text: '貼給你的 AI Agent，說「幫我安裝」' });
          button.textContent = '已複製 ✓';
          window.setTimeout(() => (button.textContent = '複製'), 1500);
        } catch {
          (window as any).siteToast?.({ title: '複製失敗，請手動選取上方文字複製' });
          button.textContent = '請手動複製';
          window.setTimeout(() => (button.textContent = '複製'), 1800);
        }
      });
    });
  </script>
</Base>
