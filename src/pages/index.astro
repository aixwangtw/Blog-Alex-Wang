    .case-mini-grid span {
      margin-top: 7px;
      font-size: 11.5px;
      line-height: 1.5;
      color: var(--color-accent);
    }
    @media (max-width: 767px) {
      .service-details {
        padding-top: 64px;
      }
      .service-row {
        padding: 48px 0;
      }
      .service-media {
        order: -1;
        aspect-ratio: 16 / 10;
      }
      .service-copy > p:not(.service-kicker) {
        font-size: 15px;
      }
      .case-mini-grid {
        order: -1;
      }
      .case-mini-grid li {
        grid-template-columns: 32px minmax(0, 1fr);
        min-height: 112px;
        padding: 12px;
      }
      .case-mini-icon {
        width: 32px;
        height: 32px;
      }
      .case-mini-grid strong {
        font-size: 12px;
      }
    }

    /* ---------- 結尾 CTA ---------- */
    .closer {
      padding-top: 76px;
    }
    @media (min-width: 768px) {
      .closer {
        padding-top: 120px;
      }
    }
    .closer-p {
      margin-top: 18px;
      font-size: 15.5px;
      line-height: 1.95;
      color: var(--color-ink-2);
      max-width: 52ch;
    }

    /* ============================================================
       hover 一律加裝置條件：觸控裝置上 :hover 會「黏住」，
       點過的元件會停在 hover 狀態直到點別的地方。
       :focus-visible 另外寫一份、不設任何條件。
       ============================================================ */
    @media (hover: hover) and (pointer: fine) {
      .btn-line:hover {
        background: #05b34c;
        border-color: #05b34c;
        transform: translateY(-1px);
      }
      .paths-list a:hover {
        background: rgb(255 255 255 / 60%);
      }
      .paths-list a:hover .p-t {
        color: var(--color-accent);
      }
    }

    /* 鍵盤焦點：不靠 hover 也要有等價的視覺回饋（不設裝置條件） */
    .paths-list a:focus-visible {
      background: rgb(255 255 255 / 60%);
    }
    .paths-list a:focus-visible .p-t {
      color: var(--color-accent);
    }

    /* ============================================================
       逐段浮現：內容一律寫在 HTML 裡，只有「顯示與否」交給 CSS。
       沒有 JS 時 .js 不會加上，全部維持完整可見。
       IntersectionObserver 掛掉時另有 2 秒逾時強制顯示（見上方 script）。
       ============================================================ */
    .home.js .reveal {
      opacity: 0.3;
      transform: translateY(30px);
      transition:
        opacity 0.6s var(--ease) var(--d, 0ms),
        transform 0.6s var(--ease) var(--d, 0ms);
    }
    .home.js .reveal.is-in {
      opacity: 1;
      transform: translateY(0);
    }

    /* 首屏：0 + 70 + 140ms 延遲，各 200ms —— 總揭露 340ms */
    .home.js .hero-reveal {
      opacity: 0.3;
      transform: translateY(30px);
      transition:
        opacity 0.2s var(--ease) var(--d, 0ms),
        transform 0.2s var(--ease) var(--d, 0ms);
    }
    .home.js .hero-reveal.is-in {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .home.js .reveal,
      .home.js .hero-reveal,
      .home.js .reveal.is-in,
      .home.js .hero-reveal.is-in {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      /* 只關過渡，不寫任何 :hover 選擇器。
         「所有 hover 收在 @media (hover:hover) and (pointer:fine) 裡」是硬規則，
         在這裡補一條 .btn-line:hover{transform:none} 會是全站唯一一條沒有裝置
         條件的 hover 規則。而且它也沒有必要：那顆按鈕的 translateY(-1px) 本來就
         只在有滑鼠的裝置上生效，過渡一關就是瞬間位移，不構成前庭風險的動態。 */
      .btn,
      .paths-list a,
      .p-t,
      .terminal-typed,
      .terminal-command > i,
      .terminal-thinking,
      .terminal-done,
      .terminal-thinking i {
        transition: none !important;
        animation: none !important;
      }
      .terminal-typed {
        max-width: 18em;
      }
      .terminal-command > i,
      .terminal-thinking {
        display: none;
      }
      .terminal-done {
        opacity: 1;
        transform: none;
      }
    }
  </style>
</Base>
