---
// ============================================================
// 首頁（2026-08 改版第三階段）
// ------------------------------------------------------------
// 版面、字級、字距補償、全形問號修剪、捲動揭露的唯一真實來源是
// public/_preview/home-b4-lean.html（變體 B-v4「精簡版」）。
// 這個檔案是把該原型做進 Astro，頁首與頁尾改由 src/layouts/Base.astro 提供。
//
// 改版前是 239 行、七個區塊（免費資源、教學案例、演講經歷、教學內容、
// 精選文章、FAQ、CTA）。原型的結論是：首頁字放到 96px 也救不了資訊過載，
// 所以砍到五個單元 —— 頁首／Hero（含三張服務卡）／信任證明／結尾 CTA／頁尾。
//
// 被移除的區塊都另有去處，沒有內容因此消失：
//   TEACHING_CASES      → /services/one-on-one/、/about/
//   SPEAKING_ENGAGEMENTS→ /services/speaking/、/about/
//   TEACHING_CONTENT    → /services/one-on-one/
//   HOME_FAQS           → /faq/
//   精選文章             → /blog/
//   VIDEOS              → /resources/（本階段一併新建；VIDEOS 原本只有首頁在用）
//
// schema 的兩個處理，方向相反，不可弄錯：
//   Course  保留。它的 teaches 來自 SYLLABUS，而 SYLLABUS 本來就不 render 成畫面、
//           只餵 schema，因此區塊移除不影響它，資料與 schema 都留著。
//   FAQPage 移除。/faq/ 已經有 2 份 FAQPage（HOME_FAQS ＋ 各文章 FAQ），
//           首頁那份從一開始就是重複的。
// ============================================================
import { Image } from 'astro:assets';
import instructorShirt from '../assets/instructor-shirt.jpg';
import taichungTalk from '../assets/taichung-talk.jpg';
import tookaCover from '../assets/tooka-cover.jpg';
import { AUTHOR, LINKS, SITE, pageBannerUrl } from '../consts';
import { SYLLABUS } from '../data/home';
import { TEACHING_CASES } from '../data/services';
import Base from '../layouts/Base.astro';

const schema = [
  {
    '@type': 'Course',
    '@id': `${SITE.url}/#course`,
    name: 'AI 新手實戰課：桌面版 Agent 與社群自動發文',
    description:
      '手把手帶零基礎學員從 0 到 1 完成第一個作品，包含桌面版 AI Agent 安裝、實作、測試與除錯。提供雙北實體與線上私人家教。',
    provider: { '@id': AUTHOR.id },
    inLanguage: 'zh-TW',
    courseMode: ['onsite', 'online'],
    teaches: SYLLABUS.map((s) => s.title),
  },
];
---

<Base
  title="AI新手教學｜零基礎學 Claude Code / Codex 與社群自動發文"
  description={SITE.description}
  ogImage={pageBannerUrl('home')}
  ogImageAlt="AI 新手教學｜從工具到自動化"
  schema={schema}
>
  <div class="home" id="home-root">
    <div class="home-shell">
      <!-- 1／Hero：核心主張、終端機演示與 LINE 行動入口 -->
      <section class="hero" aria-labelledby="hero-h">
        <div class="hero-top">
          <h1 class="q q--display hero-reveal" id="hero-h" style="--d:0ms">手把手教學<br />帶你從 <span class="lat">0</span> 到 <span class="lat">1</span><br />完成第一個作品</h1>
          <div class="reply">
            <div class="hero-reveal" style="--d:70ms">
              <p class="by"><span class="by-name micro"><span class="lat">ALEX</span> 私人家教</span></p>
              <p class="lede">不需要技術背景，第一次帶你把工作流跑通，後續只靠對話就能使用。</p>
            </div>
            <div class="terminal-demo hero-reveal" aria-label="從安裝、操作、排錯到上線，一條龍帶你完成" style="--d:110ms">
              <div class="terminal-bar" aria-hidden="true">
                <span></span><span></span><span></span><b><span class="lat">AI Agent</span></b>
              </div>
              <div class="terminal-screen">
                <p class="terminal-command"><span class="terminal-prompt">❯</span><span class="terminal-typed">從安裝 &gt; 操作 &gt; 排錯 &gt; 上線</span><i aria-hidden="true"></i></p>
                <div class="terminal-state" aria-hidden="true">
                  <span class="terminal-thinking"><i></i>全部打包成自動化流程…</span>
                  <strong class="terminal-done"><span aria-hidden="true">✓</span> 一條龍帶你完成</strong>
                </div>
              </div>
            </div>
            <div class="actions hero-reveal" style="--d:140ms">
              <a class="btn btn-line" href={LINKS.line} target="_blank" rel="noreferrer">
                <span class="line-ic" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" /></svg></span>
                <span class="btn-l">加 <span class="lat">LINE</span> 免費諮詢</span>
              </a>
            </div>
          </div>
        </div>

        <section class="outcomes-block hero-reveal" aria-labelledby="outcomes-h" style="--d:190ms">
          <h2 class="outcomes-h" id="outcomes-h">你可以完成</h2>
          <ul class="outcomes-list">
              <li>
                <strong><span class="lat">Vibe Coding</span></strong>
                <span>帶你用提示詞解耦，不再改 <span class="lat">A</span> 壞 <span class="lat">B</span></span>
              </li>
              <li>
                <strong><span class="lat">AI</span> 拍片</strong>
                <span>從腳本、配音到剪輯與發佈</span>
              </li>
              <li>
                <strong>社群自動化</strong>
                <span>串接帳號，完成自動發文與排程</span>
              </li>
            </ul>
        </section>

        <nav class="paths hero-reveal" aria-label="服務導覽" style="--d:210ms">
          <ul class="paths-list">
            <li>
              <a href="/resources/">
                <h3 class="p-t">免費資源</h3>
                <span class="p-go" aria-hidden="true">→</span>
                <p class="p-d">教學影片與開源工具，先自己動手做</p>
              </a>
            </li>
            <li>
              <a href="/services/one-on-one/">
                <h3 class="p-t">私人家教</h3>
                <span class="p-go" aria-hidden="true">→</span>
                <p class="p-d">雙北實體或線上，手把手完成第一個作品</p>
              </a>
            </li>
            <li>
              <a href="/services/speaking/">
                <h3 class="p-t">演講邀約</h3>
                <span class="p-go" aria-hidden="true">→</span>
                <p class="p-d">企業、學校與社群的演講、內訓與工作坊</p>
              </a>
            </li>
          </ul>
        </nav>

        <!-- 2／信任證明：一行，不做成卡片 -->
        <p class="trust hero-reveal" style="--d:280ms"><b>接案工程師、資策會講師</b></p>
      </section>

      <!-- 3／服務詳細介紹：首屏卡片的下一層資訊 -->
      <section class="service-details" aria-label="服務詳細介紹">
        <article class="service-row reveal">
          <div class="service-copy">
            <p class="service-kicker">先自己試試看</p>
            <h2>免費資源</h2>
            <p>先用免費教學影片和開源工具動手做。從 Agent 安裝、Meta API 申請到自動發文，都有可以直接跟著操作的內容。</p>
            <ul>
              <li>免費實作影片</li>
              <li>開源社群圖文工具 Tooka</li>
              <li>卡關再來問，不必急著付費</li>
            </ul>
            <a class="service-link" href="/resources/">查看免費資源 <span aria-hidden="true">→</span></a>
          </div>
          <figure class="service-media">
            <Image src={tookaCover} alt="Tooka 開源社群圖文工具畫面" widths={[560, 880]} sizes="(min-width: 768px) 45vw, 100vw" />
          </figure>
        </article>

        <article class="service-row service-row--reverse reveal">
          <div class="service-copy">
            <p class="service-kicker">實際學員與專案</p>
            <h2>私人家教案例</h2>
            <p>每堂課都用學員自己的電腦、帳號和需求實作。過去已帶學員完成 Agent 安裝、社群自動發文、Email 與行事曆整理，以及 OpenClaw 排錯救援。</p>
            <ul>
              <li>WordPress 串接 Threads 自動發文</li>
              <li>Codex 搜尋 Threads 品牌輿情</li>
              <li>Claude Code 整理 Email、行事曆與 LINE 提醒</li>
            </ul>
            <a class="service-link" href="/services/one-on-one/">查看完整案例與上課方式 <span aria-hidden="true">→</span></a>
          </div>
          <ul class="case-mini-grid" aria-label="四個私人家教實際案例">
            {TEACHING_CASES.map((item) => (
              <li>
                <Image src={item.image} alt={item.imageAlt} width={64} class="case-mini-icon" />
                <div>
                  <strong>{item.topic}</strong>
                  <span>{item.student}</span>
