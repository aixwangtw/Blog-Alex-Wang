---
// ============================================================
// 首頁（2026-08 改版第三階段）
// ------------------------------------------------------------
// 版面、字級、字距補償、全形問號修剪、捲動揭露的唯一真實來源是
// public/_preview/home-b4-lean.html（變體 B-v4「精簡版」）。
// 這個檔案是把該原型做進 Astro，頁首與頁尾改由 src/layouts/Base.astro 提供。
//
// 改版前是 239 行、七個區塊（免費資源、教學案例、演講經歷、教學內容、
// 精選文章、FAQ、CTA）。原型的結論是：首頁字放到 96px 也救不了資訊過載，
// 所以砍到五個單元 —— 頁首／Hero（含三張服務卡）／信任證明／結尾 CTA／頁尾。
//
// 被移除的區塊都另有去處，沒有內容因此消失：
//   TEACHING_CASES      → /course/、/about/
//   SPEAKING_ENGAGEMENTS→ /services/speaking/、/about/
//   TEACHING_CONTENT    → /course/
//   HOME_FAQS           → /faq/
//   精選文章             → /blog/
//   VIDEOS              → /resources/（本階段一併新建；VIDEOS 原本只有首頁在用）
//
// schema 的兩個處理，方向相反，不可弄錯：
//   Course  保留。它的 teaches 來自 SYLLABUS，而 SYLLABUS 本來就不 render 成畫面、
//           只餵 schema，因此區塊移除不影響它，資料與 schema 都留著。
//   FAQPage 移除。/faq/ 已經有 2 份 FAQPage（HOME_FAQS ＋ 各文章 FAQ），
//           首頁那份從一開始就是重複的。
// ============================================================
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import freeResourcesHome from '../assets/free-resources-home-v2.png';
import instructorShirt from '../assets/instructor-shirt.jpg';
import taichungTalk from '../assets/taichung-talk.jpg';
import tookaCover from '../assets/tooka-cover.jpg';
import { AUTHOR, LINKS, SERVICE_SITE, SITE, pageBannerUrl } from '../consts';
import { SYLLABUS } from '../data/home';
import { TEACHING_CASES } from '../data/services';
import Base from '../layouts/Base.astro';

const HOME_FEATURED_ORDER = ['how-to-start-learning-ai'];
const featuredPosts = (await getCollection('blog', ({ data }) => !data.unlisted && data.featured))
  .sort(
    (a, b) => {
      const aPriority = HOME_FEATURED_ORDER.indexOf(a.id);
      const bPriority = HOME_FEATURED_ORDER.indexOf(b.id);
      if (aPriority !== -1 || bPriority !== -1) {
        if (aPriority === -1) return 1;
        if (bPriority === -1) return -1;
        return aPriority - bPriority;
      }
      return (
        b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
        (b.data.cmsId ?? 0) - (a.data.cmsId ?? 0)
      );
    },
  )
  .slice(0, 3);
const schema = [
  {
    '@type': 'Course',
    '@id': `${SITE.url}/#course`,
    name: 'Claude Code/Codex 手把手教學：從 0 到 1 完成第一個作品',
    description:
      '手把手使用 Claude Code 或 Codex，從 0 到 1 完成第一個作品，包含 AI Agent 安裝、實作、測試與除錯。提供雙北實體與線上私人家教。',
    provider: { '@id': AUTHOR.id },
    inLanguage: 'zh-TW',
    courseMode: ['onsite', 'online'],
    teaches: SYLLABUS.map((s) => s.title),
  },
];
---

<Base
  title="Claude Code/Codex 手把手教學｜從 0 到 1 完成第一個作品"
  description={SITE.description}
  ogImage={pageBannerUrl('home')}
  ogImageAlt="AI 新手教學｜從工具到自動化"
  schema={schema}
>
  <div class="home" id="home-root">
    <!-- 1／Hero：單一 CLI 介面，讓訪客直接選擇想認識 Alex 的哪一面 -->
    <section class="hero" aria-labelledby="hero-h">
        <div class="cli hero-reveal" id="hero-cli" tabindex="0" style="--d:0ms">
          <div class="cli-bar" aria-hidden="true">
            <span class="cli-dot cli-dot--red"></span>
            <span class="cli-dot cli-dot--yellow"></span>
            <span class="cli-dot cli-dot--green"></span>
            <b>alex@aixwang: ~</b>
          </div>
          <div class="cli-screen">
            <p class="cli-boot"><span>AIX PERSONAL INTERFACE</span><span>v1.0.0</span></p>
            <div class="cli-conversation">
            <div class="cli-dialog">
              <span class="cli-ai-label">AI</span>
              <h1 class="cli-question" id="hero-h" data-cli-question="你想要了解我什麼內容？">你想要了解我什麼內容？</h1>
              <span class="cli-caret" aria-hidden="true"></span>
            </div>
            <div class="cli-options" role="listbox" aria-label="選擇想了解的內容">
              <button
                type="button"
                role="option"
                aria-selected="true"
                class="is-active"
                data-answer="手把手帶你從0到1，用 Claude Code 或 Codex，從工具安裝、建立專案規則、環境建置、功能拆分、除錯到完成第一個可用作品，零基礎也能開始。"
                data-image-kind="cases"
                data-href={`${SERVICE_SITE.url}/course/`}
                data-link-label="查看 AI 新手實戰課"
                data-ga-button="hero_cli_newbie"
                data-ga-label="我的新手教學內容"
                data-ga-location="hero_cli"
                data-ga-action="select_topic"
              ><span class="cli-selector" aria-hidden="true">❯</span><span class="cli-index">01</span><strong>我的新手教學內容</strong></button>
              <button
                type="button"
                role="option"
                aria-selected="false"
                data-answer="曾受 MixerBox、TAIA 與地方社群邀請，分享 AI Agent、社群自動化與對話式拍片，內容以現場實作為主。"
                data-image={taichungTalk.src}
                data-image-alt="Alex 在台中場進行 AI 社群圖文演講"
                data-href={`${SERVICE_SITE.url}/services/speaking/`}
                data-link-label="查看完整演講履歷"
                data-ga-button="hero_cli_speaking"
                data-ga-label="我的演講履歷"
                data-ga-location="hero_cli"
                data-ga-action="select_topic"
              ><span class="cli-selector" aria-hidden="true">❯</span><span class="cli-index">02</span><strong>我的演講履歷</strong></button>
              <button
                type="button"
                role="option"
                aria-selected="false"
                data-answer="推薦從 Tooka 社群圖文工具開始；網站也整理了 Codex、Skills、Meta API 與 AI 自動化的免費資源。"
                data-image={tookaCover.src}
                data-image-alt="Tooka 開源社群圖文卡片工具操作畫面"
                data-href="/resources/"
                data-link-label="查看免費工具與教學"
                data-ga-button="hero_cli_tools"
                data-ga-label="推薦的開源工具"
                data-ga-location="hero_cli"
                data-ga-action="select_topic"
              ><span class="cli-selector" aria-hidden="true">❯</span><span class="cli-index">03</span><strong>推薦的開源工具</strong></button>
              <button
                type="button"
                role="option"
                aria-selected="false"
                data-answer="文章依照實作目的整理，可以先從 Codex 工具安裝開始，再依需求查看 Threads 與 Instagram API 申請教學。"
                data-image-kind="articles"
                data-href="/blog/"
                data-link-label="閱讀全部文章"
                data-ga-button="hero_cli_articles"
                data-ga-label="看我的文章"
                data-ga-location="hero_cli"
                data-ga-action="select_topic"
              ><span class="cli-selector" aria-hidden="true">❯</span><span class="cli-index">04</span><strong>看我的文章</strong></button>
            </div>
            <div class="cli-output" id="cli-output" aria-live="polite" aria-atomic="true">
              <p class="cli-command"><span>❯</span><b id="cli-command-text"></b><i aria-hidden="true"></i></p>
              <p class="cli-thinking" id="cli-thinking"><span aria-hidden="true"></span>AI 正在整理資料…</p>
              <div class="cli-answer" id="cli-answer">
                <span class="cli-ai-label">AI</span>
                <div class="cli-answer-content">
                  <div class="cli-answer-media" id="cli-answer-media">
                    <img id="cli-answer-image" src={taichungTalk.src} alt="" hidden />
                    <div class="cli-case-visual" id="cli-case-visual" aria-label="AI 新手教學實際案例與使用工具">
                      <div class="cli-case-visual-head"><span>CASE LOG</span><b>實際教學案例</b></div>
                      <ul>
                        {TEACHING_CASES.slice(0, 3).map((item) => (
                          <li>
                            <Image src={item.image} alt={item.imageAlt} width={42} />
                            <span><small>{item.student}</small><b>{item.topic}</b></span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="cli-article-visual" id="cli-article-visual" aria-label="文章分類" hidden>
                      <a href="/blog/codex-windows-wsl-install/" data-ga-button="hero_article_codex" data-ga-label="Codex 安裝教學" data-ga-location="hero_answer" data-ga-action="open_article">
                        <img src="/images/blog/codex-windows-wsl-install.png" alt="Codex Windows 與 WSL 安裝教學" loading="lazy" />
                        <span><small>工具安裝</small><b>Codex 安裝教學</b></span>
                      </a>
                      <div class="cli-article-category">
                        <img src="/images/blog/threads-api-tutorial.png" alt="Threads API 申請教學" loading="lazy" />
                        <span>
                          <small>API 申請</small>
                          <a href="/blog/threads-api-tutorial/" data-ga-button="hero_article_threads_api" data-ga-label="Threads API" data-ga-location="hero_answer" data-ga-action="open_article">Threads API</a>
                          <a href="/blog/instagram-api-tutorial/" data-ga-button="hero_article_instagram_api" data-ga-label="Instagram API" data-ga-location="hero_answer" data-ga-action="open_article">Instagram API</a>
                        </span>
                      </div>
                    </div>
                  </div>
                  <p id="cli-answer-text"></p>
                </div>
                <a id="cli-answer-link" href="/" data-ga-button="hero_answer_cta" data-ga-label="繼續查看" data-ga-location="hero_answer" data-ga-action="navigate">繼續查看 <span aria-hidden="true">→</span></a>
                <button class="cli-end" id="cli-end" type="button" data-ga-button="hero_end_conversation" data-ga-label="結束對話" data-ga-location="hero_answer" data-ga-action="reset"><span aria-hidden="true">[x]</span> 結束對話</button>
              </div>
            </div>
            </div>
          </div>
          <div class="cli-search-area">
            <div class="cli-search-results" id="cli-search-results" aria-live="polite" hidden></div>
            <form class="cli-search-form" id="cli-search-form" role="search" data-ga-submit="hero_search_submit" data-ga-label="搜尋站內內容" data-ga-location="hero_cli" data-ga-action="search" data-ga-input="#cli-search-input">
              <label class="sr-only" for="cli-search-input">搜尋站內文章、教學或工具</label>
              <span class="cli-search-prompt" aria-hidden="true">alex@aixwang:~$</span>
              <input id="cli-search-input" type="search" autocomplete="off" placeholder="search 文章、教學或工具…" />
              <button type="submit" aria-label="送出搜尋" title="送出搜尋">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                  <path d="M12 19V5M6.5 10.5 12 5l5.5 5.5" />
                </svg>
              </button>
            </form>
          </div>
          <div class="cli-status" aria-hidden="true"><span>● ONLINE</span></div>
        </div>
    </section>

    <div class="home-shell">
      <!-- 2／服務詳細介紹：服務入口的下一層資訊 -->
      <section class="service-details" aria-label="服務詳細介紹">
        <article class="service-row reveal" id="free-resources">
          <div class="service-copy">
            <p class="service-kicker">先自己試試看</p>
            <h2>免費資源</h2>
            <p>先把 Codex 裝好，再把現成的 Skills 交給 AI 安裝。想做社群自動化或社群圖文時，再依需求使用 API 教學與開源工具。</p>
            <ul>
              <li>Codex 新手安裝教學</li>
              <li>可直接交給 AI 安裝的 Skills</li>
              <li>API 串接教學與開源工具</li>
            </ul>
            <a class="service-link" href="/resources/">查看免費資源 <span aria-hidden="true">→</span></a>
          </div>
          <figure class="service-media">
            <Image src={freeResourcesHome} alt="教學影片、開源工具與實作指南組成的免費 AI 學習資源" widths={[560, 880]} sizes="(min-width: 768px) 45vw, 100vw" />
          </figure>
        </article>

        <article class="service-row service-row--reverse reveal">
          <div class="service-copy">
            <p class="service-kicker">實際學員與專案</p>
            <h2>私人家教案例</h2>
            <p>每堂課都用學員自己的電腦、帳號和需求實作。過去已帶學員完成 Agent 安裝、社群自動發文、Email 與行事曆整理，以及 OpenClaw 排錯救援。</p>
            <ul>
              <li>WordPress 串接 Threads 自動發文</li>
              <li>Codex 搜尋 Threads 品牌輿情</li>
              <li>Claude Code 整理 Email、行事曆與 LINE 提醒</li>
            </ul>
            <a class="service-link" href={`${SERVICE_SITE.url}/course/`}>查看完整案例與上課方式 <span aria-hidden="true">→</span></a>
          </div>
          <ul class="case-mini-grid" aria-label="四個私人家教實際案例">
            {TEACHING_CASES.map((item) => (
              <li>
                <Image src={item.image} alt={item.imageAlt} width={64} class="case-mini-icon" />
                <div>
                  <strong>{item.topic}</strong>
                  <span>{item.student}</span>
                </div>
              </li>
            ))}
          </ul>
        </article>

        <article class="service-row reveal">
          <div class="service-copy">
            <p class="service-kicker">現場演示與實作</p>
            <h2>演講紀錄</h2>
            <p>曾於企業、AI 協會與地方社群分享 AI Agent、社群圖文與對話式拍片。內容不只講概念，會把真實工作流搬到現場演示。</p>
            <ul>
              <li>MixerBox：OpenClaw 雙機斷線救援</li>
              <li>TAIA：只靠對話一條龍完成拍片</li>
              <li>台中、雲林：AI 社群圖文實作</li>
            </ul>
            <a class="service-link" href={`${SERVICE_SITE.url}/services/speaking/`}>查看全部演講紀錄與邀約方式 <span aria-hidden="true">→</span></a>
          </div>
          <figure class="service-media">
            <Image src={taichungTalk} alt="Alex 在台中場進行 AI 社群圖文演講" widths={[560, 880]} sizes="(min-width: 768px) 45vw, 100vw" />
          </figure>
        </article>

        <section class="instructor-profile reveal" aria-labelledby="instructor-h">
          <figure class="instructor-photo">
            <Image src={instructorShirt} alt="AI 應用講師 Alex" widths={[420, 700]} sizes="(min-width: 768px) 34vw, 100vw" />
          </figure>
          <div class="instructor-main">
            <p class="service-kicker">從非科班到 AI 應用講師</p>
            <h2 id="instructor-h">關於講師</h2>
            <p class="instructor-name"><span class="lat">Alex Wang</span>／王士麟</p>
            <p class="instructor-intro">接案工程師與資策會講師，也是從沒有技術背景開始，透過 AI 一步一步學會寫程式、做自動化與完成客戶專案，因此特別知道新手容易卡在哪裡。</p>
            <div class="instructor-actions">
              <a class="service-link" href="/about/">了解講師經歷 <span aria-hidden="true">→</span></a>
              <nav class="instructor-socials" aria-label="講師社群連結">
                <a href={LINKS.threads} target="_blank" rel="noreferrer" aria-label="Alex 的 Threads（開新分頁）">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221Z" /></svg>
                </a>
                <a href={LINKS.youtube} target="_blank" rel="noreferrer" aria-label="Alex 的 YouTube（開新分頁）">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.003 3.003 0 0 0-2.112-2.123C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.386.563A3.003 3.003 0 0 0 .502 6.186 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .502 5.814 3.003 3.003 0 0 0 2.112 2.123C4.495 20.5 12 20.5 12 20.5s7.505 0 9.386-.563a3.003 3.003 0 0 0 2.112-2.123A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z" /></svg>
                </a>
              </nav>
            </div>
          </div>
          <dl class="instructor-facts">
            <div><dt>角色</dt><dd>AI 應用講師<br />全職接案工程師</dd></div>
            <div><dt>專長</dt><dd>AI Agent<br />Vibe Coding<br />工作流自動化</dd></div>
            <div><dt>教學</dt><dd>雙北實體<br />線上私人家教<br />企業與社群演講</dd></div>
          </dl>
        </section>

        {featuredPosts.length > 0 && (
          <section class="featured-posts reveal" aria-labelledby="featured-h">
            <div class="featured-head">
              <div>
                <p class="service-kicker">LATEST ARTICLES</p>
                <h2 id="featured-h">精選文章</h2>
              </div>
              <a href="/blog/">查看全部文章 <span aria-hidden="true">→</span></a>
            </div>
            <ul class="featured-list">
              {featuredPosts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    <img src={`/images/blog/${post.id}-thumb.webp`} alt="" width="640" height="336" loading="lazy" />
                    <p class="featured-meta"><span>{post.data.tags[0] ?? 'AI 教學'}</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-TW')}</time></p>
                    <h3>{post.data.title}</h3>
                    <span class="featured-go" aria-hidden="true">閱讀全文 →</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </section>

      <!-- 4／結尾 CTA -->
      <section class="closer" aria-labelledby="closer-h">
        <h2 class="q q--sec reveal" id="closer-h"><span class="nb">不確定自己適合哪一種<span class="qt">？</span></span></h2>
        <div class="reveal" style="--d:70ms">
          <p class="closer-p">加 <span class="lat">LINE</span> 直接說你想自動化什麼。我會告訴你該走哪一條，也可能直接告訴你哪篇免費文章就能解決。</p>
          <div class="actions">
            <a class="btn btn-line" href={LINKS.line} target="_blank" rel="noreferrer">
