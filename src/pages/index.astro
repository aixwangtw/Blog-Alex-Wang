      .cli-options a:hover {
        border-color: #a85b67;
        background: #2a2323;
        color: #fffaf4;
        box-shadow: 0 8px 24px rgb(0 0 0 / 20%);
        transform: translateY(-1px);
      }
      .cli-options a:hover .cli-option-arrow { transform: translate(2px, -2px); }
      .cli-tabs button:hover { color: #fffaf4; }
      :global(.cli-search-result:hover) {
        border-color: var(--color-accent-line-2);
        background: var(--color-accent-tint);
      }
      .cli-search-form button:hover {
        border-color: #bc6472;
        background: #944252;
        color: #fffaf4;
      }
    }

    /* 鍵盤焦點：不靠 hover 也要有等價的視覺回饋（不設裝置條件） */
    .featured-list a:focus-visible,
    .cli-options a:focus-visible,
    .cli-tabs button:focus-visible,
    :global(.cli-search-result:focus-visible),
    .cli-search-form button:focus-visible {
      outline: 2px solid #f0a6b1;
      outline-offset: 3px;
    }
    .cli-search-form:focus-within {
      box-shadow: inset 3px 0 #a85b67;
    }
    .hero-contact-actions a:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }

    /* ============================================================
       逐段浮現：內容一律寫在 HTML 裡，只有「顯示與否」交給 CSS。
       沒有 JS 時 .js 不會加上，全部維持完整可見。
       IntersectionObserver 掛掉時另有 2 秒逾時強制顯示（見上方 script）。
       ============================================================ */
    .home.js .reveal {
      opacity: 0.3;
      transform: translateY(30px);
      transition:
        opacity 0.6s var(--ease) var(--d, 0ms),
        transform 0.6s var(--ease) var(--d, 0ms);
    }
    .home.js .reveal.is-in {
      opacity: 1;
      transform: translateY(0);
    }

    /* 首屏：0 + 70 + 140ms 延遲，各 200ms —— 總揭露 340ms */
    .home.js .hero-reveal {
      opacity: 0.3;
      transform: translateY(30px);
      transition:
        opacity 0.2s var(--ease) var(--d, 0ms),
        transform 0.2s var(--ease) var(--d, 0ms);
    }
    .home.js .hero-reveal.is-in {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .home.js .reveal,
      .home.js .hero-reveal,
      .home.js .reveal.is-in,
      .home.js .hero-reveal.is-in {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      /* 只關過渡，不寫任何 :hover 選擇器。
         「所有 hover 收在 @media (hover:hover) and (pointer:fine) 裡」是硬規則，
         在這裡補一條 .btn-line:hover{transform:none} 會是全站唯一一條沒有裝置
         條件的 hover 規則。而且它也沒有必要：那顆按鈕的 translateY(-1px) 本來就
         只在有滑鼠的裝置上生效，過渡一關就是瞬間位移，不構成前庭風險的動態。 */
      .btn,
      .terminal-typed,
      .terminal-command > i,
      .terminal-thinking,
      .terminal-done,
      .terminal-thinking i {
        transition: none !important;
        animation: none !important;
      }
      .terminal-typed {
        max-width: 18em;
      }
      .terminal-command > i,
      .terminal-thinking {
        display: none;
      }
      .terminal-done {
        opacity: 1;
        transform: none;
      }
    }

