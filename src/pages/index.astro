---
// ============================================================
// 首頁（2026-08 改版第三階段）
// ------------------------------------------------------------
// 版面、字級、字距補償、全形問號修剪、捲動揭露的唯一真實來源是
// public/_preview/home-b4-lean.html（變體 B-v4「精簡版」）。
// 這個檔案是把該原型做進 Astro，頁首與頁尾改由 src/layouts/Base.astro 提供。
//
// 改版前是 239 行、七個區塊（免費資源、教學案例、演講經歷、教學內容、
// 精選文章、FAQ、CTA）。原型的結論是：首頁字放到 96px 也救不了資訊過載，
// 所以砍到五個單元 —— 頁首／Hero（含三張服務卡）／信任證明／結尾 CTA／頁尾。
//
// 被移除的區塊都另有去處，沒有內容因此消失：
//   SPEAKING_ENGAGEMENTS→ /services/speaking/、/about/
//   TEACHING_CONTENT    → /course/
//   HOME_FAQS           → 原指向 /faq/，2026-10-13 起 /faq/ 不收教學題，改由客服 faq-index 指向 /course/#faq
//   精選文章             → /blog/
//   VIDEOS              → /resources/（本階段一併新建；VIDEOS 原本只有首頁在用）
//
// 2026-10：Course 結構化資料已移除（它的內容是 Agent 安裝與自動發文課程，站上不再提供）；
// FAQPage 仍不在首頁，/faq/ 已經有了。
// ============================================================
import { DEVELOPMENT_SERVICE, LINKS, pageBannerUrl, COURSE_SERVICE_URL, SPEAKING_SERVICE_URL, SECTION_NAMES } from '../consts';
import DevCategoryPicker from '../components/DevCategoryPicker.astro';
import { DEVELOPMENT_CAPABILITIES, DEVELOPMENT_CASE_FEATURES } from '../data/services';
import LineIcon from '../components/LineIcon.astro';
import { getCollection } from 'astro:content';
import FaqList from '../components/FaqList.astro';
import Base from '../layouts/Base.astro';

// 首頁只留三題常見問題，題目與答案一字不改取自〈系統開發、AI 導入費用怎麼算？〉文章；
// 費用與付款那題放在系統開發服務頁。找不到就中斷建置，避免文章改題後首頁悄悄變空。
const HOME_FAQ_QUESTIONS = [
  '簽約前能先看到 Demo 嗎？要收費嗎？',
  '做的過程中能不能隨時修改？',
  '資料和原始碼歸誰？可以簽保密協議嗎？',
];
const guideArticle = (await getCollection('blog')).find((post) => post.id === 'custom-system-development-demo');
const homeFaqs = HOME_FAQ_QUESTIONS.map((question) => {
  const faq = guideArticle?.data.faqs.find((item) => item.question === question);
  if (!faq) {
    throw new Error(`系統開發文章找不到 FAQ「${question}」，請更新 src/pages/index.astro 的 HOME_FAQ_QUESTIONS`);
  }
  return faq;
});

const allPosts = (await getCollection('blog', ({ data }) => !data.unlisted)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || (b.data.cmsId ?? 0) - (a.data.cmsId ?? 0),
);
const latestPosts = allPosts.slice(0, 5);
---

<Base
  title="客製系統開發、AI 導入｜聊完需求先試用 Demo｜Aix 系統開發"
  description="Alex 和開發夥伴承接客製系統開發與 AI 導入。聊完需求可以先提供試用 Demo，看過再決定要不要簽約。代表案例：數學題庫系統。"
  ogImage={pageBannerUrl('home')}
  ogImageAlt="客製系統開發、AI 導入｜Aix 系統開發"
>
  <div class="home" id="home-root">

    <div class="home-shell">
      <!-- 1／首屏：直接問想做什麼系統，六個類別卡＋「聊聊需求」主按鈕（DevCategoryPicker 與服務站共用） -->
      <DevCategoryPicker location="home_hero" headingId="hero-h" />

      <!-- 2／開發案例：只放站上已有的真實案例，一案一張同比例卡片，不放大圖 -->
      <section class="dev-case reveal" id="development-case" aria-labelledby="case-h">
        <p class="service-kicker">{SECTION_NAMES.cases}</p>
        <h2 id="case-h">做過的系統</h2>
        <ul class="case-cards">
          <li>
            <article class="case-card">
              <img class="case-card-thumb" src="/images/blog/math-teacher-question-bank/import-review.jpg" alt="題庫系統的考卷匯入審核頁：左邊是原始考卷，右邊是 AI 辨識出來的題目" width="1400" height="875" loading="lazy" decoding="async" />
              <div class="case-card-body">
                <h3>數學題庫系統</h3>
                <p>補習班數學老師用來把考卷收進題庫、出卷。</p>
                <ul class="dev-list">
                  {DEVELOPMENT_CASE_FEATURES.map((item) => <li>{item}</li>)}
                </ul>
                <div class="case-card-actions">
                  <a class="service-link" href="https://demo-question.aixwang.dev" target="_blank" rel="noreferrer" data-ga-button="home_case_demo" data-ga-label="試用題庫系統 Demo" data-ga-location="home_case" data-ga-action="external">試用 Demo，免費不用註冊 <span aria-hidden="true">↗</span></a>
                </div>
              </div>
            </article>
          </li>
        </ul>
        <p class="dev-case-more">另外做過 CRM、健檢系統、預約系統、揪團平台等。<a href="/cases/" data-ga-button="home_case_all" data-ga-label="看全部案例" data-ga-location="home_case" data-ga-action="navigate">看全部案例 →</a></p>
      </section>

      <!-- 3／能做什麼 -->
      <section class="dev-scope reveal" aria-labelledby="scope-h">
        <p class="service-kicker">可以做什麼</p>
        <h2 id="scope-h">AI 導入、資料管理、API 串接</h2>
        <p class="dev-scope-lead">大多數功能都能做，這三項是我們團隊的強項。</p>
        <dl class="dev-scope-list">
          {DEVELOPMENT_CAPABILITIES.map((item) => <div><dt>{item.title}</dt><dd>{item.description}</dd></div>)}
        </dl>
      </section>

      <!-- 4／四步流程：用詞取自 DEVELOPMENT_SERVICE.steps 與系統開發服務頁 -->
      <section class="dev-flow reveal" id="development-process" aria-labelledby="flow-h">
        <p class="service-kicker">合作流程</p>
        <h2 id="flow-h">合作流程怎麼走？</h2>
        <ol class="dev-flow-list">
          <li><span class="dev-flow-no">01</span><strong>聊需求</strong><span>加 LINE 說你想做的系統，可以免費評估。</span></li>
          <li><span class="dev-flow-no">02</span><strong>免費試用 Demo</strong><span>依需求做簡易 Demo，看過再決定要不要簽約。</span></li>
          <li><span class="dev-flow-no">03</span><strong>開發與驗收</strong><span>分階段開發，需求隨調隨改；改好的地方附調整說明，你確認才算完成。</span></li>
          <li><span class="dev-flow-no">04</span><strong>上線與維運</strong><span>上線並教你怎麼用，一年保固；保固結束後可簽維護合約。</span></li>
        </ol>
        <p class="dev-flow-note">{DEVELOPMENT_SERVICE.timeline}</p>
        <a class="service-link" href={DEVELOPMENT_SERVICE.url} data-ga-button="home_development_service" data-ga-label="看合作流程與費用" data-ga-location="home_development_process" data-ga-action="navigate">看合作流程、付款與主機費用 <span aria-hidden="true">→</span></a>
      </section>

      <!-- 5／文章入口 -->
      <section class="dev-articles reveal" aria-labelledby="articles-h">
        <p class="service-kicker">文章</p>
        <h2 id="articles-h">開發紀錄與實作文章</h2>
        <ul class="dev-articles-list">
          {latestPosts.map((post) => (
            <li><a href={`/blog/${post.id}/`} data-ga-button="home_article" data-ga-label={post.data.title} data-ga-location="home_articles" data-ga-action="navigate">{post.data.title}</a></li>
          ))}
        </ul>
        <a class="service-link" href="/blog/" data-ga-button="home_articles_all" data-ga-label="看全部文章" data-ga-location="home_articles" data-ga-action="navigate">看全部 {allPosts.length} 篇文章 <span aria-hidden="true">→</span></a>
      </section>

      <!-- 6／常見問題 -->
      <section class="home-faq reveal" aria-labelledby="home-faq-h">
        <p class="service-kicker">常見問題</p>
        <h2 id="home-faq-h">合作前最常問的三件事</h2>
        <FaqList faqs={homeFaqs} />
        <a class="service-link" href={`${DEVELOPMENT_SERVICE.url}#development-cost`} data-ga-button="home_faq_cost" data-ga-label="看時程與費用" data-ga-location="home_faq" data-ga-action="navigate">時程、付款與主機費用 <span aria-hidden="true">→</span></a>
      </section>

      <!-- 7／其他：教學與演講在服務站，開源工具在主站；三張等寬等高小卡 -->
      <section class="dev-more reveal" aria-label="其他服務與工具">
        <ul class="dev-more-list">
          <li><a href={COURSE_SERVICE_URL} data-ga-button="home_more_course" data-ga-label="一對一教學" data-ga-location="home_more" data-ga-action="navigate"><strong>AI 一對一教學</strong><span>用 Claude Code 寫系統、做網頁、做動畫影片，方案在服務站。</span><em>看教學方案 →</em></a></li>
          <li><a href={SPEAKING_SERVICE_URL} data-ga-button="home_more_speaking" data-ga-label="演講邀約" data-ga-location="home_more" data-ga-action="navigate"><strong>演講邀約</strong><span>公開演講、企業內訓、工作坊。</span><em>看演講經歷 →</em></a></li>
          <li><a href="/resources/" data-ga-button="home_more_opensource" data-ga-label={SECTION_NAMES.openSource} data-ga-location="home_more" data-ga-action="navigate"><strong>{SECTION_NAMES.openSource}</strong><span>feedback-desk 問題回報系統、grill-me Skill。</span><em>看開源工具 →</em></a></li>
        </ul>
      </section>

      <!-- 8／結尾 CTA -->
      <section class="closer" aria-labelledby="closer-h">
        <h2 class="q q--sec reveal" id="closer-h"><span class="nb">想聊聊你的需求嗎<span class="qt">？</span></span></h2>
        <div class="reveal" style="--d:70ms">
          <p class="closer-p">加 LINE 說你想做的系統和手上的資料，聊完先拿 Demo 試用。</p>
          <div class="dev-hero-actions">
            <a class="dev-line-btn" href={LINKS.line} target="_blank" rel="noreferrer" data-ga-button="home_closer_line" data-ga-label="聊聊需求" data-ga-location="home_closer" data-ga-action="external"><LineIcon class="dev-line-icon" /><span>聊聊需求</span></a>
            <a class="service-link" href={DEVELOPMENT_SERVICE.url} data-ga-button="home_closer_service" data-ga-label="了解系統開發服務" data-ga-location="home_closer" data-ga-action="navigate">了解系統開發服務 <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>
    </div>
  </div>


  <script is:inline>
    /* 逐段浮現：內容 100% 寫在初始 HTML 裡，只有「顯示與否」交給 CSS。
       `js` 這個 class 加在 #home-root（不是 <html>）上，因為這一頁的樣式是
       Astro 的元件範圍樣式——選擇器會被加上 data-astro-cid-*，
       掛在 <html> 上的 class 選不到。
       三層保險，任何一層失效內容都仍然完整可見：
         1. 沒有 JS（或這段拋例外）→ `js` 不會加上 → 所有 .reveal 維持原樣可見
         2. IntersectionObserver 不存在／被停用／行為異常 → 2 秒逾時強制顯示
         3. prefers-reduced-motion → 直接全部顯示，且 CSS 也把過渡關掉 */
    (function () {
      var root = document.getElementById('home-root');
      if (!root) return;
      var reveals = root.querySelectorAll('.reveal, .hero-reveal');

      function revealAll() {
        for (var i = 0; i < reveals.length; i++) reveals[i].classList.add('is-in');
      }

      try {
        root.classList.add('js');

        // 保險 1：先掛逾時，再做任何可能爆炸的事
        var ioAlive = false;
        setTimeout(function () {
          if (!ioAlive) revealAll();
        }, 2000);

        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 首屏：立刻揭露（0 / 70 / 140ms 延遲，各 200ms → 總揭露 340ms）
        var hero = root.querySelectorAll('.hero-reveal');
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            for (var i = 0; i < hero.length; i++) hero[i].classList.add('is-in');
          });
        });

        if (reduce || !('IntersectionObserver' in window)) {
          revealAll();
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            ioAlive = true; // 觀察器確實會回呼 → 逾時保險不必動作
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );

        var scrollReveals = root.querySelectorAll('.reveal');
        for (var k = 0; k < scrollReveals.length; k++) io.observe(scrollReveals[k]);
      } catch (err) {
        revealAll(); // 保險 2
      }
    })();
  </script>


  <style>
    /* ============================================================
       首頁專屬排版。這裡的每一條都只作用在首頁，不外洩到內頁：
       - 展示級 H1（96px）與襯線體是首頁專用（設計語言定案 #1）
       - 字距分級只套在拉丁字段（.lat）上，中文一律 0
       - 顏色一律用 global.css @theme 的 --color-*，這裡不重新定義任何顏色
       - 內頁字級 .t-h1／.t-h2／.t-h3 這裡完全不碰
       ============================================================ */
    .home {
      /* ---- 字距分級（依光學尺寸，不是一個值套到底）----
         只套在拉丁字段（.lat）上；中文一律 0。
         --ls-display 供 ≥72px 的字段使用。H1 是 clamp(56,8vw,96)，
         8vw 在 viewport 900px 時剛好等於 72px，因此 display 級只在
         min-width:900px 之後才接上；900px 以下 H1 是 56–71.9px，留在 title 級。 */
      --ls-display: -0.06em;
      --ls-title: -0.028em;
      --ls-body: -0.011em;
      --ls-micro: 0.12em;
      --ls: var(--ls-body); /* 拉丁字段預設用內文級 */

      color: var(--color-ink-2);
      font-size: 16px;
      line-height: 1.9;
      letter-spacing: 0; /* 中文：0，不商量 */
    }

    /* 版心對齊 Base 的頁首頁尾（.hd-cap／.ft-wrap 都是 max-width:72rem、
       padding 20/40px）。原型的 .shell 是 1120px，這裡改用 72rem＝1152px，
       為的是 H1 的左緣跟頁首字標、頁尾品牌塊落在同一條垂直線上——
       兩者差 32px 時，捲動經過頁首那條線會看得出來。 */
    .home-shell {
      width: 100%;
      max-width: 72rem;
      margin: 0 auto;
      padding: 0 20px;
    }
    @media (min-width: 768px) {
      .home-shell {
        padding: 0 40px;
      }
    }

    /* ---- 拉丁字段：字距只加在這裡，並補回「尾字距」----
       CSS 的 letter-spacing 會在字段最後一個字元「後面」也加一份間距，
       負值會把後面的中文吸過來、正值會推開。用等量反向的 margin 補回。
       原型是用 .lat 包裹、由 Python 腳本在建置期產生；Astro 沒有那一步，
       首頁內容已砍到 470 字上下，.lat 的位置不多，直接手寫在模板裡。 */
    .lat {
      font-style: normal;
      letter-spacing: var(--ls, 0em);
      margin-inline-end: calc(-1 * var(--ls, 0em));
    }

    /* 12–13px 小標籤：唯一反向加字距的地方（正值，中文也適用），
       同樣要補回尾字距，否則標籤右側會多出一份空白。 */
    .micro {
      letter-spacing: var(--ls-micro);
      margin-inline-end: calc(-1 * var(--ls-micro));
      --ls: 0em; /* 內層 .lat 不再疊加 */
    }

    /* ============================================================
       全形問號的左空白修剪
       ------------------------------------------------------------
       問題：96px 下句末的全形「？」左邊留一個 27px 的空洞。
       實測（Noto Serif TC，upm 1000）：
         U+FF1F  advance 1.000em，墨跡 0.254em → 0.730em
                 左空白 0.254em、右空白 0.270em
         相鄰漢字 始 rsb 0.043em／大 rsb 0.049em／哪 lsb 0.068em
       → 漢字對漢字的墨跡間距約 0.068em，漢字對「？」是 0.297em，差 3.7 倍。
         Chrome 147／96px 實際渲染量測：始？＝28px，始始＝7px。

       ---- 三條「正規解法」全部驗證過，全部不能用 ----
       1. font-feature-settings:"palt" 1
          ／font-variant-east-asian:proportional-width
          Noto Serif TC 的 GPOS 裡「沒有 palt」。108 個子集抽驗 3 個
          （含實際含 U+FF1F 的那個），GPOS 只有 chws/halt/kern/vchw/vhal/vpal。
          halt 的涵蓋範圍只有「」（）！ 等六個字符，chws 只處理成對括號，
          兩者都不含 U+FF1F。實測結果：間距 26px 完全不動。
          同一段 CSS 換成 Noto Sans TC 就有效（27px → 12px）——Sans 有 palt
          且涵蓋 U+FF1F（XPlacement −134／XAdvance −283）。
          也就是說語法沒錯，是這支襯線字型沒有這個功能。
          另外 font-variant-east-asian:proportional-width 對應的是 pwid 而非
          palt，連 Noto Sans TC 都沒有效果（實測 27px 不動）。
       2. text-spacing-trim（CSS Text Level 4）
          Chrome 147 只接受 normal / trim-start / space-all；
          trim-both、trim-all、auto 全部 invalid（CSS.supports 回 false）。
          功能本身確實有在運作：trim-start 會把行首的「切掉左半格
          （墨跡左緣 163px → 115px，正好 0.5em）。
          但三個合法值對「？」的渲染結果一模一樣（26px 不動）——
          規格只裁全形的「開頭／結尾標點」，全形問號、驚嘆號不在裡面。
       3. GSUB 的 hwid／pwid 寬度替代字符
          Noto Serif TC 的 GSUB 只有 ccmp/liga/locl/vert/vrt2，沒有寬度替代。

       ---- 結論與作法 ----
       這支字型沒有任何 OpenType 或 CSS 標準機制可用，只剩光學修剪一條路。
       修剪量不是喬出來的：0.254em（？的左空白）− 0.05em（保留的殘餘空白）
       = 0.204em。留下的 0.05em 讓「？」的墨跡間距落回漢字的節奏上。
       實測驗收（Chrome 147／96px）：始？ 28px → 9px（對照 始始 ＝ 7px）、
                                     大？ 26px → 7px（對照 大大 ＝ 5px）。
       比漢字節奏鬆 2px，這是對的——問號本來就該比字距多留一點點氣。

       副作用與圍堵：
       - 只作用在被 .qt 包起來的那一個字元。頁面其他地方的「，」「。」
         完全不受影響（實測 大，大 加不加 .qt 都是 41/43px）。
       - 修剪量是 em，隨字級等比縮放，所有斷點的光學結果一致，
         不需要為不同字級各補一次。
       - 換行風險：用 .nb（white-space:nowrap）把「開始？」綁成一個
         不可斷的單位，「？」永遠不可能落到行首，也就不會把負 margin
         拉到容器左緣外面。
       - 字型 fallback 風險：若 Noto Serif TC 沒載入，改用 Songti TC 等
         備援字型時修剪量可能不完全匹配。只有在備援字型的「？」左空白
         小於 0.204em 時才會過修——絕大多數中文字型都是 0.24–0.28em，
         風險低，但這條無法在本機驗證，仍屬已知風險。
       ============================================================ */
    .qt {
      margin-inline-start: -0.204em;
    }
    .nb {
      white-space: nowrap;
    }

    /* ---------- Hero：保留終端機語彙，但不模擬 AI 思考或等待 ----------
       60／30／10 配色以全頁計算：中性紙色是主要底色、深色終端機是次要區塊，
       酒紅只用於狀態與互動提示。每個選項都是原生連結，點擊後直接導頁。 */
    .hero-media {
      margin: 0;
      align-self: center;
    }
    /* 首屏放 9:16 直式短影音：寬度固定上限，高度不超過一個畫面 */
    .hero-media {
      justify-self: center;
      width: min(100%, calc((100svh - 160px) * 9 / 16));
    }
    .hero-media video {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 9 / 16;
      background: var(--color-ink);
      border: 1px solid var(--color-rule-2);
    }
    .hero-media figcaption {
      margin-top: 12px;
      font-size: 13px;
      color: var(--color-ink-3);
    }
    .hero {
      display: grid;
      width: 100%;
      max-width: 72rem;
      grid-template-columns: minmax(0, 1fr) 340px;
      align-items: start;
      gap: clamp(36px, 6vw, 88px);
      margin: 0 auto;
      padding: clamp(58px, 8vw, 108px) 40px;
    }
    .hero-copy {
      align-self: center;
      max-width: 510px;
    }
    .hero-kicker {
      margin: 0 0 16px;
      color: var(--color-accent);
      font: 700 13px/1.5 var(--font-display);
      letter-spacing: 0.02em;
    }
    .hero-copy h1 {
      margin: 0;
      color: var(--color-ink);
      font: 650 clamp(42px, 5vw, 68px)/1.15 var(--font-display);
      letter-spacing: -0.045em;
    }
    .hero-h1-sub {
      display: block;
      margin-top: 0.35em;
      font-size: 0.5em;
      line-height: 1.35;
      letter-spacing: -0.02em;
    }
    .hero-summary a {
      color: var(--color-accent);
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    .hero-summary {
      max-width: 470px;
      margin: 24px 0 0;
      color: var(--color-ink-2);
      font: 400 clamp(15px, 1.45vw, 18px)/1.85 var(--font-display);
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 18px;
      margin-top: 30px;
    }
    .hero-ghost {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      padding: 12px 22px;
      border: 1px solid var(--color-ink);
      border-radius: 6px;
      color: var(--color-ink);
      font: 600 14px/1.5 var(--font-display);
      text-decoration: none;
      transition: background-color 0.18s var(--ease), color 0.18s var(--ease);
    }
    .hero-secondary {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      padding: 12px 22px;
      border: 1px solid var(--color-accent);
      border-radius: 6px;
      background: var(--color-accent);
      color: #fff;
      font: 600 14px/1.5 var(--font-display);
      text-decoration: none;
    }
    .cli {
      display: flex;
      width: 100%;
      flex-direction: column;
      border: 1px solid #3f3a37;
      border-radius: 14px;
      background: #181716;
      color: #f7f3ed;
      box-shadow: 0 26px 70px rgb(22 22 26 / 18%);
      overflow: hidden;
      overflow-anchor: none;
    }
    /* 保留視窗列與三色圓點的終端機識別，不加入英文狀態字。 */
    .cli-brand {
      display: flex;
      height: 44px;
      flex: none;
      align-items: center;
      gap: 12px;
      padding: 0 18px;
      border-bottom: 1px solid #3f3a37;
      background: #24211f;
      border-radius: 13px 13px 0 0;
    }
    .cli-window-dots {
      display: flex;
      gap: 6px;
    }
    .cli-window-dots i {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #665f5a;
    }
    .cli-window-dots i:first-child { background: #d96c70; }
    .cli-window-dots i:nth-child(2) { background: #d6a34d; }
    .cli-window-dots i:last-child { background: #69aa79; }
    .cli-window-title {
      color: #aaa39d;
      font: 500 11px/1.4 var(--font-mono);
      letter-spacing: 0.01em;
    }
    .cli-screen {
      display: flex;
      width: 100%;
      min-height: 0;
      flex: 1;
      flex-direction: column;
      padding: clamp(24px, 4vw, 44px);
      font-family: var(--font-mono);
    }
    .cli-conversation {
      width: 100%;
    }
    .cli-dialog {
      display: block;
      min-width: 0;
    }
    .cli-question-bubble {
      max-width: 760px;
    }
    .cli-question {
      min-width: 0;
      margin: 0;
      color: #fffaf4;
      font: 650 clamp(25px, 4vw, 42px)/1.3 var(--font-display);
      letter-spacing: 0;
      overflow-wrap: anywhere;
    }
    .cli-tabs {
      display: grid;
      max-width: 820px;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
      margin: 26px 0 0;
      padding: 4px;
      border: 1px solid #403b38;
      border-radius: 9px;
      background: #171615;
    }
    .cli-tabs button {
      min-height: 42px;
      padding: 8px 10px;
      border: 0;
      border-radius: 6px;
      background: transparent;
      color: #aaa39d;
      font: 600 13px/1.3 var(--font-display);
      cursor: pointer;
    }
    .cli-tabs button[aria-selected='true'] {
      background: #a85b67;
      color: #fffaf4;
      box-shadow: 0 4px 14px rgb(0 0 0 / 22%);
    }
    .cli-tab-panel[hidden] {
      display: none;
    }
    .cli-options {
      display: grid;
      gap: 10px;
      max-width: 820px;
      margin: 10px 0 0;
    }
    .cli-options a {
      display: grid;
      width: 100%;
      min-height: 68px;
      grid-template-columns: 32px minmax(0, 1fr) auto;
      align-items: center;
      gap: 14px;
      padding: 13px 18px;
      border: 1px solid #403b38;
      border-radius: 8px;
      background: #211f1e;
      color: #f7f3ed;
      text-decoration: none;
      transition: border-color 0.16s ease, background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
    }
    .cli-option-index {
      flex: none;
      color: #f0a6b1;
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 700;
    }
    .cli-options a > span:nth-child(2) { min-width: 0; }
    .cli-options strong {
      display: block;
      color: #fffaf4;
      font-family: var(--font-display);
      font-size: clamp(14px, 1.6vw, 16px);
      font-weight: 600;
      line-height: 1.4;
    }
    .cli-options small {
      display: block;
      margin-top: 2px;
      color: #aaa39d;
      font: 400 12px/1.55 var(--font-display);
    }
    .cli-option-arrow {
      flex: none;
      color: #f0a6b1;
      font-size: 17px;
      transition: transform 0.16s ease;
    }
    .cli-search-area {
      flex: none;
      border-top: 1px solid #3f3a37;
      background: #11100f;
      border-radius: 0 0 13px 13px;
      font-family: var(--font-mono);
    }
    .cli-search-results {
      display: grid;
      gap: 3px;
      padding: 12px clamp(15px, 4vw, 46px) 8px;
      border-bottom: 1px solid #3f3a37;
    }
    .cli-search-results[hidden] { display: none; }
    :global(.cli-search-empty) {
      margin: 0;
      color: #aaa39d;
      font-size: 11px;
      line-height: 1.7;
    }
    :global(.cli-search-result) {
      display: grid;
      gap: 2px;
      padding: 8px 10px;
      border: 1px solid transparent;
      border-radius: 6px;
      color: #d9d3cc;
      text-decoration: none;
    }
    :global(.cli-search-result.is-active) {
      border-color: #8f4652;
      background: #2a2323;
    }
    :global(.cli-search-title) {
      color: #fffaf4;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 500;
      line-height: 1.5;
    }
    :global(.cli-search-description) {
      overflow: hidden;
      color: #aaa39d;
      font-family: var(--font-display);
      font-size: 10px;
      line-height: 1.5;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .cli-search-form {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      min-height: 56px;
      align-items: center;
      gap: 10px;
      padding: 0 clamp(15px, 4vw, 46px);
    }
    .cli-search-form input {
      min-width: 0;
      padding: 10px 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: #fffaf4;
      font: 400 13px/1.5 var(--font-mono);
    }
    .cli-search-form input::placeholder { color: #817a75; }
    .cli-search-form button {
      display: grid;
      width: 36px;
      height: 36px;
      min-height: 36px;
      place-items: center;
      padding: 0;
      border: 1px solid #9d4c5a;
      border-radius: 50%;
      background: #7a2e3b;
      color: #fffaf4;
      cursor: pointer;
    }
    .cli-search-form button svg {
      width: 17px;
      height: 17px;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    @media (min-width: 768px) {
      .hero { padding-inline: 40px; }
    }
    @media (max-width: 1080px) {
      .hero {
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 32px;
      }
      .hero-copy h1 { font-size: clamp(36px, 5vw, 52px); }
    }
    @media (max-width: 960px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 36px;
      }
      .hero-copy { max-width: 680px; }
    }
    @media (max-width: 767px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 14px;
        padding: 20px 20px 30px;
      }
      .hero-copy { max-width: none; }
      .hero-media { width: min(78%, 300px); margin-top: 18px; }
      .hero-kicker { margin-bottom: 10px; font-size: 10px; }
      .hero-copy h1 { font-size: clamp(34px, 10vw, 46px); line-height: 1.18; }
      .hero-summary { margin-top: 12px; font-size: 15px; line-height: 1.7; }
      .hero-actions { display: grid; gap: 8px; margin-top: 16px; }
        .hero-ghost { width: 100%; }
      .hero-secondary { width: 100%; }
      .cli { border-radius: 10px; }
      .cli-brand {
        height: 32px;
        padding-inline: 12px;
        border-radius: 9px 9px 0 0;
      }
      .cli-window-title { overflow: hidden; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
      .cli-screen {
        min-height: 0;
        padding: 10px 12px 12px;
      }
      .cli-question {
        font-size: clamp(22px, 7vw, 28px);
      }
      .cli-tabs {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-top: 12px;
      }
      .cli-tabs button { min-height: 34px; font-size: 12px; }
      .cli-options {
        gap: 8px;
        margin: 8px 0 0;
      }
      .cli-options a {
        min-height: 54px;
        grid-template-columns: 26px minmax(0, 1fr) auto;
        padding: 8px 12px;
        gap: 10px;
      }
      .cli-options strong { font-size: 13px; }
      .cli-options small { font-size: 11px; }
      .cli-option-index { font-size: 11px; }
      .cli-option-arrow { font-size: 13px; }
      .cli-search-results {
        padding-inline: 10px;
      }
      .cli-search-form {
        min-height: 44px;
        gap: 7px;
        padding-inline: 10px;
      }
      .cli-search-form input { font-size: 11px; }
      .cli-search-form button {
        width: 32px;
        height: 32px;
        min-height: 32px;
      }
    }
    @media (max-width: 767px) and (max-height: 520px) {
      .hero { padding-block: 24px; }
      .cli-screen { padding-block: 10px; }
      .cli-conversation { margin-top: 0; }
      .cli-search-form { min-height: 44px; }
    }

    /* 區塊提問只用於頁尾 CTA。 */
    .q {
      color: var(--color-ink);
      font-family: var(--font-serif);
      font-weight: 600;
      letter-spacing: 0;
    }
    .q--sec {
      font-size: clamp(20px, 3vw, 28px);
      line-height: 1.15;
    }
    /* ---------- 按鈕 ---------- */
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 26px;
    }
    .hero-contact-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-top: 24px;
    }
    .hero-scroll-cue {
      display: flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 8px;
      color: var(--color-accent);
      font-size: 12.5px;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    .hero-scroll-cue span {
      font-family: var(--font-mono);
      text-decoration: none;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14.5px;
      font-weight: 500;
      text-decoration: none;
      padding: 12px 22px;
      border-radius: 3px;
      line-height: 1.4;
      /* 44px 觸控目標：12+12 內距 ＋ 14.5×1.4 行框 ≈ 44.3px */
      min-height: 44px;
      transition:
        background-color 0.18s var(--ease),
        border-color 0.18s var(--ease),
        color 0.18s var(--ease),
        transform 0.18s var(--ease);
    }
    .btn-contact {
      border: 1px solid var(--color-rule-3);
      background: rgb(255 255 255 / 34%);
      color: var(--color-ink-2);
    }
    .btn-contact > svg {
      width: 18px;
      height: 18px;
      flex: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    @media (max-width: 767px) {
      .hero-contact-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 5px;
        margin-top: 10px;
      }
      .hero-contact-actions .btn {
        justify-content: center;
        gap: 5px;
        min-width: 0;
        padding: 8px 5px;
        font-size: 11px;
      }
      .hero-contact-actions .btn-contact > svg {
        width: 16px;
        height: 16px;
      }
    }
    /* 按鈕文字必須是「一個」flex 子項。若讓文字節點直接當子項，
       包裹拉丁字段用的 .lat 會被 blockify 成 flex item，gap:8px 就會
       把「加 LINE 免費諮詢」拆成三塊。 */
    .btn-l {
      display: inline;
    }
    .btn .arw {
      font-family: var(--font-mono);
      font-size: 12.5px;
      opacity: 0.85;
      --ls: 0em;
    }

    /* ---------- 首屏下方的服務詳細介紹 ---------- */
    .service-details {
      padding-top: clamp(24px, 4vw, 48px);
    }
    #free-resources {
      scroll-margin-top: calc(var(--bar) + 16px);
    }
    .service-row {
      display: grid;
      gap: 30px;
      padding: clamp(48px, 7vw, 88px) 0;
      border-top: 1px solid var(--color-rule);
    }
    @media (max-width: 767px) {
      .service-row:first-child {
        padding-top: 36px;
      }
    }
    @media (min-width: 768px) {
      .service-row {
        grid-template-columns: minmax(0, 1fr) minmax(280px, 0.88fr);
        gap: clamp(48px, 7vw, 96px);
        align-items: center;
      }
      .service-row--reverse .service-copy {
        order: 2;
      }
      .service-row--reverse .service-media {
        order: 1;
      }
    }
    .service-copy {
      max-width: 58ch;
    }
    .development-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 24px;
    }
    .development-steps {
      display: grid;
      gap: 6px;
      margin-top: 20px;
      padding-left: 1.4em;
      color: var(--color-ink-3);
      font-size: 14px;
      line-height: 1.7;
    }
    .development-cost {
      display: grid;
      gap: 28px;
      padding: clamp(48px, 7vw, 88px) 0;
      border-top: 1px solid var(--color-rule);
    }
    .development-cost-head h2 {
      font-family: var(--font-serif);
      font-size: clamp(32px, 4vw, 52px);
      line-height: 1.1;
      font-weight: 600;
      color: var(--color-ink);
    }
    .development-cost-head > p:not(.service-kicker) {
      max-width: 58ch;
      margin-top: 20px;
      font-size: 16px;
      line-height: 1.9;
      color: var(--color-ink-2);
    }
    .development-cost-list {
      display: grid;
      gap: 0;
      border-top: 1px solid var(--color-rule);
    }
    .development-cost-list > div {
      display: grid;
      gap: 6px;
      padding: 18px 0;
      border-bottom: 1px solid var(--color-rule);
    }
    .development-cost-list dt {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: var(--color-accent);
    }
    .development-cost-list dd {
      margin: 0;
      font-size: 15px;
      line-height: 1.8;
      color: var(--color-ink-2);
    }
    @media (min-width: 768px) {
      .development-cost-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 40px;
      }
    }
    .development-cost-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px 28px;
    }
    .development-cost-primary {
      display: inline-flex;
      min-height: 50px;
      align-items: center;
      gap: 10px;
      padding: 0 24px;
      background: var(--color-accent);
      color: #fff;
      font-weight: 700;
      text-decoration: none;
    }
    .development-cost-primary:hover {
      background: var(--color-accent-2, var(--color-accent));
    }
    @media (max-width: 767px) {
      .development-cost-primary {
        width: 100%;
        justify-content: center;
      }
    }
    .home-subhead {
      padding: clamp(40px, 6vw, 72px) 0 0;
      border-top: 1px solid var(--color-rule);
    }
    .home-subhead h2 {
      font-family: var(--font-serif);
      font-size: clamp(26px, 3vw, 38px);
      line-height: 1.2;
      font-weight: 600;
      color: var(--color-ink);
    }
    .home-subhead + .service-row {
      border-top: 0;
    }
    .service-kicker {
      margin-bottom: 12px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.1em;
      color: var(--color-accent);
    }
    .service-copy h2 {
      font-family: var(--font-serif);
      font-size: clamp(32px, 4vw, 52px);
      line-height: 1.1;
      font-weight: 600;
      color: var(--color-ink);
    }
    .service-copy > p:not(.service-kicker) {
      margin-top: 20px;
      font-size: 16px;
      line-height: 1.9;
      color: var(--color-ink-2);
    }
    .service-copy ul {
      display: grid;
      gap: 8px;
      margin-top: 20px;
      padding: 0;
      list-style: none;
      color: var(--color-ink-3);
      font-size: 14px;
      line-height: 1.65;
    }
    .service-copy li {
      position: relative;
      padding-left: 16px;
    }
    .service-copy li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--color-accent);
    }
    .service-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      margin-top: 24px;
      color: var(--color-accent);
      font-size: 14.5px;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 5px;
    }
    .service-media {
      margin: 0;
      overflow: hidden;
      aspect-ratio: 4 / 3;
    }
    .service-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border: 1px solid var(--color-rule-2);
    }
    .service-media--portrait img {
      object-position: center 28%;
    }
    .case-mini-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .case-mini-grid li {
      display: grid;
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 11px;
      align-items: start;
      min-height: 126px;
      padding: 14px;
      border: 1px solid var(--color-rule-2);
      background: rgb(255 255 255 / 42%);
    }
    .case-mini-icon {
      width: 38px;
      height: 38px;
      object-fit: contain;
    }
    .case-mini-grid strong,
    .case-mini-grid span {
      display: block;
    }
    .case-mini-grid strong {
      font-size: 13px;
      line-height: 1.55;
      font-weight: 600;
      color: var(--color-ink);
    }
    .case-mini-grid span {
      margin-top: 7px;
      font-size: 11.5px;
      line-height: 1.5;
      color: var(--color-accent);
    }

    /* ---------- 關於講師：人物檔案式資訊層級 ---------- */
    .instructor-profile {
      display: grid;
