  <script is:inline>
    /* 手機首屏的終端機本身已有站內搜尋；終端機還在畫面時隱藏右下角浮動操作，
       避免 LINE 與 chatbot 蓋住搜尋列／ONLINE 狀態列。滑過終端機後再顯示。 */
    (function () {
      var cli = document.getElementById('hero-cli');
      if (!cli) return;

      function setCliVisible(visible) {
        document.body.classList.toggle('home-cli-visible', visible);
      }

      setCliVisible(true);

      if ('IntersectionObserver' in window) {
        var cliObserver = new IntersectionObserver(function (entries) {
          setCliVisible(entries[0].isIntersecting);
        });
        cliObserver.observe(cli);
        return;
      }

      function updateCliVisibility() {
        var rect = cli.getBoundingClientRect();
        setCliVisible(rect.bottom > 0 && rect.top < window.innerHeight);
      }
      window.addEventListener('scroll', updateCliVisibility, { passive: true });
      window.addEventListener('resize', updateCliVisibility);
      updateCliVisibility();
    })();
  </script>

  <script is:inline>
    /* 逐段浮現：內容 100% 寫在初始 HTML 裡，只有「顯示與否」交給 CSS。
       `js` 這個 class 加在 #home-root（不是 <html>）上，因為這一頁的樣式是
       Astro 的元件範圍樣式——選擇器會被加上 data-astro-cid-*，
       掛在 <html> 上的 class 選不到。
       三層保險，任何一層失效內容都仍然完整可見：
         1. 沒有 JS（或這段拋例外）→ `js` 不會加上 → 所有 .reveal 維持原樣可見
         2. IntersectionObserver 不存在／被停用／行為異常 → 2 秒逾時強制顯示
         3. prefers-reduced-motion → 直接全部顯示，且 CSS 也把過渡關掉 */
    (function () {
      var root = document.getElementById('home-root');
      if (!root) return;
      var reveals = root.querySelectorAll('.reveal, .hero-reveal');

      function revealAll() {
        for (var i = 0; i < reveals.length; i++) reveals[i].classList.add('is-in');
      }

      try {
        root.classList.add('js');

        // 保險 1：先掛逾時，再做任何可能爆炸的事
        var ioAlive = false;
        setTimeout(function () {
          if (!ioAlive) revealAll();
        }, 2000);

        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 首屏：立刻揭露（0 / 70 / 140ms 延遲，各 200ms → 總揭露 340ms）
        var hero = root.querySelectorAll('.hero-reveal');
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            for (var i = 0; i < hero.length; i++) hero[i].classList.add('is-in');
          });
        });

        if (reduce || !('IntersectionObserver' in window)) {
          revealAll();
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            ioAlive = true; // 觀察器確實會回呼 → 逾時保險不必動作
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );

        var scrollReveals = root.querySelectorAll('.reveal');
        for (var k = 0; k < scrollReveals.length; k++) io.observe(scrollReveals[k]);
      } catch (err) {
        revealAll(); // 保險 2
      }
    })();
  </script>

  <script is:inline>
    (function () {
      var cli = document.getElementById('hero-cli');
      if (!cli) return;
      var question = cli.querySelector('[data-cli-question]');
      var options = Array.prototype.slice.call(cli.querySelectorAll('.cli-options button'));
      var output = document.getElementById('cli-output');
      var commandText = document.getElementById('cli-command-text');
      var thinking = document.getElementById('cli-thinking');
      var answer = document.getElementById('cli-answer');
      var answerText = document.getElementById('cli-answer-text');
      var answerImage = document.getElementById('cli-answer-image');
      var caseVisual = document.getElementById('cli-case-visual');
      var articleVisual = document.getElementById('cli-article-visual');
      var answerLink = document.getElementById('cli-answer-link');
      var endButton = document.getElementById('cli-end');
      var searchForm = document.getElementById('cli-search-form');
      var searchInput = document.getElementById('cli-search-input');
      var searchResults = document.getElementById('cli-search-results');
      if (!question || !options.length || !output || !commandText || !thinking || !answer || !answerText || !answerImage || !caseVisual || !articleVisual || !answerLink || !endButton || !searchForm || !searchInput || !searchResults) return;

      var active = 0;
      var autoTimer = 0;
      var timers = [];
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var searchIndexPromise;
      var searchTimer;
      var searchActive = -1;

      function later(callback, delay) {
        var timer = window.setTimeout(callback, delay);
        timers.push(timer);
        return timer;
      }

      function clearResponseTimers() {
        timers.forEach(function (timer) { window.clearTimeout(timer); });
        timers = [];
      }

      function stopAuto() {
        window.clearInterval(autoTimer);
        autoTimer = 0;
        cli.classList.add('is-controlled');
      }

      function setActive(index, focus) {
        active = (index + options.length) % options.length;
        options.forEach(function (option, optionIndex) {
          var selected = optionIndex === active;
          option.classList.toggle('is-active', selected);
          option.setAttribute('aria-selected', selected ? 'true' : 'false');
        });
        if (focus) options[active].focus({ preventScroll: true });
      }

      function typeText(element, value, speed, done) {
        if (reduce) {
          element.textContent = value;
          if (done) done();
          return;
        }
        element.textContent = '';
        var index = 0;
        function next() {
          element.textContent = value.slice(0, index + 1);
          index += 1;
          if (index < value.length) later(next, speed);
          else if (done) done();
        }
        next();
      }

      function runAnswer(option) {
        if (!cli.classList.contains('is-ready')) return;
        var pageScrollY = window.scrollY;
        stopAuto();
        clearResponseTimers();
        cli.focus({ preventScroll: true });
        question.textContent = question.dataset.cliQuestion || '';
        setActive(options.indexOf(option), false);
        cli.classList.remove('is-thinking', 'is-answered');
        cli.classList.add('has-output');
        output.classList.add('is-visible');
        thinking.hidden = true;
        commandText.textContent = option.querySelector('strong').textContent;
        var showCases = option.dataset.imageKind === 'cases';
        var showArticles = option.dataset.imageKind === 'articles';
        caseVisual.hidden = !showCases;
        articleVisual.hidden = !showArticles;
        answerImage.hidden = showCases || showArticles;
        if (!showCases && !showArticles) {
          answerImage.src = option.dataset.image || '';
          answerImage.alt = option.dataset.imageAlt || '';
        }
        answerLink.href = option.dataset.href || '/';
        answerLink.firstChild.textContent = (option.dataset.linkLabel || '繼續查看') + ' ';
        answerLink.dataset.gaLabel = option.dataset.linkLabel || '繼續查看';
        cli.classList.add('is-answered');
        answer.hidden = false;
        answer.classList.add('is-visible');
        typeText(answerText, option.dataset.answer || '', 14);
        window.requestAnimationFrame(function () { window.scrollTo(0, pageScrollY); });
      }

      function endConversation() {
        clearResponseTimers();
        cli.classList.remove('has-output', 'is-thinking', 'is-answered');
        output.classList.remove('is-visible');
        thinking.hidden = true;
        answer.hidden = true;
        answer.classList.remove('is-visible');
        commandText.textContent = '';
        answerText.textContent = '';
        answerImage.alt = '';
        setActive(0, false);
        cli.focus({ preventScroll: true });
      }

      function loadSearchIndex() {
        if (!searchIndexPromise) {
          searchIndexPromise = fetch('/search-index.json')
            .then(function (response) { return response.json(); })
            .catch(function () { return []; });
        }
        return searchIndexPromise;
      }

      function setSearchActive(index) {
        var links = searchResults.querySelectorAll('a');
        if (!links.length) return;
        searchActive = Math.max(0, Math.min(index, links.length - 1));
        links.forEach(function (link, linkIndex) {
          link.classList.toggle('is-active', linkIndex === searchActive);
        });
        links[searchActive].scrollIntoView({ block: 'nearest' });
      }

      function renderSearchResults(items) {
        searchResults.replaceChildren();
        if (!items.length) {
          var empty = document.createElement('p');
          empty.className = 'cli-search-empty';
          empty.textContent = '找不到符合的文章，請嘗試其他關鍵字。';
          searchResults.appendChild(empty);
          searchActive = -1;
        } else {
          items.slice(0, 5).forEach(function (item) {
            var link = document.createElement('a');
            var title = document.createElement('strong');
            var description = document.createElement('span');
            link.className = 'cli-search-result';
            title.className = 'cli-search-title';
            description.className = 'cli-search-description';
            link.href = item.u;
            link.dataset.gaButton = 'hero_search_result';
            link.dataset.gaLabel = item.t;
            link.dataset.gaLocation = 'hero_cli';
            link.dataset.gaAction = 'open_result';
            title.textContent = item.t;
            description.textContent = item.d || '';
            link.append(title, description);
            searchResults.appendChild(link);
          });
          setSearchActive(0);
        }
        searchResults.hidden = false;
      }

      function searchSite(rawQuery) {
        var query = rawQuery.trim().toLowerCase();
        window.clearTimeout(searchTimer);
        if (!query) {
          searchResults.hidden = true;
          searchResults.replaceChildren();
          searchActive = -1;
          return;
        }
        searchResults.hidden = false;
        searchResults.replaceChildren();
        var loading = document.createElement('p');
        loading.className = 'cli-search-empty';
        loading.textContent = '搜尋中…';
        searchResults.appendChild(loading);
        loadSearchIndex().then(function (items) {
          renderSearchResults(items.filter(function (item) {
            return ((item.t || '') + ' ' + (item.d || '') + ' ' + (item.g || ''))
              .toLowerCase()
              .indexOf(query) !== -1;
          }));
        });
      }

      options.forEach(function (option, index) {
        option.addEventListener('mouseenter', function () {
          stopAuto();
          setActive(index, false);
        });
        option.addEventListener('focus', function () {
          stopAuto();
          setActive(index, false);
        });
        option.addEventListener('click', function () { runAnswer(option); });
      });

      cli.addEventListener('pointerdown', stopAuto, { once: true });
      endButton.addEventListener('click', endConversation);
      cli.addEventListener('keydown', function (event) {
        if (searchForm.contains(event.target)) return;
        if (cli.classList.contains('has-output') || !cli.classList.contains('is-ready')) return;
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          stopAuto();
          setActive(active + (event.key === 'ArrowDown' ? 1 : -1), true);
        } else if (event.key === 'Enter' && event.target === cli) {
          event.preventDefault();
          options[active].click();
        }
      });

      searchInput.addEventListener('focus', loadSearchIndex);
      searchInput.addEventListener('input', function () {
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(function () { searchSite(searchInput.value); }, 180);
      });
      searchInput.addEventListener('keydown', function (event) {
        var links = searchResults.querySelectorAll('a');
        if (event.key === 'ArrowDown' && links.length) {
          event.preventDefault();
          setSearchActive(searchActive + 1);
        } else if (event.key === 'ArrowUp' && links.length) {
          event.preventDefault();
          setSearchActive(searchActive - 1);
        } else if (event.key === 'Enter') {
          event.preventDefault();
          if (links.length && searchActive >= 0) {
            links[searchActive].click();
          } else {
            searchSite(searchInput.value);
          }
        } else if (event.key === 'Escape') {
          searchInput.value = '';
          searchSite('');
        }
      });
      searchForm.addEventListener('submit', function (event) {
        event.preventDefault();
        searchSite(searchInput.value);
      });

      function ready() {
        cli.classList.remove('is-typing');
        cli.classList.add('is-ready');
        if (!reduce) {
          autoTimer = window.setInterval(function () { setActive(active + 1, false); }, 1450);
        }
      }

      if (reduce) {
        ready();
      } else {
        cli.classList.add('is-typing');
        typeText(question, question.dataset.cliQuestion || '', 42, function () { later(ready, 220); });
      }
    })();
  </script>

  <style>
    /* ============================================================
       首頁專屬排版。這裡的每一條都只作用在首頁，不外洩到內頁：
       - 展示級 H1（96px）與襯線體是首頁專用（設計語言定案 #1）
       - 字距分級只套在拉丁字段（.lat）上，中文一律 0
       - 顏色一律用 global.css @theme 的 --color-*，這裡不重新定義任何顏色
       - 內頁字級 .t-h1／.t-h2／.t-h3 這裡完全不碰
       ============================================================ */
    .home {
      /* ---- 字距分級（依光學尺寸，不是一個值套到底）----
         只套在拉丁字段（.lat）上；中文一律 0。
         --ls-display 供 ≥72px 的字段使用。H1 是 clamp(56,8vw,96)，
         8vw 在 viewport 900px 時剛好等於 72px，因此 display 級只在
         min-width:900px 之後才接上；900px 以下 H1 是 56–71.9px，留在 title 級。 */
      --ls-display: -0.06em;
      --ls-title: -0.028em;
      --ls-body: -0.011em;
      --ls-micro: 0.12em;
      --ls: var(--ls-body); /* 拉丁字段預設用內文級 */

      color: var(--color-ink-2);
      font-size: 16px;
      line-height: 1.9;
      letter-spacing: 0; /* 中文：0，不商量 */
    }

    /* 版心對齊 Base 的頁首頁尾（.hd-cap／.ft-wrap 都是 max-width:72rem、
       padding 20/40px）。原型的 .shell 是 1120px，這裡改用 72rem＝1152px，
       為的是 H1 的左緣跟頁首字標、頁尾品牌塊落在同一條垂直線上——
       兩者差 32px 時，捲動經過頁首那條線會看得出來。 */
    .home-shell {
      width: 100%;
      max-width: 72rem;
      margin: 0 auto;
      padding: 0 20px;
    }
    @media (min-width: 768px) {
      .home-shell {
        padding: 0 40px;
      }
    }

    /* ---- 拉丁字段：字距只加在這裡，並補回「尾字距」----
       CSS 的 letter-spacing 會在字段最後一個字元「後面」也加一份間距，
       負值會把後面的中文吸過來、正值會推開。用等量反向的 margin 補回。
       原型是用 .lat 包裹、由 Python 腳本在建置期產生；Astro 沒有那一步，
       首頁內容已砍到 470 字上下，.lat 的位置不多，直接手寫在模板裡。 */
    .lat {
      font-style: normal;
      letter-spacing: var(--ls, 0em);
      margin-inline-end: calc(-1 * var(--ls, 0em));
    }

    /* 12–13px 小標籤：唯一反向加字距的地方（正值，中文也適用），
       同樣要補回尾字距，否則標籤右側會多出一份空白。 */
    .micro {
      letter-spacing: var(--ls-micro);
      margin-inline-end: calc(-1 * var(--ls-micro));
      --ls: 0em; /* 內層 .lat 不再疊加 */
    }

    /* ============================================================
       全形問號的左空白修剪
       ------------------------------------------------------------
       問題：96px 下句末的全形「？」左邊留一個 27px 的空洞。
       實測（Noto Serif TC，upm 1000）：
         U+FF1F  advance 1.000em，墨跡 0.254em → 0.730em
                 左空白 0.254em、右空白 0.270em
         相鄰漢字 始 rsb 0.043em／大 rsb 0.049em／哪 lsb 0.068em
       → 漢字對漢字的墨跡間距約 0.068em，漢字對「？」是 0.297em，差 3.7 倍。
         Chrome 147／96px 實際渲染量測：始？＝28px，始始＝7px。

       ---- 三條「正規解法」全部驗證過，全部不能用 ----
       1. font-feature-settings:"palt" 1
          ／font-variant-east-asian:proportional-width
          Noto Serif TC 的 GPOS 裡「沒有 palt」。108 個子集抽驗 3 個
          （含實際含 U+FF1F 的那個），GPOS 只有 chws/halt/kern/vchw/vhal/vpal。
          halt 的涵蓋範圍只有「」（）！ 等六個字符，chws 只處理成對括號，
          兩者都不含 U+FF1F。實測結果：間距 26px 完全不動。
          同一段 CSS 換成 Noto Sans TC 就有效（27px → 12px）——Sans 有 palt
          且涵蓋 U+FF1F（XPlacement −134／XAdvance −283）。
          也就是說語法沒錯，是這支襯線字型沒有這個功能。
          另外 font-variant-east-asian:proportional-width 對應的是 pwid 而非
          palt，連 Noto Sans TC 都沒有效果（實測 27px 不動）。
       2. text-spacing-trim（CSS Text Level 4）
          Chrome 147 只接受 normal / trim-start / space-all；
          trim-both、trim-all、auto 全部 invalid（CSS.supports 回 false）。
          功能本身確實有在運作：trim-start 會把行首的「切掉左半格
          （墨跡左緣 163px → 115px，正好 0.5em）。
          但三個合法值對「？」的渲染結果一模一樣（26px 不動）——
          規格只裁全形的「開頭／結尾標點」，全形問號、驚嘆號不在裡面。
       3. GSUB 的 hwid／pwid 寬度替代字符
          Noto Serif TC 的 GSUB 只有 ccmp/liga/locl/vert/vrt2，沒有寬度替代。

       ---- 結論與作法 ----
       這支字型沒有任何 OpenType 或 CSS 標準機制可用，只剩光學修剪一條路。
       修剪量不是喬出來的：0.254em（？的左空白）− 0.05em（保留的殘餘空白）
       = 0.204em。留下的 0.05em 讓「？」的墨跡間距落回漢字的節奏上。
       實測驗收（Chrome 147／96px）：始？ 28px → 9px（對照 始始 ＝ 7px）、
                                     大？ 26px → 7px（對照 大大 ＝ 5px）。
       比漢字節奏鬆 2px，這是對的——問號本來就該比字距多留一點點氣。

       副作用與圍堵：
       - 只作用在被 .qt 包起來的那一個字元。頁面其他地方的「，」「。」
         完全不受影響（實測 大，大 加不加 .qt 都是 41/43px）。
       - 修剪量是 em，隨字級等比縮放，所有斷點的光學結果一致，
         不需要為不同字級各補一次。
       - 換行風險：用 .nb（white-space:nowrap）把「開始？」綁成一個
         不可斷的單位，「？」永遠不可能落到行首，也就不會把負 margin
         拉到容器左緣外面。
       - 字型 fallback 風險：若 Noto Serif TC 沒載入，改用 Songti TC 等
         備援字型時修剪量可能不完全匹配。只有在備援字型的「？」左空白
         小於 0.204em 時才會過修——絕大多數中文字型都是 0.24–0.28em，
         風險低，但這條無法在本機驗證，仍屬已知風險。
       ============================================================ */
    .qt {
      margin-inline-start: -0.204em;
    }
    .nb {
      white-space: nowrap;
    }

    /* ---------- Hero：單一互動式 CLI ---------- */
    .hero {
      display: grid;
      width: 100%;
      min-height: calc(100vh - var(--bar));
      min-height: calc(100svh - var(--bar));
      align-items: stretch;
      justify-content: stretch;
      padding: 20px;
    }
    .cli {
      display: flex;
      width: 100%;
      /* 72rem 全站版心扣掉桌機兩側各 40px 內距，與導覽、免費區塊內容左右緣對齊。 */
      max-width: 67rem;
      min-height: calc(100vh - var(--bar) - 40px);
      min-height: calc(100svh - var(--bar) - 40px);
      flex-direction: column;
      margin: 0 auto;
      border: 1px solid #343130;
      border-radius: 8px;
      background: #151414;
      color: #f5f1eb;
      box-shadow: 0 26px 70px rgb(22 18 17 / 18%);
      outline: none;
      overflow-anchor: none;
    }
    .cli:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 4px;
    }
    .cli-bar {
      display: flex;
      height: 42px;
      align-items: center;
      gap: 7px;
      padding: 0 15px;
      border-bottom: 1px solid #393635;
      background: #242120;
    }
    .cli-dot {
      width: 9px;
      height: 9px;
      flex: none;
      border-radius: 50%;
    }
    .cli-dot--red { background: #a94d59; }
    .cli-dot--yellow { background: #b8924f; }
    .cli-dot--green { background: #5d9975; }
    .cli-bar b {
      min-width: 0;
      margin-inline-start: 5px;
      overflow: hidden;
      color: #aaa29d;
      font: 400 11px/1 var(--font-mono);
      letter-spacing: 0.03em;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .cli-screen {
      display: flex;
      width: 100%;
      min-height: 0;
      flex: 1;
      flex-direction: column;
      padding: clamp(22px, 4vw, 46px);
      font-family: var(--font-mono);
    }
    .cli-boot {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      margin: 0;
      color: #716b67;
      font-size: 10px;
      line-height: 1.4;
      letter-spacing: 0.11em;
    }
    .cli-conversation {
      width: 100%;
      margin-top: 24px;
      padding-top: 0;
    }
    .cli-dialog {
      display: flex;
      min-width: 0;
      align-items: center;
      gap: 12px;
    }
    .cli-ai-label {
      display: inline-grid;
      min-width: 34px;
      height: 25px;
      flex: none;
      place-items: center;
      padding: 0 7px;
      border: 1px solid #bc6472;
      border-radius: 3px;
      color: #f09aa7;
      font-size: 10px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.08em;
    }
    .cli-question {
      min-width: 0;
      margin: 0;
      color: #f7f3ee;
      font: 600 clamp(20px, 3.2vw, 34px)/1.45 var(--font-display);
      letter-spacing: 0;
      overflow-wrap: anywhere;
    }
    .cli-caret,
    .cli-command i {
      display: inline-block;
      width: 2px;
      height: 1.3em;
      flex: none;
      background: #e98a98;
      animation: cli-caret 0.72s step-end infinite;
    }
    .cli.is-ready .cli-caret {
      opacity: 0;
    }
    .cli-options {
      display: grid;
      gap: 4px;
      max-width: 760px;
      margin-left: 34px;
    }
    .cli-options button {
      display: grid;
      grid-template-columns: 18px 28px minmax(0, 1fr);
      gap: 10px;
      width: 100%;
      min-height: 48px;
      align-items: center;
      padding: 8px 12px;
      border: 1px solid transparent;
      border-radius: 3px;
      background: transparent;
      color: #aaa39e;
      font: inherit;
      text-align: left;
      cursor: pointer;
      transition: border-color 0.16s ease, background-color 0.16s ease, color 0.16s ease;
    }
    .cli-options button.is-active {
      border-color: #5a5150;
      background: #272322;
      color: #fffaf4;
    }
    .cli-selector {
      color: transparent;
      font-size: 15px;
    }
    .cli-options button.is-active .cli-selector {
      color: #ef8998;
    }
    .cli-index {
      color: #716b67;
      font-size: 10px;
    }
    .cli-options strong {
      min-width: 0;
      color: inherit;
      font-family: var(--font-display);
      font-size: clamp(13px, 1.7vw, 16px);
      font-weight: 500;
      line-height: 1.45;
    }
    .cli.is-typing .cli-options {
      opacity: 0;
      pointer-events: none;
    }
    .cli.is-ready .cli-options {
      animation: cli-options-in 0.34s var(--ease) both;
    }
    .cli.has-output .cli-options {
      display: none;
    }
    .cli-output {
      display: none;
      max-width: 820px;
      margin: 18px 0 0 34px;
      padding-top: 0;
      border-top: 0;
    }
    .cli.has-output .cli-output {
      display: block;
    }
    .cli-command {
      display: flex;
      min-height: 25px;
      align-items: center;
      gap: 9px;
      margin: 0;
      color: #d7d0ca;
      font-size: 13px;
      line-height: 1.6;
    }
    .cli-command > span { color: #ef8998; }
    .cli-command b { font-weight: 500; }
    .cli-command i {
      width: 1px;
      height: 1.05em;
    }
    .cli-thinking {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 12px 0 0;
      color: #8e8782;
      font-size: 11px;
    }
    .cli-thinking[hidden],
    .cli-answer[hidden] {
      display: none;
    }
    .cli-thinking > span {
      width: 9px;
      height: 9px;
      border: 1px solid #716b67;
      border-top-color: #ef8998;
      border-radius: 50%;
      animation: cli-spin 0.75s linear infinite;
    }
    .cli-answer {
      display: grid;
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 11px 12px;
      margin-top: 16px;
      animation: cli-answer-in 0.3s var(--ease) both;
    }
    .cli-answer-content {
      display: grid;
      min-width: 0;
      grid-template-columns: minmax(180px, 0.85fr) minmax(220px, 1fr);
      align-items: center;
      gap: clamp(14px, 2.5vw, 24px);
    }
    .cli-answer-media {
      min-width: 0;
    }
    .cli-answer-media > img {
      display: block;
      width: 100%;
      max-height: 230px;
      border: 1px solid #494442;
      border-radius: 4px;
      background: #242120;
      object-fit: cover;
      aspect-ratio: 16 / 9;
    }
    .cli-answer-media > img[hidden],
    .cli-case-visual[hidden],
    .cli-article-visual[hidden] {
      display: none;
    }
    .cli-case-visual {
      padding: 12px;
      border: 1px solid #494442;
      border-radius: 4px;
      background: #201e1d;
    }
    .cli-case-visual-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding-bottom: 8px;
      border-bottom: 1px solid #3b3735;
    }
    .cli-case-visual-head span {
      color: #ef8998;
      font-size: 8px;
      letter-spacing: 0.12em;
    }
    .cli-case-visual-head b {
      color: #d8d1cb;
      font: 600 11px/1.4 var(--font-display);
    }
    .cli-case-visual ul {
      display: grid;
      gap: 6px;
      margin: 8px 0 0;
      padding: 0;
      list-style: none;
    }
    .cli-case-visual li {
      display: grid;
      min-width: 0;
      grid-template-columns: 28px minmax(0, 1fr);
      align-items: center;
      gap: 8px;
      padding: 6px 7px;
      border: 1px solid #373331;
      border-radius: 3px;
      background: #292625;
    }
    .cli-case-visual li img {
      width: 28px;
      height: 28px;
      border-radius: 4px;
      object-fit: contain;
    }
    .cli-case-visual li span,
    .cli-case-visual li b,
    .cli-case-visual li small {
      display: block;
      min-width: 0;
    }
    .cli-case-visual li small {
      margin-bottom: 1px;
      color: #8f8782;
      font-size: 7px;
      line-height: 1.3;
    }
    .cli-case-visual li b {
      overflow: hidden;
      color: #e7e0da;
      font-size: 8px;
      font-weight: 500;
      line-height: 1.4;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .cli-article-visual {
      display: grid;
      gap: 7px;
    }
    .cli-article-visual > a,
    .cli-article-category {
      display: grid;
      min-width: 0;
      min-height: 72px;
      grid-template-columns: 92px minmax(0, 1fr);
      align-items: center;
      gap: 10px;
      padding: 7px;
      border: 1px solid #494442;
      border-radius: 4px;
      background: #201e1d;
      color: #e7e0da;
      text-decoration: none;
    }
    .cli-article-visual img {
      display: block;
      width: 92px;
      height: 58px;
      border-radius: 3px;
      object-fit: cover;
    }
    .cli-article-visual span,
    .cli-article-visual small,
    .cli-article-visual b {
      display: block;
      min-width: 0;
    }
    .cli-article-visual small {
      margin-bottom: 3px;
      color: #ef8998;
      font-size: 8px;
      letter-spacing: 0.08em;
    }
    .cli-article-visual b,
    .cli-article-category span > a {
      color: #e7e0da;
      font: 500 10px/1.45 var(--font-display);
    }
    .cli-article-category span > a {
      display: inline-block;
      min-height: 32px;
      margin-right: 8px;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .cli-answer p {
      margin: 0;
      color: #d8d1cb;
      font-family: var(--font-display);
      font-size: clamp(12px, 1.5vw, 14px);
      line-height: 1.9;
    }
    .cli-answer > a {
      grid-column: 2;
      width: fit-content;
      min-height: 44px;
      color: #f09aa7;
      font-family: var(--font-display);
      font-size: 12px;
      line-height: 1.5;
      text-underline-offset: 4px;
    }
    .cli-end {
      grid-column: 2;
      width: fit-content;
      min-height: 44px;
      padding: 0;
      border: 0;
      background: transparent;
      color: #918a84;
      font: 500 11px/1.5 var(--font-mono);
      text-decoration: underline;
      text-underline-offset: 4px;
      cursor: pointer;
    }
    .cli-search-area {
      flex: none;
      border-top: 1px solid #393635;
      background: #181716;
      font-family: var(--font-mono);
    }
    .cli-search-results {
      display: grid;
      gap: 3px;
      padding: 12px clamp(15px, 4vw, 46px) 8px;
      border-bottom: 1px solid #302e2b;
    }
    .cli-search-results[hidden] { display: none; }
    :global(.cli-search-empty) {
      margin: 0;
      color: #8e8782;
      font-size: 11px;
      line-height: 1.7;
    }
    :global(.cli-search-result) {
      display: grid;
      gap: 2px;
      padding: 8px 10px;
      border: 1px solid transparent;
      border-radius: 2px;
      color: #c9c2bb;
      text-decoration: none;
    }
    :global(.cli-search-result.is-active) {
      border-color: #514a47;
      background: #272322;
    }
    :global(.cli-search-title) {
      color: #f2ede6;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 500;
      line-height: 1.5;
    }
    :global(.cli-search-description) {
      overflow: hidden;
      color: #8e8782;
      font-family: var(--font-display);
      font-size: 10px;
      line-height: 1.5;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .cli-search-form {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      min-height: 52px;
      align-items: center;
      gap: 10px;
      padding: 0 clamp(15px, 4vw, 46px);
    }
    .cli-search-prompt {
      color: #71b58a;
      font-size: 11px;
      white-space: nowrap;
    }
    .cli-search-form input {
      min-width: 0;
      padding: 8px 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: #f5f1eb;
      font: 400 13px/1.5 var(--font-mono);
    }
    .cli-search-form input::placeholder { color: #716b67; }
    .cli-search-form button {
      display: grid;
      width: 34px;
      height: 34px;
      min-height: 34px;
      place-items: center;
      padding: 0;
      border: 1px solid #e4ded6;
      border-radius: 50%;
      background: #e4ded6;
      color: #1b1918;
      cursor: pointer;
    }
    .cli-search-form button svg {
      width: 17px;
      height: 17px;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .cli-status {
      display: flex;
      min-height: 34px;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 0 15px;
      border-top: 1px solid #393635;
      background: #1d1b1a;
      color: #746d69;
      font: 400 9px/1.4 var(--font-mono);
      letter-spacing: 0.08em;
    }
    .cli-status span:first-child { color: #71b58a; }
    @keyframes cli-caret { 50% { opacity: 0; } }
    @keyframes cli-spin { to { transform: rotate(360deg); } }
    @keyframes cli-options-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes cli-answer-in {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @media (min-width: 768px) {
      .hero {
        min-height: calc(100vh - 84px);
        min-height: calc(100svh - 84px);
        padding: 32px 40px;
      }
      .cli {
        min-height: calc(100vh - 148px);
        min-height: calc(100svh - 148px);
      }
    }
    @media (max-width: 767px) {
      .cli { border-radius: 5px; }
      .cli-bar {
        height: 34px;
        padding-inline: 10px;
      }
      .cli-dot {
        width: 7px;
        height: 7px;
      }
      .cli-bar b { font-size: 9px; }
      .cli-screen {
        min-height: 0;
        padding: 18px 12px 22px;
      }
      .cli-boot {
        margin-bottom: 0;
        font-size: 8px;
      }
      .cli-conversation {
        margin-top: 20px;
        padding-top: 0;
      }
      .cli-dialog {
        align-items: flex-start;
        gap: 8px;
      }
      .cli-ai-label {
        min-width: 29px;
        height: 22px;
        padding-inline: 5px;
        font-size: 9px;
      }
      .cli-question {
        font-size: clamp(17px, 5.2vw, 21px);
      }
      .cli-options {
        gap: 2px;
        margin-left: 0;
      }
      .cli-options button {
        grid-template-columns: 15px 23px minmax(0, 1fr);
        gap: 6px;
        min-height: 44px;
        padding: 7px 8px;
      }
      .cli-options strong { font-size: 12px; }
      .cli-output {
        margin: 16px 0 0;
        padding-top: 14px;
      }
      .cli-command { font-size: 11px; }
      .cli-answer {
        grid-template-columns: 29px minmax(0, 1fr);
        gap: 8px;
      }
      .cli-answer-content {
        grid-template-columns: 1fr;
        gap: 10px;
      }
      .cli-answer-media > img {
        max-height: 190px;
      }
      .cli-answer p {
        font-size: 11px;
        line-height: 1.75;
      }
      .cli-answer > a { font-size: 10.5px; }
      .cli-end { font-size: 10px; }
      .cli-search-results {
        padding-inline: 10px;
      }
      .cli-search-form {
        grid-template-columns: auto minmax(0, 1fr) auto;
        min-height: 48px;
        gap: 7px;
        padding-inline: 10px;
      }
      .cli-search-prompt { font-size: 8px; }
      .cli-search-form input { font-size: 11px; }
      .cli-search-form button {
        width: 32px;
        height: 32px;
        min-height: 32px;
      }
      .cli-status {
        min-height: 30px;
        padding-inline: 10px;
        font-size: 7.5px;
      }
    }
    @media (max-width: 767px) and (max-height: 520px) {
      .hero { padding-block: 8px; }
      .cli {
        min-height: calc(100vh - var(--bar) - 16px);
        min-height: calc(100svh - var(--bar) - 16px);
      }
      .cli-screen { padding-block: 10px; }
      .cli-conversation { margin-top: 12px; padding-top: 0; }
      .cli-search-form { min-height: 44px; }
      .cli-status { min-height: 28px; }
    }

    /* 區塊提問只用於頁尾 CTA。 */
    .q {
      color: var(--color-ink);
      font-family: var(--font-serif);
      font-weight: 600;
      letter-spacing: 0;
    }
    .q--sec {
      font-size: clamp(20px, 3vw, 28px);
      line-height: 1.15;
    }
    /* ---------- 按鈕 ---------- */
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 26px;
    }
    .hero-contact-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-top: 24px;
    }
    .hero-scroll-cue {
      display: flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 8px;
      color: var(--color-accent);
      font-size: 12.5px;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    .hero-scroll-cue span {
      font-family: var(--font-mono);
      text-decoration: none;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14.5px;
      font-weight: 500;
      text-decoration: none;
      padding: 12px 22px;
      border-radius: 3px;
      line-height: 1.4;
      /* 44px 觸控目標：12+12 內距 ＋ 14.5×1.4 行框 ≈ 44.3px */
      min-height: 44px;
      transition:
        background-color 0.18s var(--ease),
        border-color 0.18s var(--ease),
        color 0.18s var(--ease),
        transform 0.18s var(--ease);
    }
    .btn-line {
      background: #06c755;
      color: #fff;
      border: 1px solid #06c755;
    }
    .btn-contact {
      border: 1px solid var(--color-rule-3);
      background: rgb(255 255 255 / 34%);
      color: var(--color-ink-2);
    }
    .btn-contact > svg {
      width: 18px;
      height: 18px;
      flex: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    @media (max-width: 767px) {
      .hero-contact-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 5px;
        margin-top: 10px;
      }
      .hero-contact-actions .btn {
        justify-content: center;
        gap: 5px;
        min-width: 0;
        padding: 8px 5px;
        font-size: 11px;
      }
      .hero-contact-actions .line-ic,
      .hero-contact-actions .line-ic svg,
      .hero-contact-actions .btn-contact > svg {
        width: 16px;
        height: 16px;
      }
    }
    .line-ic,
    .line-ic svg {
      display: block;
      width: 20px;
      height: 20px;
    }
    .line-ic svg {
      fill: currentColor;
    }
    /* 按鈕文字必須是「一個」flex 子項。若讓文字節點直接當子項，
       包裹拉丁字段用的 .lat 會被 blockify 成 flex item，gap:8px 就會
       把「加 LINE 免費諮詢」拆成三塊。 */
    .btn-l {
      display: inline;
    }
    .btn .arw {
      font-family: var(--font-mono);
      font-size: 12.5px;
      opacity: 0.85;
      --ls: 0em;
    }

    /* ---------- 首屏下方的服務詳細介紹 ---------- */
    .service-details {
      padding-top: clamp(24px, 4vw, 48px);
    }
    #free-resources {
      scroll-margin-top: calc(var(--bar) + 16px);
    }
    .service-row {
      display: grid;
      gap: 30px;
      padding: clamp(48px, 7vw, 88px) 0;
      border-top: 1px solid var(--color-rule);
    }
    @media (max-width: 767px) {
      .service-row:first-child {
        padding-top: 36px;
      }
    }
    @media (min-width: 768px) {
      .service-row {
        grid-template-columns: minmax(0, 1fr) minmax(280px, 0.88fr);
        gap: clamp(48px, 7vw, 96px);
        align-items: center;
      }
      .service-row--reverse .service-copy {
        order: 2;
      }
      .service-row--reverse .service-media {
        order: 1;
      }
    }
    .service-copy {
      max-width: 58ch;
    }
    .service-kicker {
      margin-bottom: 12px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.1em;
      color: var(--color-accent);
    }
    .service-copy h2 {
      font-family: var(--font-serif);
      font-size: clamp(32px, 4vw, 52px);
      line-height: 1.1;
      font-weight: 600;
      color: var(--color-ink);
    }
    .service-copy > p:not(.service-kicker) {
      margin-top: 20px;
      font-size: 16px;
      line-height: 1.9;
      color: var(--color-ink-2);
    }
    .service-copy ul {
      display: grid;
      gap: 8px;
      margin-top: 20px;
      padding: 0;
      list-style: none;
      color: var(--color-ink-3);
      font-size: 14px;
      line-height: 1.65;
    }
    .service-copy li {
      position: relative;
      padding-left: 16px;
    }
    .service-copy li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--color-accent);
    }
    .service-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      margin-top: 24px;
      color: var(--color-accent);
      font-size: 14.5px;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 5px;
    }
    .service-media {
      margin: 0;
      overflow: hidden;
      border: 1px solid var(--color-rule-2);
      background: var(--color-surface);
      aspect-ratio: 4 / 3;
    }
    .service-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .service-media--portrait img {
      object-position: center 28%;
    }
    .case-mini-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .case-mini-grid li {
      display: grid;
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 11px;
      align-items: start;
      min-height: 126px;
      padding: 14px;
      border: 1px solid var(--color-rule-2);
      background: rgb(255 255 255 / 42%);
    }
    .case-mini-icon {
      width: 38px;
      height: 38px;
      object-fit: contain;
    }
    .case-mini-grid strong,
    .case-mini-grid span {
      display: block;
    }
    .case-mini-grid strong {
      font-size: 13px;
      line-height: 1.55;
      font-weight: 600;
      color: var(--color-ink);
    }
    .case-mini-grid span {
      margin-top: 7px;
      font-size: 11.5px;
      line-height: 1.5;
      color: var(--color-accent);
    }

    /* ---------- 關於講師：人物檔案式資訊層級 ---------- */
    .instructor-profile {
      display: grid;
      grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr) minmax(180px, 0.62fr);
      gap: clamp(28px, 4vw, 56px);
      align-items: start;
      padding: clamp(56px, 8vw, 96px) 0;
      border-top: 1px solid var(--color-rule);
    }
    .instructor-photo {
      margin: 0;
      overflow: hidden;
      border: 1px solid var(--color-rule-2);
      aspect-ratio: 4 / 5;
      background: var(--color-surface);
    }
    .instructor-photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 28%;
    }
    .instructor-main h2,
    .featured-head h2 {
      font-family: var(--font-serif);
      font-size: clamp(32px, 4vw, 52px);
      line-height: 1.1;
      font-weight: 600;
      color: var(--color-ink);
    }
    .instructor-name {
      margin-top: 18px;
      font-size: 14px;
      font-weight: 600;
      color: var(--color-accent);
    }
    .instructor-intro {
      max-width: 50ch;
      margin-top: 16px;
      font-size: 15px;
      line-height: 1.9;
      color: var(--color-ink-2);
    }
    .instructor-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px 22px;
      margin-top: 20px;
    }
    .instructor-actions .service-link {
      margin-top: 0;
    }
    .instructor-socials {
      display: flex;
      gap: 8px;
    }
    .instructor-socials a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      min-height: 44px;
      padding: 0;
      border: 1px solid var(--color-rule-3);
      border-radius: 999px;
      color: var(--color-ink-2);
      text-decoration: none;
      transition:
        color 0.18s var(--ease),
        border-color 0.18s var(--ease),
        background-color 0.18s var(--ease);
    }
    .instructor-socials svg {
      width: 17px;
      height: 17px;
    }
    .instructor-facts {
      margin: 0;
      border-top: 1px solid var(--color-rule-2);
    }
    .instructor-facts div {
      padding: 14px 0 16px;
      border-bottom: 1px solid var(--color-rule);
    }
    .instructor-facts dt {
      margin-bottom: 6px;
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--color-accent);
    }
    .instructor-facts dd {
      margin: 0;
      font-size: 12.5px;
      line-height: 1.65;
      color: var(--color-ink-2);
    }

    /* ---------- 關於講師下方：三篇精選文章 ---------- */
    .featured-posts {
      padding: clamp(56px, 8vw, 96px) 0 0;
      border-top: 1px solid var(--color-rule);
    }
    .featured-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 24px;
    }
    .featured-head > a {
      min-height: 44px;
      color: var(--color-accent);
      font-size: 13px;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 5px;
    }
    .featured-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(18px, 3vw, 34px);
      margin: 28px 0 0;
      padding: 0;
      list-style: none;
    }
    .featured-list li {
      min-width: 0;
      border-top: 1px solid var(--color-rule-2);
    }
    .featured-list a {
      display: flex;
      height: 100%;
      flex-direction: column;
      padding: 18px 0 0;
      color: inherit;
      text-decoration: none;
    }
    .featured-list img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1200 / 630;
      object-fit: cover;
      border: 1px solid var(--color-rule);
    }
    .featured-meta {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-top: 14px;
      font-family: var(--font-mono);
      font-size: 10px;
      line-height: 1.5;
      color: var(--color-ink-3);
    }
    .featured-meta span {
      color: var(--color-accent);
    }
    .featured-list h3 {
      margin-top: 8px;
      font-size: 15px;
      line-height: 1.65;
      font-weight: 600;
      color: var(--color-ink);
      transition: color 0.18s var(--ease);
    }
    .featured-go {
      margin-top: auto;
      padding-top: 14px;
      font-size: 12px;
      color: var(--color-accent);
    }
    @media (max-width: 767px) {
      .service-details {
        padding-top: 64px;
      }
      .service-row {
        padding: 48px 0;
      }
      /* 手機版把文案容器攤平成 service-row 的 grid 子項，才能在不複製圖片的
         前提下，讓媒體落在「介紹與重點」之後、「查看連結」之前。桌機仍保留
         service-copy／media 左右雙欄，不受這組順序影響。 */
      .service-row .service-copy {
        display: contents;
      }
      .service-row .service-kicker {
        order: 1;
        margin-bottom: -18px;
      }
      .service-row .service-copy h2 {
        order: 2;
      }
      .service-row .service-copy > p:not(.service-kicker) {
        order: 3;
        margin-top: -10px;
      }
      .service-row .service-copy ul {
        order: 4;
        margin-top: -10px;
      }
      .service-row .service-media {
        order: 5;
        aspect-ratio: 16 / 10;
      }
      .service-row .service-link {
        order: 6;
        margin-top: -10px;
      }
      .case-mini-grid {
        order: 5;
      }
      .case-mini-grid li {
        grid-template-columns: 32px minmax(0, 1fr);
        min-height: 112px;
        padding: 12px;
      }
      .case-mini-icon {
        width: 32px;
        height: 32px;
      }
      .case-mini-grid strong {
        font-size: 12px;
      }
      .instructor-profile {
        grid-template-columns: minmax(0, 1fr);
        gap: 24px;
        padding: 56px 0;
      }
      .instructor-photo {
        width: min(74vw, 280px);
        aspect-ratio: 4 / 5;
      }
      .instructor-intro {
        font-size: 14px;
      }
      .instructor-facts {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .instructor-facts div {
        padding: 12px 10px 14px 0;
      }
      .instructor-facts div + div {
        padding-left: 10px;
        border-left: 1px solid var(--color-rule);
      }
      .instructor-facts dd {
        font-size: 11px;
      }
      .featured-posts {
        padding-top: 56px;
      }
      .featured-head {
        align-items: end;
      }
      .featured-list {
        grid-template-columns: minmax(0, 1fr);
        gap: 30px;
        margin-top: 22px;
      }
    }

    /* ---------- 結尾 CTA ---------- */
    .closer {
      padding-top: 76px;
    }
    @media (min-width: 768px) {
      .closer {
        padding-top: 120px;
      }
    }
    .closer-p {
      margin-top: 18px;
      font-size: 15.5px;
      line-height: 1.95;
      color: var(--color-ink-2);
      max-width: 52ch;
    }

    /* ============================================================
       hover 一律加裝置條件：觸控裝置上 :hover 會「黏住」，
       點過的元件會停在 hover 狀態直到點別的地方。
       :focus-visible 另外寫一份、不設任何條件。
       ============================================================ */
    @media (hover: hover) and (pointer: fine) {
      .btn-line:hover {
        background: #05b34c;
        border-color: #05b34c;
        transform: translateY(-1px);
      }
      .btn-contact:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
        background: rgb(255 255 255 / 64%);
        transform: translateY(-1px);
      }
      .instructor-socials a:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
        background: rgb(255 255 255 / 60%);
      }
      .featured-list a:hover h3 {
        color: var(--color-accent);
      }
      .cli-options button:hover {
        border-color: #4a4540;
        background: #211f1c;
        color: #fffaf1;
      }
      .cli-answer a:hover { color: #ffc2cb; }
      .cli-end:hover { color: #f2ece5; }
      :global(.cli-search-result:hover) {
        border-color: #514a47;
        background: #272322;
      }
      .cli-search-form button:hover {
        border-color: #fffaf4;
        background: #fffaf4;
        color: #151414;
      }
    }

    /* 鍵盤焦點：不靠 hover 也要有等價的視覺回饋（不設裝置條件） */
    .instructor-socials a:focus-visible,
    .featured-list a:focus-visible,
    .cli-options button:focus-visible,
    .cli-answer a:focus-visible,
    .cli-end:focus-visible,
    :global(.cli-search-result:focus-visible),
    .cli-search-form button:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }
    .cli-search-form:focus-within {
      box-shadow: inset 3px 0 #e98a98;
    }
    .hero-contact-actions a:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }

    /* ============================================================
       逐段浮現：內容一律寫在 HTML 裡，只有「顯示與否」交給 CSS。
       沒有 JS 時 .js 不會加上，全部維持完整可見。
       IntersectionObserver 掛掉時另有 2 秒逾時強制顯示（見上方 script）。
       ============================================================ */
    .home.js .reveal {
      opacity: 0.3;
      transform: translateY(30px);
      transition:
        opacity 0.6s var(--ease) var(--d, 0ms),
        transform 0.6s var(--ease) var(--d, 0ms);
    }
    .home.js .reveal.is-in {
      opacity: 1;
      transform: translateY(0);
    }

    /* 首屏：0 + 70 + 140ms 延遲，各 200ms —— 總揭露 340ms */
    .home.js .hero-reveal {
      opacity: 0.3;
      transform: translateY(30px);
      transition:
        opacity 0.2s var(--ease) var(--d, 0ms),
        transform 0.2s var(--ease) var(--d, 0ms);
    }
    .home.js .hero-reveal.is-in {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .home.js .reveal,
      .home.js .hero-reveal,
      .home.js .reveal.is-in,
      .home.js .hero-reveal.is-in {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      /* 只關過渡，不寫任何 :hover 選擇器。
         「所有 hover 收在 @media (hover:hover) and (pointer:fine) 裡」是硬規則，
         在這裡補一條 .btn-line:hover{transform:none} 會是全站唯一一條沒有裝置
         條件的 hover 規則。而且它也沒有必要：那顆按鈕的 translateY(-1px) 本來就
         只在有滑鼠的裝置上生效，過渡一關就是瞬間位移，不構成前庭風險的動態。 */
      .btn,
      .cli-caret,
      .cli-command i,
      .cli-thinking span,
      .terminal-typed,
      .terminal-command > i,
      .terminal-thinking,
      .terminal-done,
      .terminal-thinking i {
        transition: none !important;
        animation: none !important;
      }
      .cli-caret { display: none; }
      .terminal-typed {
        max-width: 18em;
      }
      .terminal-command > i,
      .terminal-thinking {
        display: none;
      }
      .terminal-done {
        opacity: 1;
        transform: none;
      }
      .cli-caret,
      .cli-command i,
      .cli-thinking > span,
      .cli.is-ready .cli-options,
      .cli-answer {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>
</Base>
