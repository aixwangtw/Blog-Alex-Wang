      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
      margin: 26px 0 0;
      padding: 4px;
      border: 1px solid #403b38;
      border-radius: 9px;
      background: #171615;
    }
    .cli-tabs button {
      min-height: 42px;
      padding: 8px 10px;
      border: 0;
      border-radius: 6px;
      background: transparent;
      color: #aaa39d;
      font: 600 13px/1.3 var(--font-display);
      cursor: pointer;
    }
    .cli-tabs button[aria-selected='true'] {
      background: #a85b67;
      color: #fffaf4;
      box-shadow: 0 4px 14px rgb(0 0 0 / 22%);
    }
    .cli-tab-panel[hidden] {
      display: none;
    }
    .cli-options {
      display: grid;
      gap: 10px;
      max-width: 820px;
      margin: 10px 0 0;
    }
    .cli-options a {
      display: grid;
      width: 100%;
      min-height: 68px;
      grid-template-columns: 32px minmax(0, 1fr) auto;
      align-items: center;
      gap: 14px;
      padding: 13px 18px;
      border: 1px solid #403b38;
      border-radius: 8px;
      background: #211f1e;
      color: #f7f3ed;
      text-decoration: none;
      transition: border-color 0.16s ease, background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
    }
    .cli-option-index {
      flex: none;
      color: #f0a6b1;
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 700;
    }
    .cli-options a > span:nth-child(2) { min-width: 0; }
    .cli-options strong {
      display: block;
      color: #fffaf4;
      font-family: var(--font-display);
      font-size: clamp(14px, 1.6vw, 16px);
      font-weight: 600;
      line-height: 1.4;
    }
    .cli-options small {
      display: block;
      margin-top: 2px;
      color: #aaa39d;
      font: 400 12px/1.55 var(--font-display);
    }
    .cli-option-arrow {
      flex: none;
      color: #f0a6b1;
      font-size: 17px;
      transition: transform 0.16s ease;
    }
    .cli-search-area {
      flex: none;
      border-top: 1px solid #3f3a37;
      background: #11100f;
      border-radius: 0 0 13px 13px;
      font-family: var(--font-mono);
    }
    .cli-search-results {
      display: grid;
      gap: 3px;
      padding: 12px clamp(15px, 4vw, 46px) 8px;
      border-bottom: 1px solid #3f3a37;
    }
    .cli-search-results[hidden] { display: none; }
    :global(.cli-search-empty) {
      margin: 0;
      color: #aaa39d;
      font-size: 11px;
      line-height: 1.7;
    }
    :global(.cli-search-result) {
      display: grid;
      gap: 2px;
      padding: 8px 10px;
      border: 1px solid transparent;
      border-radius: 6px;
      color: #d9d3cc;
      text-decoration: none;
    }
    :global(.cli-search-result.is-active) {
      border-color: #8f4652;
      background: #2a2323;
    }
    :global(.cli-search-title) {
      color: #fffaf4;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 500;
      line-height: 1.5;
    }
    :global(.cli-search-description) {
      overflow: hidden;
      color: #aaa39d;
      font-family: var(--font-display);
      font-size: 10px;
      line-height: 1.5;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .cli-search-form {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      min-height: 56px;
      align-items: center;
      gap: 10px;
      padding: 0 clamp(15px, 4vw, 46px);
    }
    .cli-search-form input {
      min-width: 0;
      padding: 10px 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: #fffaf4;
      font: 400 13px/1.5 var(--font-mono);
    }
    .cli-search-form input::placeholder { color: #817a75; }
    .cli-search-form button {
      display: grid;
      width: 36px;
      height: 36px;
      min-height: 36px;
      place-items: center;
      padding: 0;
      border: 1px solid #9d4c5a;
      border-radius: 50%;
      background: #7a2e3b;
      color: #fffaf4;
      cursor: pointer;
    }
    .cli-search-form button svg {
      width: 17px;
      height: 17px;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    @media (min-width: 768px) {
      .hero { padding-inline: 40px; }
    }
    @media (max-width: 1080px) {
      .hero {
        grid-template-columns: minmax(0, 0.72fr) minmax(520px, 1.28fr);
        gap: 32px;
      }
      .hero-copy h1 { font-size: clamp(36px, 5vw, 52px); }
    }
    @media (max-width: 960px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 36px;
      }
      .hero-copy { max-width: 680px; }
    }
    @media (max-width: 767px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 14px;
        padding: 20px 20px 30px;
      }
      .hero-copy { max-width: none; }
      .hero-kicker { margin-bottom: 10px; font-size: 10px; }
      .hero-copy h1 { font-size: clamp(34px, 10vw, 46px); line-height: 1.18; }
      .hero-summary { margin-top: 12px; font-size: 15px; line-height: 1.7; }
      .hero-actions { display: none; }
      .hero-primary { width: 100%; }
      .hero-secondary { justify-content: center; }
      .cli { border-radius: 10px; }
      .cli-brand {
        height: 32px;
        padding-inline: 12px;
        border-radius: 9px 9px 0 0;
      }
      .cli-window-title { overflow: hidden; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
      .cli-screen {
        min-height: 0;
        padding: 10px 12px 12px;
      }
      .cli-question {
        font-size: clamp(22px, 7vw, 28px);
      }
      .cli-tabs {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-top: 12px;
      }
      .cli-tabs button { min-height: 34px; font-size: 12px; }
      .cli-options {
        gap: 8px;
        margin: 8px 0 0;
      }
      .cli-options a {
        min-height: 54px;
        grid-template-columns: 26px minmax(0, 1fr) auto;
        padding: 8px 12px;
        gap: 10px;
      }
      .cli-options strong { font-size: 13px; }
      .cli-options small { font-size: 11px; }
      .cli-option-index { font-size: 11px; }
      .cli-option-arrow { font-size: 13px; }
      .cli-search-results {
        padding-inline: 10px;
      }
      .cli-search-form {
        min-height: 44px;
        gap: 7px;
        padding-inline: 10px;
      }
      .cli-search-form input { font-size: 11px; }
      .cli-search-form button {
        width: 32px;
        height: 32px;
        min-height: 32px;
      }
    }
    @media (max-width: 767px) and (max-height: 520px) {
      .hero { padding-block: 24px; }
      .cli-screen { padding-block: 10px; }
      .cli-conversation { margin-top: 0; }
      .cli-search-form { min-height: 44px; }
    }

    /* 區塊提問只用於頁尾 CTA。 */
    .q {
      color: var(--color-ink);
      font-family: var(--font-serif);
      font-weight: 600;
      letter-spacing: 0;
    }
    .q--sec {
      font-size: clamp(20px, 3vw, 28px);
      line-height: 1.15;
    }
    /* ---------- 按鈕 ---------- */
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 26px;
    }
    .hero-contact-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-top: 24px;
    }
    .hero-scroll-cue {
      display: flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 8px;
      color: var(--color-accent);
      font-size: 12.5px;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    .hero-scroll-cue span {
      font-family: var(--font-mono);
      text-decoration: none;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14.5px;
      font-weight: 500;
      text-decoration: none;
      padding: 12px 22px;
      border-radius: 3px;
      line-height: 1.4;
      /* 44px 觸控目標：12+12 內距 ＋ 14.5×1.4 行框 ≈ 44.3px */
      min-height: 44px;
      transition:
        background-color 0.18s var(--ease),
        border-color 0.18s var(--ease),
        color 0.18s var(--ease),
        transform 0.18s var(--ease);
    }
    .btn-line {
      background: #06c755;
      color: #fff;
      border: 1px solid #06c755;
    }
    .btn-contact {
      border: 1px solid var(--color-rule-3);
      background: rgb(255 255 255 / 34%);
      color: var(--color-ink-2);
    }
    .btn-contact > svg {
      width: 18px;
      height: 18px;
      flex: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    @media (max-width: 767px) {
      .hero-contact-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 5px;
        margin-top: 10px;
      }
      .hero-contact-actions .btn {
        justify-content: center;
        gap: 5px;
        min-width: 0;
        padding: 8px 5px;
        font-size: 11px;
      }
      .hero-contact-actions .line-ic,
      .hero-contact-actions .line-ic svg,
      .hero-contact-actions .btn-contact > svg {
        width: 16px;
        height: 16px;
      }
    }
    .line-ic,
    .line-ic svg {
      display: block;
      width: 20px;
      height: 20px;
    }
    .line-ic svg {
      fill: currentColor;
    }
    /* 按鈕文字必須是「一個」flex 子項。若讓文字節點直接當子項，
       包裹拉丁字段用的 .lat 會被 blockify 成 flex item，gap:8px 就會
       把「加 LINE 免費諮詢」拆成三塊。 */
    .btn-l {
      display: inline;
    }
    .btn .arw {
      font-family: var(--font-mono);
      font-size: 12.5px;
      opacity: 0.85;
      --ls: 0em;
    }

    /* ---------- 首屏下方的服務詳細介紹 ---------- */
    .service-details {
      padding-top: clamp(24px, 4vw, 48px);
    }
    #free-resources {
      scroll-margin-top: calc(var(--bar) + 16px);
    }
    .service-row {
      display: grid;
      gap: 30px;
      padding: clamp(48px, 7vw, 88px) 0;
      border-top: 1px solid var(--color-rule);
    }
    @media (max-width: 767px) {
      .service-row:first-child {
        padding-top: 36px;
      }
    }
    @media (min-width: 768px) {
      .service-row {
        grid-template-columns: minmax(0, 1fr) minmax(280px, 0.88fr);
        gap: clamp(48px, 7vw, 96px);
        align-items: center;
      }
      .service-row--reverse .service-copy {
        order: 2;
      }
      .service-row--reverse .service-media {
        order: 1;
      }
    }
    .service-copy {
      max-width: 58ch;
    }
    .service-kicker {
      margin-bottom: 12px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.1em;
      color: var(--color-accent);
    }
    .service-copy h2 {
      font-family: var(--font-serif);
      font-size: clamp(32px, 4vw, 52px);
      line-height: 1.1;
      font-weight: 600;
      color: var(--color-ink);
    }
    .service-copy > p:not(.service-kicker) {
      margin-top: 20px;
      font-size: 16px;
      line-height: 1.9;
      color: var(--color-ink-2);
    }
    .service-copy ul {
      display: grid;
      gap: 8px;
      margin-top: 20px;
      padding: 0;
      list-style: none;
      color: var(--color-ink-3);
      font-size: 14px;
      line-height: 1.65;
    }
    .service-copy li {
      position: relative;
      padding-left: 16px;
    }
    .service-copy li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--color-accent);
    }
    .service-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      margin-top: 24px;
      color: var(--color-accent);
      font-size: 14.5px;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 5px;
    }
    .service-media {
      margin: 0;
      overflow: hidden;
      border: 1px solid var(--color-rule-2);
      background: var(--color-surface);
      aspect-ratio: 4 / 3;
    }
    .service-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .service-media--portrait img {
      object-position: center 28%;
    }
    .case-mini-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .case-mini-grid li {
      display: grid;
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 11px;
      align-items: start;
      min-height: 126px;
      padding: 14px;
      border: 1px solid var(--color-rule-2);
      background: rgb(255 255 255 / 42%);
    }
    .case-mini-icon {
      width: 38px;
      height: 38px;
      object-fit: contain;
    }
    .case-mini-grid strong,
    .case-mini-grid span {
      display: block;
    }
    .case-mini-grid strong {
      font-size: 13px;
      line-height: 1.55;
      font-weight: 600;
      color: var(--color-ink);
    }
    .case-mini-grid span {
      margin-top: 7px;
      font-size: 11.5px;
      line-height: 1.5;
      color: var(--color-accent);
    }

    /* ---------- 關於講師：人物檔案式資訊層級 ---------- */
    .instructor-profile {
      display: grid;
      grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr) minmax(180px, 0.62fr);
      gap: clamp(28px, 4vw, 56px);
      align-items: start;
      padding: clamp(56px, 8vw, 96px) 0;
      border-top: 1px solid var(--color-rule);
    }
    .instructor-photo {
      margin: 0;
      overflow: hidden;
      border: 1px solid var(--color-rule-2);
      aspect-ratio: 4 / 5;
      background: var(--color-surface);
    }
    .instructor-photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 28%;
    }
    .instructor-main h2,
    .featured-head h2 {
      font-family: var(--font-serif);
      font-size: clamp(32px, 4vw, 52px);
      line-height: 1.1;
      font-weight: 600;
      color: var(--color-ink);
    }
    .instructor-name {
      margin-top: 18px;
      font-size: 14px;
      font-weight: 600;
      color: var(--color-accent);
    }
    .instructor-intro {
      max-width: 50ch;
      margin-top: 16px;
      font-size: 15px;
      line-height: 1.9;
      color: var(--color-ink-2);
    }
    .instructor-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px 22px;
      margin-top: 20px;
    }
    .instructor-actions .service-link {
      margin-top: 0;
    }
    .instructor-socials {
      display: flex;
      gap: 8px;
    }
    .instructor-socials a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      min-height: 44px;
      padding: 0;
      border: 1px solid var(--color-rule-3);
      border-radius: 999px;
      color: var(--color-ink-2);
      text-decoration: none;
      transition:
        color 0.18s var(--ease),
        border-color 0.18s var(--ease),
        background-color 0.18s var(--ease);
    }
    .instructor-socials svg {
      width: 17px;
      height: 17px;
    }
    .instructor-facts {
      margin: 0;
      border-top: 1px solid var(--color-rule-2);
    }
    .instructor-facts div {
      padding: 14px 0 16px;
      border-bottom: 1px solid var(--color-rule);
    }
    .instructor-facts dt {
      margin-bottom: 6px;
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--color-accent);
    }
    .instructor-facts dd {
      margin: 0;
      font-size: 12.5px;
      line-height: 1.65;
      color: var(--color-ink-2);
    }

    /* ---------- 關於講師下方：三篇精選文章 ---------- */
    .featured-posts {
      padding: clamp(56px, 8vw, 96px) 0 0;
      border-top: 1px solid var(--color-rule);
    }
    .featured-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 24px;
    }
    .featured-head > a {
      min-height: 44px;
      color: var(--color-accent);
      font-size: 13px;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 5px;
    }
    .featured-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(18px, 3vw, 34px);
      margin: 28px 0 0;
      padding: 0;
      list-style: none;
    }
    .featured-list li {
      min-width: 0;
      border-top: 1px solid var(--color-rule-2);
    }
    .featured-list a {
      display: flex;
      height: 100%;
      flex-direction: column;
      padding: 18px 0 0;
      color: inherit;
      text-decoration: none;
    }
    .featured-list img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1200 / 630;
      object-fit: cover;
      border: 1px solid var(--color-rule);
    }
    .featured-meta {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-top: 14px;
      font-family: var(--font-mono);
      font-size: 10px;
      line-height: 1.5;
      color: var(--color-ink-3);
    }
    .featured-meta span {
      color: var(--color-accent);
    }
    .featured-list h3 {
      margin-top: 8px;
      font-size: 15px;
      line-height: 1.65;
      font-weight: 600;
      color: var(--color-ink);
      transition: color 0.18s var(--ease);
    }
    .featured-go {
      margin-top: auto;
      padding-top: 14px;
      font-size: 12px;
      color: var(--color-accent);
    }
    @media (max-width: 767px) {
      .service-details {
        padding-top: 64px;
      }
      .service-row {
        padding: 48px 0;
      }
      /* 手機版把文案容器攤平成 service-row 的 grid 子項，才能在不複製圖片的
         前提下，讓媒體落在「介紹與重點」之後、「查看連結」之前。桌機仍保留
         service-copy／media 左右雙欄，不受這組順序影響。 */
      .service-row .service-copy {
        display: contents;
      }
      .service-row .service-kicker {
        order: 1;
        margin-bottom: -18px;
      }
      .service-row .service-copy h2 {
        order: 2;
      }
      .service-row .service-copy > p:not(.service-kicker) {
        order: 3;
        margin-top: -10px;
      }
      .service-row .service-copy ul {
        order: 4;
        margin-top: -10px;
      }
      .service-row .service-media {
        order: 5;
        aspect-ratio: 16 / 10;
      }
      .service-row .service-link {
        order: 6;
        margin-top: -10px;
      }
      .case-mini-grid {
        order: 5;
      }
      .case-mini-grid li {
        grid-template-columns: 32px minmax(0, 1fr);
        min-height: 112px;
        padding: 12px;
      }
      .case-mini-icon {
        width: 32px;
        height: 32px;
      }
      .case-mini-grid strong {
        font-size: 12px;
      }
      .instructor-profile {
        grid-template-columns: minmax(0, 1fr);
        gap: 24px;
        padding: 56px 0;
      }
      .instructor-photo {
        width: min(74vw, 280px);
        aspect-ratio: 4 / 5;
      }
      .instructor-intro {
        font-size: 14px;
      }
      .instructor-facts {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .instructor-facts div {
        padding: 12px 10px 14px 0;
      }
      .instructor-facts div + div {
        padding-left: 10px;
        border-left: 1px solid var(--color-rule);
      }
      .instructor-facts dd {
        font-size: 11px;
      }
      .featured-posts {
        padding-top: 56px;
      }
      .featured-head {
        align-items: end;
      }
      .featured-list {
        grid-template-columns: minmax(0, 1fr);
        gap: 30px;
        margin-top: 22px;
      }
    }

    /* ---------- 結尾 CTA ---------- */
    .closer {
      padding-top: 76px;
    }
    @media (min-width: 768px) {
      .closer {
        padding-top: 120px;
      }
    }
    .closer-p {
      margin-top: 18px;
      font-size: 15.5px;
      line-height: 1.95;
      color: var(--color-ink-2);
      max-width: 52ch;
    }

    /* ============================================================
       hover 一律加裝置條件：觸控裝置上 :hover 會「黏住」，
       點過的元件會停在 hover 狀態直到點別的地方。
       :focus-visible 另外寫一份、不設任何條件。
       ============================================================ */
    @media (hover: hover) and (pointer: fine) {
      .btn-line:hover {
        background: #05b34c;
        border-color: #05b34c;
        transform: translateY(-1px);
      }
      .btn-contact:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
        background: rgb(255 255 255 / 64%);
        transform: translateY(-1px);
      }
      .instructor-socials a:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
        background: rgb(255 255 255 / 60%);
      }
      .featured-list a:hover h3 {
        color: var(--color-accent);
      }
      .cli-options a:hover {
        border-color: #a85b67;
        background: #2a2323;
        color: #fffaf4;
        box-shadow: 0 8px 24px rgb(0 0 0 / 20%);
        transform: translateY(-1px);
      }
      .cli-options a:hover .cli-option-arrow { transform: translate(2px, -2px); }
      .cli-tabs button:hover { color: #fffaf4; }
      :global(.cli-search-result:hover) {
        border-color: var(--color-accent-line-2);
        background: var(--color-accent-tint);
      }
      .cli-search-form button:hover {
        border-color: #bc6472;
        background: #944252;
        color: #fffaf4;
      }
    }

    /* 鍵盤焦點：不靠 hover 也要有等價的視覺回饋（不設裝置條件） */
    .instructor-socials a:focus-visible,
    .featured-list a:focus-visible,
    .cli-options a:focus-visible,
    .cli-tabs button:focus-visible,
    :global(.cli-search-result:focus-visible),
    .cli-search-form button:focus-visible {
      outline: 2px solid #f0a6b1;
      outline-offset: 3px;
    }
    .cli-search-form:focus-within {
      box-shadow: inset 3px 0 #a85b67;
    }
    .hero-contact-actions a:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }

    /* ============================================================
       逐段浮現：內容一律寫在 HTML 裡，只有「顯示與否」交給 CSS。
       沒有 JS 時 .js 不會加上，全部維持完整可見。
       IntersectionObserver 掛掉時另有 2 秒逾時強制顯示（見上方 script）。
       ============================================================ */
    .home.js .reveal {
      opacity: 0.3;
      transform: translateY(30px);
      transition:
        opacity 0.6s var(--ease) var(--d, 0ms),
        transform 0.6s var(--ease) var(--d, 0ms);
    }
    .home.js .reveal.is-in {
      opacity: 1;
      transform: translateY(0);
    }

    /* 首屏：0 + 70 + 140ms 延遲，各 200ms —— 總揭露 340ms */
    .home.js .hero-reveal {
      opacity: 0.3;
      transform: translateY(30px);
      transition:
        opacity 0.2s var(--ease) var(--d, 0ms),
        transform 0.2s var(--ease) var(--d, 0ms);
    }
    .home.js .hero-reveal.is-in {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .home.js .reveal,
      .home.js .hero-reveal,
      .home.js .reveal.is-in,
      .home.js .hero-reveal.is-in {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      /* 只關過渡，不寫任何 :hover 選擇器。
         「所有 hover 收在 @media (hover:hover) and (pointer:fine) 裡」是硬規則，
         在這裡補一條 .btn-line:hover{transform:none} 會是全站唯一一條沒有裝置
         條件的 hover 規則。而且它也沒有必要：那顆按鈕的 translateY(-1px) 本來就
         只在有滑鼠的裝置上生效，過渡一關就是瞬間位移，不構成前庭風險的動態。 */
      .btn,
      .terminal-typed,
      .terminal-command > i,
      .terminal-thinking,
      .terminal-done,
      .terminal-thinking i {
        transition: none !important;
        animation: none !important;
      }
      .terminal-typed {
        max-width: 18em;
      }
      .terminal-command > i,
      .terminal-thinking {
        display: none;
      }
      .terminal-done {
        opacity: 1;
        transform: none;
      }
    }
  </style>
</Base>
