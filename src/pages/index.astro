  <script is:inline>
    /* 首屏終端機與右下角入口是同一個功能：終端機還在畫面時收起 chatbot，
       離開終端機後再顯示縮合入口，避免同一用途在首屏重複出現。 */
    (function () {
      var cli = document.getElementById('hero-cli');
      if (!cli) return;

      var wasVisible = true;
      var tabs = Array.from(cli.querySelectorAll('[data-radar-tab]'));
      var panels = Array.from(cli.querySelectorAll('[data-radar-panel]'));

      function activateTab(key, moveFocus) {
        tabs.forEach(function (tab) {
          var selected = tab.getAttribute('data-radar-tab') === key;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          if (selected && moveFocus) tab.focus();
        });
        panels.forEach(function (panel) {
          panel.hidden = panel.getAttribute('data-radar-panel') !== key;
        });
      }

      tabs.forEach(function (tab, index) {
        tab.addEventListener('click', function () {
          activateTab(tab.getAttribute('data-radar-tab'), false);
        });
        tab.addEventListener('keydown', function (event) {
          var nextIndex = index;
          if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') nextIndex = 0;
          else if (event.key === 'End') nextIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          activateTab(tabs[nextIndex].getAttribute('data-radar-tab'), true);
        });
      });

      function setCliVisible(visible) {
        document.body.classList.toggle('home-cli-visible', visible);
        var chatbot = document.getElementById('search-chatbot');
        if (wasVisible && !visible && chatbot && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          chatbot.classList.remove('is-terminal-collapse');
          void chatbot.offsetWidth;
          chatbot.classList.add('is-terminal-collapse');
          window.setTimeout(function () { chatbot.classList.remove('is-terminal-collapse'); }, 650);
        }
        wasVisible = visible;
      }

      setCliVisible(true);

      if ('IntersectionObserver' in window) {
        var cliObserver = new IntersectionObserver(function (entries) {
          setCliVisible(entries[0].isIntersecting);
        });
        cliObserver.observe(cli);
        return;
      }

      function updateCliVisibility() {
        var rect = cli.getBoundingClientRect();
        setCliVisible(rect.bottom > 0 && rect.top < window.innerHeight);
      }
      window.addEventListener('scroll', updateCliVisibility, { passive: true });
      window.addEventListener('resize', updateCliVisibility);
      updateCliVisibility();
    })();
  </script>

  <script is:inline>
    /* 逐段浮現：內容 100% 寫在初始 HTML 裡，只有「顯示與否」交給 CSS。
       `js` 這個 class 加在 #home-root（不是 <html>）上，因為這一頁的樣式是
       Astro 的元件範圍樣式——選擇器會被加上 data-astro-cid-*，
       掛在 <html> 上的 class 選不到。
       三層保險，任何一層失效內容都仍然完整可見：
         1. 沒有 JS（或這段拋例外）→ `js` 不會加上 → 所有 .reveal 維持原樣可見
         2. IntersectionObserver 不存在／被停用／行為異常 → 2 秒逾時強制顯示
         3. prefers-reduced-motion → 直接全部顯示，且 CSS 也把過渡關掉 */
    (function () {
      var root = document.getElementById('home-root');
      if (!root) return;
      var reveals = root.querySelectorAll('.reveal, .hero-reveal');

      function revealAll() {
        for (var i = 0; i < reveals.length; i++) reveals[i].classList.add('is-in');
      }

      try {
        root.classList.add('js');

        // 保險 1：先掛逾時，再做任何可能爆炸的事
        var ioAlive = false;
        setTimeout(function () {
          if (!ioAlive) revealAll();
        }, 2000);

        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 首屏：立刻揭露（0 / 70 / 140ms 延遲，各 200ms → 總揭露 340ms）
        var hero = root.querySelectorAll('.hero-reveal');
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            for (var i = 0; i < hero.length; i++) hero[i].classList.add('is-in');
          });
        });

        if (reduce || !('IntersectionObserver' in window)) {
          revealAll();
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            ioAlive = true; // 觀察器確實會回呼 → 逾時保險不必動作
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );

        var scrollReveals = root.querySelectorAll('.reveal');
        for (var k = 0; k < scrollReveals.length; k++) io.observe(scrollReveals[k]);
      } catch (err) {
        revealAll(); // 保險 2
      }
    })();
  </script>

  <script is:inline>
    (function () {
      var cli = document.getElementById('hero-cli');
      if (!cli) return;
      var searchForm = document.getElementById('cli-search-form');
      var searchInput = document.getElementById('cli-search-input');
      var searchResults = document.getElementById('cli-search-results');
      if (!searchForm || !searchInput || !searchResults) return;

      var searchIndexPromise;
      var searchActive = -1;

      function loadSearchIndex() {
        if (!searchIndexPromise) {
          searchIndexPromise = fetch('/search-index.json')
            .then(function (response) { return response.json(); })
            .catch(function () { return []; });
        }
        return searchIndexPromise;
      }

      function setSearchActive(index) {
        var links = searchResults.querySelectorAll('a');
        if (!links.length) return;
        searchActive = Math.max(0, Math.min(index, links.length - 1));
        links.forEach(function (link, linkIndex) {
          link.classList.toggle('is-active', linkIndex === searchActive);
        });
        links[searchActive].scrollIntoView({ block: 'nearest' });
      }

      function renderSearchResults(items) {
        searchResults.replaceChildren();
        if (!items.length) {
          var empty = document.createElement('p');
          empty.className = 'cli-search-empty';
          empty.textContent = '找不到符合的文章，請嘗試其他關鍵字。';
          searchResults.appendChild(empty);
          searchActive = -1;
        } else {
          items.slice(0, 5).forEach(function (item) {
            var link = document.createElement('a');
            var title = document.createElement('strong');
            var description = document.createElement('span');
            link.className = 'cli-search-result';
            title.className = 'cli-search-title';
            description.className = 'cli-search-description';
            link.href = item.u;
            link.dataset.gaButton = 'hero_search_result';
            link.dataset.gaLabel = item.t;
            link.dataset.gaLocation = 'hero_cli';
            link.dataset.gaAction = 'open_result';
            title.textContent = item.t;
            description.textContent = item.d || '';
            link.append(title, description);
            searchResults.appendChild(link);
          });
          setSearchActive(0);
        }
        searchResults.hidden = false;
      }

      function searchSite(rawQuery) {
        var query = rawQuery.trim().toLowerCase();
        if (!query) {
          searchResults.hidden = true;
          searchResults.replaceChildren();
          searchActive = -1;
          return;
        }
        searchResults.hidden = false;
        searchResults.replaceChildren();
        loadSearchIndex().then(function (items) {
          renderSearchResults(items.filter(function (item) {
            return ((item.t || '') + ' ' + (item.d || '') + ' ' + (item.g || ''))
              .toLowerCase()
              .indexOf(query) !== -1;
          }));
        });
      }

      searchInput.addEventListener('focus', loadSearchIndex);
      searchInput.addEventListener('input', function () {
        searchSite(searchInput.value);
      });
      searchInput.addEventListener('keydown', function (event) {
        var links = searchResults.querySelectorAll('a');
        if (event.key === 'ArrowDown' && links.length) {
          event.preventDefault();
          setSearchActive(searchActive + 1);
        } else if (event.key === 'ArrowUp' && links.length) {
          event.preventDefault();
          setSearchActive(searchActive - 1);
        } else if (event.key === 'Enter') {
          event.preventDefault();
          if (links.length && searchActive >= 0) {
            links[searchActive].click();
          } else {
            searchSite(searchInput.value);
          }
        } else if (event.key === 'Escape') {
          searchInput.value = '';
          searchSite('');
        }
      });
      searchForm.addEventListener('submit', function (event) {
        event.preventDefault();
        searchSite(searchInput.value);
      });
    })();
  </script>

  <style>
    /* ============================================================
       首頁專屬排版。這裡的每一條都只作用在首頁，不外洩到內頁：
       - 展示級 H1（96px）與襯線體是首頁專用（設計語言定案 #1）
       - 字距分級只套在拉丁字段（.lat）上，中文一律 0
       - 顏色一律用 global.css @theme 的 --color-*，這裡不重新定義任何顏色
       - 內頁字級 .t-h1／.t-h2／.t-h3 這裡完全不碰
       ============================================================ */
    .home {
      /* ---- 字距分級（依光學尺寸，不是一個值套到底）----
         只套在拉丁字段（.lat）上；中文一律 0。
         --ls-display 供 ≥72px 的字段使用。H1 是 clamp(56,8vw,96)，
         8vw 在 viewport 900px 時剛好等於 72px，因此 display 級只在
         min-width:900px 之後才接上；900px 以下 H1 是 56–71.9px，留在 title 級。 */
      --ls-display: -0.06em;
      --ls-title: -0.028em;
      --ls-body: -0.011em;
      --ls-micro: 0.12em;
      --ls: var(--ls-body); /* 拉丁字段預設用內文級 */

      color: var(--color-ink-2);
      font-size: 16px;
      line-height: 1.9;
      letter-spacing: 0; /* 中文：0，不商量 */
    }

    /* 版心對齊 Base 的頁首頁尾（.hd-cap／.ft-wrap 都是 max-width:72rem、
       padding 20/40px）。原型的 .shell 是 1120px，這裡改用 72rem＝1152px，
       為的是 H1 的左緣跟頁首字標、頁尾品牌塊落在同一條垂直線上——
       兩者差 32px 時，捲動經過頁首那條線會看得出來。 */
    .home-shell {
      width: 100%;
      max-width: 72rem;
      margin: 0 auto;
      padding: 0 20px;
    }
    @media (min-width: 768px) {
      .home-shell {
        padding: 0 40px;
      }
    }

    /* ---- 拉丁字段：字距只加在這裡，並補回「尾字距」----
       CSS 的 letter-spacing 會在字段最後一個字元「後面」也加一份間距，
       負值會把後面的中文吸過來、正值會推開。用等量反向的 margin 補回。
       原型是用 .lat 包裹、由 Python 腳本在建置期產生；Astro 沒有那一步，
       首頁內容已砍到 470 字上下，.lat 的位置不多，直接手寫在模板裡。 */
    .lat {
      font-style: normal;
      letter-spacing: var(--ls, 0em);
      margin-inline-end: calc(-1 * var(--ls, 0em));
    }

    /* 12–13px 小標籤：唯一反向加字距的地方（正值，中文也適用），
       同樣要補回尾字距，否則標籤右側會多出一份空白。 */
    .micro {
      letter-spacing: var(--ls-micro);
      margin-inline-end: calc(-1 * var(--ls-micro));
      --ls: 0em; /* 內層 .lat 不再疊加 */
    }

    /* ============================================================
       全形問號的左空白修剪
       ------------------------------------------------------------
       問題：96px 下句末的全形「？」左邊留一個 27px 的空洞。
       實測（Noto Serif TC，upm 1000）：
         U+FF1F  advance 1.000em，墨跡 0.254em → 0.730em
                 左空白 0.254em、右空白 0.270em
         相鄰漢字 始 rsb 0.043em／大 rsb 0.049em／哪 lsb 0.068em
       → 漢字對漢字的墨跡間距約 0.068em，漢字對「？」是 0.297em，差 3.7 倍。
         Chrome 147／96px 實際渲染量測：始？＝28px，始始＝7px。

       ---- 三條「正規解法」全部驗證過，全部不能用 ----
       1. font-feature-settings:"palt" 1
          ／font-variant-east-asian:proportional-width
          Noto Serif TC 的 GPOS 裡「沒有 palt」。108 個子集抽驗 3 個
          （含實際含 U+FF1F 的那個），GPOS 只有 chws/halt/kern/vchw/vhal/vpal。
          halt 的涵蓋範圍只有「」（）！ 等六個字符，chws 只處理成對括號，
          兩者都不含 U+FF1F。實測結果：間距 26px 完全不動。
          同一段 CSS 換成 Noto Sans TC 就有效（27px → 12px）——Sans 有 palt
          且涵蓋 U+FF1F（XPlacement −134／XAdvance −283）。
          也就是說語法沒錯，是這支襯線字型沒有這個功能。
          另外 font-variant-east-asian:proportional-width 對應的是 pwid 而非
          palt，連 Noto Sans TC 都沒有效果（實測 27px 不動）。
       2. text-spacing-trim（CSS Text Level 4）
          Chrome 147 只接受 normal / trim-start / space-all；
          trim-both、trim-all、auto 全部 invalid（CSS.supports 回 false）。
          功能本身確實有在運作：trim-start 會把行首的「切掉左半格
          （墨跡左緣 163px → 115px，正好 0.5em）。
          但三個合法值對「？」的渲染結果一模一樣（26px 不動）——
          規格只裁全形的「開頭／結尾標點」，全形問號、驚嘆號不在裡面。
       3. GSUB 的 hwid／pwid 寬度替代字符
          Noto Serif TC 的 GSUB 只有 ccmp/liga/locl/vert/vrt2，沒有寬度替代。

       ---- 結論與作法 ----
       這支字型沒有任何 OpenType 或 CSS 標準機制可用，只剩光學修剪一條路。
       修剪量不是喬出來的：0.254em（？的左空白）− 0.05em（保留的殘餘空白）
       = 0.204em。留下的 0.05em 讓「？」的墨跡間距落回漢字的節奏上。
       實測驗收（Chrome 147／96px）：始？ 28px → 9px（對照 始始 ＝ 7px）、
                                     大？ 26px → 7px（對照 大大 ＝ 5px）。
       比漢字節奏鬆 2px，這是對的——問號本來就該比字距多留一點點氣。

       副作用與圍堵：
       - 只作用在被 .qt 包起來的那一個字元。頁面其他地方的「，」「。」
         完全不受影響（實測 大，大 加不加 .qt 都是 41/43px）。
       - 修剪量是 em，隨字級等比縮放，所有斷點的光學結果一致，
         不需要為不同字級各補一次。
       - 換行風險：用 .nb（white-space:nowrap）把「開始？」綁成一個
         不可斷的單位，「？」永遠不可能落到行首，也就不會把負 margin
         拉到容器左緣外面。
       - 字型 fallback 風險：若 Noto Serif TC 沒載入，改用 Songti TC 等
         備援字型時修剪量可能不完全匹配。只有在備援字型的「？」左空白
         小於 0.204em 時才會過修——絕大多數中文字型都是 0.24–0.28em，
         風險低，但這條無法在本機驗證，仍屬已知風險。
       ============================================================ */
    .qt {
      margin-inline-start: -0.204em;
    }
    .nb {
      white-space: nowrap;
    }

    /* ---------- Hero：保留終端機語彙，但不模擬 AI 思考或等待 ----------
       60／30／10 配色以全頁計算：中性紙色是主要底色、深色終端機是次要區塊，
       酒紅只用於狀態與互動提示。每個選項都是原生連結，點擊後直接導頁。 */
