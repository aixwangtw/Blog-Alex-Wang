---
import { Image } from 'astro:assets';
import Card from '../../components/Card.astro';
import CheckItem from '../../components/CheckItem.astro';
import Cta from '../../components/Cta.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { AUTHOR, SERVICE_SITE, SITE, breadcrumbSchema, speakingBannerUrl } from '../../consts';
import { SPEAKING_ENGAGEMENTS, SPEAKING_FORMATS, SPEAKING_TOPICS } from '../../data/services';
import ServiceBase from '../../layouts/ServiceBase.astro';

const schema = [
  breadcrumbSchema([
    { name: '服務首頁', item: `${SERVICE_SITE.url}/` },
    { name: 'AI 演講與企業內訓' },
  ]),
  {
    '@type': 'Service',
    '@id': `${SERVICE_SITE.url}/services/speaking/#service`,
    name: 'AI 主題演講與企業內訓',
    serviceType: '公開演講 / 企業內訓 / 工作坊',
    description:
      'Alex 提供 AI 主題的公開演講、企業內訓與實作工作坊：「跟 AI 對話就能拍片」等主題，曾受 MixerBox、TAIA 台灣人工智慧協會等單位邀請演講。',
    provider: { '@id': AUTHOR.id },
    areaServed: '雙北為主，外縣市有提供交通補助也可配合（實體）',
  },
  {
    '@type': 'ItemList',
    '@id': `${SERVICE_SITE.url}/services/speaking/#engagements`,
    name: '過往演講紀錄',
    itemListElement: SPEAKING_ENGAGEMENTS.map((e, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${e.host}｜${e.topic}`,
      description: e.description,
      image: new URL(e.image.src, SITE.url).href,
    })),
  },
];

const pageToc = [
  { id: 'speaking-records', label: '演講紀錄' },
  { id: 'speaking-topics', label: '邀約主題' },
  { id: 'speaking-formats', label: '形式與地區' },
];
---

<ServiceBase
  title="AI 演講邀約｜企業內訓、社群講座與實作工作坊"
  description="Alex 接受 AI 主題的演講與企業內訓邀約：AI 一鍵拍片：跟 AI 對話就能完成影片。曾受 MixerBox、TAIA 台灣人工智慧協會邀請演講。實體以雙北為主，外縣市有提供交通補助也可配合。"
  ogImage={speakingBannerUrl()}
  ogImageAlt="AI 演講與企業內訓邀約｜講師 Alex"
  schema={schema}
>
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-6 sm:py-14">
    <Breadcrumbs items={[{ name: '服務首頁', href: `${SERVICE_SITE.url}/` }, { name: 'AI 演講與企業內訓' }]} class="mb-8" />

    <section class="grid items-center gap-9 lg:grid-cols-[1fr_0.92fr] lg:gap-14">
      <div>
        <p class="text-sm font-semibold text-accent">公開演講／企業內訓／工作坊</p>
        <h1 class="t-h1 mt-3 font-semibold text-ink">AI 演講與企業內訓邀約</h1>
        <p class="mt-6 text-base leading-8 text-ink sm:text-lg sm:leading-9">
          我是 <a href={`${SITE.url}/about/`} class="text-accent underline underline-offset-4">{AUTHOR.name}</a>，接受企業、學校與社群的
          <strong class="text-accent">AI 主題演講、內訓與實作工作坊</strong>邀約。內容以「聽完就能動手」為原則：不談概念空話，現場直接演示
          怎麼只靠跟 AI 對話就把影片拍出來。曾受 MixerBox、TAIA 台灣人工智慧協會等單位邀請演講。
        </p>
        <p class="mt-6 font-semibold text-accent">邀約請點右下角官方 LINE 直接問我 <span aria-hidden="true">↘</span></p>
      </div>
      <Image src={SPEAKING_ENGAGEMENTS[0].image} alt={SPEAKING_ENGAGEMENTS[0].imageAlt} class="h-auto w-full border border-rule object-cover" loading="eager" />
    </section>

    <nav aria-label="演講服務目錄" class="mt-10 overflow-x-auto border-y border-rule">
      <ul class="flex min-w-max sm:grid sm:min-w-0 sm:grid-cols-3">
        {pageToc.map((item) => (
          <li class="min-w-28 flex-1"><a href={`#${item.id}`} class="block px-3 py-4 text-center font-semibold text-ink transition hover:bg-paper-2 hover:text-accent">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <SectionHeading id="speaking-records" size="md" class="mt-16 scroll-mt-24">過往演講紀錄</SectionHeading>
    <div class="mt-6 grid max-w-xl gap-5">
      {SPEAKING_ENGAGEMENTS.map((item, index) => (
        <Card padded={false} class="flex h-full flex-col overflow-hidden">
          <Image src={item.image} alt={item.imageAlt} widths={[480, 720, 960]} sizes="(min-width: 640px) 50vw, 100vw" class="aspect-[4/3] h-auto w-full object-cover" />
          <div class="flex flex-1 flex-col p-6 sm:p-7">
            <div class="flex items-center justify-between gap-4 border-b border-rule pb-4">
              <p class="text-xs font-semibold tracking-[0.12em] text-accent">{item.host}</p>
              <span class="font-mono text-[11px] text-ink-3">CASE 0{index + 1}</span>
            </div>
            <h3 class="mt-3 text-lg font-semibold text-ink">{item.topic}</h3>
            <p class="mt-3 leading-7 text-ink-2">{item.description}</p>
            {item.link && (
              <a
                href={item.link}
                target="_blank"
                rel="noreferrer"
                class="mt-auto inline-block pt-5 text-sm font-semibold text-accent transition hover:text-accent-2"
              >
                {item.linkLabel}
              </a>
            )}
          </div>
        </Card>
      ))}
    </div>

    <SectionHeading id="speaking-topics" size="md" class="mt-16 scroll-mt-24">可邀約的主題</SectionHeading>
    <div class="mt-6 grid max-w-xl gap-5">
      {SPEAKING_TOPICS.map((topic) => (
        <Card>
          <h3 class="text-lg font-semibold text-ink">{topic.title}</h3>
          <p class="mt-3 leading-7 text-ink-2">{topic.description}</p>
        </Card>
      ))}
    </div>
    <p class="mt-6 leading-7 text-ink-2">
      主題可依聽眾背景（零基礎／行銷／工程）調整深度，也可以安排成半天或一天的實作工作坊。
    </p>

    <SectionHeading id="speaking-formats" size="md" class="mt-16 scroll-mt-24">形式與地區</SectionHeading>
    <ul class="mt-6 space-y-4">
      {SPEAKING_FORMATS.map((item) => <CheckItem>{item}</CheckItem>)}
    </ul>

    <Cta
      title="邀約洽談"
      text="請提供活動日期、聽眾輪廓與希望的主題方向，我會盡快回覆可行性與報價。"
      hint="有問題點右下角官方 LINE 直接問我"
      href={null}
      links={[]}
    />
  </div>
</ServiceBase>
