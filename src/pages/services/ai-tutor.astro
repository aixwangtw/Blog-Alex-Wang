---
import { Image } from 'astro:assets';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import FaqList from '../../components/FaqList.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TeachingTools from '../../components/TeachingTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { AUTHOR, LINKS, SITE, breadcrumbSchema, pageBannerUrl } from '../../consts';
import { ONE_ON_ONE_FAQS } from '../../data/faqs';
import {
  CLASS_FORMATS,
  TEACHING_CASES,
  TEACHING_CONTENT,
  TEACHING_TOOLS,
  VIBE_CODING_PROMPTS,
  VIBE_CODING_SYLLABUS,
} from '../../data/services';
import Base from '../../layouts/Base.astro';

const schema = [
  breadcrumbSchema([
    { name: '首頁', item: `${SITE.url}/` },
    { name: 'AI 一對一私人教學' },
  ]),
  {
    '@type': 'Service',
    '@id': `${SITE.url}/services/ai-tutor/#service`,
    name: 'AI 一對一私人教學',
    serviceType: 'AI 教學 / 一對一家教',
    description:
      '付費一對一 AI 私人教學：手把手帶零基礎學員完成桌面版 Claude Code / Codex、OpenClaw（龍蝦）、Hermes（愛馬仕）安裝、Meta API 串接與社群自動發文系統。雙北咖啡廳實體課或 Google Meet / Discord 線上課。',
    provider: { '@id': AUTHOR.id },
    areaServed: ['台北市', '新北市', '線上（台灣與海外皆可）'],
    availableChannel: [
      { '@type': 'ServiceChannel', name: '實體課（雙北咖啡廳）' },
      { '@type': 'ServiceChannel', name: '線上課（Google Meet / Discord）' },
    ],
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE.url}/services/ai-tutor/#cases`,
    name: '一對一教學實際案例',
    itemListElement: TEACHING_CASES.map((c, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${c.topic}｜學員背景：${c.student}`,
      description: c.description,
      image: new URL(c.image.src, SITE.url).href,
    })),
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE.url}/services/ai-tutor/#tools`,
    name: '可教學工具',
    itemListElement: TEACHING_TOOLS.map((t, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: t.note ? `${t.name}（${t.note}）` : t.name,
      image: new URL(t.image.src, SITE.url).href,
    })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: ONE_ON_ONE_FAQS.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];

const pageToc = [
  { id: 'class-formats', label: '上課形式' },
  { id: 'teaching-content', label: '教學內容' },
  { id: 'vibe-coding-syllabus', label: 'Vibe Coding 新手實戰課綱' },
  { id: 'teaching-tools', label: '可教學工具' },
  { id: 'teaching-cases', label: '實際教學案例' },
  { id: 'faq', label: '常見問題' },
];
---

<Base
  title="AI 一對一私人教學｜雙北實體、線上皆可的付費 AI 家教"
  description="Alex 提供付費一對一 AI 私人教學：手把手帶你完成 Claude Code / Codex、OpenClaw（龍蝦）、Hermes（愛馬仕）安裝、Meta API 串接與自動發文系統。雙北咖啡廳實體課，或 Google Meet / Discord 線上課。"
  ogImage={pageBannerUrl('one-on-one')}
  ogImageAlt="AI 一對一私人教學｜講師 Alex"
  schema={schema}
>
  <div class="mx-auto max-w-4xl px-6 py-12">
    <Breadcrumbs items={[{ name: '首頁', href: '/' }, { name: 'AI 一對一私人教學' }]} class="mb-8" />
    <h1 class="t-h1 font-semibold text-ink">AI 一對一私人教學</h1>

    <p class="mt-8 text-lg leading-9 text-ink">
      這是付費的一對一 AI 私人教學服務：由我（<a href="/about/" class="text-accent underline underline-offset-4">{AUTHOR.name}</a>）手把手帶你，在<strong class="text-accent">你自己的電腦、你自己的帳號</strong>上，把
      AI 自動化流程真正跑通一次——從四大 AI Agent（Claude Code、Codex、OpenClaw 龍蝦、Hermes 愛馬仕）的安裝使用、<strong class="text-accent">讓 AI 可以跟你的社群軟體互動的 API 串接</strong>（例如用 LINE 跟 AI 對話，整理其他平台的訊息），到做出可排程的社群自動發文系統，以及打造你的生圖、拍片工作流。
    </p>

    <nav aria-label="頁面目錄" class="mt-8 border-y border-rule px-0.5 py-6">
      <p class="font-mono text-[11.5px] tracking-[0.12em] text-ink-3">目錄</p>
      <ol class="mt-4 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
        {pageToc.map((item, index) => (
          <li class="flex gap-3 leading-7">
            <span class="shrink-0 font-mono text-[13px] tabular-nums text-ink-3" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <a href={`#${item.id}`} class="text-accent underline-offset-4 hover:underline">{item.label}</a>
          </li>
        ))}
      </ol>
    </nav>

    <SectionHeading id="class-formats" size="md" class="mt-14 scroll-mt-24">上課形式</SectionHeading>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {CLASS_FORMATS.map((format) => (
        <Card>
          <h3 class="text-xl font-semibold text-ink">{format.title}</h3>
          <p class="mt-3 leading-7 text-ink-2">{format.description}</p>
        </Card>
      ))}
    </div>
    <p class="mt-5 border-l-2 border-accent pl-4 leading-7 text-ink-2">
      也可安排一對多教學：第一位學員依原價計費，<strong class="font-semibold text-ink">第二位起每位教學費用享八折</strong>。
    </p>

    <SectionHeading id="teaching-content" size="md" class="mt-14 scroll-mt-24">教學內容</SectionHeading>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {TEACHING_CONTENT.map((item) => (
        <Card>
          <h3 class="text-xl font-semibold text-ink">{item.category}</h3>
          {item.logos && (
            <div class="mt-4 flex gap-2.5">
              {item.logos.map((logo) => (
                <Image src={logo.image} alt={logo.alt} width={96} class="h-9 w-9 object-cover" />
              ))}
            </div>
          )}
          <p class="mt-3 leading-7 text-ink-2">{item.detail}</p>
        </Card>
      ))}
    </div>

    <SectionHeading id="vibe-coding-syllabus" size="md" class="mt-14 scroll-mt-24">Vibe Coding 新手實戰課綱</SectionHeading>
    <p class="mt-4 leading-7 text-ink-2">
      適合沒有程式背景，或已經用 AI 寫出作品，卻經常遇到功能互相影響、改 A 壞 B 的新手。課程時間約 3 小時。
    </p>
    <div class="mt-6 grid gap-5">
      {VIBE_CODING_SYLLABUS.map((item) => (
        <Card>
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-semibold text-accent">{item.step}</span>
            <span class="text-sm text-ink-3">{item.duration}</span>
          </div>
          <h3 class="mt-2 text-xl font-semibold text-ink">{item.title}</h3>
          <p class="mt-3 leading-7 text-ink-2">{item.detail}</p>
        </Card>
      ))}
    </div>
    <Card class="mt-5">
      <h3 class="text-xl font-semibold text-ink">課堂會練習的提示詞</h3>
      <ul class="mt-4 space-y-2 text-ink-2">
        {VIBE_CODING_PROMPTS.map((prompt) => (
          <li class="flex gap-3 leading-7">
            <span aria-hidden="true" class="text-accent">→</span>
            <span>{prompt}</span>
          </li>
        ))}
      </ul>
    </Card>

    <SectionHeading id="teaching-tools" size="md" class="mt-14 scroll-mt-24">可教學工具</SectionHeading>
    <TeachingTools />

    <SectionHeading id="teaching-cases" size="md" class="mt-14 scroll-mt-24">實際教學案例</SectionHeading>
    <p class="mt-4 leading-7 text-ink-2">
      以下是四個實際的一對一教學案例，涵蓋不同背景的學員與客製化主題：
    </p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {TEACHING_CASES.map((item) => (
        <Card>
          <div class="flex items-center gap-3">
            <Image src={item.image} alt={item.imageAlt} width={96} class="h-10 w-10 shrink-0 object-contain" />
            <h3 class="text-lg font-semibold leading-snug text-ink">{item.topic}</h3>
          </div>
          <p class="mt-3 text-sm text-accent">學員背景：{item.student}</p>
          <p class="mt-3 leading-7 text-ink-2">{item.description}</p>
        </Card>
      ))}
    </div>

    <SectionHeading id="faq" size="md" class="mt-14 scroll-mt-24">常見問題</SectionHeading>
    <div class="mt-6">
      <FaqList faqs={ONE_ON_ONE_FAQS} />
    </div>

    <Cta
      title="想預約或先問問題？"
      text="加 LINE 告訴我你的目標和目前程度，我會建議適合的上課方式與堂數。"
      links={[{ href: LINKS.email, label: 'Email 聯絡' }]}
    />
  </div>
</Base>
