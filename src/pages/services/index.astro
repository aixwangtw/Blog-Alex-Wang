---
import { Image } from 'astro:assets';
import freeResourcesHome from '../../assets/free-resources-home-v2.png';
import Cta from '../../components/Cta.astro';
import {
  AUTHOR,
  COLLABORATION_ENTRY_LINKS,
  CTA_VARIANTS,
  FREE_ENTRY_LINKS,
  GUIDED_ENTRY_LINKS,
  LEARNING_ENTRY_LINKS,
  LINKS,
  PERSON_SCHEMA,
  SERVICE_SITE,
  SITE,
  pageBannerUrl,
} from '../../consts';
import { SPEAKING_ENGAGEMENTS, TEACHING_CASES } from '../../data/services';
import { DEVELOPMENT_SERVICE, LINE_URLS } from '../../consts';
import ServiceBase from '../../layouts/ServiceBase.astro';

const serviceCards = [
  {
    number: '01',
    eyebrow: 'FOR BEGINNERS',
    title: 'AI 新手實戰課',
    description: '不需要程式背景。3 小時帶你在自己的電腦上，從工具安裝到完成第一個可以使用的專案。',
    href: '/course/',
    action: '查看課程',
  },
  {
    number: '02',
    eyebrow: 'FOR TEAMS',
    title: 'AI 演講與企業內訓',
    description: '以真實任務現場演示 AI Agent、社群自動化與對話式拍片，主題可依聽眾背景調整。',
    href: '/services/speaking/',
    action: '查看演講服務',
  },
];

// 快速入口（原本在主站首屏）：主站相對路徑要補上主站網域，服務站上才連得到。
const absolute = (href: string) => (href.startsWith('/') ? `${SITE.url}${href}` : href);
const entryTabs = [
  { key: 'collaborate', label: '邀合作', links: COLLABORATION_ENTRY_LINKS },
  { key: 'learn', label: '自己學', links: LEARNING_ENTRY_LINKS },
  { key: 'guided', label: '找人帶', links: GUIDED_ENTRY_LINKS },
  { key: 'free', label: '找免費', links: FREE_ENTRY_LINKS },
].map((tab) => ({ ...tab, links: tab.links.map((entry) => ({ ...entry, href: absolute(entry.href) })) }));

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SERVICE_SITE.url}/#webpage`,
    url: `${SERVICE_SITE.url}/`,
    name: 'Alex AI 服務｜系統開發、AI 教學與演講',
    description: SERVICE_SITE.description,
    isPartOf: { '@id': `${SERVICE_SITE.url}/#website` },
    about: { '@id': PERSON_SCHEMA['@id'] },
  },
  {
    '@type': 'ItemList',
    name: 'Alex AI 服務項目',
    itemListElement: [{ title: '客製系統開發', href: '/services/development/' }, ...serviceCards].map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      url: new URL(item.href, SERVICE_SITE.url).href,
    })),
  },
];
---

<ServiceBase
  title="Alex AI 服務｜系統開發、AI 教學與演講"
  description={SERVICE_SITE.description}
  canonicalPath="/"
  ogImage={pageBannerUrl('service-home')}
  ogImageAlt="Alex AI 服務｜講師 Alex"
  schema={schema}
>
  <section class="service-hero">
    <div class="service-hero-copy">
      <p class="service-kicker">SYSTEM DEVELOPMENT</p>
      <h1>客製系統開發</h1>
      <p class="service-lead">我是 {AUTHOR.name}，目前全職接案，和開發夥伴一起把重複、瑣碎的工作做成一套系統。代表案例是補習班數學老師用的題庫系統：考卷匯入、AI 出題、AI 詳解。</p>
      <div class="service-hero-actions">
        <a href="/services/development/" data-ga-button="service_home_development" data-ga-label="查看系統開發服務" data-ga-location="service_home_hero" data-ga-action="navigate">查看系統開發服務</a>
        <a href={LINE_URLS.blog} target="_blank" rel="noreferrer" data-ga-button="service_home_line" data-ga-label="加官方 LINE 免費評估" data-ga-location="service_home_hero" data-ga-action="external">加官方 LINE 免費評估</a>
      </div>
    </div>
    <figure class="service-hero-case">
      <img src={`${SITE.url}/images/blog/math-teacher-question-bank/import-review.jpg`} alt="數學題庫系統的考卷匯入審核頁：左邊是原始考卷，右邊是 AI 辨識出來的題目" width="1400" height="875" fetchpriority="high" />
      <figcaption>
        <span>代表案例</span>
        <strong>補習班數學題庫系統</strong>
        <small>考卷匯入・AI 出題・AI 詳解</small>
      </figcaption>
    </figure>
  </section>

  <section class="service-proof" aria-label="系統開發合作重點">
    <p><strong>和開發夥伴一起開發</strong></p>
    <p><strong>開發時程約兩個月</strong></p>
    <p><strong>分三期付款</strong></p>
  </section>

  <section class="service-dev" id="development" aria-labelledby="dev-h">
    <div class="service-dev-copy">
      <p class="service-kicker">代表案例</p>
      <h2 id="dev-h">數學題庫系統</h2>
      <p class="service-section-lead">幫補習班數學老師把瑣碎的出題流程自動化：上傳考卷由 AI 拆成一題一題，老師對照原卷確認後收進題庫；出卷時勾選、排序，就能匯出圖片或貼進 Word。</p>
      <ul>
        <li>考卷匯入、AI 辨識與審核</li>
        <li>AI 出相似題、AI 產生詳解</li>
        <li>出卷與匯出（PNG、Word、MathType）</li>
      </ul>
      <div class="service-dev-links">
        <a href={`${SITE.url}${DEVELOPMENT_SERVICE.caseArticle}`} data-ga-button="service_home_case_article" data-ga-label="看題庫系統完整介紹" data-ga-location="service_home_development" data-ga-action="navigate">看完整介紹 →</a>
        <a href={DEVELOPMENT_SERVICE.demoUrl} target="_blank" rel="noreferrer" data-ga-button="service_home_case_demo" data-ga-label="試用題庫系統 Demo" data-ga-location="service_home_development" data-ga-action="external">試用 Demo ↗</a>
      </div>
    </div>
    <div class="service-dev-cost">
      <p class="service-kicker">費用怎麼算</p>
      <dl>
        <div><dt>開發費</dt><dd>依需要的功能報價，加 LINE 可以免費評估。</dd></div>
        <div><dt>付款方式</dt><dd>簽約時 40%、期中 30%、驗收時 30%，需要分更多期可以再詳談。</dd></div>
        <div><dt>主機費用</dt><dd>建置依規格約新台幣 5,000 元（一次性），基本規格每月約新台幣 500 元。</dd></div>
        <div><dt>AI 使用費</dt><dd>依實際用量計算，一般每月約新台幣 20～150 元。</dd></div>
      </dl>
      <a class="service-dev-primary" href="/services/development/" data-ga-button="service_home_dev_detail" data-ga-label="看合作流程與費用細節" data-ga-location="service_home_development" data-ga-action="navigate">看合作流程與費用細節 →</a>
    </div>
  </section>

  <section class="service-options" id="services">
    <header>
      <p class="service-kicker">其他服務</p>
      <h2>也提供 AI 教學與演講</h2>
    </header>
    <div class="service-option-grid">
      {serviceCards.map((item) => (
        <article>
          <span class="service-option-number">{item.number}</span>
          <p>{item.eyebrow}</p>
          <h3>{item.title}</h3>
          <div class="service-option-rule"></div>
          <p>{item.description}</p>
          <a href={item.href}>{item.action}<span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="service-entry" id="quick-entry" aria-labelledby="quick-entry-h">
    <header>
      <p class="service-kicker">快速入口</p>
      <h2 id="quick-entry-h">你希望我如何幫你？</h2>
    </header>
    <div class="service-entry-tabs" role="tablist" aria-label="選擇需求">
      {entryTabs.map((tab, index) => (
        <button
          id={`entry-tab-${tab.key}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`entry-panel-${tab.key}`}
          tabindex={index === 0 ? undefined : '-1'}
          data-entry-tab={tab.key}
          data-ga-button={`service_entry_tab_${tab.key}`}
          data-ga-label={tab.label}
          data-ga-location="service_quick_entry"
          data-ga-action="switch_tab"
        >{tab.label}</button>
      ))}
    </div>
    {entryTabs.map((tab, index) => (
      <div id={`entry-panel-${tab.key}`} class="service-entry-panel" role="tabpanel" aria-labelledby={`entry-tab-${tab.key}`} data-entry-panel={tab.key} hidden={index !== 0}>
        <nav class="service-entry-options" aria-label={tab.label}>
          {tab.links.map((entry, linkIndex) => (
            <a href={entry.href} data-ga-button={`service_entry_${entry.analyticsKey}`} data-ga-label={entry.analyticsLabel} data-ga-location="service_quick_entry" data-ga-action="navigate">
              <span class="service-entry-index" aria-hidden="true">{String(linkIndex + 1).padStart(2, '0')}</span>
              <span><strong>{entry.title}</strong><small>{entry.description}</small></span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </div>
    ))}
  </section>

  <section class="service-experience" id="teaching-cases">
    <header>
      <p class="service-kicker">AI 一對一教學</p>
      <h2>私人家教案例</h2>
      <p class="service-section-lead">每堂課都用學員自己的電腦、帳號和需求實作，過去已帶學員完成 Agent 安裝、社群自動發文、Email 與行事曆整理，以及 OpenClaw 排錯救援。</p>
    </header>
    <ul class="service-case-grid">
      {TEACHING_CASES.map((item) => (
        <li>
          <Image src={item.image} alt={item.imageAlt} width={64} class="service-case-icon" />
          <div>
            <strong>{item.topic}</strong>
            <span>{item.student}</span>
          </div>
        </li>
      ))}
    </ul>
    <a class="service-text-link" href="/course/" data-ga-button="service_home_course_cases" data-ga-label="查看完整教學案例與上課方式" data-ga-location="service_home_teaching" data-ga-action="navigate">查看完整案例與上課方式 →</a>
  </section>

  <section class="service-experience" id="speaking-cases">
    <header>
      <p class="service-kicker">演講邀約</p>
      <h2>過往演講紀錄</h2>
    </header>
    <div class="service-experience-grid">
      {SPEAKING_ENGAGEMENTS.slice(0, 3).map((item, index) => (
        <article>
          <Image src={item.image} alt={item.imageAlt} widths={[420, 640, 840]} sizes="(min-width: 768px) 33vw, 100vw" />
          <div class="service-experience-copy">
            <div><small>{item.host}</small><span>CASE 0{index + 1}</span></div>
            <h3>{item.topic}</h3>
            <p>{item.description}</p>
          </div>
        </article>
      ))}
    </div>
    <a class="service-text-link" href="/services/speaking/">查看全部演講案例 →</a>
  </section>

  <section class="service-experience service-free" id="free-resources">
    <div class="service-free-copy">
      <p class="service-kicker">先自己試試看</p>
      <h2>免費資源</h2>
      <p class="service-section-lead">整理了免費教學文章、影片與開源工具，點選你需要的主題就能查看。</p>
      <ul>
        <li>Codex 新手安裝教學</li>
        <li>可直接交給 AI 安裝的 Skills</li>
        <li>API 串接教學與開源工具</li>
      </ul>
      <a class="service-text-link" href={`${SITE.url}/resources/`} data-ga-button="service_home_free_resources" data-ga-label="查看免費資源" data-ga-location="service_home_free" data-ga-action="navigate">查看免費資源 →</a>
    </div>
    <Image src={freeResourcesHome} alt="教學影片、開源工具與實作指南組成的免費 AI 學習資源" widths={[560, 880]} sizes="(min-width: 768px) 45vw, 100vw" class="service-free-media" />
  </section>

  <div class="service-home-cta">
    <Cta
      title={CTA_VARIANTS[2].title}
      text={CTA_VARIANTS[2].text}
      label={'詢問適合的\n合作方式'}
      links={[{ href: LINKS.email, label: 'Email 聯絡' }]}
    />
  </div>

  <style>
    .service-kicker { color:var(--color-accent); font-size:13px; font-weight:700; letter-spacing:.08em; }
    .service-hero { display:grid; grid-template-columns:minmax(0, 1.06fr) minmax(320px, .8fr); gap:64px; align-items:center; width:min(1120px, calc(100% - 48px)); margin:0 auto; padding:80px 0 70px; }
    .service-hero h1 { max-width:12ch; margin-top:22px; font-family:var(--font-serif, serif); font-size:clamp(48px, 6.1vw, 78px); font-weight:600; line-height:1.12; letter-spacing:-.055em; }
    .service-lead { max-width:620px; margin-top:28px; color:var(--color-ink-2); font-size:18px; line-height:1.9; }
    .service-hero-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:34px; }
    .service-hero-actions a { display:inline-flex; min-height:50px; align-items:center; justify-content:center; padding:0 24px; border:1px solid var(--color-accent); color:var(--color-accent); font-weight:700; text-decoration:none; }
    .service-hero-actions a:first-child { background:var(--color-accent); color:#fff; }
    .service-hero figure { position:relative; margin:0; }
    .service-hero figure img { display:block; width:100%; height:auto; border:1px solid var(--color-rule-2); filter:saturate(.86); }
    .service-hero figcaption { position:absolute; right:-18px; bottom:24px; display:grid; min-width:230px; padding:17px 20px; border:1px solid var(--color-accent-line-2); background:rgb(247 245 241 / 96%); box-shadow:0 12px 30px rgb(22 22 26 / 12%); }
    .service-hero figcaption span, .service-hero figcaption small { color:var(--color-ink-3); font-size:11px; }
    .service-hero figcaption strong { margin:5px 0; font-size:20px; }
    .service-proof { display:grid; grid-template-columns:repeat(3, 1fr); width:min(1120px, calc(100% - 48px)); margin:auto; border-block:1px solid var(--color-rule); }
    .service-proof p { display:grid; place-items:center; min-height:82px; margin:0; padding:20px; text-align:center; }
    .service-proof p + p { border-left:1px solid var(--color-rule); }
    .service-proof strong { max-width:24ch; color:var(--color-accent); font-size:16px; line-height:1.55; }
    .service-options, .service-experience { width:min(1120px, calc(100% - 48px)); margin:110px auto 0; }
    .service-options > header, .service-experience > header { max-width:700px; }
    .service-options h2, .service-experience h2 { margin-top:14px; font:600 clamp(34px, 4vw, 52px)/1.25 var(--font-serif, serif); letter-spacing:-.035em; }
    .service-option-grid { display:grid; grid-template-columns:repeat(2, 1fr); gap:20px; margin-top:42px; }
    .service-option-grid article { position:relative; min-height:330px; padding:34px 34px 76px; border:1px solid var(--color-rule-2); background:var(--color-paper-2); }
    .service-option-grid article:nth-child(1) { background:var(--color-paper-2); }
    .service-option-number { position:absolute; top:30px; right:32px; color:var(--color-accent-line-2); font:700 13px/1 ui-monospace, monospace; }
    .service-option-grid article > p:first-of-type { color:var(--color-accent); font:700 10px/1.3 ui-monospace, monospace; letter-spacing:.15em; }
    .service-option-grid h3 { max-width:12ch; margin-top:24px; font:600 clamp(26px, 2.6vw, 35px)/1.25 var(--font-serif, serif); }
    .service-option-rule { width:44px; height:2px; margin:24px 0; background:var(--color-accent); }
    .service-option-grid article > p:nth-of-type(2) { max-width:48ch; color:var(--color-ink-3); line-height:1.8; }
    
    .service-option-grid article > a { position:absolute; bottom:30px; left:34px; display:flex; gap:14px; color:inherit; font-weight:700; text-decoration:none; }
    .service-option-grid article > a span { color:var(--color-accent); }
    .service-experience-grid { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:18px; margin-top:38px; }
    .service-experience article { overflow:hidden; border:1px solid var(--color-rule-2); background:var(--color-paper-2); }
    .service-experience article > img { display:block; width:100%; aspect-ratio:4 / 3; object-fit:cover; }
    .service-experience-copy { padding:22px; }
    .service-experience-copy > div { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; padding-bottom:14px; border-bottom:1px solid var(--color-rule); }
    .service-experience-copy span { color:var(--color-ink-3); font:700 10px/1.4 ui-monospace, monospace; white-space:nowrap; }
    .service-experience small { color:var(--color-accent); font-weight:700; }
    .service-experience h3 { margin-top:16px; font-size:20px; line-height:1.45; }
    .service-experience article p { margin-top:9px; color:var(--color-ink-3); line-height:1.75; }
    .service-text-link { display:inline-block; margin-top:24px; color:var(--color-accent); font-weight:700; text-decoration:none; }
    .service-home-cta { width:min(1120px, calc(100% - 48px)); margin:80px auto 0; }
    .service-hero-case { position:relative; margin:0; }
    .service-hero-case img { display:block; width:100%; height:auto; border:1px solid var(--color-rule-2); box-shadow:0 18px 48px rgb(22 22 26 / 12%); }
    .service-dev { display:grid; grid-template-columns:minmax(0, 1.05fr) minmax(0, .95fr); gap:56px; width:min(1120px, calc(100% - 48px)); margin:96px auto 0; align-items:start; }
    .service-dev h2 { margin-top:14px; font:600 clamp(34px, 4vw, 52px)/1.25 var(--font-serif, serif); letter-spacing:-.035em; }
    .service-dev-copy ul { display:grid; gap:8px; margin-top:18px; padding:0; list-style:none; color:var(--color-ink-3); }
    .service-dev-links { display:flex; flex-wrap:wrap; gap:12px 24px; margin-top:22px; }
    .service-dev-links a { color:var(--color-accent); font-weight:700; text-decoration:none; }
    .service-dev-cost { padding:28px; background:var(--color-ink); color:#fff; }
    .service-dev-cost dl { display:grid; margin-top:14px; }
    .service-dev-cost dl > div { padding:14px 0; border-bottom:1px solid rgb(255 255 255 / 14%); }
    .service-dev-cost dt { color:#e7b8c0; font-size:13px; font-weight:700; letter-spacing:.06em; }
    .service-dev-cost dd { margin:4px 0 0; color:#e9e5df; line-height:1.75; }
    .service-dev-primary { display:inline-flex; min-height:48px; align-items:center; margin-top:22px; padding:0 22px; background:var(--color-accent); color:#fff; font-weight:700; text-decoration:none; }
    .service-section-lead { max-width:62ch; margin-top:16px; color:var(--color-ink-2); line-height:1.85; }
    .service-case-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:14px; margin:34px 0 0; padding:0; list-style:none; }
    .service-case-grid li { display:grid; grid-template-columns:44px minmax(0, 1fr); gap:14px; align-items:center; padding:18px; border:1px solid var(--color-rule-2); background:var(--color-paper-2); }
    .service-case-icon { width:44px; height:44px; object-fit:contain; }
    .service-case-grid strong { display:block; color:var(--color-ink); line-height:1.5; }
    .service-case-grid span { display:block; margin-top:4px; color:var(--color-ink-3); font-size:13px; }
    .service-free { display:grid; grid-template-columns:minmax(0, 1fr) minmax(280px, .9fr); gap:48px; align-items:center; }
    .service-free-copy ul { display:grid; gap:8px; margin-top:18px; padding:0; list-style:none; color:var(--color-ink-3); }
    .service-free-media { display:block; width:100%; height:auto; border:1px solid var(--color-rule-2); }
    @media (max-width:767px) {
      .service-hero { grid-template-columns:1fr; gap:40px; width:min(100% - 40px, 620px); padding:54px 0 50px; }
      .service-hero h1 { font-size:clamp(40px, 13vw, 58px); line-height:1.12; }
      .service-lead { font-size:16px; line-height:1.8; }
      .service-hero-actions { display:grid; grid-template-columns:1fr; }
      .service-hero-actions a { width:100%; }
      .service-hero figure { width:calc(100% - 14px); }
      .service-hero figcaption { right:-14px; bottom:18px; min-width:min(230px, calc(100% - 24px)); }
      .service-proof { grid-template-columns:1fr; width:calc(100% - 40px); }
      .service-proof p + p { border-top:1px solid var(--color-rule); border-left:0; }
      .service-options, .service-experience, .service-home-cta { width:calc(100% - 40px); margin-top:76px; }
      .service-option-grid { grid-template-columns:1fr; }
      .service-option-grid article { min-height:0; padding:28px 24px 72px; }
      .service-option-grid article > a { left:24px; }
      .service-experience-grid { grid-template-columns:1fr; }
      .service-case-grid { grid-template-columns:1fr; }
      .service-dev { grid-template-columns:1fr; gap:32px; width:calc(100% - 40px); margin-top:72px; }
      .service-dev-cost { padding:22px; }
      .service-dev-primary { width:100%; justify-content:center; }
      .service-free { grid-template-columns:1fr; gap:28px; }
    }
    @media (max-width:340px) {
      .service-hero, .service-proof, .service-options, .service-experience, .service-home-cta { width:calc(100% - 32px); }
      .service-hero h1 { font-size:38px; }
    }
    .service-entry { width:min(1120px, calc(100% - 48px)); margin:110px auto 0; }
    .service-entry h2 { margin-top:14px; font:600 clamp(34px, 4vw, 52px)/1.25 var(--font-serif, serif); letter-spacing:-.035em; }
    .service-entry-tabs { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:6px; margin-top:32px; padding:6px; border:1px solid var(--color-rule-2); background:var(--color-paper-2); }
    .service-entry-tabs button { min-height:46px; border:0; background:transparent; color:var(--color-ink-2); font-weight:700; cursor:pointer; }
    .service-entry-tabs button[aria-selected='true'] { background:var(--color-accent); color:#fff; }
    .service-entry-tabs button:focus-visible { outline:2px solid var(--color-accent); outline-offset:2px; }
    .service-entry-panel[hidden] { display:none; }
    .service-entry-options { display:grid; gap:10px; margin-top:14px; }
    .service-entry-options a { display:grid; grid-template-columns:40px minmax(0, 1fr) auto; gap:12px; align-items:center; padding:18px 20px; border:1px solid var(--color-rule-2); color:var(--color-ink); text-decoration:none; transition:border-color .15s; }
    .service-entry-options a:hover { border-color:var(--color-accent); }
    .service-entry-index { color:var(--color-accent); font:700 12px/1 ui-monospace, monospace; }
    .service-entry-options strong { display:block; }
    .service-entry-options small { display:block; margin-top:4px; color:var(--color-ink-3); font-size:13px; }
    @media (max-width:767px) {
      .service-entry { width:calc(100% - 40px); margin-top:76px; }
      .service-entry-tabs { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    }
  </style>
  <script is:inline>
    (function () {
      var tabs = Array.from(document.querySelectorAll('[data-entry-tab]'));
      var panels = Array.from(document.querySelectorAll('[data-entry-panel]'));
      if (!tabs.length) return;
      function activate(key, focus) {
        tabs.forEach(function (tab) {
          var on = tab.getAttribute('data-entry-tab') === key;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          if (on && focus) tab.focus();
        });
        panels.forEach(function (panel) { panel.hidden = panel.getAttribute('data-entry-panel') !== key; });
      }
      tabs.forEach(function (tab, index) {
        tab.addEventListener('click', function () { activate(tab.getAttribute('data-entry-tab'), false); });
        tab.addEventListener('keydown', function (event) {
          var next = index;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault();
          activate(tabs[next].getAttribute('data-entry-tab'), true);
        });
      });
    })();
  </script>
