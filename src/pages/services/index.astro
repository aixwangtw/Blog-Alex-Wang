---
import { Image } from 'astro:assets';
import freeResourcesHome from '../../assets/free-resources-home-v2.png';
import Cta from '../../components/Cta.astro';
import DevCategoryPicker from '../../components/DevCategoryPicker.astro';
import { PERSON_SCHEMA, PROFESSIONAL_SERVICE_SCHEMA, SERVICE_SITE, SITE, pageBannerUrl, DEVELOPMENT_SERVICE, COURSE_SERVICE_URL, SPEAKING_SERVICE_URL, servicePath } from '../../consts';
import ServiceBase from '../../layouts/ServiceBase.astro';

// 2026-10-31 起首屏改為「你想做什麼系統？」六類別（與主站首頁共用 DevCategoryPicker）；教學、演講、開源工具改放首屏下方三張小卡。
const heroServiceCards = [
  { key: 'development', href: servicePath(DEVELOPMENT_SERVICE.url), title: '系統開發' },
  { key: 'course', href: servicePath(COURSE_SERVICE_URL), title: 'AI 一對一教學' },
];

// <title>、og:title 與 WebPage.name 共用同一個字串，避免兩處漂移
const pageTitle = 'Aix 系統開發服務｜系統開發、AI 導入、AI 一對一教學';

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SERVICE_SITE.url}/#webpage`,
    url: `${SERVICE_SITE.url}/`,
    name: pageTitle,
    description: SERVICE_SITE.description,
    isPartOf: { '@id': `${SERVICE_SITE.url}/#website` },
    about: { '@id': PERSON_SCHEMA['@id'] },
  },
  PROFESSIONAL_SERVICE_SCHEMA,
  {
    '@type': 'ItemList',
    name: 'Aix 系統開發服務項目',
    itemListElement: heroServiceCards.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      url: new URL(item.href, SERVICE_SITE.url).href,
    })),
  },
];
---

<ServiceBase
  title={pageTitle}
  description={SERVICE_SITE.description}
  canonicalPath="/"
  ogImage={pageBannerUrl('service-home')}
  ogImageAlt="Aix 系統開發服務｜工程師 Alex"
  schema={schema}
>
  <div class="service-router" id="quick-entry">
    <DevCategoryPicker location="service_hero" headingId="service-hero-h" kicker="客製系統開發、AI 導入｜AI 手把手教學" absoluteLinks />
    <ul class="service-more" aria-label="其他服務與工具">
      <li><a href={servicePath(COURSE_SERVICE_URL)} data-ga-button="service_more_course" data-ga-label="一對一教學" data-ga-location="service_more" data-ga-action="navigate"><strong>AI 一對一教學</strong><span>Claude Code 系統開發、簡單網頁、AI 動畫影片。</span><em>看教學方案 →</em></a></li>
      <li><a href={servicePath(SPEAKING_SERVICE_URL)} data-ga-button="service_more_speaking" data-ga-label="演講邀約" data-ga-location="service_more" data-ga-action="navigate"><strong>演講邀約</strong><span>公開演講、企業內訓、工作坊，主題可以討論。</span><em>邀請演講 →</em></a></li>
      <li><a href={`${SITE.url}/resources/`} data-ga-button="service_more_opensource" data-ga-label="開源工具" data-ga-location="service_more" data-ga-action="navigate"><strong>開源工具</strong><span>feedback-desk 問題回報系統、grill-me Skill。</span><em>看開源工具 →</em></a></li>
    </ul>
  </div>

  <section class="service-dev" id="system-development" aria-labelledby="service-dev-h">
    <p class="service-kicker">系統開發</p>
    <h2 id="service-dev-h">客製系統開發、AI 導入</h2>
    <p class="service-section-lead">AI 導入、資料管理、API 串接是我們團隊的強項：讓 AI 讀文件、整理資料、產生報告，做客戶、訂單、庫存這類資料的後台，或接 LINE、金流、Google 服務。做過的系統有 CRM、背書系統、健檢系統、預約系統、揪團平台等。</p>
    <article class="service-case">
      <img class="service-case-thumb" src="/images/blog/math-teacher-question-bank/import-review.jpg" alt="題庫系統的考卷匯入審核頁：左邊是原始考卷，右邊是 AI 辨識出來的題目" width="1400" height="875" loading="lazy" decoding="async" />
      <div class="service-case-body">
        <p class="service-kicker">代表案例</p>
        <h3>數學題庫系統</h3>
        <p>AI 辨識審核、AI 詳解、AI 出題。AI 出題可以先在 Demo 體驗，正式導入時依需求開發。</p>
        <p class="service-dev-links">
          <a href={servicePath(DEVELOPMENT_SERVICE.url)} data-ga-button="service_home_dev_detail" data-ga-label="看合作流程與費用" data-ga-location="service_home_dev" data-ga-action="navigate">看合作流程與費用 <span aria-hidden="true">→</span></a>
          <a href={`${SITE.url}/blog/math-teacher-question-bank/`} data-ga-button="service_home_dev_case" data-ga-label="看題庫系統完整介紹" data-ga-location="service_home_dev" data-ga-action="navigate">看題庫系統完整介紹 <span aria-hidden="true">→</span></a>
        </p>
      </div>
    </article>
  </section>

  <section class="service-experience service-free" id="free-resources">
    <div class="service-free-copy">
      <p class="service-kicker">先自己試試看</p>
      <h2>免費資源</h2>
      <p class="service-section-lead">整理了免費教學文章、影片與開源工具，點選你需要的主題就能查看。</p>
<a class="service-text-link" href={`${SITE.url}/resources/`} data-ga-button="service_home_free_resources" data-ga-label="查看免費資源" data-ga-location="service_home_free" data-ga-action="navigate">查看免費資源 →</a>
    </div>
    <Image src={freeResourcesHome} alt="教學影片、開源工具與實作指南組成的免費 AI 學習資源" widths={[560, 880]} sizes="(min-width: 768px) 45vw, 100vw" class="service-free-media" />
  </section>

  <div class="service-home-cta">
    <Cta
      title="對系統有疑問嗎？"
      text="加 LINE 先聊需求，Demo 試用過再決定要不要簽約。想自己學著做，可以看一對一教學。"
      label={'了解系統\n開發服務'}
      external={false}
      hint="想先評估需求，右下角官方 LINE 可以免費聊"
      links={[{ href: servicePath(COURSE_SERVICE_URL), label: '看一對一教學' }]}
    />
  </div>

  <style>
    .service-kicker { color:var(--color-accent); font-size:13px; font-weight:700; letter-spacing:.08em; }
    .service-hero { display:grid; gap:44px; width:min(1120px, calc(100% - 48px)); margin:0 auto; padding:88px 0 0; }
    .service-hero-copy { max-width:760px; }
    .service-hero h1 { max-width:18ch; margin-top:22px; font-family:var(--font-serif, serif); font-size:clamp(40px, 4.6vw, 60px); font-weight:600; line-height:1.12; letter-spacing:-.055em; }
    .service-lead { max-width:620px; margin-top:28px; color:var(--color-ink-2); font-size:18px; line-height:1.9; }
    .service-hero-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:34px; }
    .service-hero-actions a { display:inline-flex; min-height:50px; align-items:center; justify-content:center; padding:0 24px; border:1px solid var(--color-accent); background:var(--color-accent); color:#fff; font-weight:700; text-decoration:none; }
    .service-hero h1 .nb { white-space:nowrap; }
    .service-hero-actions a.service-hero-ghost { border-color:var(--color-ink); background:transparent; color:var(--color-ink); }
    .service-dev-links { display:flex; flex-wrap:wrap; gap:12px 28px; }
    .service-lead a { color:var(--color-accent); text-decoration:underline; text-underline-offset:4px; }
    .service-dev { width:min(1120px, calc(100% - 48px)); margin:96px auto 0; padding-top:56px; border-top:1px solid var(--color-rule); }
    .service-dev h2 { margin-top:14px; font:600 clamp(36px, 4.6vw, 60px)/1.15 var(--font-serif, serif); letter-spacing:-.04em; }
    .service-dev-links { margin-top:28px; }
    .service-dev-links a { color:var(--color-accent); font-weight:700; text-decoration:none; }
    .service-experience { width:min(1120px, calc(100% - 48px)); margin:110px auto 0; }
    .service-experience > header { max-width:700px; }
    .service-experience h2 { margin-top:14px; font:600 clamp(34px, 4vw, 52px)/1.25 var(--font-serif, serif); letter-spacing:-.035em; }
    .service-text-link { display:inline-block; margin-top:24px; color:var(--color-accent); font-weight:700; text-decoration:none; }
    .service-home-cta { width:min(1120px, calc(100% - 48px)); margin:80px auto 0; }
    .service-section-lead { max-width:62ch; margin-top:16px; color:var(--color-ink-2); line-height:1.85; }
    .service-router { width:min(1120px, calc(100% - 48px)); margin:0 auto; }
    .service-more { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:16px; margin:0; padding:0; list-style:none; }
    .service-more > li { display:flex; min-width:0; }
    .service-more a { display:flex; flex:1; flex-direction:column; gap:6px; min-width:0; padding:18px 20px; border:1px solid var(--color-rule-2); border-radius:8px; color:var(--color-ink); text-decoration:none; }
    .service-more strong { font-size:16px; }
    .service-more span { font-size:14px; line-height:1.7; color:var(--color-ink-3); }
    .service-more em { margin-top:auto; padding-top:6px; font-style:normal; font-size:14px; font-weight:650; color:var(--color-accent); }
    @media (hover:hover) and (pointer:fine) { .service-more a:hover { border-color:var(--color-accent); } }
    .service-case { display:grid; grid-template-columns:minmax(0, 5fr) minmax(0, 7fr); margin-top:32px; overflow:hidden; border:1px solid var(--color-rule-2); border-radius:8px; }
    .service-case-thumb { display:block; width:100%; height:100%; aspect-ratio:16 / 10; object-fit:cover; object-position:left top; border-right:1px solid var(--color-rule-2); }
    .service-case-body { display:flex; flex-direction:column; min-width:0; padding:22px 24px; }
    .service-case-body h3 { margin-top:8px; font-size:20px; font-weight:700; }
    .service-case-body > p:not(.service-kicker):not(.service-dev-links) { margin-top:8px; color:var(--color-ink-2); line-height:1.8; }
    .service-case-body .service-dev-links { margin-top:auto; padding-top:18px; }
    .service-free { display:grid; grid-template-columns:minmax(0, 1fr) minmax(280px, .9fr); gap:48px; align-items:center; }
        .service-free-media { display:block; width:100%; height:auto; border:1px solid var(--color-rule-2); }
    @media (max-width:767px) {
      .service-hero { gap:32px; width:calc(100% - 40px); padding:48px 0 0; }
      .service-hero h1 { font-size:clamp(32px, 9vw, 44px); line-height:1.18; }
      .service-lead { font-size:16px; line-height:1.8; }
      .service-hero-actions { display:grid; grid-template-columns:1fr; }
      .service-hero-actions a { width:100%; }
      .service-dev, .service-experience, .service-home-cta { width:calc(100% - 40px); }
      .service-dev { margin-top:64px; padding-top:40px; }
      .service-experience, .service-home-cta { margin-top:76px; }
      .service-free { grid-template-columns:1fr; gap:28px; }
      .service-router { width:calc(100% - 40px); }
      .service-more { grid-template-columns:minmax(0, 1fr); grid-auto-rows:1fr; gap:12px; }
      .service-case { grid-template-columns:minmax(0, 1fr); }
      .service-case-thumb { border-right:0; border-bottom:1px solid var(--color-rule-2); }
    }
    @media (max-width:340px) {
      .service-hero, .service-router, .service-dev, .service-experience, .service-home-cta { width:calc(100% - 32px); }
      .service-hero h1 { font-size:38px; }
    }
  </style>
</ServiceBase>
