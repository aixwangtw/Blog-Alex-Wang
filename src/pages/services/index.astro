---
import { Image } from 'astro:assets';
import freeResourcesHome from '../../assets/free-resources-home-v2.png';
import Cta from '../../components/Cta.astro';
import {
  AUTHOR,
  COLLABORATION_ENTRY_LINKS,
  CTA_VARIANTS,
  FREE_ENTRY_LINKS,
  GUIDED_ENTRY_LINKS,
  LEARNING_ENTRY_LINKS,
  LINKS,
  PERSON_SCHEMA,
  SERVICE_SITE,
  SITE,
  pageBannerUrl,
} from '../../consts';
import { SPEAKING_ENGAGEMENTS, TEACHING_CASES } from '../../data/services';
import ServiceBase from '../../layouts/ServiceBase.astro';

// 三種服務：系統開發為主，其餘兩項只列成次要細線列表。描述取自站上既有事實（TEACHING_CASES、SPEAKING_ENGAGEMENTS）。
const heroServiceCards = [
  { key: 'development', href: '/services/development/', title: '系統開發' },
  {
    key: 'course',
    href: '/course/',
    title: 'AI 一對一教學',
    description: '不需要程式背景，3 小時用你自己的電腦和帳號，從裝好 Claude Code、Codex、Hermes 或 OpenClaw，做到第一個能用的專案，像自動發文、整理 Email。',
    action: '看教學內容',
  },
  {
    key: 'speaking',
    href: '/services/speaking/',
    title: '演講邀約',
    description: `企業、學校與社群的 AI 演講，主題可依聽眾背景調整，講過 ${SPEAKING_ENGAGEMENTS.slice(0, 2).map((item) => item.host).join('、')}等場次。`,
    action: '看演講紀錄',
  },
];
const secondaryServices = heroServiceCards.filter((card) => card.key !== 'development');

// 系統開發區的三張真實截圖：主圖放大，另兩張當輔助。
const devShots = {
  main: { src: '/images/blog/math-teacher-question-bank/import-review.jpg', width: 1400, height: 875, alt: '題庫系統的考卷匯入審核頁：左邊是原始考卷，右邊是 AI 辨識出來的題目' },
  extras: [
    { src: '/images/blog/math-teacher-question-bank/ai-similar-triangle.jpg', width: 1400, height: 875, alt: '題庫系統的 AI 出相似題：依一題三角形題目產生相似題與詳解' },
    { src: '/images/blog/math-teacher-question-bank/exam-export.jpg', width: 1400, height: 972, alt: '題庫系統的出卷頁：勾選題目、排序後直接匯出考卷' },
  ],
};

// 快速入口（原本在主站首屏）：主站相對路徑要補上主站網域，服務站上才連得到。
const absolute = (href: string) => (href.startsWith('/') ? `${SITE.url}${href}` : href);
const entryTabs = [
  { key: 'collaborate', label: '邀合作', links: COLLABORATION_ENTRY_LINKS },
  { key: 'learn', label: '自己學', links: LEARNING_ENTRY_LINKS },
  { key: 'guided', label: '找人帶', links: GUIDED_ENTRY_LINKS },
  { key: 'free', label: '找免費', links: FREE_ENTRY_LINKS },
].map((tab) => ({ ...tab, links: tab.links.map((entry) => ({ ...entry, href: absolute(entry.href) })) }));

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SERVICE_SITE.url}/#webpage`,
    url: `${SERVICE_SITE.url}/`,
    name: 'Aix 系統開發服務｜客製系統開發、AI 教學與演講',
    description: SERVICE_SITE.description,
    isPartOf: { '@id': `${SERVICE_SITE.url}/#website` },
    about: { '@id': PERSON_SCHEMA['@id'] },
  },
  {
    '@type': 'ItemList',
    name: 'Aix 系統開發服務項目',
    itemListElement: heroServiceCards.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      url: new URL(item.href, SERVICE_SITE.url).href,
    })),
  },
];
---

<ServiceBase
  title="Aix 系統開發服務｜AI 自動化系統開發、數學題庫系統案例"
  description={SERVICE_SITE.description}
  canonicalPath="/"
  ogImage={pageBannerUrl('service-home')}
  ogImageAlt="Aix 系統開發服務｜工程師 Alex"
  schema={schema}
>
  <section class="service-entry" id="quick-entry" aria-labelledby="quick-entry-h">
    <header>
      <p class="service-kicker">快速入口</p>
      <h2 id="quick-entry-h">你希望我如何幫你？</h2>
    </header>
    <div class="service-entry-tabs" role="tablist" aria-label="選擇需求">
      {entryTabs.map((tab, index) => (
        <button
          id={`entry-tab-${tab.key}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`entry-panel-${tab.key}`}
          tabindex={index === 0 ? undefined : '-1'}
          data-entry-tab={tab.key}
          data-ga-button={`service_entry_tab_${tab.key}`}
          data-ga-label={tab.label}
          data-ga-location="service_quick_entry"
          data-ga-action="switch_tab"
        >{tab.label}</button>
      ))}
    </div>
    {entryTabs.map((tab, index) => (
      <div id={`entry-panel-${tab.key}`} class="service-entry-panel" role="tabpanel" aria-labelledby={`entry-tab-${tab.key}`} data-entry-panel={tab.key} hidden={index !== 0}>
        <nav class="service-entry-options" aria-label={tab.label}>
          {tab.links.map((entry, linkIndex) => (
            <a href={entry.href} data-ga-button={`service_entry_${entry.analyticsKey}`} data-ga-label={entry.analyticsLabel} data-ga-location="service_quick_entry" data-ga-action="navigate">
              <span class="service-entry-index" aria-hidden="true">{String(linkIndex + 1).padStart(2, '0')}</span>
              <span><strong>{entry.title}</strong><small>{entry.description}</small></span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </div>
    ))}
  </section>

  <section class="service-hero">
    <div class="service-hero-copy">
      <p class="service-kicker">{SERVICE_SITE.title}</p>
      <h1><span class="nb">客製系統開發，</span><span class="nb">也教 AI、接演講</span></h1>
      <p class="service-lead">我是 {AUTHOR.name}，目前全職接案。主要和開發夥伴承接客製系統開發；也提供一對一 AI 教學（雙北咖啡廳實體或線上），並接受企業、學校與社群的演講邀約。先看你需要哪一種，再加 LINE 聊細節。</p>
      <div class="service-hero-actions">
        <a href="/services/development/" data-ga-button="service_home_development" data-ga-label="看系統開發服務" data-ga-location="service_home_hero" data-ga-action="navigate">看系統開發服務</a>
      </div>
    </div>
  </section>

  <section class="service-dev" id="system-development" aria-labelledby="service-dev-h">
    <p class="service-kicker">系統開發</p>
    <h2 id="service-dev-h">數學題庫系統</h2>
    <p class="service-section-lead">題庫與教學系統、後台管理、LINE 網頁、AI 自動化流程。代表案例是補習班數學題庫：考卷匯入、AI 辨識審核、AI 出相似題與詳解、出卷與匯出。</p>
    <figure class="service-shot service-shot--main">
      <img src={devShots.main.src} alt={devShots.main.alt} width={devShots.main.width} height={devShots.main.height} loading="lazy" decoding="async" />
    </figure>
    <div class="service-shot-row">
      {devShots.extras.map((shot) => (
        <figure class="service-shot">
          <img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
    <p class="service-dev-links">
      <a href="/services/development/" data-ga-button="service_home_dev_detail" data-ga-label="看合作流程與費用" data-ga-location="service_home_dev" data-ga-action="navigate">看合作流程與費用 <span aria-hidden="true">→</span></a>
    </p>
  </section>

  <section class="service-others" aria-label="其他服務">
    <ul>
      {secondaryServices.map((card) => (
        <li>
          <div>
            <strong>{card.title}</strong>
            <span>{card.description}</span>
          </div>
          <a href={card.href} data-ga-button={`service_home_card_${card.key}`} data-ga-label={card.title} data-ga-location="service_home_others" data-ga-action="navigate">{card.action} <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>


  <section class="service-experience" id="teaching-cases">
    <header>
      <p class="service-kicker">AI 一對一教學</p>
      <h2>私人家教案例</h2>
      <p class="service-section-lead">每堂課都用學員自己的電腦、帳號和需求實作，過去已帶學員完成 Agent 安裝、社群自動發文、Email 與行事曆整理，以及 OpenClaw 排錯救援。</p>
    </header>
    <ul class="service-case-list">
      {TEACHING_CASES.map((item) => (
        <li>
          <Image src={item.image} alt={item.imageAlt} width={64} class="service-case-icon" />
          <div>
            <strong>{item.topic}</strong>
            <span>{item.student}</span>
          </div>
        </li>
      ))}
    </ul>
    <a class="service-text-link" href="/course/" data-ga-button="service_home_course_cases" data-ga-label="查看完整教學案例與上課方式" data-ga-location="service_home_teaching" data-ga-action="navigate">查看完整案例與上課方式 →</a>
  </section>

  <section class="service-experience" id="speaking-cases">
    <header>
      <p class="service-kicker">演講邀約</p>
      <h2>過往演講紀錄</h2>
    </header>
    <ul class="service-speaking-list">
      {SPEAKING_ENGAGEMENTS.slice(0, 3).map((item, index) => (
        <li>
          <Image src={item.image} alt={item.imageAlt} widths={[160, 320]} sizes="(min-width: 768px) 160px, 96px" loading="lazy" />
          <div>
            <small>{item.host}<span>CASE 0{index + 1}</span></small>
            <h3>{item.topic}</h3>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ul>
    <a class="service-text-link" href="/services/speaking/">查看全部演講案例 →</a>
  </section>

  <section class="service-experience service-free" id="free-resources">
    <div class="service-free-copy">
      <p class="service-kicker">先自己試試看</p>
      <h2>免費資源</h2>
      <p class="service-section-lead">整理了免費教學文章、影片與開源工具，點選你需要的主題就能查看。</p>
      <ul>
        <li>Codex 新手安裝教學</li>
        <li>可直接交給 AI 安裝的 Skills</li>
        <li>API 串接教學與開源工具</li>
      </ul>
      <a class="service-text-link" href={`${SITE.url}/resources/`} data-ga-button="service_home_free_resources" data-ga-label="查看免費資源" data-ga-location="service_home_free" data-ga-action="navigate">查看免費資源 →</a>
    </div>
    <Image src={freeResourcesHome} alt="教學影片、開源工具與實作指南組成的免費 AI 學習資源" widths={[560, 880]} sizes="(min-width: 768px) 45vw, 100vw" class="service-free-media" />
  </section>

  <div class="service-home-cta">
    <Cta
      title={CTA_VARIANTS[2].title}
      text={CTA_VARIANTS[2].text}
      label={'了解系統\n開發服務'}
      external={false}
      links={[{ href: LINKS.email, label: 'Email 聯絡' }]}
    />
  </div>

  <style>
    .service-kicker { color:var(--color-accent); font-size:13px; font-weight:700; letter-spacing:.08em; }
    .service-hero { display:grid; gap:44px; width:min(1120px, calc(100% - 48px)); margin:0 auto; padding:88px 0 0; }
    .service-hero-copy { max-width:760px; }
    .service-hero h1 { max-width:18ch; margin-top:22px; font-family:var(--font-serif, serif); font-size:clamp(40px, 4.6vw, 60px); font-weight:600; line-height:1.12; letter-spacing:-.055em; }
    .service-lead { max-width:620px; margin-top:28px; color:var(--color-ink-2); font-size:18px; line-height:1.9; }
    .service-hero-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:34px; }
    .service-hero-actions a { display:inline-flex; min-height:50px; align-items:center; justify-content:center; padding:0 24px; border:1px solid var(--color-accent); background:var(--color-accent); color:#fff; font-weight:700; text-decoration:none; }
    .service-hero h1 .nb { white-space:nowrap; }
    .service-lead a { color:var(--color-accent); text-decoration:underline; text-underline-offset:4px; }
    .service-dev { width:min(1120px, calc(100% - 48px)); margin:96px auto 0; padding-top:56px; border-top:1px solid var(--color-rule); }
    .service-dev h2 { margin-top:14px; font:600 clamp(36px, 4.6vw, 60px)/1.15 var(--font-serif, serif); letter-spacing:-.04em; }
    .service-shot { margin:0; }
    .service-shot img { display:block; width:100%; height:auto; border:1px solid var(--color-rule-2); }
    .service-shot--main { margin-top:36px; }
    .service-shot-row { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:24px; margin-top:24px; }
    .service-dev-links { margin-top:28px; }
    .service-dev-links a, .service-others a { color:var(--color-accent); font-weight:700; text-decoration:none; }
    .service-others { width:min(1120px, calc(100% - 48px)); margin:64px auto 0; }
    .service-others ul { margin:0; padding:0; list-style:none; }
    .service-others li { display:grid; grid-template-columns:minmax(0, 1fr) auto; gap:24px; align-items:center; padding:22px 2px; border-top:1px solid var(--color-rule); }
    .service-others li:last-child { border-bottom:1px solid var(--color-rule); }
    .service-others strong { display:block; font-size:17px; line-height:1.4; }
    .service-others li span { display:block; margin-top:6px; max-width:62ch; color:var(--color-ink-3); font-size:14px; line-height:1.75; }
    .service-others a { white-space:nowrap; }
    .service-experience { width:min(1120px, calc(100% - 48px)); margin:110px auto 0; }
    .service-experience > header { max-width:700px; }
    .service-experience h2 { margin-top:14px; font:600 clamp(34px, 4vw, 52px)/1.25 var(--font-serif, serif); letter-spacing:-.035em; }
    .service-text-link { display:inline-block; margin-top:24px; color:var(--color-accent); font-weight:700; text-decoration:none; }
    .service-home-cta { width:min(1120px, calc(100% - 48px)); margin:80px auto 0; }
    .service-section-lead { max-width:62ch; margin-top:16px; color:var(--color-ink-2); line-height:1.85; }
    .service-case-list { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); column-gap:40px; margin:34px 0 0; padding:0; list-style:none; }
    .service-case-list li { display:grid; grid-template-columns:44px minmax(0, 1fr); gap:14px; align-items:center; padding:18px 2px; border-top:1px solid var(--color-rule); }
    .service-case-icon { width:44px; height:44px; object-fit:contain; }
    .service-case-list strong { display:block; color:var(--color-ink); line-height:1.5; }
    .service-case-list span { display:block; margin-top:4px; color:var(--color-ink-3); font-size:13px; }
    .service-speaking-list { margin:34px 0 0; padding:0; list-style:none; }
    .service-speaking-list li { display:grid; grid-template-columns:160px minmax(0, 1fr); gap:28px; align-items:start; padding:24px 2px; border-top:1px solid var(--color-rule); }
    .service-speaking-list li > img { display:block; width:160px; height:auto; aspect-ratio:4 / 3; object-fit:cover; border:1px solid var(--color-rule-2); }
    .service-speaking-list small { display:flex; gap:12px; color:var(--color-accent); font-weight:700; }
    .service-speaking-list small span { color:var(--color-ink-3); font:700 10px/1.8 ui-monospace, monospace; }
    .service-speaking-list h3 { margin-top:8px; font-size:20px; line-height:1.45; }
    .service-speaking-list p { margin-top:8px; color:var(--color-ink-3); line-height:1.75; }
    .service-free { display:grid; grid-template-columns:minmax(0, 1fr) minmax(280px, .9fr); gap:48px; align-items:center; }
    .service-free-copy ul { display:grid; gap:8px; margin-top:18px; padding:0; list-style:none; color:var(--color-ink-3); }
    .service-free-media { display:block; width:100%; height:auto; border:1px solid var(--color-rule-2); }
    .service-entry { width:min(1120px, calc(100% - 48px)); margin:64px auto 0; }
    .service-entry h2 { margin-top:14px; font:600 clamp(34px, 4vw, 52px)/1.25 var(--font-serif, serif); letter-spacing:-.035em; }
    .service-entry-tabs { display:flex; flex-wrap:wrap; gap:6px 28px; margin-top:28px; }
    .service-entry-tabs button { min-height:44px; padding:0; border:0; border-bottom:2px solid transparent; background:transparent; color:var(--color-ink-3); font-size:16px; font-weight:700; cursor:pointer; }
    .service-entry-tabs button[aria-selected='true'] { border-bottom-color:var(--color-accent); color:var(--color-ink); }
    .service-entry-tabs button:focus-visible { outline:2px solid var(--color-accent); outline-offset:2px; }
    .service-entry-panel[hidden] { display:none; }
    .service-entry-options { display:grid; margin-top:8px; }
    .service-entry-options a { display:grid; grid-template-columns:40px minmax(0, 1fr) auto; gap:12px; align-items:center; padding:18px 2px; border-top:1px solid var(--color-rule); color:var(--color-ink); text-decoration:none; }
    .service-entry-options a:hover strong { color:var(--color-accent); }
    .service-entry-index { color:var(--color-accent); font:700 12px/1 ui-monospace, monospace; }
    .service-entry-options strong { display:block; }
    .service-entry-options small { display:block; margin-top:4px; color:var(--color-ink-3); font-size:13px; }
    @media (max-width:767px) {
      .service-hero { gap:32px; width:calc(100% - 40px); padding:48px 0 0; }
      .service-hero h1 { font-size:clamp(32px, 9vw, 44px); line-height:1.18; }
      .service-lead { font-size:16px; line-height:1.8; }
      .service-hero-actions { display:grid; grid-template-columns:1fr; }
      .service-hero-actions a { width:100%; }
      .service-dev, .service-others, .service-experience, .service-home-cta, .service-entry { width:calc(100% - 40px); }
      .service-dev { margin-top:64px; padding-top:40px; }
      .service-shot-row { grid-template-columns:1fr; gap:16px; }
      .service-others li { grid-template-columns:1fr; gap:10px; }
      .service-experience, .service-home-cta { margin-top:76px; }
      .service-case-list { grid-template-columns:1fr; }
      .service-speaking-list li { grid-template-columns:96px minmax(0, 1fr); gap:16px; }
      .service-speaking-list li > img { width:96px; }
      .service-free { grid-template-columns:1fr; gap:28px; }
      .service-entry { margin-top:40px; }
    }
    @media (max-width:340px) {
      .service-hero, .service-dev, .service-others, .service-experience, .service-home-cta, .service-entry { width:calc(100% - 32px); }
      .service-hero h1 { font-size:38px; }
    }
  </style>
  <script is:inline>
    (function () {
      var tabs = Array.from(document.querySelectorAll('[data-entry-tab]'));
      var panels = Array.from(document.querySelectorAll('[data-entry-panel]'));
      if (!tabs.length) return;
      function activate(key, focus) {
        tabs.forEach(function (tab) {
          var on = tab.getAttribute('data-entry-tab') === key;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          if (on && focus) tab.focus();
        });
        panels.forEach(function (panel) { panel.hidden = panel.getAttribute('data-entry-panel') !== key; });
      }
      tabs.forEach(function (tab, index) {
        tab.addEventListener('click', function () { activate(tab.getAttribute('data-entry-tab'), false); });
        tab.addEventListener('keydown', function (event) {
          var next = index;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault();
          activate(tabs[next].getAttribute('data-entry-tab'), true);
        });
      });
    })();
  </script>
</ServiceBase>
