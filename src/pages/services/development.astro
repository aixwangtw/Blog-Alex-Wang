---
// 系統開發服務頁（service.aixwang.dev/services/development/）。
// 內容只寫已確認的事實：做過的案例類型、題庫系統功能、流程與付款方式；
// 流程、時程、付款與主機費用統一取自 consts.ts 的 DEVELOPMENT_SERVICE，
// 需與題庫文章 FAQ 第 1 題一致，不寫開發費金額。
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import Card from '../../components/Card.astro';
import CheckItem from '../../components/CheckItem.astro';
import Cta from '../../components/Cta.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { AUTHOR, DEVELOPMENT_SERVICE, PROFESSIONAL_SERVICE_SCHEMA, SERVICE_SITE, SITE, breadcrumbSchema } from '../../consts';
import ServiceBase from '../../layouts/ServiceBase.astro';
import { blogBannerPath } from '../../lib/blog-banner';

// 常見問題：題目與答案一字不改，取自題庫文章 FAQ 裡已有的系統開發題（費用、流程、AI 成本、Demo 是否開放、其他科目）。
// 找不到就中斷建置，避免文章 FAQ 改題後這裡悄悄變成空的或漂移。
const caseArticle = (await getCollection('blog')).find((post) => post.id === 'math-teacher-question-bank');
const DEVELOPMENT_FAQ_QUESTIONS = [
  '開發怎麼進行？費用怎麼算？',
  'AI 的使用費用怎麼算？',
  '可以提供原始碼跟資料庫嗎？',
  '不想讓題目被外流出去，可以簽保密協議嗎？',
  '擔心保固結束後找不到人處理怎麼辦？',
  '除了數學以外，也有其他科目嗎？',
  '國中、高中都可以用嗎？',
  '有 Demo 可以試用嗎？',
];
const developmentFaqs = DEVELOPMENT_FAQ_QUESTIONS.map((question) => {
  const faq = caseArticle?.data.faqs.find((item) => item.question === question);
  if (!faq) throw new Error(`題庫文章找不到 FAQ「${question}」，請更新 services/development.astro 的題目清單`);
  return faq;
});

const caseArticleUrl = `${SITE.url}${DEVELOPMENT_SERVICE.caseArticle}`;

const capabilities = [
  { title: '題庫與教學系統', description: '考卷匯入、AI 辨識、單元分類、出卷與複製到 Word，代表案例就是下方的數學題庫系統。' },
  { title: '後台管理系統', description: '把散在表單、試算表與訊息裡的資料，整理成一套有權限、可查詢的後台，例如 CRM 客戶管理。' },
  { title: 'LINE 相關網頁', description: 'LINE LIFF 網頁、預約與會員功能，讓客戶在 LINE 裡就能完成操作。' },
  { title: 'AI 自動化流程', description: '把重複的整理、回覆與產出交給 AI，例如 AI 客服與 AI 詳解；AI 出題可依需求開發。' },
];

const caseFeatures = [
  '上傳 PDF、Word 或考卷照片，AI 拆成一題一題，老師對照原卷審核',
  '依冊、章分單元，另有難易度、題型、學校、卷別標籤',
  '題目列表勾選後，選題目版、詳解版或答與解版，複製到 Word 或 MathType',
  'AI 產生詳解，老師確認後才收進題庫；AI 出題是常見需求，正式導入時依需求開發',
];

// 首屏下方三個合作重點（原本在服務站首頁）；時程與付款細節見下方「時程與費用」，同取自 DEVELOPMENT_SERVICE。
const developmentHighlights = ['和開發夥伴一起開發', '開發時程約兩個月', '分三期付款'];

const pageToc = [
  { id: 'development-scope', label: '可以做什麼' },
  { id: 'development-case', label: '代表案例' },
  { id: 'development-process', label: '合作流程' },
  { id: 'development-cost', label: '時程與費用' },
  { id: 'development-faq', label: '常見問題' },
];

const schema = [
  breadcrumbSchema([
    { name: '服務首頁', item: `${SERVICE_SITE.url}/` },
    { name: '客製系統開發' },
  ]),
  {
    '@type': 'Service',
    '@id': `${DEVELOPMENT_SERVICE.url}#service`,
    name: '客製系統開發',
    serviceType: '客製系統開發 / 後台管理系統 / AI 自動化',
    description:
      'Alex 和開發夥伴承接客製系統開發，用 AI 自動化整理資料、產出內容。代表案例是補習班數學老師用的題庫系統：考卷匯入、AI 詳解。',
    provider: { '@id': AUTHOR.id },
    areaServed: '台灣',
  },
  PROFESSIONAL_SERVICE_SCHEMA,
  {
    '@type': 'FAQPage',
    '@id': `${DEVELOPMENT_SERVICE.url}#faq`,
    name: '客製系統開發常見問題',
    url: DEVELOPMENT_SERVICE.url,
    mainEntity: developmentFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<ServiceBase
  title="客製化系統開發服務｜數學題庫系統案例"
  description="Alex 和開發夥伴承接客製系統開發：題庫與教學系統、後台管理系統、LINE 相關網頁與 AI 自動化流程。代表案例是補習班數學題庫系統，開發時程約兩個月，分三期付款。"
  ogImage={`${SITE.url}${blogBannerPath('math-teacher-question-bank')}`}
  ogImageAlt="客製系統開發｜代表案例：數學題庫系統"
  schema={schema}
>
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-6 sm:py-14">
    <Breadcrumbs items={[{ name: '服務首頁', href: `${SERVICE_SITE.url}/` }, { name: '客製系統開發' }]} class="mb-8" />

    <section class="grid items-center gap-9 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-14">
      <div>
        <p class="text-sm font-semibold text-accent">客製系統開發｜題庫與教學系統、後台管理、LINE 網頁、AI 自動化流程</p>
        <h1 class="t-h1 mt-3 font-semibold text-ink">客製化系統開發<span class="mt-2 block text-[0.55em] leading-snug">代表案例：數學題庫系統</span></h1>
        <p class="mt-6 text-base leading-8 text-ink sm:text-lg sm:leading-9">
          補習班數學老師上傳 PDF、Word 或考卷照片，AI 拆成一題一題，老師對照原卷確認後才收進題庫；出卷時勾選、排序，就能複製到 Word 或 MathType。你手上如果也有每天重複整理的資料，可以點右下角官方 LINE 跟我們聊。Demo 暫停開放，想試用請私訊。
        </p>
      </div>
      <video
        src={`${SITE.url}/videos/math-question-bank-reel.mp4`}
        poster={`${SITE.url}/images/math-question-bank-reel-poster.webp`}
        width="720"
        height="1280"
        controls
        preload="metadata"
        playsinline
        aria-label="數學題庫系統介紹短影音：AI 辨識紙本考卷、AI 出題、AI 解析答案"
        class="aspect-[9/16] h-auto w-[min(78%,300px)] justify-self-center border border-rule bg-ink lg:w-[min(340px,calc((100svh-160px)*9/16))]"
      ></video>
    </section>

    <ul class="mt-10 grid border-y border-rule sm:grid-cols-3" aria-label="系統開發合作重點">
      {developmentHighlights.map((item) => (
        <li class="border-rule px-4 py-5 text-center [&+&]:border-t sm:[&+&]:border-l sm:[&+&]:border-t-0">
          <strong class="block font-semibold text-accent">{item}</strong>
        </li>
      ))}
    </ul>

    <nav aria-label="系統開發服務目錄" class="mt-8 overflow-x-auto border-y border-rule">
      <ul class="flex min-w-max sm:grid sm:min-w-0 sm:grid-cols-5">
        {pageToc.map((item) => (
          <li class="min-w-28 flex-1"><a href={`#${item.id}`} class="block px-3 py-4 text-center font-semibold text-ink transition hover:bg-paper-2 hover:text-accent">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <SectionHeading id="development-scope" size="md" class="mt-16 scroll-mt-24">可以做什麼</SectionHeading>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {capabilities.map((item) => (
        <Card>
          <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
          <p class="mt-3 leading-7 text-ink-2">{item.description}</p>
        </Card>
      ))}
    </div>

    <SectionHeading id="development-case" size="md" class="mt-16 scroll-mt-24">代表案例：數學題庫系統</SectionHeading>
    <div class="mt-6 grid items-start gap-8 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="leading-8 text-ink-2">幫補習班數學老師把瑣碎的出題流程自動化，不用再挑題挑到青光眼。</p>
        <ul class="mt-5 space-y-4">
          {caseFeatures.map((item) => <CheckItem>{item}</CheckItem>)}
        </ul>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
          <a href={caseArticleUrl} class="font-semibold text-accent no-underline" data-ga-button="development_case_article" data-ga-label="看題庫系統完整介紹" data-ga-location="development_case" data-ga-action="navigate">看完整介紹 →</a>
        </div>
      </div>
      <img src={`${SITE.url}/images/blog/math-teacher-question-bank/exam-export.jpg`} alt="題庫系統的出卷頁：勾選題目、排序後直接匯出考卷" width="1400" height="972" class="h-auto w-full border border-rule" loading="lazy" decoding="async" />
    </div>

    <SectionHeading id="development-process" size="md" class="mt-16 scroll-mt-24">合作流程</SectionHeading>
    <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {DEVELOPMENT_SERVICE.steps.map((step, index) => (
        <li class="border border-rule bg-paper-2 p-5">
          <span class="font-mono text-xs text-accent">STEP 0{index + 1}</span>
          <p class="mt-2 font-semibold text-ink">{step}</p>
        </li>
      ))}
    </ol>

    <SectionHeading id="development-cost" size="md" class="mt-16 scroll-mt-24">時程與費用</SectionHeading>
    <ul class="mt-6 space-y-4">
      <CheckItem>{DEVELOPMENT_SERVICE.timeline}</CheckItem>
      <CheckItem>{DEVELOPMENT_SERVICE.payment}</CheckItem>
      <CheckItem>{DEVELOPMENT_SERVICE.hosting}</CheckItem>
    </ul>

    <SectionHeading id="development-faq" size="md" class="mt-16 scroll-mt-24">常見問題</SectionHeading>
    <div class="mt-6">
      <FaqList faqs={developmentFaqs} />
    </div>
    <p class="mt-4 text-sm">
      <a href={caseArticleUrl} class="text-accent underline underline-offset-4">更多問題見題庫系統完整介紹 →</a>
    </p>

    <Cta
      title="對系統有疑問嗎？"
      text="Demo 暫停開放，想試用請私訊。需求內容很長也沒關係，我跟夥伴都會一一看過再回覆。"
      hint="有問題點右下角官方 LINE 直接問我"
      href={DEVELOPMENT_SERVICE.caseArticle}
      label={'看題庫\n系統介紹'}
      external={false}
      links={[]}
    />
  </div>
</ServiceBase>
