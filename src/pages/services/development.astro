---
// 系統開發服務頁（service.aixwang.dev/services/development/）。
// 2026-10-24 起改成通用的客製系統開發介紹，題庫系統降為代表案例。
// 內容只寫〈系統開發、AI 導入費用怎麼算？〉文章已寫明的事實；
// 流程、時程、付款與主機費用統一取自 consts.ts 的 DEVELOPMENT_SERVICE，不寫開發費金額。
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import Card from '../../components/Card.astro';
import CheckItem from '../../components/CheckItem.astro';
import Cta from '../../components/Cta.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { AUTHOR, DEVELOPMENT_SERVICE, PROFESSIONAL_SERVICE_SCHEMA, SERVICE_SITE, SITE, breadcrumbSchema } from '../../consts';
import ServiceBase from '../../layouts/ServiceBase.astro';
import { DEVELOPMENT_AFTER_LAUNCH, DEVELOPMENT_CAPABILITIES, DEVELOPMENT_CASE_FEATURES } from '../../data/services';
import { getDevelopmentFaqs } from '../../lib/development-faqs';
import { blogBannerPath } from '../../lib/blog-banner';

const developmentFaqs = await getDevelopmentFaqs();

const caseArticleUrl = `${SITE.url}${DEVELOPMENT_SERVICE.caseArticle}`;
const guideArticleUrl = `${SITE.url}${DEVELOPMENT_SERVICE.guideArticle}`;
const feedbackDeskUrl = `${SITE.url}/blog/feedback-desk/`;

const capabilities = DEVELOPMENT_CAPABILITIES;

const caseFeatures = DEVELOPMENT_CASE_FEATURES;

const afterLaunch = DEVELOPMENT_AFTER_LAUNCH;

// 首屏下方三個合作重點，細節見下方各節，同取自 DEVELOPMENT_SERVICE 與新文章。
const developmentHighlights = ['簡易 Demo 免費', '依功能報價、分三期付款', '上線後一年保固'];

const pageToc = [
  { id: 'development-scope', label: '可以做什麼' },
  { id: 'development-process', label: '合作流程' },
  { id: 'development-cost', label: '時程與費用' },
  { id: 'development-after', label: '上線之後' },
  { id: 'development-case', label: '做過的案子' },
  { id: 'development-faq', label: '常見問題' },
];

const schema = [
  breadcrumbSchema([
    { name: '服務首頁', item: `${SERVICE_SITE.url}/` },
    { name: '客製系統開發' },
  ]),
  {
    '@type': 'Service',
    '@id': `${DEVELOPMENT_SERVICE.url}#service`,
    name: '客製系統開發',
    serviceType: '系統開發 / AI 導入 / 資料管理 / API 串接',
    description:
      'Alex 和開發夥伴承接客製系統開發與 AI 導入。談需求時先免費做簡易 Demo，看過再決定要不要簽約；開發費依功能報價、分三期付款，上線後一年保固。代表案例是補習班數學老師用的題庫系統。',
    provider: { '@id': AUTHOR.id },
    areaServed: '台灣',
  },
  PROFESSIONAL_SERVICE_SCHEMA,
  {
    '@type': 'FAQPage',
    '@id': `${DEVELOPMENT_SERVICE.url}#faq`,
    name: '客製系統開發常見問題',
    url: DEVELOPMENT_SERVICE.url,
    mainEntity: developmentFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<ServiceBase
  title="系統開發、AI 導入｜客製系統開發服務，先免費看 Demo 再簽約"
  description="客製系統開發與 AI 導入：談需求時先免費做簡易 Demo，看過再決定要不要簽約。開發費依功能報價、分三期付款，主機帳號用你的名義，一年保固、可簽保密協議。代表案例：數學題庫系統。"
  ogImage={`${SITE.url}${blogBannerPath('custom-system-development-demo')}`}
  ogImageAlt="系統開發、AI 導入：先免費看 Demo 再簽約"
  schema={schema}
>
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-6 sm:py-14">
    <Breadcrumbs items={[{ name: '服務首頁', href: `${SERVICE_SITE.url}/` }, { name: '客製系統開發' }]} class="mb-8" />

    <section class="max-w-3xl">
      <p class="text-sm font-semibold text-accent">客製系統開發｜AI 導入、資料管理、API 串接</p>
      <h1 class="t-h1 mt-3 font-semibold text-ink">系統開發、AI 導入<span class="mt-2 block text-[0.55em] leading-snug">先免費看 Demo，再決定要不要簽約</span></h1>
      <p class="mt-6 text-base leading-8 text-ink sm:text-lg sm:leading-9">
        第一次聊，我們會先了解你的需求。接著依你的需求免費做一個簡易 Demo，讓你看系統大概長什麼樣子、流程對不對；看完覺得不適合，不用付任何費用。
      </p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
        <a href={guideArticleUrl} class="inline-flex min-h-12 items-center border border-rule-2 px-6 font-semibold text-ink no-underline" data-ga-button="development_hero_guide" data-ga-label="看費用與合作方式" data-ga-location="development_hero" data-ga-action="navigate">看費用與合作方式</a>
      </div>
    </section>

    <ul class="mt-10 grid border-y border-rule sm:grid-cols-3" aria-label="系統開發合作重點">
      {developmentHighlights.map((item) => (
        <li class="border-rule px-4 py-5 text-center [&+&]:border-t sm:[&+&]:border-l sm:[&+&]:border-t-0">
          <strong class="block font-semibold text-accent">{item}</strong>
        </li>
      ))}
    </ul>

    <nav aria-label="系統開發服務目錄" class="mt-8 overflow-x-auto border-y border-rule">
      <ul class="flex min-w-max sm:grid sm:min-w-0 sm:grid-cols-6">
        {pageToc.map((item) => (
          <li class="min-w-28 flex-1"><a href={`#${item.id}`} class="block px-3 py-4 text-center font-semibold text-ink transition hover:bg-paper-2 hover:text-accent">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <SectionHeading id="development-scope" size="md" class="mt-16 scroll-mt-24">可以做什麼</SectionHeading>
    <p class="mt-4 max-w-3xl leading-8 text-ink-2">大多數功能都能做，AI 導入、資料管理、API 串接是我們團隊的強項。</p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {capabilities.map((item) => (
        <Card>
          <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
          <p class="mt-3 leading-7 text-ink-2">{item.description}</p>
        </Card>
      ))}
    </div>

    <SectionHeading id="development-process" size="md" class="mt-16 scroll-mt-24">合作流程</SectionHeading>
    <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {DEVELOPMENT_SERVICE.steps.map((step, index) => (
        <li class="border border-rule bg-paper-2 p-5">
          <span class="font-mono text-xs text-accent">STEP 0{index + 1}</span>
          <p class="mt-2 font-semibold text-ink">{step}</p>
        </li>
      ))}
    </ol>
    <p class="mt-6 max-w-3xl leading-8 text-ink-2">
      開發過程中，我會提供一套問題回報系統。想改的地方一個問題開一張單，可以附截圖；我們改好會在單上寫調整說明、附上畫面，你確認沒問題才算完成。這套回報系統是我們自己開發、開源的 <a href={feedbackDeskUrl} class="font-semibold text-accent underline underline-offset-4" data-ga-button="development_process_feedback_desk" data-ga-label="feedback-desk 介紹" data-ga-location="development_process" data-ga-action="navigate">feedback-desk</a>。
    </p>

    <SectionHeading id="development-cost" size="md" class="mt-16 scroll-mt-24">時程與費用</SectionHeading>
    <ul class="mt-6 space-y-4">
      <CheckItem>{DEVELOPMENT_SERVICE.timeline}</CheckItem>
      <CheckItem>{DEVELOPMENT_SERVICE.payment}</CheckItem>
      <CheckItem>{DEVELOPMENT_SERVICE.hosting}</CheckItem>
      <CheckItem>{DEVELOPMENT_SERVICE.aiCost}</CheckItem>
    </ul>

    <SectionHeading id="development-after" size="md" class="mt-16 scroll-mt-24">上線之後</SectionHeading>
    <ul class="mt-6 space-y-4">
      {afterLaunch.map((item) => <CheckItem>{item}</CheckItem>)}
    </ul>

    <SectionHeading id="development-case" size="md" class="mt-16 scroll-mt-24">做過的案子</SectionHeading>
    <p class="mt-4 max-w-3xl leading-8 text-ink-2">做過的系統有 CRM、背書系統、健檢系統、預約系統、揪團平台等，代表案例是幫補習班老師做的數學題庫系統。</p>
    <div class="mt-8 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-14">
      <div>
        <h3 class="text-xl font-semibold text-ink">代表案例：數學題庫系統</h3>
        <p class="mt-3 leading-8 text-ink-2">幫補習班數學老師把瑣碎的出題流程自動化，不用再挑題挑到青光眼。</p>
        <ul class="mt-5 space-y-4">
          {caseFeatures.map((item) => <CheckItem>{item}</CheckItem>)}
        </ul>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
          <a href={caseArticleUrl} class="font-semibold text-accent no-underline" data-ga-button="development_case_article" data-ga-label="看題庫系統完整介紹" data-ga-location="development_case" data-ga-action="navigate">看完整介紹 →</a>
          <a href={DEVELOPMENT_SERVICE.demoUrl} target="_blank" rel="noreferrer" class="font-semibold text-accent no-underline" data-ga-button="development_case_demo" data-ga-label="試用題庫系統 Demo" data-ga-location="development_case" data-ga-action="external">試用 Demo ↗</a>
        </div>
      </div>
      <video
        src={`${SITE.url}/videos/math-question-bank-reel.mp4`}
        poster={`${SITE.url}/images/math-question-bank-reel-poster.webp`}
        width="720"
        height="1280"
        controls
        preload="metadata"
        playsinline
        aria-label="數學題庫系統介紹短影音：AI 辨識紙本考卷、AI 出題、AI 解析答案"
        class="aspect-[9/16] h-auto w-[min(78%,300px)] justify-self-center border border-rule bg-ink lg:w-[300px]"
      ></video>
    </div>

    <SectionHeading id="development-faq" size="md" class="mt-16 scroll-mt-24">常見問題</SectionHeading>
    <div class="mt-6">
      <FaqList faqs={developmentFaqs} />
    </div>
    <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a href={guideArticleUrl} class="text-accent underline underline-offset-4">完整說明見〈系統開發、AI 導入費用怎麼算？〉→</a>
      <a href={caseArticleUrl} class="text-accent underline underline-offset-4">題庫系統的問題見題庫系統完整介紹 →</a>
    </p>

    <Cta
      title="對系統有疑問嗎？"
      text="加 LINE 可以免費評估。想先看做好的系統長什麼樣子，可以試用題庫系統的 Demo，免費、不用註冊。"
      hint="有問題點右下角官方 LINE 直接問我"
      href={DEVELOPMENT_SERVICE.demoUrl}
      label={'試用\n題庫 Demo'}
      external
      links={[]}
    />
  </div>
</ServiceBase>
