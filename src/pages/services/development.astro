---
// 系統開發服務頁（service.aixwang.dev/services/development/）。
// 內容只寫已確認的事實：做過的案例類型、題庫系統功能、流程與付款方式；
// 流程、時程、付款與主機費用統一取自 consts.ts 的 DEVELOPMENT_SERVICE，
// 需與題庫文章 FAQ 第 1 題一致，不寫開發費金額。
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import CheckItem from '../../components/CheckItem.astro';
import Cta from '../../components/Cta.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { AUTHOR, DEVELOPMENT_SERVICE, LINE_URLS, LINKS, SERVICE_SITE, SITE, breadcrumbSchema } from '../../consts';
import ServiceBase from '../../layouts/ServiceBase.astro';
import { blogBannerPath } from '../../lib/blog-banner';

const caseArticleUrl = `${SITE.url}${DEVELOPMENT_SERVICE.caseArticle}`;

const capabilities = [
  { title: '題庫與教學系統', description: '考卷匯入、AI 辨識、單元分類、出卷與匯出，代表案例就是下方的數學題庫系統。' },
  { title: '後台管理系統', description: '把散在表單、試算表與訊息裡的資料，整理成一套有權限、可查詢的後台，例如 CRM 客戶管理。' },
  { title: 'LINE 相關網頁', description: 'LINE LIFF 網頁、預約與會員功能，讓客戶在 LINE 裡就能完成操作。' },
  { title: 'AI 自動化流程', description: '把重複的整理、回覆與產出交給 AI，例如 AI 客服、AI 出題與 AI 詳解。' },
];

const caseFeatures = [
  '上傳 PDF、Word 或考卷照片，AI 拆成一題一題，老師對照原卷審核',
  '依冊、章分單元，另有難易度、題型、學校、卷別標籤',
  '出卷區勾選、排序後直接匯出 PNG，或複製到 Word、MathType',
  'AI 出相似題、AI 產生詳解，老師確認後才收進題庫',
];

const pageToc = [
  { id: 'development-scope', label: '可以做什麼' },
  { id: 'development-case', label: '代表案例' },
  { id: 'development-process', label: '合作流程' },
  { id: 'development-cost', label: '時程與費用' },
];

const schema = [
  breadcrumbSchema([
    { name: '服務首頁', item: `${SERVICE_SITE.url}/` },
    { name: '客製系統開發' },
  ]),
  {
    '@type': 'Service',
    '@id': `${DEVELOPMENT_SERVICE.url}#service`,
    name: '客製系統開發',
    serviceType: '客製系統開發 / 後台管理系統 / AI 自動化',
    description:
      'Alex 和開發夥伴承接客製系統開發，把重複的工作做成一套系統。代表案例是補習班數學老師用的題庫系統：考卷匯入、AI 出題、AI 詳解。',
    provider: { '@id': AUTHOR.id },
    areaServed: '台灣',
  },
];
---

<ServiceBase
  title="客製系統開發｜把重複的工作做成一套系統"
  description="Alex 和開發夥伴承接客製系統開發：題庫與教學系統、後台管理系統、LINE 相關網頁與 AI 自動化流程。代表案例是補習班數學題庫系統，開發時程約兩個月，分三期付款。"
  ogImage={`${SITE.url}${blogBannerPath('math-teacher-question-bank')}`}
  ogImageAlt="客製系統開發｜代表案例：數學題庫系統"
  schema={schema}
>
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-6 sm:py-14">
    <Breadcrumbs items={[{ name: '服務首頁', href: `${SERVICE_SITE.url}/` }, { name: '客製系統開發' }]} class="mb-8" />

    <section class="grid items-center gap-9 lg:grid-cols-[1fr_0.92fr] lg:gap-14">
      <div>
        <p class="text-sm font-semibold text-accent">系統開發／客製開發</p>
        <h1 class="t-h1 mt-3 font-semibold text-ink">把重複的工作，做成一套系統</h1>
        <p class="mt-6 text-base leading-8 text-ink sm:text-lg sm:leading-9">
          我是 <a href={`${SITE.url}/about/`} class="text-accent underline underline-offset-4">{AUTHOR.name}</a>，目前全職接案，和開發夥伴承接
          <strong class="text-accent">客製系統開發</strong>。先聊你手上的工作怎麼進行，再把重複、瑣碎的部分做成一套系統。
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={LINE_URLS.blog} target="_blank" rel="noreferrer" class="inline-flex min-h-12 items-center bg-[#06c755] px-6 font-semibold text-white no-underline" data-ga-button="development_hero_line" data-ga-label="加官方 LINE 免費評估" data-ga-location="development_hero" data-ga-action="external">加官方 LINE 免費評估</a>
          <a href={caseArticleUrl} class="inline-flex min-h-12 items-center border border-rule-2 px-6 font-semibold text-ink no-underline" data-ga-button="development_hero_case" data-ga-label="看題庫系統案例" data-ga-location="development_hero" data-ga-action="navigate">看題庫系統案例</a>
        </div>
      </div>
      <img src={`${SITE.url}/images/blog/math-teacher-question-bank/import-review.jpg`} alt="題庫系統的考卷匯入審核頁：左邊是原始考卷，右邊是 AI 辨識出來的題目" width="1400" height="875" class="h-auto w-full border border-rule object-cover" loading="eager" />
    </section>

    <nav aria-label="系統開發服務目錄" class="mt-10 overflow-x-auto border-y border-rule">
      <ul class="flex min-w-max sm:grid sm:min-w-0 sm:grid-cols-4">
        {pageToc.map((item) => (
          <li class="min-w-28 flex-1"><a href={`#${item.id}`} class="block px-3 py-4 text-center font-semibold text-ink transition hover:bg-paper-2 hover:text-accent">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <SectionHeading id="development-scope" size="md" class="mt-16 scroll-mt-24">可以做什麼</SectionHeading>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {capabilities.map((item) => (
        <Card>
          <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
          <p class="mt-3 leading-7 text-ink-2">{item.description}</p>
        </Card>
      ))}
    </div>

    <SectionHeading id="development-case" size="md" class="mt-16 scroll-mt-24">代表案例：數學題庫系統</SectionHeading>
    <div class="mt-6 grid items-start gap-8 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="leading-8 text-ink-2">幫補習班數學老師把瑣碎的出題流程自動化，不用再挑題挑到青光眼。</p>
        <ul class="mt-5 space-y-4">
          {caseFeatures.map((item) => <CheckItem>{item}</CheckItem>)}
        </ul>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
          <a href={caseArticleUrl} class="font-semibold text-accent no-underline" data-ga-button="development_case_article" data-ga-label="看題庫系統完整介紹" data-ga-location="development_case" data-ga-action="navigate">看完整介紹 →</a>
          <a href={DEVELOPMENT_SERVICE.demoUrl} target="_blank" rel="noreferrer" class="font-semibold text-accent no-underline" data-ga-button="development_case_demo" data-ga-label="試用題庫系統 Demo" data-ga-location="development_case" data-ga-action="external">試用 Demo ↗</a>
        </div>
      </div>
      <img src={`${SITE.url}/images/blog/math-teacher-question-bank/exam-export.jpg`} alt="題庫系統的出卷頁：勾選題目、排序後直接匯出考卷" width="1400" height="972" class="h-auto w-full border border-rule" loading="lazy" decoding="async" />
    </div>

    <SectionHeading id="development-process" size="md" class="mt-16 scroll-mt-24">合作流程</SectionHeading>
    <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {DEVELOPMENT_SERVICE.steps.map((step, index) => (
        <li class="border border-rule bg-paper-2 p-5">
          <span class="font-mono text-xs text-accent">STEP 0{index + 1}</span>
          <p class="mt-2 font-semibold text-ink">{step}</p>
        </li>
      ))}
    </ol>

    <SectionHeading id="development-cost" size="md" class="mt-16 scroll-mt-24">時程與費用</SectionHeading>
    <ul class="mt-6 space-y-4">
      <CheckItem>{DEVELOPMENT_SERVICE.timeline}</CheckItem>
      <CheckItem>{DEVELOPMENT_SERVICE.payment}</CheckItem>
      <CheckItem>{DEVELOPMENT_SERVICE.hosting}</CheckItem>
    </ul>

    <Cta
      title="想把手上的工作做成一套系統？"
      text="加官方 LINE 直接列出你的需求，內容很長也沒關係，我跟夥伴都會一一看過再回覆。"
      href={LINE_URLS.blog}
      label={'加官方 LINE\n免費評估'}
      links={[{ href: LINKS.email, label: 'Email 聯絡' }]}
    />
  </div>
</ServiceBase>
